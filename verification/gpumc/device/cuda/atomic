#pragma once
// cuda::atomic_ref for a GPUMC harness: each operation carries the memory order it is given and
// the scope of the template argument (thread_scope_block at block scope, every other scope at
// device scope).
#include "../hg_gpumc.hpp"

namespace cuda {

enum thread_scope {
    thread_scope_system,
    thread_scope_device,
    thread_scope_block,
    thread_scope_thread
};

enum memory_order {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
};

inline memory_order failure_order_of(memory_order o) {
    if (o == memory_order_acq_rel) return memory_order_acquire;
    if (o == memory_order_release) return memory_order_relaxed;
    return o;
}

template <class T, thread_scope S = thread_scope_system>
class atomic_ref {
public:
    HG_GPUMC_INLINE explicit atomic_ref(T& r) : p_(&r) {}

    HG_GPUMC_INLINE T load(memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_load_n(p, o);
    }
    HG_GPUMC_INLINE void store(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        __atomic_store_n(p, v, o);
    }
    HG_GPUMC_INLINE T exchange(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_exchange_n(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_add(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_add(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_sub(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_sub(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_or(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_or(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_and(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_and(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_min(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_min(p, v, o);
    }
    HG_GPUMC_INLINE T fetch_max(T v, memory_order o = memory_order_seq_cst) const {
        T* p = p_;
        scope();
        return __atomic_fetch_max(p, v, o);
    }
    HG_GPUMC_INLINE bool compare_exchange_strong(T& e, T d, memory_order s,
                                                 memory_order f) const {
        T* p = p_;
        scope();
        return __atomic_compare_exchange_n(p, &e, d, false, s, f);
    }
    HG_GPUMC_INLINE bool compare_exchange_strong(T& e, T d,
                                                 memory_order o = memory_order_seq_cst) const {
        return compare_exchange_strong(e, d, o, failure_order_of(o));
    }
    HG_GPUMC_INLINE bool compare_exchange_weak(T& e, T d, memory_order s, memory_order f) const {
        T* p = p_;
        scope();
        return __atomic_compare_exchange_n(p, &e, d, true, s, f);
    }
    HG_GPUMC_INLINE bool compare_exchange_weak(T& e, T d,
                                               memory_order o = memory_order_seq_cst) const {
        return compare_exchange_weak(e, d, o, failure_order_of(o));
    }

private:
    HG_GPUMC_INLINE static void scope() {
        if (S == thread_scope_block) __VERIFIER_memory_scope_work_group();
        else __VERIFIER_memory_scope_device();
    }
    T* p_;
};

}  // namespace cuda
