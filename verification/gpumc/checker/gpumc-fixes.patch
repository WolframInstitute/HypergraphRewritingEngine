+	/* True when the bottom B bits of the two values are equal. A store keeps
+	 * its value zero-extended and an atomic add or sub keeps it sign-extended,
+	 * so a compare-exchange compares at its access width. */
+	bool eqBottom(const SVal &v, unsigned b) const {
+		if (b >= width)
+			return v.value == value;
+		const Value m = (Value(1) << b) - 1;
+		return (v.value & m) == (value & m);
+	}
