+template <class Loc>
+static void recordRaceAt(GenMCDriver::Result &result, const std::string &scopes,
+			 const Loc &a, const Loc &b)
+{
+	auto where = [](const Loc &l) {
+		std::string f = l.second;
+		Parser::stripSlashes(f);
+		return f + ":" + std::to_string(l.first);
+	};
+	auto ka = where(a), kb = where(b);
