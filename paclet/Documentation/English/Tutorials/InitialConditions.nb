          RowBox[{"0", ",", " ", "b"}], "}"}]}], ",", " ", 
        RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
      "0", ",", " ", "\"\<GlobalEdges\>\""}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", 
