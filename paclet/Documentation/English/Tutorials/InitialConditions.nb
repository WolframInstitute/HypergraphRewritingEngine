Cell["\<\
The engine numbers vertices from 0 in order of first appearance, and writes \
each edge as its id followed by its vertices:\
\>", "Text",
 CellID->1377816002,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"First", " ", "@", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "0", ",", 
    " ", "\"\<States\>\""}], "]"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->293863717,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Id\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"CanonicalId\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"ContentStateId\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Step\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Edges\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"IsInitial\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",
 CellID->1063680002,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]
}, Open  ]],

