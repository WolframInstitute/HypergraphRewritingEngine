      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Poisson\>\""}], ",", " ", 
        RowBox[{"\"\<Density\>\"", " ", "->", " ", "30"}], ",", " ", 
        RowBox[{"\"\<MinDistance\>\"", " ", "->", " ", "2."}], ",", " ", 
