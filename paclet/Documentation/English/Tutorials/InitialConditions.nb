     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "1", ",", 
   " ", "\"\<StatesGraph\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1653674069,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

