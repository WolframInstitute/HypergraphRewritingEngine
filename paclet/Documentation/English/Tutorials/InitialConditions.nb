Cell[TextData[{
 Cell[BoxData["\"\<GridHoles\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " cuts circular holes, each ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"x", ",", " ", "y", ",", " ", "radius"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 ", where the vertex in column ",
 StyleBox["i", "TI"],
 " and row ",
 StyleBox["j", "TI"],
 " is at (",
 StyleBox["i", "TI"],
 " - 1, ",
 StyleBox["j", "TI"],
 " - 1). A vertex inside a hole is removed, and so is an edge whose midpoint \
is inside one. Two holes in a 6 by 6 grid:"
}], "Text",
 CellID->1892712309,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

