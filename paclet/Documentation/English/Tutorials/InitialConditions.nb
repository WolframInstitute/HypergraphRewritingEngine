Cell["With speeds of light 0.5, 1 and 2:", "Text",
 CellID->1175763064,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
