Cell[TextData[{
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " (also ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b76025-96bb-3fff-214d-798f234f85c5"],
 ") places ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " points (500 by default) at random in a region of flat spacetime of extent ",
 Cell[BoxData["\"\<SprinklingTimeExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " (10) in time and ",
 Cell[BoxData["\"\<SprinklingSpatialExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " (10) in each of ",
 Cell[BoxData["\"\<SprinklingSpatialDim\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " (2) space dimensions. ",
 Cell[BoxData["\"\<SprinklingLightconeAngle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " (1) is the speed of light."
}], "Text",
 CellID->1570109414,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[TextData[{
 "Two points are linked when one is in the other's future light cone within a \
proper time of ",
 Cell[BoxData["\"\<SprinklingAlexandrovCutoff\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " (5). ",
 Cell[BoxData["\"\<SprinklingTransitivityReduction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " (",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ") removes each link implied by a chain of other links, and ",
 Cell[BoxData["\"\<SprinklingMaxEdgesPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " (50) caps the links from each point. The hypergraph has an edge from each \
point to each point it is linked to; a point with no links is not in it."
}], "Text",
 CellID->746824257,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["A sprinkling of 24 points, with time running down the page:", "Text",
 CellID->966663717,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

