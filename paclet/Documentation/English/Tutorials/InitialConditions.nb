}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"],
 " places ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"],
 " points at random in the same box, with no minimum distance. The automatic \
threshold is 1.5 times the square root of the box area divided by the number \
of points."
}], "Text",
 CellID->1020643561,ExpressionUUID->"333832e2-8bec-4128-62c7-abcc2d991072"],

