Cell["\<\
Two steps from the torus, with 32 edges and then 33 to split, reach 1 + 32 + \
32 \[Times] 33 = 1089 states:\
\>", "Text",
 CellID->1358080856,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "rule", ",", " ", "\"\<Torus\>\"", ",", " ", "2", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->1567798648,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

Cell[BoxData["1089"], "Output",
 CellLabel->"Out[27]= ",
 CellID->1698987884,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"]
}, Open  ]],

Cell["Sprinklings of Minkowski space", "Section",
 CellID->1594238871,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[TextData[{
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " (also ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 ") places ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " points (500 by default) at random in a region of flat spacetime of extent ",
 Cell[BoxData["\"\<SprinklingTimeExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 " (10) in time and ",
 Cell[BoxData["\"\<SprinklingSpatialExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " (10) in each of ",
 Cell[BoxData["\"\<SprinklingSpatialDim\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 " (2) space dimensions. ",
 Cell[BoxData["\"\<SprinklingLightconeAngle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 " (1) is the speed of light."
}], "Text",
 CellID->2002505366,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[TextData[{
 "Two points are linked when one is in the other's future light cone within a \
proper time of ",
 Cell[BoxData["\"\<SprinklingAlexandrovCutoff\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " (5). ",
 Cell[BoxData["\"\<SprinklingTransitivityReduction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 " (",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 ") removes each link implied by a chain of other links, and ",
 Cell[BoxData["\"\<SprinklingMaxEdgesPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 " (50) caps the links from each point. The hypergraph has an edge from each \
point to each point it is linked to; a point with no links is not in it."
}], "Text",
 CellID->2121396920,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell["A sprinkling of 24 points, with time running down the page:", "Text",
 CellID->993357154,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"initialStateGraph", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "\"\<Sprinkling\>\"", ",", " ", "0", ",", 
     " ", "\"\<GlobalEdges\>\"", ",", " ", 
     RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "24"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
   RowBox[{"GraphLayout", " ", "->", " ", "\"\<LayeredDigraphEmbedding\>\""}],
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "420"}]}], "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1256055991,ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

