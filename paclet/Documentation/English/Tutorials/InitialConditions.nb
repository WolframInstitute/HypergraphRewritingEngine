Cell[TextData[{
 "The association keys are the option names without ",
 Cell[BoxData["Sprinkling"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3343f580-98d5-e31c-6170-ecea1961ce66"],
 ": ",
 Cell[BoxData["\"\<Density\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 ", ",
 Cell[BoxData["\"\<TimeExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 ", ",
 Cell[BoxData["\"\<SpatialExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 ", ",
 Cell[BoxData["\"\<SpatialDim\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 ", ",
 Cell[BoxData["\"\<LightconeAngle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 ", ",
 Cell[BoxData["\"\<AlexandrovCutoff\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 ", ",
 Cell[BoxData["\"\<TransitivityReduction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 ", ",
 Cell[BoxData["\"\<MaxEdgesPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 ", and ",
 Cell[BoxData["\"\<Seed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 ":"
}], "Text",
 CellID->1074416020,ExpressionUUID->"3fdc991b-fead-14b0-65e3-1144fb587e9a"],

