Cell["The random seed", "Section",
 CellID->1063989564,ExpressionUUID->"77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " is ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " by default, which draws a new seed on each evaluation. Any other value \
fixes what a family draws: the points of a point cloud, and the edge \
directions of a grid or surface."
}], "Text",
 CellID->1987333543,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell["\<\
The same seed gives the same twenty uniform points each time:\
\>", "Text",
 CellID->616753397,ExpressionUUID->"4140e475-1e41-1f16-777f-fe3f9bf4627c"],

