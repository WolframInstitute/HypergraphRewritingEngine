Notebook[{

Cell[CellGroupData[{
Cell["Generated Initial Conditions", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "The second argument of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " is the initial state. It can be a list of hyperedges, a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 ", a list of several states, or the name of a generated family: a grid, a \
surface (cylinder, torus, sphere, Klein bottle, M\[ODoubleDot]bius strip), a \
sprinkling of Minkowski space, a point cloud around two Brill-Lindquist black \
holes, or a Poisson-disk or uniform point cloud. ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 " fixes what a family draws at random."
}], "Text",
 CellID->329621944,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["An explicit initial state", "Section",
 CellID->515379898,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
Every example in this tutorial uses a rule that splits one edge into two:\
\>", "Text",
 CellID->604760901,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rule", " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->214672358,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->985978867,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"]
}, Open  ]],

Cell["\<\
An explicit initial state is a list of hyperedges. One step from a path of \
two edges reaches two states, one for each edge split:\
\>", "Text",
 CellID->448336599,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
