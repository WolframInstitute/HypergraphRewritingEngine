      RowBox[{
       RowBox[{"-", "8."}], ",", " ", "8."}], "}"}]}], ",", " ", 
    RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "4."}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], 
  "]"}]], "Input",
