   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]], "Input",
