Cell["Poisson-disk and uniform point clouds", "Section",
 CellID->339747688,ExpressionUUID->"6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],

Cell[TextData[{
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 " places points at random in the box from 0 to 10 in each direction, and \
keeps a point only if it is at least ",
 Cell[BoxData["\"\<PoissonMinDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 " (1) from every point already kept. It makes up to 100 attempts for each of \
the ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " points requested, so with a large minimum distance it keeps fewer. Two \
points closer than ",
 Cell[BoxData["\"\<EdgeThreshold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],
 " are joined; ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " is twice the minimum distance."
}], "Text",
 CellID->1569376968,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell["Thirty points requested with a minimum distance of 2:", "Text",
