Cell["The holes remove 8 of the 60 edges:", "Text",
 CellID->525088789,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "\"\<Grid\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "6"}], ",", " ", 
      RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "6"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "\"\<Grid\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "6"}], ",", " ", 
      RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "6"}], ",", " ", 
      RowBox[{"\"\<GridHoles\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "0.8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4", ",", " ", "0.8"}], "}"}]}], "}"}]}], ",",
       " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->1509916714,ExpressionUUID->"1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"60", ",", "52"}], "}"}]], "Output",
 CellLabel->"Out[18]= ",
 CellID->132257103,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"]
}, Open  ]],

Cell[TextData[{
 "The association keys are ",
 Cell[BoxData["\"\<Width\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],
 ", ",
 Cell[BoxData["\"\<Height\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5077c06e-c394-b43c-000c-da4bf6261f06"],
 ", ",
 Cell[BoxData["\"\<Holes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 " and ",
 Cell[BoxData["\"\<Seed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 ". A 4 by 3 grid:"
}], "Text",
 CellID->1802489801,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rule", ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
     RowBox[{"\"\<Width\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"\"\<Height\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", "0", ",",
    " ", "\"\<GlobalEdges\>\""}], "]"}]], "Input",
 CellLabel->"In[19]:= ",
 CellID->800886605,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
