     " ", "\"\<NumStates\>\"", ",", " ", 
     RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}], ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[56]:= ",
