  "741b091d-feb2-1a39-1c38-a146fb476903"],
 " become the hyperedges, in the order ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EdgeList"]], "paclet:ref/EdgeList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
