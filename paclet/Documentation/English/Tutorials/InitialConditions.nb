Cell["The graph and that list give the same evolution:", "Text",
 CellID->2122865143,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
