Cell[TextData[{
 "The association keys are the option names without ",
 Cell[BoxData["Sprinkling"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 ": ",
 Cell[BoxData["\"\<Density\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 ", ",
 Cell[BoxData["\"\<TimeExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 ", ",
 Cell[BoxData["\"\<SpatialExtent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 ", ",
 Cell[BoxData["\"\<SpatialDim\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 ", ",
 Cell[BoxData["\"\<LightconeAngle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399d1ff3-4632-be92-6fa2-96bd73c404f8"],
 ", ",
 Cell[BoxData["\"\<AlexandrovCutoff\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 ", ",
 Cell[BoxData["\"\<TransitivityReduction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", ",
 Cell[BoxData["\"\<MaxEdgesPerVertex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ", and ",
 Cell[BoxData["\"\<Seed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ":"
}], "Text",
 CellID->315698450,ExpressionUUID->"74397683-04f4-1d4d-1dc7-6fedac816797"],

