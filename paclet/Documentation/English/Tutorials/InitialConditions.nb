Cell["Three dimensions", "Subsection",
 CellID->1307080411,ExpressionUUID->"40ea559d-da93-7842-70ea-4cc6df264aa8"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<BrillLindquistDimension\>\"", " ", "->", " ", "3"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 " (key ",
 Cell[BoxData["\"\<Dimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 "), the points fill a box whose z range is ",
 Cell[BoxData["\"\<BrillLindquistBoxZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " (key ",
 Cell[BoxData["\"\<BoxZ\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 ", -15 to 15). The density of points is then \[Psi]\:2076, the volume \
element of \[Psi]\:2074 \[Delta] in three dimensions. With ",
 Cell[BoxData[
  RowBox[{"\"\<BrillLindquistPeriodic\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 " (key ",
 Cell[BoxData["\"\<Periodic\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 "), distances are measured to the nearest periodic image of a point, so two \
points near opposite faces of the box can be joined."
}], "Text",
 CellID->1960030258,ExpressionUUID->"69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],

Cell["\<\
J. Gorard, arXiv:2102.09363, places two black holes of mass 0.5 at separation \
1 in the centre of a periodic box of side 20. 200 points with a cut-off of \
4.3, which is 1.25 times the mean spacing (8000/200)^(1/3) \[TildeTilde] \
3.42, form one connected piece:\
\>", "Text",
 CellID->535682707,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gorard", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<BrillLindquist\>\""}], ",", 
     " ", 
     RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<Periodic\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<Density\>\"", " ", "->", " ", "200"}], ",", " ", 
     RowBox[{"\"\<Mass1\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"\"\<Mass2\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"\"\<Separation\>\"", " ", "->", " ", "1."}], ",", " ", 
     RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<BoxZ\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "4.3"}], ",", " ", 
     RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"DirectedEdge", " ", "@@@", " ", 
       RowBox[{"Rest", " ", "/@", " ", 
        RowBox[{"HGEvolve", "[", 
         RowBox[{
         "rule", ",", " ", "gorard", ",", " ", "0", ",", 
          " ", "\"\<GlobalEdges\>\""}], "]"}]}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
     RowBox[{"EdgeCount", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"WeaklyConnectedComponents", "[", "g", "]"}], "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[48]:= ",
 CellID->66187005,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"200", ",", "788", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[48]= ",
 CellID->571397984,ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"]
}, Open  ]],

Cell["The same points without periodic distances have fewer edges:", "Text",
 CellID->1612953718,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"Append", "[", 
     RowBox[{"gorard", ",", " ", 
      RowBox[{"\"\<Periodic\>\"", " ", "->", " ", "False"}]}], "]"}], ",", 
    " ", "0", ",", " ", "\"\<GlobalEdges\>\""}], "]"}], "]"}]], "Input",
 CellLabel->"In[49]:= ",
 CellID->668344547,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[BoxData["638"], "Output",
 CellLabel->"Out[49]= ",
 CellID->1925254897,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"]
}, Open  ]],

Cell["The points", "Subsection",
 CellID->1163030741,ExpressionUUID->"635fdfdb-2856-deda-1164-d68549e0a420"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<InitialCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 " property returns the generated initial condition with its points. ",
 Cell[BoxData["\"\<VertexCoordinates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 " gives each vertex's point, keyed by the vertex as the states name it, so \
the points can be drawn, measured or triangulated beside the evolution. The \
200 points of the box above are three-dimensional, and none is inside a \
horizon:"
}], "Text",
 CellID->1753119213,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ic", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "gorard", ",", " ", "0", ",", 
     " ", "\"\<InitialCondition\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pts", " ", "=", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"ic", "[", "\"\<VertexCoordinates\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "[", "pts", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"Min", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{"#", " ", "-", " ", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", " ", "0.", ",", " ", "0."}], "}"}]}], "]"}], 
       " ", "&"}], " ", "/@", " ", "pts"}], "]"}], " ", ">", " ", "0.25"}], ",",
    " ", 
   RowBox[{"Length", "[", 
    RowBox[{"ic", "[", "\"\<Edges\>\"", "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[50]:= ",
