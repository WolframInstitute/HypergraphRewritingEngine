     RowBox[{
     "rule", ",", " ", "\"\<Uniform\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "20"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", "3", "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[54]:= ",
 CellID->1018218973,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

