 CellID->1339473503,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"]
}, Open  ]],

Cell[TextData[{
 "Two keys have no option. The key ",
 Cell[BoxData["\"\<Diagonals\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " with value ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " adds both diagonals of each cell, so the 4 by 3 grid has 12 more edges:"
}], "Text",
 CellID->1651187567,ExpressionUUID->"30baa1c8-66ad-75e0-6059-389213585fca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
      RowBox[{"\"\<Width\>\"", " ", "->", " ", "4"}], ",", " ", 
      RowBox[{"\"\<Height\>\"", " ", "->", " ", "3"}], ",", " ", 
      RowBox[{"\"\<Diagonals\>\"", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", "0", 
    ",", " ", "\"\<GlobalEdges\>\""}], "]"}], "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->1235362500,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[BoxData["29"], "Output",
 CellLabel->"Out[20]= ",
 CellID->41412554,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"]
}, Open  ]],

Cell[TextData[{
 "The key ",
 Cell[BoxData["\"\<RandomizeDirections\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7421cf44-a1ac-4319-1dde-e721d0592e63"],
 " with value ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " keeps every edge in the generator's own direction, so the seed has no \
effect on the grid:"
}], "Text",
 CellID->2120243592,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SameQ", " ", "@@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGEvolve", "[", 
     RowBox[{"rule", ",", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
        RowBox[{"\"\<Width\>\"", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"\"\<Height\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"\"\<RandomizeDirections\>\"", " ", "->", " ", "False"}], ",",
         " ", 
        RowBox[{"\"\<Seed\>\"", " ", "->", " ", "s"}]}], "|>"}], ",", " ", 
      "0", ",", " ", "\"\<GlobalEdges\>\""}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "3"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1471736196,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[21]= ",
 CellID->98487553,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<RandomizeDirections\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " applies to the surfaces and to the ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 " and ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " clouds as well."
}], "Text",
 CellID->1820947576,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell["\<\
A lattice has at most 2^31 vertices. A larger grid, cylinder, torus, sphere, \
Klein bottle or M\[ODoubleDot]bius strip is refused before it is generated:\
\>", "Text",
 CellID->670734585,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rule", ",", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
     RowBox[{"\"\<Width\>\"", " ", "->", " ", "50000"}], ",", " ", 
     RowBox[{"\"\<Height\>\"", " ", "->", " ", "50000"}]}], "|>"}], ",", " ", 
   "0", ",", " ", "\"\<NumStates\>\""}], "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->19023026,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGEvolve", "::", "enginemsg"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Engine", " ", "binary", " ", 
   RowBox[{"reported", ":", " "}]}], 
  RowBox[{
   RowBox[{
   "the", " ", "\<\"Grid\"\>", " ", "initial", " ", "condition", " ", "has", " ",
     "2500000000", " ", "vertices"}], ";", " ", 
   RowBox[{"the", " ", "limit", " ", "is", " ", "2147483648"}]}]}]], "Message",\
 "MSG",
 CellID->623243872,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[22]= ",
 CellID->264295139,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"]
}, Open  ]],

Cell["Surfaces", "Section",
 CellID->393464600,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell["Five families join the sides of a grid:", "Text",
 CellID->1484396876,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[TextData[{
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " joins both pairs of opposite sides of a square grid with ",
 Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " vertices on a side."
}], "Item",
 CellID->1149283354,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[TextData[{
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 " joins two sides of a grid of ",
 Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 " columns and ",
 Cell[BoxData["\"\<Height\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " rows."
}], "Item",
 CellID->1092188694,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[TextData[{
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " does the same as ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " with one side reversed."
}], "Item",
 CellID->559599970,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[TextData[{
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " joins two sides of a grid of ",
 Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " columns and ",
 Cell[BoxData["\"\<Width\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " rows, with one side reversed."
}], "Item",
 CellID->1710123944,ExpressionUUID->"0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],

Cell[TextData[{
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " has ",
 Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " rings of latitude, with fewer vertices on the rings near the poles, and \
joins each vertex to the next on its ring and to the nearest vertex of the \
next ring."
}], "Item",
 CellID->934597701,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[TextData[{
 "With options, the resolution is ",
 Cell[BoxData["\"\<GridWidth\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 " and the height is ",
 Cell[BoxData["\"\<GridHeight\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2845529c-454d-b13b-587b-4bc66cf90001"],
 "; the M\[ODoubleDot]bius width is 5 unless the association gives ",
 Cell[BoxData["\"\<Width\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 ". Edge directions are drawn from ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 ". The association keys ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6405505f-4b92-3bd6-0c3b-4a196e24893c"],
 " (1 for the cylinder, sphere and Klein bottle, 2 for the M\[ODoubleDot]bius \
strip) and ",
 Cell[BoxData["\"\<MajorRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6878c7f8-419e-9db5-1807-dea27028e79f"],
 " and ",
 Cell[BoxData["\"\<MinorRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " (3 and 1 for the torus) set the size of the surface in the coordinates of \
the ",
 Cell[BoxData["\"\<InitialCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " property. They leave the edges unchanged."
}], "Text",
 CellID->284780108,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell["A torus of resolution 4 has 32 edges:", "Text",
 CellID->643798763,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "\"\<Torus\>\"", ",", " ", "0", ",", 
    " ", "\"\<GlobalEdges\>\"", ",", " ", 
    RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->2058425823,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[BoxData["32"], "Output",
 CellLabel->"Out[23]= ",
 CellID->1689509600,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"]
}, Open  ]],

