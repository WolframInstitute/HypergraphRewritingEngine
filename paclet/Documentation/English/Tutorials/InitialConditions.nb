Cell["A M\[ODoubleDot]bius strip of 6 columns and 3 rows:", "Text",
 CellID->412518898,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"initialStateGraph", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{"rule", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Mobius\>\""}], ",", " ", 
       RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "6"}], ",", " ", 
       RowBox[{"\"\<Width\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", "0",
      ",", " ", "\"\<GlobalEdges\>\""}], "]"}], ",", " ", 
   RowBox[{
   "GraphLayout", " ", "->", " ", "\"\<SpringElectricalEmbedding\>\""}]}], 
  "]"}]], "Input",
