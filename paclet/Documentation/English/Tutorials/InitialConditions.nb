     RowBox[{
     "rule", ",", " ", "\"\<Sprinkling\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "24"}], ",", " ", 
      RowBox[{"\"\<SprinklingLightconeAngle\>\"", " ", "->", " ", "c"}], ",", 
      " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", 
     RowBox[{"{", 
