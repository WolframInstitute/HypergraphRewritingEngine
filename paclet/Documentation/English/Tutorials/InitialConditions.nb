Cell["Brill-Lindquist point clouds", "Section",
 CellID->865519937,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"],

Cell[TextData[{
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 " places ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 " points in the plane around two black holes of masses ",
 Cell[BoxData["\"\<BrillLindquistMass1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0371ff35-cd30-cda2-310e-f77ee4ca9788"],
 " and ",
 Cell[BoxData["\"\<BrillLindquistMass2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " (3 each), ",
 Cell[BoxData["\"\<BrillLindquistSeparation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " (10) apart on the x axis, in the box ",
 Cell[BoxData["\"\<BrillLindquistBoxX\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " by ",
 Cell[BoxData["\"\<BrillLindquistBoxY\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " (-15 to 15 each). The density of points follows the volume element of the \
Brill-Lindquist metric, so points are denser near the horizons, and no point \
is inside a horizon, whose radius is half the mass. Two points closer than ",
 Cell[BoxData["\"\<EdgeThreshold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " (2 when ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 ") are joined unless the midpoint between them is inside a horizon."
}], "Text",
 CellID->845186625,ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"],

Cell["\<\
Thirty points in the default box have few pairs within that distance:\
\>", "Text",
