Cell["Poisson-disk and uniform point clouds", "Section",
 CellID->387004599,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell[TextData[{
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7281c19b-2602-dcd4-22be-d8c553b4a63e"],
 " places points at random in the box from 0 to 10 in each direction, and \
keeps a point only if it is at least ",
 Cell[BoxData["\"\<PoissonMinDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " (1) from every point already kept. It makes up to 100 attempts for each of \
the ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " points requested, so with a large minimum distance it keeps fewer. Two \
points closer than ",
 Cell[BoxData["\"\<EdgeThreshold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " are joined; ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 " is twice the minimum distance."
}], "Text",
 CellID->1976158344,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

