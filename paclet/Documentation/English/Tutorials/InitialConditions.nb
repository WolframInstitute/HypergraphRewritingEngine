Cell[TextData[{
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " and ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " give the same result:"
}], "Text",
 CellID->1607396713,ExpressionUUID->"7085d256-6adc-aa08-20ba-d4100f6ef952"],

