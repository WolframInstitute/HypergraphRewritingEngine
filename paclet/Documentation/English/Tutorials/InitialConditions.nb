Cell["Brill-Lindquist point clouds", "Section",
 CellID->1242319925,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[TextData[{
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " places ",
 Cell[BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 " points in the plane around two black holes of masses ",
 Cell[BoxData["\"\<BrillLindquistMass1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 " and ",
 Cell[BoxData["\"\<BrillLindquistMass2\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 " (3 each), ",
 Cell[BoxData["\"\<BrillLindquistSeparation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " (10) apart on the x axis, in the box ",
 Cell[BoxData["\"\<BrillLindquistBoxX\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " by ",
 Cell[BoxData["\"\<BrillLindquistBoxY\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 " (-15 to 15 each). The density of points follows the volume element of the \
Brill-Lindquist metric \[Psi]\:2074 \[Delta], which is \[Psi]\:2074 in the \
plane, with \[Psi] = 1 + m1/(2 r1) + m2/(2 r2) and r1, r2 the distances to \
the two black holes, so points are denser near the horizons, and no point is \
inside a horizon, whose radius is half the mass. Two points closer than ",
 Cell[BoxData["\"\<EdgeThreshold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " (2 when ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 ") are joined unless the midpoint between them is inside a horizon."
}], "Text",
 CellID->1600082692,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell["\<\
Thirty points in the default box have few pairs within that distance:\
\>", "Text",
 CellID->1091979148,ExpressionUUID->"499f95c1-a958-6c18-7fa4-0caac8ed3762"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "\"\<BrillLindquist\>\"", ",", " ", "0", ",", 
    " ", "\"\<GlobalEdges\>\"", ",", " ", 
    RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "30"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[40]:= ",
 CellID->1148512439,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[BoxData["12"], "Output",
 CellLabel->"Out[40]= ",
 CellID->107455031,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"]
}, Open  ]],

Cell["\<\
A smaller box and a threshold of 4 join the points into one piece:\
\>", "Text",
 CellID->234435634,ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"initialStateGraph", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "\"\<BrillLindquist\>\"", ",", " ", "0", ",", 
    " ", "\"\<GlobalEdges\>\"", ",", " ", 
    RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "30"}], ",", " ", 
    RowBox[{"\"\<BrillLindquistBoxX\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8."}], ",", " ", "8."}], "}"}]}], ",", " ", 
    RowBox[{"\"\<BrillLindquistBoxY\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8."}], ",", " ", "8."}], "}"}]}], ",", " ", 
    RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "4."}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[41]:= ",
 CellID->404102428,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

