    RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "30"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[37]:= ",
