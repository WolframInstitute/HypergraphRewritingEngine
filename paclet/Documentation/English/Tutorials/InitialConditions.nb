Cell[TextData[{
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 " and ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 " give the same result:"
}], "Text",
 CellID->680111415,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SameQ", " ", "@@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "ic", ",", " ", "0", ",", " ", "\"\<GlobalEdges\>\"", ",",
       " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "24"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"ic", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Sprinkling\>\"", ",", " ", "\"\<Minkowski\>\""}], "}"}]}],
      "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[29]:= ",
 CellID->1051605173,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[29]= ",
 CellID->1152687680,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"]
}, Open  ]],

