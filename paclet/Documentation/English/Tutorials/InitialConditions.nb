  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 ", ",
 Cell[BoxData["\"\<BoxX\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 ", ",
 Cell[BoxData["\"\<BoxY\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 ", ",
 Cell[BoxData["\"\<EdgeThreshold\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 " and ",
 Cell[BoxData["\"\<Seed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e73fafe-05d0-7203-6600-f3b8ac654169"],
 ". Twenty points in a box of side 5:"
}], "Text",
 CellID->1320676321,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rule", ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Uniform\>\""}], ",", " ", 
      RowBox[{"\"\<Density\>\"", " ", "->", " ", "20"}], ",", " ", 
      RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "5"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "2."}], ",", " ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", "0", 
    ",", " ", "\"\<GlobalEdges\>\""}], "]"}], "]"}]], "Input",
 CellLabel->"In[58]:= ",
 CellID->242695750,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[BoxData["68"], "Output",
 CellLabel->"Out[58]= ",
 CellID->538928732,ExpressionUUID->"3d9aa029-60a8-273a-6bb9-3a7311428a00"]
}, Open  ]],

Cell["\<\
Two steps from the twenty points, with isomorphic states identified:\
\>", "Text",
 CellID->1655262560,ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "rule", ",", " ", "\"\<Uniform\>\"", ",", " ", "2", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "20"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
  "]"}]], "Input",
 CellLabel->"In[59]:= ",
 CellID->985599703,ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"],

Cell[BoxData["1274"], "Output",
 CellLabel->"Out[59]= ",
 CellID->582636370,ExpressionUUID->"4670f053-f537-0b3f-6e0f-ea1cfcc25605"]
}, Open  ]],

Cell["The random seed", "Section",
 CellID->1241281984,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell[TextData[{
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],
 " is ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70d705b8-410a-1477-20ec-9ce270bf7f5d"],
 " by default, which draws a new seed on each evaluation. Any other value \
fixes what a family draws: the points of a point cloud, and the edge \
directions of a grid or surface."
}], "Text",
 CellID->2083544408,ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"],

Cell["\<\
The same seed gives the same twenty uniform points each time:\
\>", "Text",
 CellID->960626294,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SameQ", " ", "@@", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "\"\<Uniform\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "20"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", "3", "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[60]:= ",
 CellID->1130672623,ExpressionUUID->"10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[60]= ",
 CellID->1565019380,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"]
}, Open  ]],

Cell["Different seeds give different point clouds:", "Text",
 CellID->180386896,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "\"\<Uniform\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "20"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}], "]"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[61]:= ",
 CellID->1099644340,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"50", ",", "58", ",", "60"}], "}"}]], "Output",
 CellLabel->"Out[61]= ",
 CellID->1906878780,ExpressionUUID->"1318f44b-7a0d-b86f-4127-ee157fb90ab5"]
}, Open  ]],

Cell["\<\
For a grid, the size fixes the number of edges and the seed fixes their \
directions. The directions change the number of states up to isomorphism:\
\>", "Text",
 CellID->1256596424,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "\"\<Grid\>\"", ",", " ", "2", ",", 
     " ", "\"\<NumStates\>\"", ",", " ", 
     RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}], ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[62]:= ",
 CellID->1571891782,ExpressionUUID->"3f067a83-888f-4db3-653e-73ed293a1799"],

Cell[BoxData[
 RowBox[{"{", 
