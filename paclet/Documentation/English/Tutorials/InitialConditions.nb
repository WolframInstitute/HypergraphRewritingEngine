       " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "24"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"ic", ",", " ", 
