         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "5", ",", 
       " ", "\"\<Debug\>\"", ",", " ", 
       RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.25"}], ",", " ", 
       RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}], ",", " ", 
       RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "device"}]}], 
      "]"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"device", ",", " ", 
