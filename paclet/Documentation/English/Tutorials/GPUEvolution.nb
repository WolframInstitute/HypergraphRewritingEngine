Cell[TextData[{
 "The caps by arrival order, ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " and ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 ", keep states that depend on the thread schedule on either device, so two \
capped runs can differ."
}], "Text",
 CellID->1930159659,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell["A session on the GPU", "Section",
 CellID->1113655915,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 " takes ",
 Cell[BoxData["\"\<TargetDevice\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 ", and the session stays on that device until it is closed:"
}], "Text",
 CellID->1606118752,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\"", ",", " ", 
     RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"session", ",", " ", "2"}], "]"}]}], "Input",
 CellLabel->"In[11]:= ",
