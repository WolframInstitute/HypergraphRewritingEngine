Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 ", ",
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ", ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " and ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " decide from each transition's isomorphism-invariant identity and ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 ", so the same seed keeps the same transitions on both devices."
}], "Text",
 CellID->632614636,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell["\<\
A rule that replaces two adjacent edges by four, from two loops, keeping each \
transition with probability 0.25:\
\>", "Text",
 CellID->1689610856,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"branching", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Prepend", "[", "device", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
