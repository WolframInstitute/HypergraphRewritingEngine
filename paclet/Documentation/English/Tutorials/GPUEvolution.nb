 CellID->920878945,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[12]= ",
 CellID->653644383,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"]
}, Open  ]],

Cell["One step from the last frontier state only:", "Text",
 CellID->443736588,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"session", ",", " ", "1", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Last", "[", "frontier", "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->112567220,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[13]= ",
 CellID->1126185936,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"]
}, Open  ]],

Cell[TextData[{
 "A step without ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " expands the state left out as well, and the session holds the evolution of \
four steps:"
}], "Text",
 CellID->1742646261,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->285826620,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"34", ",", "34"}], "}"}]], "Output",
 CellLabel->"Out[14]= ",
 CellID->993903248,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"HGSessionClose", "[", "session", "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->1939141443,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell["Capacity", "Section",
 CellID->5047578,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"],

Cell[TextData[{
 "The GPU engine sizes its memory pools before a run, from the number of \
steps and the initial state. A pool that fills is enlarged and the run \
repeated. When a pool cannot be enlarged enough, the run ends early, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "overflow"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 ", and the result is partial. Fewer steps, ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 ", or the CPU engine avoid it."
}], "Text",
 CellID->15008895,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell["When no GPU engine is available", "Section",
 CellID->1892712309,ExpressionUUID->"46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],

Cell[TextData[{
 "Where the paclet has no GPU engine for the platform, ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "gpudev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " and the evolution runs on the CPU."
}], "Text",
 CellID->787969749,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[TextData[{
 "A value other than ",
 Cell[BoxData["\"\<CPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " or ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 " issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "baddev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 ", and the evolution runs on the CPU:"
}], "Text",
 CellID->525088789,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<TPU\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1509916714,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGEvolve", "::", "baddev"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"TargetDevice", " ", "->", " "}], "TPU", 
  RowBox[{" ", 
   RowBox[{
    RowBox[{"is", " ", "not", " ", "valid"}], ";", " ", 
    RowBox[{"use", " ", "\<\"CPU\"\>", " ", "or", " ", 
     RowBox[{"\<\"GPU\"\>", ".", " ", "Using"}], " ", 
     RowBox[{"CPU", "."}]}]}]}]}]], "Message", "MSG",
 CellID->132257103,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

