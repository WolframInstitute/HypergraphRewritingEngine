Cell["\<\
The same graph from the GPU. State ids are assigned separately in each run, \
so the two graphs are compared by their sizes and out-degrees:\
\>", "Text",
 CellID->299517738,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"statesGPU", " ", "=", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "physics", ",", " ", "physicsInit", ",", " ", "3", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", " ", 
    RowBox[{"AspectRatio", " ", "->", " ", 
     RowBox[{"1", "/", "2"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->1064655499,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

