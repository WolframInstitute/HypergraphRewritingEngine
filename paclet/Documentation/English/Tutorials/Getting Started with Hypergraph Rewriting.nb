Cell["Structured initial conditions", "Section",ExpressionUUID->"1d24ee39-4128-1649-9b12-a27765b143eb"],

Cell[TextData[{
 "Instead of an explicit edge list, name a structured initial condition and \
shape it with ",
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b41f2d7-60ce-bc40-98bf-56cf3cf28b76"],
 "'s options:"
}], "Text",ExpressionUUID->"eeba57d6-0707-5843-a31a-6f6768aa1557"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", 
   " ", "\"\<Grid\>\"", ",", " ", "2", ",", " ", "\"\<NumStates\>\"", ",", 
   "\n", "         ", 
   RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "4"}]}], "]"}]], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"01109bf1-69db-f749-a6af-31209dc49e7d"],

Cell[BoxData["565"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"0c9d855f-662e-9e48-97a2-2bc0dce5292e"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<InitialCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "795c25c7-9f6e-ff48-a8db-90f8f7ba8877"],
 " selects the family (",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "420685b6-4e0b-8a42-8d74-ce5e65a69800"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8a5d252-33e8-d140-bdaa-d64ae81ffbef"],
 ", ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c72acd3-f315-f548-ba1d-b3cc15541fd2"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "844ab90c-5eb1-3a4d-b1ce-915166357130"],
 ", ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00a0b3ff-704a-d342-a2eb-fa44f5a2f45b"],
 ") and ",
 Cell[BoxData["\"\<Topology\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dedbd51f-cbdb-3942-b5c6-74e77d6dc5cd"],
 " the surface (",
 Cell[BoxData["\"\<Flat\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d074153-c3d7-f742-957b-43fe1c8ecf49"],
 ", ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e595a406-cd46-7f4d-acb8-b58f8160dabe"],
 ", ",
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd2558d3-088a-6440-8ebc-bdd72a319963"],
 ", ",
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cabf9746-5ff2-824a-bbf3-1a669cd220d7"],
 ", ",
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5496491-0b7f-1440-a565-aa0fe4851deb"],
 ", ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a35d658d-01a5-9043-964d-3776efb12882"],
 ")."
}], "Text",ExpressionUUID->"a511684a-44c9-f542-970b-0f3073cef3f3"],

Cell["Running on the GPU", "Section",ExpressionUUID->"51b0bc16-cf57-8846-ba97-af3fb0a66168"],

Cell[TextData[{
 "Where a GPU build is bundled, evolve on the GPU with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b95c561b-f38f-aa45-aa00-c359cfba5deb"],
 " (it falls back to the CPU with a message if no GPU binary is present):"
}], "Text",ExpressionUUID->"e1b19347-c5a2-e142-94a6-552c4ec55ad7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "5", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"562ae667-2187-9944-af5c-a3d3aa054192"],

