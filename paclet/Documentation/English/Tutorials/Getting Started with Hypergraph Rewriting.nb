Notebook[{

Cell[CellGroupData[{
Cell["Getting Started with Hypergraph Rewriting", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
This tutorial walks through the core workflow: define a rule, evolve a \
hypergraph in all possible ways, and inspect the resulting states, causal, \
and branchial structure.\
\>", "Text",ExpressionUUID->"d4e29187-4c64-6d4e-80ea-ed1c2d66c915"],

Cell["A first evolution", "Section",ExpressionUUID->"28e2d4b4-b94c-624c-86a6-54c18d0cb447"],

Cell[TextData[{
 "A rewrite rule is written ",
 Cell[BoxData[
  RowBox[{"lhs", " ", "->", " ", "rhs"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2007628c-64ab-f148-80ac-52828165ba19"],
 ". Each side is a list of hyperedges, and each hyperedge is a list of \
vertices. This rule matches two edges that share a vertex and adds the edge \
closing the triangle between their other two endpoints:"
}], "Text",ExpressionUUID->"4e4eed4b-3afa-3d44-bf78-4cfde4ed4fae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "3"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4e4494b2-1499-8243-890e-dafcd0702e54"],

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], "}"}], ",", "3"}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1847ff38-4065-504b-b920-3a30336fbdbc"]
}, Open  ]],

Cell[TextData[{
 "The second argument is the initial state (a list of hyperedges); the third \
is the number of steps. By default ",
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8750ded-c669-e04a-bde3-e12b1e16465f"],
 " returns the combined evolution/causal/branchial graph."
}], "Text",ExpressionUUID->"36976949-cdcb-6347-a802-2a13df25e062"],

Cell["Choosing what to return", "Section",ExpressionUUID->"c3fb39e8-1703-0248-8d36-dc85c1684263"],

Cell["\<\
Pass a property string as the fourth argument to select the output:\
\>", "Text",ExpressionUUID->"c03edacc-d0b7-0147-94f8-092dd1cb25a4"],

Cell[CellGroupData[{

