Cell["\<\
Since the initial state is always expanded, no run at two steps has fewer \
than the initial state and its two successors:\
\>", "Text",
 CellID->1175763064,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Min", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "init", ",", " ", "2", ",", " ", "\"\<NumStates\>\"", ",",
       " ", 
      RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "0.5"}], ",", 
      " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "1", ",", " ", "20"}], "}"}]}], "]"}], 
  "]"}]], "Input",
