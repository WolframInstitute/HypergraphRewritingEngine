   RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[14]:= ",
