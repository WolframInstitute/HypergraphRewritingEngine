Cell["States per step", "Subsection",
 CellID->432388834,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " keeps the three lowest-ranked successor states of each step, together with \
any that tie with the third, so the choice does not depend on the order the \
work is done in. Step 1 has two states, so the cap applies from step 2:"
}], "Text",
 CellID->443736588,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

