 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "6", ",", "13"}], 
  "}"}]], "Output",
 CellLabel->"Out[5]= ",
 CellID->892924660,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " merges states but still applies every transition. The options in this \
tutorial skip transitions or states."
}], "Text",
 CellID->436346740,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

