Cell["Reproducible selections", "Section",
 CellID->525088789,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[TextData[{
 "These options decide each transition or state from its \
isomorphism-invariant identity and ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ". The same seed keeps the same states at any thread count, on either \
device, and on every run."
}], "Text",
 CellID->357930410,ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],

Cell["Transitions per state and rule", "Subsection",
 CellID->1802489801,ExpressionUUID->"11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " keeps ",
 StyleBox["k", "TI"],
 " transitions of each state for each rule, together with any that tie with \
the ",
 StyleBox["k", "TI"],
 "-th. They are chosen after all matches of the state are found, by the \
transitions' identities and the seed. Under this option every state is \
matched in full, since a match passed down from the parent state would arrive \
too late to be counted."
}], "Text",
 CellID->115301326,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell["Two transitions per state and rule, at three steps:", "Text",
 CellID->1651187567,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

