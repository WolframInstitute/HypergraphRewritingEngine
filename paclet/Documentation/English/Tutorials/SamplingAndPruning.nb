Cell["\<\
A state whose draws all fail keeps its transition with the lowest key, so the \
sample always reaches the requested depth. At rate 0.125 one path of five \
states remains:\
\>", "Text",
 CellID->268959046,ExpressionUUID->"519775d4-d545-25f2-07ad-6c91dcf18fd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "rule", ",", " ", "init", ",", " ", "4", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
   RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.125"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1344585674,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{0, 1, 2, 3, 
