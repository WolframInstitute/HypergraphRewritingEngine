  "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
    " ", 
   RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}]}], "]"}]], "Input",
 CellLabel->"In[11]:= ",
