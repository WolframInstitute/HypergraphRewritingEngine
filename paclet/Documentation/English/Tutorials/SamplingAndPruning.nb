Cell["The deepest step reached at that rate, for six seeds:", "Text",
 CellID->931950651,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Max", " ", "@", " ", 
    RowBox[{
     RowBox[{"Lookup", "[", "\"\<Step\>\"", "]"}], " ", "@", " ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"HGEvolve", "[", 
       RowBox[{
       "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<States\>\"", ",",
         " ", 
        RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.125"}], ",", " ", 
        RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}]}]}]}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->666326815,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "4", ",", "4", ",", "4", ",", "4", ",", "4"}], 
  "}"}]], "Output",
 CellLabel->"Out[22]= ",
 CellID->2074914640,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"]
}, Open  ]],

Cell["Rule weights", "Subsection",
 CellID->622967176,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"],

Cell[TextData[{
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " gives a multiplier on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 " for each rule, in rule order. A rule's transitions are kept with the \
product of the rate and its weight. Rules after the end of the list have \
weight 1, and the default ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 " gives every rule weight 1."
}], "Text",
 CellID->1358080856,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"],

Cell["Two rules that each add a path to a matched edge:", "Text",
 CellID->320615307,ExpressionUUID->"1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"two", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
