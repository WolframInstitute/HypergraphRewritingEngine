   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
