Cell[BoxData["3"], "Output",
 CellLabel->"Out[31]= ",
 CellID->1964771237,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 ", each isomorphism class is expanded once, and the draw is made once per \
class. The number of classes kept for six seeds, of the 6 in the full system \
at four steps:"
}], "Text",
 CellID->2143439988,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "0.5"}], ",", 
     " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}], ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
     RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
      "True"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1134629515,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "2", ",", "2", ",", "2", ",", "3", ",", "3"}], 
  "}"}]], "Output",
 CellLabel->"Out[32]= ",
 CellID->462130301,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"]
}, Open  ]],

Cell["Combining sampled runs", "Section",
 CellID->943735407,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[TextData[{
 "State ids are assigned separately in each run, so an ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 " from one run does not name a state of another. The ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 " depends only on the state's isomorphism class, so the states of two runs \
can be matched by it. The two runs below are at rate 0.5 and five steps, with \
isomorphic states merged."
}], "Text",
 CellID->865519937,ExpressionUUID->"0b990c23-b656-01a6-39a6-a58cc3e3538c"],

Cell["The class hashes of the first seed:", "Text",
