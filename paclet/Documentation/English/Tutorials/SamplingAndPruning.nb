Cell[TextData[{
 "A run that sets no ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " and is capped by arrival order or thinned by ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " or ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " can give a different result each time, and issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "warn"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 ". Every example below sets a seed."
}], "Text",
 CellID->1164297175,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell["Caps", "Section",
 CellID->632614636,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[TextData[{
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 " and ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " keep the lowest-ranked successor states, with every transition into them: \
of each state, once its matching is complete, or of each step, once the \
step's matching is complete. Successor states are the states as ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " identifies them; under the default ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " every transition makes its own state. ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfe104a-50de-a555-0985-8a1461680fbf"],
 " keeps the lowest-ranked transitions of each step. A transition not kept is \
not taken."
}], "Text",
 CellID->1689610856,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell["Successors per parent", "Subsection",
 CellID->1303163127,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell["\<\
At most two successors per state, at three steps, gives a binary tree of 15 \
states:\
\>", "Text",
 CellID->2098230307,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"capped", " ", "=", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "init", ",", " ", "3", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<MaxSuccessorStatesPerParent\>\"", " ", "->", " ", "2"}], ",",
     " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}], ",", " ", 
    RowBox[{"AspectRatio", " ", "->", " ", 
     RowBox[{"1", "/", "2"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->2012614976,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

