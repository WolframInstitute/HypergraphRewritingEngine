Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MaxSuccessorStatesPerParent\>\"", " ", "->", " ", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "2"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " both keep 31 states. The first keeps the first two successors of each \
state the threads produce; the second keeps the two transitions selected by \
the seed, and keeps the same ones on every run. The ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " and ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " counts are for this seed; other seeds give other counts."
}], "Text",
 CellID->308489360,ExpressionUUID->"5f932952-49a5-d34f-05a0-c11c6851a195"],

