Cell["\<\
Together the two runs have the 13 classes of the full system at five steps:\
\>", "Text",
 CellID->1239660989,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

Cell[CellGroupData[{

Cell[BoxData[
