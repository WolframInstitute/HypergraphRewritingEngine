Cell[TextData[{
 "A run that sets no ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " and is capped by arrival order or thinned by ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " or ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 " can give a different result each time, and issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "warn"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 ". Every example below sets a seed."
}], "Text",
 CellID->753514147,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell["Caps by arrival order", "Section",
 CellID->1164297175,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 ", ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 " and ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " count states as they are produced and keep no more once the cap is \
reached. The bound holds at any thread count. Which states are kept depends \
on the order the threads produce them in, so a capped run can keep different \
states on another run or thread count."
}], "Text",
 CellID->632614636,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell["Successors per parent", "Subsection",
 CellID->1689610856,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell["\<\
At most two successors per state, at three steps, gives a binary tree of 15 \
states:\
\>", "Text",
 CellID->1303163127,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"capped", " ", "=", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "init", ",", " ", "3", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<MaxSuccessorStatesPerParent\>\"", " ", "->", " ", "2"}], ",",
     " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}], ",", " ", 
    RowBox[{"AspectRatio", " ", "->", " ", 
     RowBox[{"1", "/", "2"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1939205009,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

