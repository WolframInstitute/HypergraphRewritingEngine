Cell["\<\
The number of states for six seeds. A run with 3 states expanded neither \
state of step 1:\
\>", "Text",
 CellID->1006830744,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "0.5"}], ",", 
     " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", "11", ",", " ", "16"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->519615703,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"42", ",", "35", ",", "42", ",", "24", ",", "3", ",", "12"}], 
  "}"}]], "Output",
 CellLabel->"Out[30]= ",
 CellID->2039429062,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"]
}, Open  ]],

Cell["The deepest step each of those runs reached:", "Text",
