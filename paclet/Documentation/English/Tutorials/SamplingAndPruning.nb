 CellID->1595664397,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"]
}, Open  ]],

Cell["\<\
Since the initial state is always expanded, no run at two steps has fewer \
than the initial state and its two successors:\
\>", "Text",
 CellID->1933756212,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Min", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rule", ",", " ", "init", ",", " ", "2", ",", " ", "\"\<NumStates\>\"", ",",
       " ", 
      RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "0.5"}], ",", 
      " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "1", ",", " ", "20"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[32]:= ",
 CellID->1104768546,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[32]= ",
 CellID->1942365842,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 ", each isomorphism class is expanded once, and the draw is made once per \
class. The number of classes kept for six seeds, of the 6 in the full system \
at four steps:"
}], "Text",
 CellID->865519937,ExpressionUUID->"52243646-2fbd-210e-03db-a8204a487054"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "0.5"}], ",", 
     " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}], ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
     RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
      "True"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[33]:= ",
 CellID->1471697777,ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "2", ",", "2", ",", "2", ",", "3", ",", "3"}], 
  "}"}]], "Output",
 CellLabel->"Out[33]= ",
 CellID->1202524403,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"]
}, Open  ]],

Cell["Combining sampled runs", "Section",
 CellID->14312863,ExpressionUUID->"1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],

Cell[TextData[{
 "State ids are assigned separately in each run, so an ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 " from one run does not name a state of another. The ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "612fd791-c81e-86f2-10d4-cedae9a8ecd8"],
 " depends only on the state's isomorphism class, so the states of two runs \
can be matched by it. The two runs below are at rate 0.5 and five steps, with \
isomorphic states merged."
}], "Text",
 CellID->315698450,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell["The class hashes of the first seed:", "Text",
 CellID->1751204118,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"hashesA", " ", "=", " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<CanonicalHash\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{
      "rule", ",", " ", "init", ",", " ", "5", ",", " ", "\"\<States\>\"", ",",
        " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
       " ", 
       RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.5"}], ",", " ", 
       RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
      "]"}]}]}]}]}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->1176841719,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[
 RowBox[{"{", 
