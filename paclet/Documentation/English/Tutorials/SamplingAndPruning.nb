        "EventId" -> 3|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {DirectedEdge[1, 2, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip], 
         DirectedEdge[3, 4, <|"EventId" -> 3|>] -> Placed[
           Row[{"Event ", 3}], Tooltip], 
         DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         DirectedEdge[2, 3, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip]}, 
       EdgeStyle -> {DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], DirectedEdge[1, 2, <|"EventId" -> 1|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], DirectedEdge[3, 4, <|"EventId" -> 3|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], DirectedEdge[2, 3, <|"EventId" -> 2|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]]}, GraphLayout -> "LayeredDigraphEmbedding", 
