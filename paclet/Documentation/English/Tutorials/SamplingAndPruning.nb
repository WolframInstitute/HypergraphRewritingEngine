Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " merges states but still applies every transition. The options in this \
tutorial skip transitions or states."
}], "Text",
 CellID->2122865143,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

