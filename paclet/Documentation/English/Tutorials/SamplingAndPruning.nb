Cell["The deepest step reached at that rate, for six seeds:", "Text",
 CellID->643798763,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Max", " ", "@", " ", 
    RowBox[{
     RowBox[{"Lookup", "[", "\"\<Step\>\"", "]"}], " ", "@", " ", 
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"HGEvolve", "[", 
       RowBox[{
       "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<States\>\"", ",",
         " ", 
        RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.125"}], ",", " ", 
        RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "s"}]}], "]"}]}]}]}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"s", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->2058425823,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "4", ",", "4", ",", "4", ",", "4", ",", "4"}], 
  "}"}]], "Output",
 CellLabel->"Out[21]= ",
 CellID->1689509600,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"]
}, Open  ]],

Cell["Rule weights", "Subsection",
 CellID->403125484,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"],

Cell[TextData[{
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " gives a multiplier on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 " for each rule, in rule order. A rule's transitions are kept with the \
product of the rate and its weight. Rules after the end of the list have \
weight 1, and the default ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 " gives every rule weight 1."
}], "Text",
 CellID->931950651,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell["Two rules that each add a path to a matched edge:", "Text",
 CellID->412518898,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"two", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
