Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "k", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
