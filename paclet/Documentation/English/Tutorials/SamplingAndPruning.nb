Cell["Matches per step", "Subsection",
 CellID->29467524,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cb5c01f-62f5-68e0-144a-da5916803aca"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " also keeps at most three states per step, in arrival order, and gives the \
same count as ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 ":"
}], "Text",
 CellID->1939141443,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}]}], "]"}], ",", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1814428022,ExpressionUUID->"2055bfee-d4b5-7aa2-506a-36cbdd404888"],

