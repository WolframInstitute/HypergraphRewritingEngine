Notebook[{

Cell[CellGroupData[{
Cell["Sampling and Pruning the Multiway System", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "The number of states of a multiway system grows quickly with the number of \
steps. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " has two kinds of options that limit it:"
}], "Text",
 CellID->329621944,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell[TextData[{
 "caps, ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 ", ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 ", ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 ", and ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 ", which keep the lowest-ranked successor states or transitions;"
}], "Item",
 CellID->515379898,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 "samples, ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " with ",
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", and ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 ", which keep each transition or state with a probability."
}], "Item",
 CellID->604760901,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "Both draw from the identity of each transition or state and the ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 ", so they keep the same states on every run with the same seed, at any \
thread count."
}], "Text",
 CellID->1476799103,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["\<\
This tutorial applies each to one rule, and combines two sampled runs using \
the canonical hashes of their states.\
\>", "Text",
 CellID->448336599,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["The size of the full system", "Section",
 CellID->970785311,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell["\<\
The chain rule splits one edge into two. Its number of states at steps 0 to 6:\
\>", "Text",
 CellID->1377816002,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{"chain", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "k", ",", 
     " ", "\"\<NumStates\>\""}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->293863717,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "4", ",", "10", ",", "34", ",", "154", ",", "874"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1063680002,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"]
}, Open  ]],

Cell["\<\
The examples below use this rule, which consumes two edges meeting at a \
vertex and produces four:\
\>", "Text",
 CellID->1641200340,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rule", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1873367150,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",
 CellID->432061762,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"]
}, Open  ]],

Cell["Its initial state is two loops at one vertex:", "Text",
 CellID->535457321,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"init", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1129727236,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",
 CellID->1769442689,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"]
}, Open  ]],

Cell["The number of states at steps 0 to 5:", "Text",
 CellID->299517738,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "k", ",", " ", "\"\<NumStates\>\""}], 
