  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 " keeps the three lowest-ranked transitions of each step. Under the default ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "None"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 " every transition makes its own state, so it keeps what ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " keeps:"
}], "Text",
 CellID->1892712309,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}]}], "]"}], ",", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "3"}]}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[13]:= ",
