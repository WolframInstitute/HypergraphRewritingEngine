Cell["Exploration probability", "Subsection",
 CellID->634665076,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<ExplorationProbability\>\"", " ", "->", " ", "p"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48a3d607-c312-9dd3-7850-c860f6a4e739"],
 " expands each state with probability ",
 StyleBox["p", "TI"],
 ", drawn from the identity of the transition that created it and the seed. \
The initial state is always expanded. A state that is not expanded has no \
successors, so a run can stop before the requested depth."
}], "Text",
 CellID->1607396713,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

