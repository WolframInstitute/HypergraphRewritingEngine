Cell["\<\
The full system has one isomorphism class at each step up to step 3, and two \
at step 4:\
\>", "Text",
 CellID->941376513,ExpressionUUID->"3181a460-bc62-f1ee-67be-3e4a3514c334"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sort", " ", "@", " ", 
  RowBox[{"Tally", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<Step\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{
      "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<States\>\"", ",",
        " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
      "]"}]}]}]}]}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->218200256,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[15]= ",
 CellID->1147471427,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 ", each state record has a ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 ", which is the same for isomorphic states on every run. The step and the \
class of each state on the path; the seed selects which of the two classes at \
step 4 it ends in:"
}], "Text",
 CellID->1047559317,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"kept", " ", "=", " ", 
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Step\>\"", ",", " ", "\"\<CanonicalHash\>\""}], "}"}], 
    "]"}], " ", "@", " ", 
   RowBox[{"Values", " ", "@", " ", 
