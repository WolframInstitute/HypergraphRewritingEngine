Cell["\<\
The full system has one isomorphism class at each step up to step 3, and two \
at step 4:\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sort", " ", "@", " ", 
  RowBox[{"Tally", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<Step\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{
      "rule", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<States\>\"", ",",
        " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
      "]"}]}]}]}]}]], "Input",
 CellLabel->"In[16]:= ",
