Cell["The geometry of branchial space", "Section",
 CellID->1091979148,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell["\<\
The branchial graph of a step joins states with a common ancestor. The plots \
show the dimension of its largest component and that component's \
Ollivier-Ricci curvature with no idleness:\
\>", "Text",
 CellID->1239660989,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"qm", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
