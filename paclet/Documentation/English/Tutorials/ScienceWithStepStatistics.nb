Cell["Free space and a gravitational field", "Section",
 CellID->1689610856,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "Does the same rule give a different dimension and curvature in free space \
and near two black holes? The rule replaces a path of four edges with four \
edges through a new vertex. One run starts from a torus of 81 vertices, the \
other from a Brill-Lindquist point cloud of 80 points around two black holes, \
both described in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Generated Initial Conditions"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
InitialConditions"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ":"
}], "Text",
 CellID->1303163127,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ruleA", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "v"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "u"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "x"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "u"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"torus", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Torus\>\""}], ",", " ", 
       RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "9"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "40", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"blackHoles", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<BrillLindquist\>\""}], ",",
        " ", 
       RowBox[{"\"\<Density\>\"", " ", "->", " ", "80"}], ",", " ", 
       RowBox[{"\"\<Separation\>\"", " ", "->", " ", "6."}], ",", " ", 
       RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
       RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
       RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "3.5"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "40", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[10]:= ",
 CellID->2098230307,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "The Brill-Lindquist state has two components, and ",
 Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " is undefined for a disconnected state:"
}], "Text",
 CellID->1930159659,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
