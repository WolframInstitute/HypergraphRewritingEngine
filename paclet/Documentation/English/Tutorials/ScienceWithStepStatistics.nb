Cell[TextData[{
 "The 20 states of a step are 20 branches. The ",
 Cell[BoxData["\"\<Histogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " of ",
 Cell[BoxData["\"\<LargestComponentDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " in ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " maps each dimension, rounded to 0.01, to the number of states with that \
dimension. The dimension over the branches at steps 50, 100 and 200:"
}], "Text",
 CellID->1735808809,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h", " ", "=", " ", 
         RowBox[{
          RowBox[{"history", "[", 
           RowBox[{"[", 
            RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], "[", 
          
          RowBox[{"\"\<Invariants\>\"", ",", 
           " ", "\"\<LargestComponentDimension\>\"", ",", 
           " ", "\"\<Histogram\>\""}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"WeightedData", "[", 
        RowBox[{
         RowBox[{"Keys", "[", "h", "]"}], ",", " ", 
         RowBox[{"Values", "[", "h", "]"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", 
        RowBox[{"50", ",", " ", "100", ",", " ", "200"}], "}"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"{", "0.01", "}"}], ",", " ", "\"\<Probability\>\"", ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<dimension\>\"", ",", " ", "\"\<fraction of states\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"ChartLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step 50\>\"", ",", " ", "\"\<step 100\>\"", ",", 
      " ", "\"\<step 200\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->372695887,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

