          RowBox[{"ToString", "[", "s", "]"}]}]}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "140"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"s", ",", " ", "1", ",", " ", "10"}], "}"}]}], "]"}], ",", " ",
