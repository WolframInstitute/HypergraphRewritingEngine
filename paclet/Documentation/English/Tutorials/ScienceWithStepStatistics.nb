Notebook[{

Cell[CellGroupData[{
Cell["Science with Step Statistics", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell[BoxData["\"\<StepStatistics\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " gives one association per step of an evolution, with counts of states and \
classes, summaries of per-state invariants, distributions over vertices and, \
on request, measures of the branchial graph, the overlap between states and \
state x state matrices. The ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 " reference page defines every key. This tutorial uses them to answer eight \
questions about rules of the Wolfram Physics Project. Every number plotted \
comes from the engine."
}], "Text",
 CellID->329621944,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["Each plot reads one key of every step with this function:", "Text",
 CellID->515379898,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[BoxData[
 RowBox[{
  RowBox[{"perStep", "[", 
   RowBox[{"stats_", ",", " ", "keys__"}], "]"}], " ", ":=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "[", "\"\<Step\>\"", "]"}], ",", " ", 
      RowBox[{"s", "[", "keys", "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "stats"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->604760901,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["States and classes per step", "Section",
 CellID->1476799103,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["\<\
How many of the states of the multiway system are distinct up to isomorphism? \
The rule is a rule of the Wolfram Physics Project, from two self-loops on one \
vertex:\
\>", "Text",
 CellID->448336599,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wolfram", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"classes", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"wolfram", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", "5", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
     RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
      "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Lookup", "[", 
  RowBox[{"classes", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Step\>\"", ",", " ", "\"\<RawStates\>\"", ",", 
     " ", "\"\<Classes\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1653674069,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "24", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "408", ",", "18"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "9504", ",", "156"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "280080", ",", "1776"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",
 CellID->1350357703,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", the engine expands one state per class and counts the states of each \
class, so ",
 Cell[BoxData["\"\<RawStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " is the number of states of the full multiway system. The number of classes \
grows more slowly:"
}], "Text",
 CellID->1377816002,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{"classes", ",", " ", "\"\<RawStates\>\""}], "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{"classes", ",", " ", "\"\<Classes\>\""}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<count\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<states\>\"", ",", " ", "\"\<classes\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->293863717,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

