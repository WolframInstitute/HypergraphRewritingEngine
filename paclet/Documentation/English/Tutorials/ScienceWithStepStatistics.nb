Cell["The distribution of curvature", "Section",
 CellID->443736588,ExpressionUUID->"337c2d89-644e-5b5e-6103-c4d30dfb29a4"],

Cell[TextData[{
 "How is curvature spread over the vertices of all branches at a step? ",
 Cell[BoxData["\"\<VertexInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 " pools the vertices of every state at the step. Its ",
 Cell[BoxData["\"\<Histogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " maps the lower edge of each bin to the number of vertices in the bin. \
Curvature has 32 bins of width 3/32 from -2 to 1. The curvature of the \
vertices at steps 5, 20 and 40, as a fraction of the vertices:"
}], "Text",
 CellID->1593449978,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vertexHistogram", "[", 
    RowBox[{"stats_", ",", " ", "step_", ",", " ", "key_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{
        RowBox[{"stats", "[", 
         RowBox[{"[", 
          RowBox[{"step", " ", "+", " ", "1"}], "]"}], "]"}], "[", 
        RowBox[{"\"\<VertexInvariants\>\"", ",", " ", "key", ",", 
         " ", "\"\<Histogram\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"WeightedData", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "h", "]"}], ",", " ", 
       RowBox[{"Values", "[", "h", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vertexHistogram", "[", 
          RowBox[{
          "torus", ",", " ", "s", ",", 
           " ", "\"\<OllivierRicciCurvature\>\""}], "]"}], ",", " ", 
         RowBox[{"vertexHistogram", "[", 
          RowBox[{
          "blackHoles", ",", " ", "s", ",", 
           " ", "\"\<OllivierRicciCurvature\>\""}], "]"}]}], "}"}], ",", " ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", " ", "1", ",", " ", 
         RowBox[{"3", "/", "32"}]}], "}"}], ",", " ", "\"\<Probability\>\"", ",",
        " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.6"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<curvature\>\"", ",", " ", "\"\<fraction\>\""}], "}"}]}],
        ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<step \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "s", "]"}]}]}], ",", " ", 
       RowBox[{"ChartLegends", " ", "->", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"s", " ", "==", " ", "40"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], 
           "}"}], ",", " ", "None"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "20", ",", " ", "40"}], "}"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"Spacer", "[", "30", "]"}]}], "]"}]}], "Input",
 CellLabel->"In[14]:= ",
 CellID->470259450,ExpressionUUID->"6801f052-da94-0b6f-183e-ea1fdf2159b5"],

