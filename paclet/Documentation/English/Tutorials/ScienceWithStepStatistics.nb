Cell["Free space and a gravitational field", "Section",
 CellID->436346740,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[TextData[{
 "Does the same rule give a different dimension and curvature in free space \
and near two black holes? The rule replaces a path of four edges with four \
edges through a new vertex. One run starts from a torus of 81 vertices, the \
other from a Brill-Lindquist point cloud of 80 points around two black holes, \
both described in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Generated Initial Conditions"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
InitialConditions"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 ":"
}], "Text",
 CellID->2122865143,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ruleA", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "v"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "u"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "x"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "u"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"torus", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Torus\>\""}], ",", " ", 
       RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "9"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "40", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"blackHoles", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<BrillLindquist\>\""}], ",",
        " ", 
       RowBox[{"\"\<Density\>\"", " ", "->", " ", "80"}], ",", " ", 
       RowBox[{"\"\<Separation\>\"", " ", "->", " ", "6."}], ",", " ", 
       RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
       RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
       RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "3.5"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "40", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[7]:= ",
 CellID->1735808809,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 "The Brill-Lindquist state has two components, and ",
 Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " is undefined for a disconnected state:"
}], "Text",
 CellID->753514147,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"First", "[", "torus", "]"}], "[", 
    RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<Components\>\"", ",", 
     " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
   RowBox[{
    RowBox[{"First", "[", "blackHoles", "]"}], "[", 
    RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<Components\>\"", ",", 
     " ", "\"\<Mean\>\""}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->2112731703,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", "2.`"}], "}"}]], "Output",
 CellLabel->"Out[8]= ",
 CellID->1175750198,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<LargestComponentDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 " is the dimension of the largest component, so it is defined for both:"
}], "Text",
 CellID->632614636,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "torus", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<LargestComponentDimension\>\"", ",", " ", "\"\<Mean\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "blackHoles", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<LargestComponentDimension\>\"", ",", " ", "\"\<Mean\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<dimension\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->758895630,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

