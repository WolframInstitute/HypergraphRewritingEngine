Cell["Mutual information between states", "Section",
 CellID->284780108,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[TextData[{
 "How much does each state at a step tell about each other state? ",
 Cell[BoxData["\"\<StepStatisticsMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " adds ",
 Cell[BoxData["\"\<StateMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 " to each step: the step's state ids and a state x state matrix for each \
measure asked for. The rule adds a square on every path of two edges, from \
two self-loops. ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " keeps 10 states at each step:"
}], "Text",
 CellID->643798763,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"square", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "c"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"b", ",", " ", "c"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "d"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "a"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pairs", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"square", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], ",", " ", "10", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<StepStatisticsMatrices\>\"", " ", "->", " ", "All"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Keys", "[", 
  RowBox[{
   RowBox[{"Last", "[", "pairs", "]"}], "[", "\"\<StateMatrices\>\"", "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[26]:= ",
 CellID->2058425823,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"States\"\>", ",", "\<\"StateOverlap\"\>", 
   ",", "\<\"StateCosineSimilarity\"\>", 
   ",", "\<\"StateMutualInformation\"\>", ",", "\<\"StateEdgeOverlap\"\>", 
   ",", "\<\"StateEdgeCosineSimilarity\"\>", 
   ",", "\<\"StateEdgeMutualInformation\"\>"}], "}"}]], "Output",
 CellLabel->"Out[26]= ",
 CellID->1689509600,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"]
}, Open  ]],

Cell[TextData[{
 "The mutual information in bits between every two states, as vertex sets, at \
steps 1 to 10. Row and column i are the i-th id of ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 ", row 1 at the top, and the diagonal is the entropy of each state:"
}], "Text",
 CellID->403125484,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

