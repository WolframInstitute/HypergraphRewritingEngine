          RowBox[{"{", 
           RowBox[{"0", ",", " ", "40"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1.0625"}], ",", " ", "1"}], "}"}]}], "}"}]}], ",", 
