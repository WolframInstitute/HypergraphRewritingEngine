Cell["\<\
The local dimension of the vertices has 32 bins of width 1/4 from 0 to 8. At \
steps 5, 20 and 40:\
\>", "Text",
 CellID->5047578,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vertexHistogram", "[", 
          RowBox[{
          "torus", ",", " ", "s", ",", " ", "\"\<LocalDimension\>\""}], "]"}],
          ",", " ", 
         RowBox[{"vertexHistogram", "[", 
          RowBox[{
          "blackHoles", ",", " ", "s", ",", " ", "\"\<LocalDimension\>\""}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "8", ",", " ", 
         RowBox[{"1", "/", "4"}]}], "}"}], ",", " ", "\"\<Probability\>\"", ",",
        " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0.8"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<dimension\>\"", ",", " ", "\"\<fraction\>\""}], "}"}]}],
        ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<step \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "s", "]"}]}]}], ",", " ", 
       RowBox[{"ChartLegends", " ", "->", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"s", " ", "==", " ", "40"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], 
           "}"}], ",", " ", "None"}], "]"}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "20", ",", " ", "40"}], "}"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"Spacer", "[", "30", "]"}]}], "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1683074990,ExpressionUUID->"3b7fe4cc-5889-7f4e-6904-fd96593c4594"],

