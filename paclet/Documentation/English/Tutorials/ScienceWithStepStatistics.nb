Cell["\<\
From about step 17 the state has 159 components, and the readings repeat a \
cycle of a few steps. The state of step 105 has 1036 vertices. The ball \
scalar curvature is negative on a uniform sample of a flat 3D box at 200 and \
at 1000 points, where the scalar curvature is 0. It reads the known curvature \
of a sphere or a torus within 25% only near 10,000 points.\
\>", "Text",
 CellID->1280025883,ExpressionUUID->"4f9438da-b80f-a114-75ab-b18439bbf07e"],

Cell["The dimension of the causal graph", "Subsection",
 CellID->681114160,ExpressionUUID->"7281c19b-2602-dcd4-22be-d8c553b4a63e"],

Cell[TextData[{
 "The causal graph of the run has 17,742 causal pairs. ",
 Cell[BoxData["myrheimMeyer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " of the section on the dimension of a causal graph gives its whole-set \
value and the median over 30 sampled intervals of at least 40 events:"
}], "Text",
 CellID->1719384190,ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pairs", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Lookup", "[", 
     RowBox[{
      RowBox[{"merger", "[", "\"\<CausalEdges\>\"", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<From\>\"", ",", " ", "\"\<To\>\""}], "}"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mm", " ", "=", " ", 
     RowBox[{"myrheimMeyer", "[", 
      RowBox[{"pairs", ",", " ", "30", ",", " ", "40", ",", " ", "1"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"100", " ", 
         RowBox[{"mm", "[", "\"\<WholeSet\>\"", "]"}]}], "]"}], "/", "100"}], 
      "]"}], ",", " ", 
     RowBox[{"mm", "[", "\"\<Intervals\>\"", "]"}], ",", " ", 
     RowBox[{"mm", "[", "\"\<IntervalMedian\>\"", "]"}]}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[50]:= ",
 CellID->2127884403,ExpressionUUID->"473164ce-b547-c1f4-6ecf-7da83cf393de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6.03`", ",", "30", ",", "1.`"}], "}"}]], "Output",
 CellLabel->"Out[50]= ",
 CellID->954676210,ExpressionUUID->"12c4fc3b-e00c-2bba-42fb-f66491b97980"]
}, Open  ]],

Cell["\<\
The Myrheim-Meyer formula holds for an interval. The whole causal graph of an \
evolution is not an interval, so its whole-set value of 6.03 is outside the \
calibration on sprinkled diamonds. The sampled intervals give a median of 1. \
The cone measure does not apply here, since it does not reproduce the \
dimension of sprinkled causal sets.\
\>", "Text",
 CellID->1064479054,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell["Causal invariance", "Subsection",
 CellID->1710804206,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell["\<\
The rule is not causal invariant. The path of five edges has two complete \
histories, one of a single event and one of two events, so their causal \
graphs differ. The number of events of each complete history:\
\>", "Text",
 CellID->762016048,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"path5", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "6"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"DirectedEdge", " ", "@@@", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"Values", "[", 
          RowBox[{"HGEvolve", "[", 
           RowBox[{
           "ruleA", ",", " ", "path5", ",", " ", "3", ",", 
            " ", "\"\<Events\>\""}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<InputState\>\"", ",", " ", "\"\<OutputState\>\""}], 
          "}"}]}], "]"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"First", "[", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"VertexInDegree", "[", 
              RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ",
             "&"}]}], "]"}], "]"}], ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"g", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[51]:= ",
 CellID->1723599999,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[51]= ",
 CellID->952712890,ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Generational\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 " applies one order among matches that share a hyperedge, so it gives one of \
the causal graphs the rule admits."
}], "Text",
 CellID->1320676321,ExpressionUUID->"5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],

