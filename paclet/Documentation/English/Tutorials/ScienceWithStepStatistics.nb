Cell["Two graph conventions for hyperedges", "Section",
 CellID->417968184,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<StatisticsGraph\>\"", " ", "->", " ", "\"\<Consecutive\>\""}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "574a2197-51ef-7938-7d49-b8d1679a4802"],
 ", the default, a hyperedge {a, b, c} gives the graph edges a-b and b-c. \
With ",
 Cell[BoxData[
  RowBox[{"\"\<StatisticsGraph\>\"", " ", "->", " ", "\"\<AllPairs\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e85e9ed-427b-8528-16ba-00b7770fec72"],
 " it also gives a-c, as the Infrageometry paclet does:"
}], "Text",
 CellID->1274591649,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ternary", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], " ", "->", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4", ",", " ", "3"}], "}"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"conv", ",", " ", 
     RowBox[{
      RowBox[{"Last", "[", 
       RowBox[{"HGEvolve", "[", 
        RowBox[{"ternary", ",", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "}"}], ",", 
         " ", "8", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
         RowBox[{"\"\<StatisticsGraph\>\"", " ", "->", " ", "conv"}], ",", 
         " ", 
         RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", "All"}]}], 
        "]"}], "]"}], "[", 
      RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"conv", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Consecutive\>\"", ",", " ", "\"\<AllPairs\>\""}], "}"}]}], 
    "}"}]}], "]"}]}], "Input",
 CellLabel->"In[41]:= ",
 CellID->846374809,ExpressionUUID->"31f4c073-8ff6-126f-678b-da3d298360b5"],

