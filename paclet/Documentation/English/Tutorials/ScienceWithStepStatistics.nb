Cell["Branches and the initial state", "Section",
 CellID->670734585,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 "How similar are the states at a step, and how much of the initial state do \
they keep? ",
 Cell[BoxData[
  RowBox[{"\"\<StepStatisticsBranchial\>\"", " ", "->", " ", "All"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " adds the branchial graph measures and the overlap of the states' vertex \
sets. ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "400"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " keeps 400 states at each step:"
}], "Text",
 CellID->58232708,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"branches", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
       RowBox[{"\"\<Width\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Height\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "10", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"\"\<StepStatisticsBranchial\>\"", " ", "->", " ", "All"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->393464600,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell["\<\
The mean over every two states of their cosine similarity and their mutual \
information, and the mean over the states of their mutual information with \
the initial state, in bits. At step 0 the only state is the initial state, so \
every vertex is in both sets and the mutual information is 0:\
\>", "Text",
 CellID->1484396876,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<StateCosineSimilarity\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<StateMutualInformation\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<InitialStateMutualInformation\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cosine similarity\>\"", ",", 
      " ", "\"\<mutual information\>\"", ",", 
      " ", "\"\<mutual information with the initial state\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->2098961127,ExpressionUUID->"341c54d9-3079-6bba-5c24-4d83410c3980"],

