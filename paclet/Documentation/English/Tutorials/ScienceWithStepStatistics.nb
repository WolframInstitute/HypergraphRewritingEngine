 CellLabel->"Out[34]= ",
 CellID->40184685,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"]
}, Open  ]],

Cell["Curvature of generated surfaces", "Section",
 CellID->1006830744,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell["\<\
A sphere is positively curved, and a torus and a Klein bottle are flat. A \
cylinder and a Mobius strip have a boundary. The table lists each generated \
surface's ball dimension and its scalar curvature from ball growth and from \
sphere growth:\
\>", "Text",
 CellID->1175763064,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", " ", "=", " ", 
           RowBox[{"zeroStep", "[", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Type\>\"", " ", "->", " ", "t"}], ",", " ", 
              RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "12"}], ",", " ", 
              
              RowBox[{"\"\<Height\>\"", " ", "->", " ", "12"}], ",", " ", 
              RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\"", ",",
              " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<BallScalarCurvature\>\"", ",", " ", "\"\<Mean\>\""}], 
            "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<SphereScalarCurvature\>\"", ",", " ", "\"\<Mean\>\""}],
             "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Sphere\>\"", ",", " ", "\"\<Torus\>\"", ",", 
           " ", "\"\<Klein\>\"", ",", " ", "\"\<Cylinder\>\"", ",", 
           " ", "\"\<Mobius\>\""}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<surface\>\"", ",", " ", "\"\<ball dimension\>\"", ",", 
       " ", "\"\<ball curvature\>\"", ",", " ", "\"\<sphere curvature\>\""}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[35]:= ",
 CellID->589439026,ExpressionUUID->"023f49e2-a747-9723-33c5-60cfd2f3fa09"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"surface\"\>", "\<\"ball dimension\"\>", "\<\"ball curvature\"\>", "\
\<\"sphere curvature\"\>"},
    {"\<\"Sphere\"\>", "1.6480581391648024`", "0.007264705627992591`", 
     "0.09826826228968466`"},
    {"\<\"Torus\"\>", "1.5020580872230278`", 
     RowBox[{"-", "0.10059102538646224`"}], "0.0962054369458793`"},
    {"\<\"Klein\"\>", "1.5602689324792185`", 
     RowBox[{"-", "0.029944224220243194`"}], "0.02172527270244018`"},
    {"\<\"Cylinder\"\>", "1.4937655870569633`", 
     RowBox[{"-", "0.037549666890943016`"}], "0.10792805683936055`"},
    {"\<\"Mobius\"\>", "1.3807463587458544`", "0.042718330583967984`", 
     "0.18620374937602238`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->"Out[35]= ",
 CellID->1964771237,ExpressionUUID->"21aa1c49-e16c-f406-57a9-9612901edf6c"]
}, Open  ]],

Cell["The dimension of a causal set", "Section",
 CellID->2143439988,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell["\<\
A sprinkling places random points in a box of Minkowski spacetime and joins \
causally related points. The dimensions read from graph distances differ from \
the spacetime dimension, because the undirected graph of causal links loses \
the time order that fixes the dimension of a causal set:\
\>", "Text",
 CellID->1933756212,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", " ", "=", " ", 
           RowBox[{"zeroStep", "[", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Sprinkling\>\""}], 
              ",", " ", 
              RowBox[{"\"\<SpatialDim\>\"", " ", "->", " ", "k"}], ",", " ", 
              RowBox[{"\"\<Density\>\"", " ", "->", " ", "250"}], ",", " ", 
              RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", " ", "+", " ", "1"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\"", ",",
              " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<RiemannianBallDimension\>\"", ",", 
             " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<SphereDimension\>\"",
              ",", " ", "\"\<Mean\>\""}], "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<spacetime dimension\>\"", ",", 
       " ", "\"\<ball (counting)\>\"", ",", " ", "\"\<ball (Riemannian)\>\"", 
       ",", " ", "\"\<sphere\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->1104768546,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"spacetime dimension\"\>", "\<\"ball (counting)\"\>", "\<\"ball \
(Riemannian)\"\>", "\<\"sphere\"\>"},
    {"2", "2.5812516098822367`", "2.573373098125776`", "3.761262074211446`"},
    {"3", "3.8943690201199956`", "1.813489802955897`", "5.459955312482103`"},
    {"4", "4.17237428014527`", "1.49126168909049`", "5.815151159368815`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->"Out[36]= ",
 CellID->1942365842,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"]
}, Open  ]],

Cell["Shortest paths and the continuum", "Section",
 CellID->865519937,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["\<\
Two points of a continuum have one shortest path, and two vertices of a \
lattice have exponentially many. The fraction of vertex pairs joined by one \
shortest path rises if evolution makes space more like a continuum:\
\>", "Text",
 CellID->845186625,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "grTorus", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<GeodeticFraction\>\"", ",", " ", "\"\<Mean\>\""}], "]"}], ",",
      " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "grHoles", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<GeodeticFraction\>\"", ",", " ", "\"\<Mean\>\""}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<geodetic fraction\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->711076509,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

