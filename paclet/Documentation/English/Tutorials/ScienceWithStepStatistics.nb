        RowBox[{"{", 
         RowBox[{"\"\<step\>\"", ",", " ", "\"\<branchial dimension\>\""}], 
         "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"perStep", "[", 
          RowBox[{
          "qm", ",", " ", "\"\<BranchialNonLazyOllivierRicciCurvature\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"_", ",", " ", 
           RowBox[{"_", "?", "NumericQ"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
