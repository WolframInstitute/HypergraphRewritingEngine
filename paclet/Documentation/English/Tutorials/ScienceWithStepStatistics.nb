Cell["Is curvature local?", "Section",
 CellID->432388834,ExpressionUUID->"134534fb-1061-d656-417a-ada5a115bcbc"],

Cell[TextData[{
 "Do vertices of high curvature sit next to each other, or does curvature \
follow the degree? ",
 Cell[BoxData["\"\<OllivierMoranI\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 " is Moran's I of the vertex curvature over the edges of a state, positive \
when neighbours have similar curvature. It is undefined when every vertex has \
the same curvature, as on the torus at step 0:"
}], "Text",
 CellID->443736588,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[CellGroupData[{

