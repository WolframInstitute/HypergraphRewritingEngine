Cell[TextData[{
 "In a notebook, ",
 Cell[BoxData[
  RowBox[{"ListAnimate", "[", 
   RowBox[{"embedding", " ", "/@", " ", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Values", "[", "history", "]"}], ",", " ", 
      RowBox[{"#Step", " ", "&"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " shows every step as an animation."
}], "Text",
 CellID->993357154,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell["Two readings of dimension", "Section",
 CellID->50259360,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell[TextData[{
 "The Infrageometry program reads the dimension of a graph from the growth of \
its balls. The counting measure counts every vertex of a ball. The Riemannian \
measure counts only the vertices whose neighbours all lie in the ball. On \
square grids of width 8 to 32 the counting reading rises from 1.29 to 1.63, \
and the Riemannian reading falls from 2.15 to 1.89, crossing 2 between widths \
16 and 24. ",
 Cell[BoxData[
  RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", "All"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " adds both readings and the other measures of this tutorial's remaining \
sections. The helper ",
 Cell[BoxData["zeroStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 " gives the statistics of a generated state without any evolution:"
}], "Text",
 CellID->680111415,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zeroStep", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "ruleA", ",", " ", "spec", ",", " ", "0", ",", 
      " ", "\"\<StepStatistics\>\"", ",", " ", 
      RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", "All"}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grids", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"zeroStep", "[", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
          
