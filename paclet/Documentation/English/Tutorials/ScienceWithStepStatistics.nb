Cell["Curvature of generated surfaces", "Section",
 CellID->1006830744,ExpressionUUID->"539491e8-328f-8d7b-01ab-08b2473bd441"],

Cell["\<\
A sphere is positively curved, and a torus and a Klein bottle are flat. A \
cylinder and a Mobius strip have a boundary. The table lists each generated \
surface's ball dimension and its scalar curvature from ball growth and from \
sphere growth:\
\>", "Text",
 CellID->1175763064,ExpressionUUID->"7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", " ", "=", " ", 
           RowBox[{"zeroStep", "[", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Type\>\"", " ", "->", " ", "t"}], ",", " ", 
              RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "12"}], ",", " ", 
              
              RowBox[{"\"\<Height\>\"", " ", "->", " ", "12"}], ",", " ", 
              RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\"", ",",
              " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<BallScalarCurvature\>\"", ",", " ", "\"\<Mean\>\""}], 
            "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<SphereScalarCurvature\>\"", ",", " ", "\"\<Mean\>\""}],
             "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
