Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"heat", "[", "state_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"stateGraph", "[", "state", "]"}]}], ",", " ", 
       RowBox[{"k", " ", "=", " ", 
        RowBox[{"state", "[", "\"\<VertexCurvature\>\"", "]"}]}]}], "}"}], ",",
      " ", 
     RowBox[{"Graph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"VertexStyle", " ", "->", " ", 
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], "[", 
              
              RowBox[{"Rescale", "[", 
               RowBox[{
                RowBox[{"Lookup", "[", 
                 RowBox[{"k", ",", " ", "#", ",", " ", "0"}], "]"}], ",", " ", 
                RowBox[{"MinMax", "[", 
                 RowBox[{"Values", "[", "k", "]"}], "]"}]}], "]"}], "]"}], 
             " ", "&"}], " ", "/@", " ", 
            RowBox[{"VertexList", "[", "g", "]"}]}], ")"}]}], "]"}]}], ",", 
       " ", 
       RowBox[{"VertexSize", " ", "->", " ", "1.2"}], ",", " ", 
       RowBox[{"EdgeStyle", " ", "->", " ", 
        RowBox[{"GrayLevel", "[", "0.6", "]"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<step \>\"", " ", "<>", " ", 
