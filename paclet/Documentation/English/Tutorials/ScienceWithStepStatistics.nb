Cell["\<\
The same at step 10 over vertex sets and over edge sets, and the cosine \
similarity of the vertex sets:\
\>", "Text",
 CellID->412518898,ExpressionUUID->"5900aac7-5263-773e-0f3f-43a167165a04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{
      RowBox[{"Last", "[", "pairs", "]"}], "[", "\"\<StateMatrices\>\"", 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ArrayPlot", "[", 
          RowBox[{
           RowBox[{"m", "[", "#1", "]"}], ",", " ", 
           RowBox[{
           "ColorFunction", " ", "->", " ", "\"\<TemperatureMap\>\""}], ",", 
           " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
           RowBox[{"PlotLabel", " ", "->", " ", "#2"}], ",", " ", 
           RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}], " ", "&"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<StateMutualInformation\>\"", ",", 
            " ", "\"\<StateEdgeMutualInformation\>\"", ",", 
            " ", "\"\<StateCosineSimilarity\>\""}], "}"}], ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<vertex mutual information\>\"", ",", 
            " ", "\"\<edge mutual information\>\"", ",", 
            " ", "\"\<cosine similarity\>\""}], "}"}]}], "}"}]}], "]"}], 
      "}"}], ",", " ", 
     RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->543971654,ExpressionUUID->"06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],

