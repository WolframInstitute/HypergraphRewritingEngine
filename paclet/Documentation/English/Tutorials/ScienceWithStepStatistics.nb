Cell[TextData[{
 "Does a growth rule settle at a fixed dimension? ",
 Cell[BoxData[
  RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " keeps 20 transitions, and so 20 states, at each step:"
}], "Text",
 CellID->141959522,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"growth", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"history", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"growth", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", "200", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[5]:= ",
 CellID->299517738,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

