        RowBox[{"st", ",", " ", 
         RowBox[{
          RowBox[{"st", "[", "\"\<Step\>\"", "]"}], " ", "==", " ", "s"}]}], 
        "]"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"action", ",", " ", "target"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
