Cell["\<\
The quantiles of the vertex curvature of the Brill-Lindquist run:\
\>", "Text",
 CellID->525088789,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "blackHoles", ",", " ", "\"\<VertexInvariants\>\"", ",", 
       " ", "\"\<OllivierRicciCurvature\>\"", ",", " ", "q"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<P10\>\"", ",", " ", "\"\<Q1\>\"", ",", 
         " ", "\"\<Median\>\"", ",", " ", "\"\<Q3\>\"", ",", 
         " ", "\"\<P90\>\""}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<curvature\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<10th percentile\>\"", ",", " ", "\"\<first quartile\>\"", ",",
       " ", "\"\<median\>\"", ",", " ", "\"\<third quartile\>\"", ",", 
      " ", "\"\<90th percentile\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
