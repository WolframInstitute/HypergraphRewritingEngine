 RowBox[{
  RowBox[{
   RowBox[{"history1", "[", 
    RowBox[{"{", 
     RowBox[{"rule_", ",", " ", "init_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"HGEvolve", "[", 
