Cell["Branches and the initial state", "Section",
 CellID->1939141443,ExpressionUUID->"2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],

Cell[TextData[{
 "How similar are the states at a step, and how much of the initial state do \
they keep? ",
 Cell[BoxData[
  RowBox[{"\"\<StepStatisticsBranchial\>\"", " ", "->", " ", "All"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 " adds the branchial graph measures and the overlap of the states' vertex \
sets. ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "400"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0daf8e98-7628-e40b-3b54-27c203c2cf51"],
 " keeps 400 states at each step:"
}], "Text",
 CellID->5047578,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"branches", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
       RowBox[{"\"\<Width\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Height\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "10", ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"\"\<StepStatisticsBranchial\>\"", " ", "->", " ", "All"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->15008895,ExpressionUUID->"7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],

Cell["\<\
The mean over every two states of their cosine similarity and their mutual \
information, and the mean over the states of their mutual information with \
the initial state, in bits. At step 0 the only state is the initial state, so \
every vertex is in both sets and the mutual information is 0:\
\>", "Text",
 CellID->1892712309,ExpressionUUID->"14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<StateCosineSimilarity\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<StateMutualInformation\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "branches", ",", " ", "\"\<InitialStateMutualInformation\>\"", ",", 
       " ", "\"\<Mean\>\""}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<cosine similarity\>\"", ",", 
      " ", "\"\<mutual information\>\"", ",", 
      " ", "\"\<mutual information with the initial state\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1439348928,ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],

