Cell["Particle-like defects", "Section",
 CellID->530919167,ExpressionUUID->"1acd7f4d-3da3-7753-4af3-7717b4565db9"],

Cell["\<\
A topological charge measures how far the neighbourhood of a vertex departs \
from a flat disc. A large charge that persists over many steps is a candidate \
for a particle-like structure:\
\>", "Text",
 CellID->1242319925,ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "grTorus", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<TopologicalChargeMax\>\"", ",", " ", "\"\<Mean\>\""}], "]"}],
      ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "grHoles", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<TopologicalChargeMax\>\"", ",", " ", "\"\<Mean\>\""}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<largest charge\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
