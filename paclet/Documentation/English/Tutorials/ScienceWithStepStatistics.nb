      RowBox[{
       RowBox[{"Values", "[", 
        RowBox[{"r", "[", "\"\<States\>\"", "]"}], "]"}], ",", " ", 
       RowBox[{"Function", "[", 
        RowBox[{"st", ",", " ", 
         RowBox[{
          RowBox[{"st", "[", "\"\<Step\>\"", "]"}], " ", "==", " ", "s"}]}], 
        "]"}]}], "]"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"{", 
       RowBox[{"action", ",", " ", "target"}], "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", " ", "4", ",", " ", "8", ",", " ", "12", ",", " ", "16"}], 
