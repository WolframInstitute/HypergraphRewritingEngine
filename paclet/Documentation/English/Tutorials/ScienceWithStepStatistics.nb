            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "+", " ", "2"}], ")"}], "/", "3"}]}], "]"}], 
          " ", "&"}], ",", " ", 
         RowBox[{"h", "/", 
          RowBox[{"Total", "[", "h", "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"10", ",", " ", "31"}], "]"}], ",", " ", "0"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
