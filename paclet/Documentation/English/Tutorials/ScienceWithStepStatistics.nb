           RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], "]"}], "[", 
        RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallScalarCurvature\>\"",
          ",", " ", "\"\<Mean\>\""}], "]"}]}], "}"}], ",", " ", 
