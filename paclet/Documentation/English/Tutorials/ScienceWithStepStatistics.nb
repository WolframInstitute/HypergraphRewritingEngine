        " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"run", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",",
        " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"run", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"torus", ",", " ", "\"\<torus\>\""}], "}"}], ",", " ", 
