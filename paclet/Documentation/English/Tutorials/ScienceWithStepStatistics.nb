       " ", "\"\<OllivierRicciCurvature\>\"", ",", " ", "q"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<P10\>\"", ",", " ", "\"\<Q1\>\"", ",", 
         " ", "\"\<Median\>\"", ",", " ", "\"\<Q3\>\"", ",", 
         " ", "\"\<P90\>\""}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
