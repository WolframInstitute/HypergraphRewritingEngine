Cell["The dimension of a causal graph", "Section",
 CellID->1191517648,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[TextData[{
 Cell[BoxData["coneDimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 " reads a dimension from the growth of forward causal cones. For each source \
event s, C(r) is the number of events within causal distance r of s, for r up \
to R, the largest distance reached. The dimension is the slope of log C(r) \
against log r over the middle half of the radii, R/4 to 3R/4, averaged over \
the sources with at least four radii in that range. The sources are a seeded \
sample of the first half of the events. ",
 Cell[BoxData["myrheimMeyer"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " reads a dimension from the fraction f of the pairs of events that are \
causally related. In an interval of d-dimensional Minkowski space the mean of \
f is \[CapitalGamma](d + 1) \[CapitalGamma](d/2) / (2 \[CapitalGamma](3d/2)), \
and the measure solves this for d, over the whole causal set and over sampled \
intervals of at least ",
 Cell[BoxData["minSize"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],
 " events. An interval is the set of events between two related events a and \
b, together with a and b."
}], "Text",
 CellID->960670710,ExpressionUUID->"0642d375-09f3-9942-2e71-cb3faf87eba8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"coneDimension", "[", 
    RowBox[{"pairs_List", ",", " ", "sources_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ev", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Flatten", "[", "pairs", "]"}], "]"}]}], ",", " ", "idx", ",",
        " ", "adj", ",", " ", "fits"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"ev", " ", "->", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "ev", "]"}], "]"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"adj", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{"idx", ",", " ", 
             RowBox[{"DeleteDuplicates", "[", "pairs", "]"}], ",", " ", 
             RowBox[{"{", "2", "}"}]}], "]"}], " ", "->", " ", "1"}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "ev", "]"}], ",", " ", 
           RowBox[{"Length", "[", "ev", "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"fits", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"seen", " ", "=", " ", 
              RowBox[{"SparseArray", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"idx", "[", "s", "]"}], " ", "->", " ", "1"}], 
                 "}"}], ",", " ", 
                RowBox[{"Length", "[", "ev", "]"}]}], "]"}]}], ",", " ", 
             "front", ",", " ", 
             RowBox[{"sizes", " ", "=", " ", 
              RowBox[{"{", "1", "}"}]}], ",", " ", "rMax", ",", " ", "radii", 
             ",", " ", "c"}], "}"}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"front", " ", "=", " ", "seen"}], ";", "\n", "      ", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"front", " ", "=", " ", 
                 RowBox[{"SparseArray", "[", 
                  RowBox[{
                   RowBox[{"Unitize", "[", 
                    RowBox[{"front", " ", ".", " ", "adj"}], "]"}], " ", 
                   RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", "seen"}], ")"}]}], "]"}]}], ";",
                 " ", 
                RowBox[{
                 RowBox[{"Total", "[", "front", "]"}], " ", ">", " ", "0"}]}],
                ")"}], ",", " ", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"sizes", ",", " ", 
                 RowBox[{"Total", "[", "front", "]"}]}], "]"}], ";", " ", 
               RowBox[{"seen", " ", "+=", " ", "front"}]}]}], "]"}], ";", 
            "\n", "      ", 
            RowBox[{"rMax", " ", "=", " ", 
             RowBox[{
              RowBox[{"Length", "[", "sizes", "]"}], " ", "-", " ", "1"}]}], ";",
             " ", 
            RowBox[{"c", " ", "=", " ", 
             RowBox[{"Accumulate", "[", "sizes", "]"}]}], ";", "\n", "      ", 
            RowBox[{"radii", " ", "=", " ", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"Ceiling", "[", 
                  RowBox[{"rMax", "/", "4"}], "]"}]}], "]"}], ",", " ", 
               RowBox[{"Floor", "[", 
                RowBox[{"3", " ", 
                 RowBox[{"rMax", "/", "4"}]}], "]"}]}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "radii", "]"}], " ", "<", " ", "4"}], ",",
               " ", "Nothing", ",", " ", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"Fit", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Log", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{"{", 
                    RowBox[{"#", ",", " ", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}]}], "}"}], 
                    "]"}], "]"}], " ", "&"}], " ", "/@", " ", "radii"}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], 
                 "]"}], ",", " ", "x"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n",
          "    ", 
         RowBox[{"{", 
          RowBox[{"s", ",", " ", "sources"}], "}"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"fits", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"Missing", "[", "\"\<NoCone\>\"", "]"}], ",", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Sources\>\"", " ", "->", " ", 
           RowBox[{"Length", "[", "fits", "]"}]}], ",", " ", 
          RowBox[{"\"\<Mean\>\"", " ", "->", " ", 
           RowBox[{"Mean", "[", "fits", "]"}]}], ",", " ", 
          RowBox[{"\"\<StandardDeviation\>\"", " ", "->", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "fits", "]"}], " ", ">", " ", "1"}], ",",
              " ", 
             RowBox[{"StandardDeviation", "[", "fits", "]"}], ",", " ", 
             "0."}], "]"}]}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coneDimension", "[", 
    RowBox[{"pairs_List", ",", " ", "k_Integer", ",", " ", "seed_Integer"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ev", " ", "=", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Flatten", "[", "pairs", "]"}], "]"}], "]"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"coneDimension", "[", 
      RowBox[{"pairs", ",", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"ev", ",", " ", 
             RowBox[{"Ceiling", "[", 
              RowBox[{
               RowBox[{"Length", "[", "ev", "]"}], "/", "2"}], "]"}]}], "]"}],
            ",", " ", 
           RowBox[{"UpTo", "[", "k", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mmDimension", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"f", " ", ">=", " ", "1"}], ",", " ", "1.", ",", " ", 
     RowBox[{"f", " ", "<=", " ", "0"}], ",", " ", "Indeterminate", ",", " ", 
     "True", ",", " ", 
     RowBox[{"d", " ", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"d", " ", "+", " ", "1"}], "]"}], " ", 
          RowBox[{
           RowBox[{"Gamma", "[", 
            RowBox[{"d", "/", "2"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"3", " ", 
               RowBox[{"d", "/", "2"}]}], "]"}]}], ")"}]}]}], " ", "==", " ", 
         "f"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "2.", ",", " ", "0.3", ",", " ", "20."}], 
         "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"myrheimMeyer", "[", 
    RowBox[{
    "pairs_List", ",", " ", "k_Integer", ",", " ", "minSize_Integer", ",", 
     " ", "seed_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{"DirectedEdge", " ", "@@@", " ", 
          RowBox[{"Sort", "[", "pairs", "]"}]}], "]"}]}], ",", " ", "order", ",",
        " ", "idx", ",", " ", "n", ",", " ", "desc", ",", " ", "anc", ",", 
       " ", "bits", ",", " ", 
       RowBox[{"iv", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"tries", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"order", " ", "=", " ", 
       RowBox[{"TopologicalSort", "[", "g", "]"}]}], ";", " ", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"Length", "[", "order", "]"}]}], ";", " ", 
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{"order", " ", "->", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"n", " ", "-", " ", "1"}]}], "]"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"desc", " ", "=", " ", 
       RowBox[{"anc", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "n"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"desc", "[", 
          RowBox[{"[", 
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"BitOr", " ", "@@", " ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "^", "#"}], " ", "+", " ", 
                RowBox[{"desc", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}]}], ")"}], 
              " ", "&"}], " ", "/@", " ", 
             RowBox[{"(", 
              RowBox[{"idx", " ", "/@", " ", 
               RowBox[{"VertexOutComponent", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"order", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 
                 RowBox[{"{", "1", "}"}]}], "]"}]}], ")"}]}], ",", " ", "0"}],
            "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}], ",", " ", "0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"anc", "[", 
          RowBox[{"[", 
           RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"BitOr", " ", "@@", " ", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "^", "#"}], " ", "+", " ", 
                RowBox[{"anc", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}]}], ")"}], 
              " ", "&"}], " ", "/@", " ", 
             RowBox[{"(", 
              RowBox[{"idx", " ", "/@", " ", 
               RowBox[{"VertexInComponent", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"order", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                 
                 RowBox[{"{", "1", "}"}]}], "]"}]}], ")"}]}], ",", " ", "0"}],
            "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"bits", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"x", ",", " ", "2"}], "]"}], "]"}], ",", " ", "1"}], 
          "]"}], "]"}], " ", "-", " ", "1"}]}], ";", "\n", "  ", 
      RowBox[{"BlockRandom", "[", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "iv", "]"}], " ", "<", " ", "k"}], " ", "&&",
            " ", 
           RowBox[{
            RowBox[{"tries", "++"}], " ", "<", " ", 
            RowBox[{"50", " ", "k"}]}]}], ",", "\n", "    ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", " ", "=", " ", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", 
                  RowBox[{"Floor", "[", 
                   RowBox[{"n", "/", "2"}], "]"}]}], "}"}], "]"}]}], ",", " ",
               "later", ",", " ", "b", ",", " ", "mask", ",", " ", 
              "members"}], "}"}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"later", " ", "=", " ", 
              RowBox[{"bits", "[", 
               RowBox[{"desc", "[", 
                RowBox[{"[", 
                 RowBox[{"a", " ", "+", " ", "1"}], "]"}], "]"}], "]"}]}], ";",
              "\n", "      ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "later", "]"}], " ", ">=", " ", 
                "minSize"}], ",", "\n", "        ", 
               RowBox[{
                RowBox[{"b", " ", "=", " ", 
                 RowBox[{"RandomChoice", "[", 
                  RowBox[{"Take", "[", 
                   RowBox[{"later", ",", " ", 
                    RowBox[{"-", 
                    RowBox[{"Floor", "[", 
                    RowBox[{
                    RowBox[{"Length", "[", "later", "]"}], "/", "2"}], 
                    "]"}]}]}], "]"}], "]"}]}], ";", "\n", "        ", 
                RowBox[{"mask", " ", "=", " ", 
                 RowBox[{"BitOr", "[", 
                  RowBox[{
                   RowBox[{"BitAnd", "[", 
                    RowBox[{
                    RowBox[{"desc", "[", 
                    RowBox[{"[", 
                    RowBox[{"a", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"anc", "[", 
                    RowBox[{"[", 
                    RowBox[{"b", " ", "+", " ", "1"}], "]"}], "]"}]}], "]"}], 
                   ",", " ", 
                   RowBox[{"2", "^", "a"}], ",", " ", 
                   RowBox[{"2", "^", "b"}]}], "]"}]}], ";", " ", 
                RowBox[{"members", " ", "=", " ", 
                 RowBox[{"bits", "[", "mask", "]"}]}], ";", "\n", "        ", 
                
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", "members", "]"}], " ", ">=", " ", 
                   "minSize"}], ",", " ", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"iv", ",", " ", 
                    RowBox[{"mmDimension", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"DigitCount", "[", 
                    RowBox[{
                    RowBox[{"BitAnd", "[", 
                    RowBox[{
                    RowBox[{"desc", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ",
                     "mask"}], "]"}], ",", " ", "2", ",", " ", "1"}], "]"}], 
                    " ", "&"}], " ", "/@", " ", "members"}], "]"}], "/", 
                    RowBox[{"Binomial", "[", 
                    RowBox[{
                    RowBox[{"Length", "[", "members", "]"}], ",", " ", "2"}], 
                    "]"}]}], "]"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}]}], 
           "]"}]}], "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<WholeSet\>\"", " ", "->", " ", 
         RowBox[{"mmDimension", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"DigitCount", "[", 
                RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}], " ", 
               "&"}], " ", "/@", " ", "desc"}], "]"}], "/", 
            RowBox[{"Binomial", "[", 
             RowBox[{"n", ",", " ", "2"}], "]"}]}], "]"}], "]"}]}], ",", " ", 
        
        RowBox[{"\"\<Intervals\>\"", " ", "->", " ", 
         RowBox[{"Length", "[", "iv", "]"}]}], ",", " ", 
        RowBox[{"\"\<IntervalMedian\>\"", " ", "->", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"iv", " ", "===", " ", 
            RowBox[{"{", "}"}]}], ",", " ", 
           RowBox[{"Missing", "[", "\"\<NoInterval\>\"", "]"}], ",", " ", 
           RowBox[{"Median", "[", "iv", "]"}]}], "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[45]:= ",
 CellID->1307080411,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
A chain of 300 events, the forward cone of radius 60 on the lattice where \
event (t, x) precedes (t + 1, x - 1) and (t + 1, x + 1), and 300 points \
sprinkled in a causal diamond of 1+1-dimensional Minkowski space give \
dimensions 1, 2 and 2:\
\>", "Text",
 CellID->1960030258,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"i", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "299"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lattice", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"1000", " ", "t"}], " ", "+", " ", "x"}], ",", " ", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{"(", 
              RowBox[{"t", " ", "+", " ", "1"}], ")"}]}], " ", "+", " ", "x", 
            " ", "-", " ", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"1000", " ", "t"}], " ", "+", " ", "x"}], ",", " ", 
           RowBox[{
            RowBox[{"1000", " ", 
             RowBox[{"(", 
              RowBox[{"t", " ", "+", " ", "1"}], ")"}]}], " ", "+", " ", "x", 
            " ", "+", " ", "1"}]}], "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "59"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "61"}], ",", " ", "61"}], "}"}]}], "]"}], ",", " ", 
     "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diamond", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2000", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Abs", "[", "#", "]"}], "]"}], " ", "<", " ", "1"}], 
             " ", "&"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", " ", "300"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"p", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
             RowBox[{"p", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", " ", "1"}], "]"}], "]"}]}], " ", ">", " ", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", " ", "2"}], "]"}], "]"}], " ", "-", " ", 
              RowBox[{"p", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", "Nothing"}], "]"}],
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "300"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "300"}], "}"}]}], "]"}], ",", " ", "1"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"Round", "[", 
    RowBox[{"100", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"coneDimension", "[", 
         RowBox[{"chain", ",", " ", "50", ",", " ", "1"}], "]"}], 
        "[", "\"\<Mean\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"coneDimension", "[", 
         RowBox[{"lattice", ",", " ", 
          RowBox[{"{", "0", "}"}]}], "]"}], "[", "\"\<Mean\>\"", "]"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"myrheimMeyer", "[", 
         RowBox[{"diamond", ",", " ", "20", ",", " ", "30", ",", " ", "1"}], 
         "]"}], "[", "\"\<WholeSet\>\"", "]"}]}], "}"}]}], "]"}], "/", 
   "100"}], "]"}]}], "Input",
 CellLabel->"In[46]:= ",
 CellID->49629080,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.99`", ",", "1.89`", ",", "2.01`"}], "}"}]], "Output",
 CellLabel->"Out[46]= ",
 CellID->1161543684,ExpressionUUID->"4c440104-ea8a-4285-747b-99618f3f10ef"]
}, Open  ]],

Cell["\<\
At a finite radius the cone measure is below the dimension. The same lattice \
gives 1.97 at radius 200, and the lattices with two and three spatial \
dimensions give 2.76 at radius 40 and 3.08 at radius 12.\
\>", "Text",
 CellID->1167207179,ExpressionUUID->"66c9a615-af45-c085-0ef6-385ecaf192ef"],

Cell["\<\
The cone measure does not reproduce the dimension of a sprinkled causal set, \
so it is not a dimension measure for causal sets. On the link graphs of 500 \
to 5000 points sprinkled in a causal diamond, it gives 3.00 to 4.21 in 1+1 \
dimensions. In 2+1 and 3+1 dimensions no cone has four radii in the middle \
half of its radii, and the measure has no value. The whole-set Myrheim-Meyer \
value of the same sprinklings gives 1.94 to 2.01 in 1+1 dimensions, 2.94 to \
2.97 in 2+1 and 3.96 to 4.09 in 3+1. The interval median gives 1.93 to 1.99, \
2.81 to 2.89 and 3.31 to 3.60.\
\>", "Text",
 CellID->1612953718,ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"],

Cell["Gorard's binary black hole merger", "Section",
 CellID->790826209,ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"],

Cell[TextData[{
 "J. Gorard, Hypergraph Discretization of the Cauchy Problem in General \
Relativity via Wolfram Model Evolution, arXiv:2102.09363v2 (2021), compares a \
numerical solution of the Einstein field equations with an evolution under ",
 Cell[BoxData["ruleA"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " alone. The paper states that this evolution, from Brill-Lindquist initial \
data for two black holes, reproduces the merger of the two holes by t = 12M \
and the ringdown of the merged hole by t = 24M, at 200, 400, 800 and 1600 \
vertices."
}], "Text",
 CellID->1163030741,ExpressionUUID->"5f7f2999-1aee-25a5-0504-c0c39e988f8f"],

Cell["\<\
The paper states the setup. Two Schwarzschild black holes of mass 0.5M each \
are 1M apart, with their centre of mass at the centre of the domain. A \
Poisson process of density \[Rho]c places the vertices, and two vertices are \
joined when they are closer than a cut-off defined relative to Vc = \
1/\[Rho]c. The numerical runs of the same paper use a periodic domain of side \
20M.\
\>", "Text",
 CellID->1753119213,ExpressionUUID->"128c7526-c883-085d-42b4-6c83e9365aa7"],

Cell["\<\
The paper applies the rule at each step to every match that shares no \
hyperedge with another match applied in the step. It does not state the value \
of the cut-off, the number of steps per unit of t, the order among matches \
that share a hyperedge, or the direction of each edge.\
\>", "Text",
 CellID->2037256,ExpressionUUID->"3279c00f-c9e2-8758-6206-da68ef94eda2"],

Cell[TextData[{
 "The runs here use the three-dimensional ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 " cloud of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Generated Initial Conditions"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
InitialConditions"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " in a periodic box of side 20, with a cut-off of c times the mean spacing \
(8000/n)^(1/3) and edges in random directions. ",
 Cell[BoxData[
  RowBox[{"\"\<Generational\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " applies the update the paper describes. Each step applies every match that \
shares no hyperedge with a match before it in the standard order, so the \
evolution follows one history. From 200 points with c = 1.25, 105 steps reach \
10 events per edge of the initial state:"
}], "Text",
 CellID->339747688,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gorard", "[", 
    RowBox[{"n_", ",", " ", "c_", ",", " ", "seed_"}], "]"}], " ", ":=", " ", 
   
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<BrillLindquist\>\""}], ",", 
     " ", 
     RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<Periodic\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<Density\>\"", " ", "->", " ", "n"}], ",", " ", 
     RowBox[{"\"\<Mass1\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"\"\<Mass2\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"\"\<Separation\>\"", " ", "->", " ", "1."}], ",", " ", 
     RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<BoxZ\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
     RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", 
      RowBox[{"c", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"8000.", "/", "n"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}]}]}], ",", " ", 
     RowBox[{"\"\<Seed\>\"", " ", "->", " ", "seed"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"merger", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"gorard", "[", 
      RowBox[{"200", ",", " ", "1.25", ",", " ", "1"}], "]"}], ",", " ", 
     "105", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<StepStatistics\>\"", ",", " ", "\"\<CausalEdges\>\"", ",", 
       " ", "\"\<NumEvents\>\""}], "}"}], ",", " ", 
     RowBox[{"\"\<Generational\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<CausalTransitiveReduction\>\"", " ", "->", " ", "False"}], ",",
      " ", 
     RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", 
      RowBox[{"{", "\"\<VolumeGrowth\>\"", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{"ruleA", ",", " ", 
      RowBox[{"gorard", "[", 
       RowBox[{"200", ",", " ", "1.25", ",", " ", "1"}], "]"}], ",", " ", "0",
       ",", " ", "\"\<GlobalEdges\>\""}], "]"}], "]"}], ",", " ", 
   RowBox[{"merger", "[", "\"\<NumEvents\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[47]:= ",
 CellID->1291277978,ExpressionUUID->"3f64ca0d-9927-5f44-651b-ec5718d225ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"877", ",", "8829"}], "}"}]], "Output",
 CellLabel->"Out[47]= ",
 CellID->936680601,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"]
}, Open  ]],

