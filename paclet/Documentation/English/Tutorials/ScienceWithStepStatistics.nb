Cell["Curvature readings near two black holes", "Section",
 CellID->966663717,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell["\<\
The evolutions of the section on free space and a gravitational field, run \
again with every measure, compare three readings of curvature: ball growth, \
sphere growth, and the transport curvature of edges with no idleness:\
\>", "Text",
 CellID->634665076,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measured", "[", "spec_", "]"}], " ", ":=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "ruleA", ",", " ", "spec", ",", " ", "40", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", "All"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grTorus", " ", "=", " ", 
   RowBox[{"measured", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Torus\>\""}], ",", " ", 
      RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "9"}], ",", " ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"grHoles", " ", "=", " ", 
   RowBox[{"measured", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<BrillLindquist\>\""}], ",",
       " ", 
      RowBox[{"\"\<Density\>\"", " ", "->", " ", "80"}], ",", " ", 
      RowBox[{"\"\<Separation\>\"", " ", "->", " ", "6."}], ",", " ", 
      RowBox[{"\"\<BoxX\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
      RowBox[{"\"\<BoxY\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10."}], ",", " ", "10."}], "}"}]}], ",", " ", 
      RowBox[{"\"\<EdgeThreshold\>\"", " ", "->", " ", "3.5"}], ",", " ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"perStep", "[", 
          RowBox[{
          "grTorus", ",", " ", "\"\<Invariants\>\"", ",", " ", "key", ",", 
           " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
         RowBox[{"perStep", "[", 
          RowBox[{
          "grHoles", ",", " ", "\"\<Invariants\>\"", ",", " ", "key", ",", 
           " ", "\"\<Mean\>\""}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<step\>\"", ",", " ", "None"}], "}"}]}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", "key"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], 
         "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"key", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<BallScalarCurvature\>\"", ",", 
         " ", "\"\<SphereScalarCurvature\>\"", ",", 
         " ", "\"\<NonLazyOllivierRicciCurvature\>\""}], "}"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]}], "Input",
 CellLabel->"In[33]:= ",
 CellID->532971963,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

