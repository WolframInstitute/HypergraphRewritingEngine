Cell["\<\
The ball dimension, the sphere dimension and the dimension of the largest \
component of the spatial hypergraph at each step:\
\>", "Text",
 CellID->151045137,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
       RowBox[{"merger", "[", "\"\<StepStatistics\>\"", "]"}], ",", 
       " ", "\"\<Invariants\>\"", ",", " ", "key", ",", " ", "\"\<Mean\>\""}],
       "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"key", ",", " ", 
       RowBox[{"{", 
