Cell["Curvature on a spectral embedding", "Section",
 CellID->1358080856,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[TextData[{
 "Where on a state does the curvature sit, and how does it move as the state \
grows? ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeVertexCurvature\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 " adds ",
 Cell[BoxData["\"\<VertexCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " to each state record: each vertex with a neighbour and its Ollivier-Ricci \
curvature. ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 " follows one history of rule A from the grid:"
}], "Text",
 CellID->320615307,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"history", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Grid\>\""}], ",", " ", 
       RowBox[{"\"\<Width\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Height\>\"", " ", "->", " ", "8"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "30", ",", " ", "\"\<States\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<IncludeVertexCurvature\>\"", " ", "->", " ", "True"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "history", "]"}]}], "Input",
 CellLabel->"In[29]:= ",
 CellID->326840490,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

Cell[BoxData["31"], "Output",
 CellLabel->"Out[29]= ",
 CellID->459072551,ExpressionUUID->"08285353-0e0e-39f8-3828-4b1dabb88bc2"]
}, Open  ]],

Cell[TextData[{
 "The graph of a state joins the consecutive vertices of each hyperedge; ",
 Cell[BoxData["Rest"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 " drops the edge id at the front of each edge. ",
 Cell[BoxData["GraphEmbedding"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " with ",
 Cell[BoxData["\"\<SpectralEmbedding\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " places each vertex at the coordinates of three eigenvectors of the graph \
Laplacian, and each point is coloured by the vertex's curvature from blue \
(the state's lowest) to red (its highest):"
}], "Text",
 CellID->2002505366,ExpressionUUID->"5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stateGraph", "[", "state_", "]"}], " ", ":=", " ", 
   RowBox[{"Graph", "[", 
    RowBox[{"UndirectedEdge", " ", "@@@", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Sort", " ", "/@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Catenate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}], " ", "&"}], 
           " ", "/@", " ", 
           RowBox[{"(", 
            RowBox[{"Rest", " ", "/@", " ", 
             RowBox[{"state", "[", "\"\<Edges\>\"", "]"}]}], ")"}]}], "]"}], ",",
          " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "=!=", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"embedding", "[", "state_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"stateGraph", "[", "state", "]"}]}], "}"}], ",", " ", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "0.025", "]"}], ",", " ", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{"GraphEmbedding", "[", 
            RowBox[{
            "g", ",", " ", "\"\<SpectralEmbedding\>\"", ",", " ", "3"}], 
            "]"}], ",", " ", 
           RowBox[{"VertexColors", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}], "[", 
                RowBox[{"Rescale", "[", 
                 RowBox[{"#", ",", " ", 
                  RowBox[{"MinMax", "[", 
                   RowBox[{"Values", "[", 
                    RowBox[{"state", "[", "\"\<VertexCurvature\>\"", "]"}], 
                    "]"}], "]"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
              
              RowBox[{"Lookup", "[", 
               RowBox[{
                RowBox[{"state", "[", "\"\<VertexCurvature\>\"", "]"}], ",", 
                " ", 
                RowBox[{"VertexList", "[", "g", "]"}], ",", " ", "0"}], 
               "]"}]}], ")"}]}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"Boxed", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<step \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", 
          RowBox[{"state", "[", "\"\<Step\>\"", "]"}], "]"}]}]}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "220"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"embedding", "[", 
      RowBox[{"SelectFirst", "[", 
       RowBox[{
        RowBox[{"Values", "[", "history", "]"}], ",", " ", 
        RowBox[{"Function", "[", 
         RowBox[{"st", ",", " ", 
          RowBox[{
           RowBox[{"st", "[", "\"\<Step\>\"", "]"}], " ", "==", " ", "#"}]}], 
         "]"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "15", ",", " ", "30"}], "}"}]}], ",", " ", 
   RowBox[{"Spacer", "[", "10", "]"}]}], "]"}]}], "Input",
 CellLabel->"In[30]:= ",
 CellID->1049544165,ExpressionUUID->"112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],

