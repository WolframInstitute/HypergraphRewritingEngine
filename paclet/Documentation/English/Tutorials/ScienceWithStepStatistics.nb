           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}]}], 
       "}"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"history1", "[", 
    RowBox[{"{", 
     RowBox[{"rule_", ",", " ", "init_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "300", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
