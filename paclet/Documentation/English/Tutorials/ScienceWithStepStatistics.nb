Cell["Cost-guided evolution", "Section",
 CellID->1828403510,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[TextData[{
 Cell[BoxData["\"\<StateCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 " gives each state a cost computed from its ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 " statistics, and with ",
 Cell[BoxData[
  RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "N"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 " each step keeps its N successor states of lowest cost. The evolution is a \
beam search through the multiway system. Three beams of width 3 follow rule A \
from the torus for 16 steps. The first minimises the mean ",
 Cell[BoxData["\"\<BallScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " of a state times its number of vertices, a discrete Einstein-Hilbert \
action. The changes of a statistic summed along a history equal its change \
from the first state to the last, so ranking the states of a step by \
curvature ranks their histories by the summed change of curvature. The second \
keeps the states whose ",
 Cell[BoxData["\"\<BallDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " is closest to 2.5. The third has no cost and keeps the lowest-ranked \
states:"
}], "Text",
 CellID->623026911,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"beam", "[", "cost_", "]"}], " ", ":=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"ruleA", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Torus\>\""}], ",", " ", 
       RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "9"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", 
     "16", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<States\>\"", ",", " ", "\"\<StepStatistics\>\""}], "}"}], ",",
      " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
     RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"\"\<StateCost\>\"", " ", "->", " ", "cost"}], ",", " ", 
     RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", 
      RowBox[{"{", "\"\<VolumeGrowth\>\"", "}"}]}], ",", " ", 
     RowBox[{"\"\<StepStatisticsWeighting\>\"", " ", "->", 
      " ", "\"\<Classes\>\""}], ",", " ", 
     RowBox[{"\"\<IncludeVertexCurvature\>\"", " ", "->", " ", "True"}], ",", 
     " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"action", ",", " ", "target", ",", " ", "plain"}], "}"}], " ", "=",
    " ", 
   RowBox[{"beam", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"#BallScalarCurvature", " ", "#VertexCount"}], " ", "&"}], ",",
       " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#BallDimension", " ", "-", " ", "2.5"}], "]"}], " ", "&"}], ",",
       " ", "None"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"Length", " ", "/@", " ", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"action", ",", " ", "target", ",", " ", "plain"}], "}"}], ",", 
    " ", "\"\<StepStatistics\>\""}], "]"}]}]}], "Input",
 CellLabel->"In[42]:= ",
 CellID->723594610,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"17", ",", "17", ",", "17"}], "}"}]], "Output",
 CellLabel->"Out[42]= ",
 CellID->357325492,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"]
}, Open  ]],

Cell["\<\
The mean over each step's kept states of the ball scalar curvature, which the \
first cost reads, and of the ball dimension, which the second cost reads:\
\>", "Text",
 CellID->387004599,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

