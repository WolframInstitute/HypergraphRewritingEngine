Cell[TextData[{
 "In a notebook, ",
 Cell[BoxData[
  RowBox[{"ListAnimate", "[", 
   RowBox[{"embedding", " ", "/@", " ", 
    RowBox[{"SortBy", "[", 
     RowBox[{
      RowBox[{"Values", "[", "history", "]"}], ",", " ", 
      RowBox[{"#Step", " ", "&"}]}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
