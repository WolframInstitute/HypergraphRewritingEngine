Cell["\<\
Each column of this plot is the curvature histogram of one step, shaded by \
the fraction of the vertices in each bin:\
\>", "Text",
 CellID->29467524,ExpressionUUID->"7b6211f5-475c-1194-2911-88bf72e963fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"curvatureColumn", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"s", "[", 
        RowBox[{"\"\<VertexInvariants\>\"", ",", 
         " ", "\"\<OllivierRicciCurvature\>\"", ",", 
         " ", "\"\<Histogram\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"KeyMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{"32", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", "+", " ", "2"}], ")"}], "/", "3"}]}], "]"}], 
          " ", "&"}], ",", " ", 
         RowBox[{"h", "/", 
          RowBox[{"Total", "[", "h", "]"}]}]}], "]"}], ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"10", ",", " ", "31"}], "]"}], ",", " ", "0"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ArrayPlot", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
