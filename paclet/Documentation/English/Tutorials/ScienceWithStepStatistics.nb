Cell["Dimension of a growth history", "Section",
 CellID->1641200340,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "Does a growth rule settle at a fixed dimension? ",
 Cell[BoxData[
  RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "20"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " keeps 20 states at each step:"
}], "Text",
 CellID->1424533854,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"growth", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"history", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"growth", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", "200", ",", 
     " ", "\"\<StepStatistics\>\"", ",", " ", 
     RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->535457321,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["\<\
The mean over the step's states of the Wolfram-Hausdorff dimension, and of \
the largest local dimension of a vertex in each state:\
\>", "Text",
 CellID->141959522,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "history", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<WolframHausdorffDimension\>\"", ",", " ", "\"\<Mean\>\""}], 
      "]"}], ",", " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "history", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<LocalDimensionMax\>\"", ",", " ", "\"\<Mean\>\""}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<dimension\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<mean over vertices\>\"", ",", 
      " ", "\"\<largest vertex\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",
