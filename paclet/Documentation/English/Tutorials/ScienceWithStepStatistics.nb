Cell[TextData[{
 Cell[BoxData["\"\<BallGrowthDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " maps each radius r to the summary over the states of the dimension \
measured from the growth of balls between radius r - 1 and r. The mean at \
steps 50, 100 and 200:"
}], "Text",
 CellID->1164297175,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", 
          RowBox[{"#2", "[", "\"\<Mean\>\"", "]"}]}], "}"}], " ", "&"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"history", "[", 
         RowBox[{"[", 
          RowBox[{"s", " ", "+", " ", "1"}], "]"}], "]"}], 
        "[", "\"\<BallGrowthDimension\>\"", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", 
       RowBox[{"{", 
        RowBox[{"50", ",", " ", "100", ",", " ", "200"}], "}"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<radius\>\"", ",", " ", "\"\<dimension\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step 50\>\"", ",", " ", "\"\<step 100\>\"", ",", 
      " ", "\"\<step 200\>\""}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1574941706,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

