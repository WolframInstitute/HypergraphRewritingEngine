         " ", "\"\<OllivierRicciCurvature\>\"", ",", 
         " ", "\"\<Histogram\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"Lookup", "[", 
      RowBox[{
       RowBox[{"KeyMap", "[", 
        RowBox[{
