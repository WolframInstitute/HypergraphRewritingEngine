Cell["The dimension of a causal set", "Section",
 CellID->2143439988,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell["\<\
A sprinkling places random points in a box of Minkowski spacetime and joins \
causally related points. The dimensions read from graph distances differ from \
the spacetime dimension, because the undirected graph of causal links loses \
the time order that fixes the dimension of a causal set:\
\>", "Text",
 CellID->1933756212,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"s", " ", "=", " ", 
           RowBox[{"zeroStep", "[", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Sprinkling\>\""}], 
              ",", " ", 
              RowBox[{"\"\<SpatialDim\>\"", " ", "->", " ", "k"}], ",", " ", 
              RowBox[{"\"\<Density\>\"", " ", "->", " ", "250"}], ",", " ", 
              RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], 
            "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", " ", "+", " ", "1"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\"", ",",
              " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", 
             " ", "\"\<RiemannianBallDimension\>\"", ",", 
             " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
           RowBox[{"s", "[", 
            
            RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<SphereDimension\>\"",
              ",", " ", "\"\<Mean\>\""}], "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<spacetime dimension\>\"", ",", 
       " ", "\"\<ball (counting)\>\"", ",", " ", "\"\<ball (Riemannian)\>\"", 
       ",", " ", "\"\<sphere\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->1104768546,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"spacetime dimension\"\>", "\<\"ball (counting)\"\>", "\<\"ball \
(Riemannian)\"\>", "\<\"sphere\"\>"},
    {"2", "2.5281423813761332`", "2.544479816976248`", "3.692326132174396`"},
    {"3", "3.864686636760613`", "1.6873376466096317`", "5.432447912109441`"},
    {"4", "4.202524286959633`", "1.6201837979851659`", "5.852229336950175`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellLabel->"Out[36]= ",
 CellID->1942365842,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"]
}, Open  ]],

Cell["Shortest paths and the continuum", "Section",
 CellID->865519937,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"],

Cell["\<\
Two points of a continuum have one shortest path, and two vertices of a \
lattice have exponentially many. The fraction of vertex pairs joined by one \
shortest path rises if evolution makes space more like a continuum:\
\>", "Text",
 CellID->845186625,ExpressionUUID->"01ed6b92-5a5f-fa78-3792-82dc5febc942"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"perStep", "[", 
      RowBox[{
      "grTorus", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<GeodeticFraction\>\"", ",", " ", "\"\<Mean\>\""}], "]"}], ",",
      " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "grHoles", ",", " ", "\"\<Invariants\>\"", ",", 
       " ", "\"\<GeodeticFraction\>\"", ",", " ", "\"\<Mean\>\""}], "]"}]}], 
    "}"}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<step\>\"", ",", " ", "\"\<geodetic fraction\>\""}], "}"}]}],
    ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<torus\>\"", ",", " ", "\"\<Brill-Lindquist\>\""}], "}"}]}], 
   ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->711076509,ExpressionUUID->"107fa29c-d013-1000-4004-3bd9e1a6636a"],

