       " ", "\"\<OllivierMoranI\>\"", ",", " ", "\"\<Mean\>\""}], "]"}], ",", 
     " ", 
     RowBox[{"perStep", "[", 
      RowBox[{
      "blackHoles", ",", " ", "\"\<Invariants\>\"", ",", 
