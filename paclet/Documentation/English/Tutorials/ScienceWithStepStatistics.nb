Cell["The distribution of curvature", "Section",
 CellID->1930159659,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[TextData[{
 "How is curvature spread over the vertices of all branches at a step? ",
 Cell[BoxData["\"\<VertexInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " pools the vertices of every state at the step. The quantiles of the vertex \
curvature of the Brill-Lindquist run:"
}], "Text",
 CellID->1113655915,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[CellGroupData[{

Cell[BoxData[
