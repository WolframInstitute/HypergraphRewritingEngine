Notebook[{

Cell[CellGroupData[{
Cell["Continuing an Evolution with Sessions", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " runs an evolution from the initial state every time it is called, so \
asking for one more step repeats every step before it. A session keeps the \
evolution in the engine: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 " opens it, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 " evolves it further from where it stopped, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " reads it, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionFrontier"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionFrontier", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " lists the states the next step expands, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionClose"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionClose", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " releases it."
}], "Text",
 CellID->329621944,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["Evolving step by step", "Section",
 CellID->515379898,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 "This rule splits an edge in two. A state with ",
 StyleBox["k", "TI"],
 " edges has ",
 StyleBox["k", "TI"],
 " successors, so the number of states grows quickly with the depth:"
}], "Text",
 CellID->604760901,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"init", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "k", ",", " ", "\"\<NumStates\>\""}],
     "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->214672358,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "4", ",", "10", ",", "34", ",", "154"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->985978867,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"]
}, Open  ]],

Cell["\<\
Each of those runs started again from the initial state. A session starts at \
step 0 and keeps what it has explored:\
\>", "Text",
 CellID->448336599,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", "init", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionQuery", "[", "session", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1653674069,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"NumStates\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",
 CellID->1350357703,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"]
}, Open  ]],

Cell[TextData[{
 "Each step continues from the last, and after ",
 StyleBox["k", "TI"],
 " steps the session holds what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " gives for ",
 StyleBox["k", "TI"],
 " steps:"
}], "Text",
 CellID->1377816002,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "2"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->293863717,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "1"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "10"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "9"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",
 CellID->1063680002,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"]
}, Open  ]],

Cell["\<\
A step can give a property the session was not opened for, and a query reads \
any property without evolving:\
\>", "Text",
 CellID->1641200340,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "1", ",", " ", "\"\<NumCausalEdges\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"HGSessionQuery", "[", 
    RowBox[{"session", ",", " ", "\"\<NumCausalEdges\>\""}], "]"}], ",", "\n",
    " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "4", ",", 
     " ", "\"\<NumCausalEdges\>\""}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1873367150,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"32", ",", "32", ",", "32"}], "}"}]], "Output",
 CellLabel->"Out[4]= ",
 CellID->432061762,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"]
}, Open  ]],

Cell["One session at a time", "Section",
 CellID->535457321,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["\<\
The engine worker holds one session for each device, so a second session is \
refused until the first is closed:\
\>", "Text",
 CellID->141959522,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGSessionOpen", "[", 
  RowBox[{"rules", ",", " ", "init", ",", " ", "\"\<NumStates\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->404018434,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGSessionOpen", "::", "refused"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
   "The", " ", "engine", " ", "refused", " ", "this", " ", "session", " ", 
    RowBox[{"job", ".", " ", "The"}], " ", "usual", " ", 
    RowBox[{"causes", ":", " ", 
     RowBox[{
     "a", " ", "session", " ", "is", " ", "already", " ", "open", " ", "on", " ",
       "this", " ", "worker", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "one", " ", "is", " ", "served", " ", "at", " ", "a", " ", "time"}], ",",
         " ", 
        RowBox[{
        "so", " ", "close", " ", "it", " ", "before", " ", "opening", " ", 
         "another"}]}], ")"}]}]}]}], ",", " ", 
   RowBox[{
   "or", " ", "the", " ", "verb", " ", "named", " ", "a", " ", "session", " ",
     "this", " ", "worker", " ", "does", " ", "not", " ", 
    RowBox[{"hold", "."}]}]}]}]], "Message", "MSG",
 CellID->1173503211,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[5]= ",
 CellID->1234659522,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"HGSessionClose", "[", "session", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->2142391071,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell["A closed session cannot be read or stepped:", "Text",
 CellID->1002769646,ExpressionUUID->"3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"session", ",", " ", "1"}], "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->804706604,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGSessionOpen", "::", "refused"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
   "The", " ", "engine", " ", "refused", " ", "this", " ", "session", " ", 
    RowBox[{"job", ".", " ", "The"}], " ", "usual", " ", 
    RowBox[{"causes", ":", " ", 
     RowBox[{
     "a", " ", "session", " ", "is", " ", "already", " ", "open", " ", "on", " ",
       "this", " ", "worker", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "one", " ", "is", " ", "served", " ", "at", " ", "a", " ", "time"}], ",",
         " ", 
        RowBox[{
        "so", " ", "close", " ", "it", " ", "before", " ", "opening", " ", 
         "another"}]}], ")"}]}]}]}], ",", " ", 
   RowBox[{
   "or", " ", "the", " ", "verb", " ", "named", " ", "a", " ", "session", " ",
     "this", " ", "worker", " ", "does", " ", "not", " ", 
    RowBox[{"hold", "."}]}]}]}]], "Message", "MSG",
 CellID->1372406984,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[7]= ",
 CellID->1156789572,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"]
}, Open  ]],

Cell["Expanding part of the frontier", "Section",
 CellID->2122865143,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["\<\
The frontier is the set of states the next step expands. After two steps it \
holds the two states at depth 2:\
\>", "Text",
 CellID->1735808809,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", "init", ",", " ", "\"\<NumStates\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"session", ",", " ", "2"}], "]"}], ";"}], "\n", 
 RowBox[{"frontier", " ", "=", " ", 
  RowBox[{"Sort", "[", 
   RowBox[{"HGSessionFrontier", "[", "session", "]"}], "]"}]}]}], "Input",
 CellLabel->"In[8]:= ",
 CellID->372695887,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[8]= ",
 CellID->507457312,ExpressionUUID->"1f908cf3-3c70-d55a-45af-25bdb50abfa0"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " expands only the states it names. Expanding one of the two adds its three \
successors:"
}], "Text",
 CellID->1164297175,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"session", ",", " ", "1", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Last", "[", "frontier", "]"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->1574941706,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[9]= ",
 CellID->1742547996,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"]
}, Open  ]],

Cell["The state left out stays on the frontier:", "Text",
 CellID->1689610856,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sort", "[", 
  RowBox[{"HGSessionFrontier", "[", "session", "]"}], "]"}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->1772006941,ExpressionUUID->"4ebf3687-f906-130d-7644-afe0f8b37e57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "5", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[10]= ",
 CellID->163441777,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"]
}, Open  ]],

Cell[TextData[{
 "A step without ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 " expands every frontier state up to the new depth, including the state left \
out, so the session again holds the depth-4 evolution:"
}], "Text",
 CellID->2098230307,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "4", ",", " ", "\"\<NumStates\>\""}],
     "]"}], ",", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"HGSessionFrontier", "[", "session", "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->2012614976,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"34", ",", "34", ",", "24"}], "}"}]], "Output",
 CellLabel->"Out[11]= ",
 CellID->1280971458,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"HGSessionClose", "[", "session", "]"}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->1113655915,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],

Cell["Sending only what a step added", "Section",
 CellID->1606118752,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "A graph property sends every state and edge again at each step. With ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 ", the engine sends only what it has not sent before, and the graph returned \
is still the whole evolution:"
}], "Text",
 CellID->2141499446,ExpressionUUID->"2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "\"\<StatesGraphStructure\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"session", ",", " ", "3"}], "]"}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"VertexCount", "[", 
    RowBox[{"HGSessionStep", "[", 
     RowBox[{"session", ",", " ", "1", ",", " ", 
      RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]}], "]"}], 
    "]"}], ",", "\n", " ", 
   RowBox[{"VertexCount", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "rules", ",", " ", "init", ",", " ", "4", ",", 
      " ", "\"\<StatesGraphStructure\>\""}], "]"}], "]"}]}], "}"}]}], "Input",\

 CellLabel->"In[13]:= ",
 CellID->806976103,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"34", ",", "34"}], "}"}]], "Output",
 CellLabel->"Out[13]= ",
 CellID->1474971991,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"HGSessionClose", "[", "session", "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->432388834,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

Cell["Identifying isomorphic states", "Section",
 CellID->443736588,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "Options are fixed when the session opens. With ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 ", states that differ only in the names of their vertices are one state, and \
the 154 states of depth 5 are 6:"
}], "Text",
 CellID->1593449978,ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"session", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "\"\<NumStates\>\"", ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"session", ",", " ", "5"}], "]"}], ",", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rules", ",", " ", "init", ",", " ", "5", ",", " ", "\"\<NumStates\>\"", ",",
      " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
    "]"}]}], "}"}]}], "Input",
 CellLabel->"In[15]:= ",
 CellID->470259450,ExpressionUUID->"644cc522-c7c4-9b18-0c73-dc8ff276e662"],

Cell[BoxData[
 RowBox[{"{", 
