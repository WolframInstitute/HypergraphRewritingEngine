   RowBox[{"edgeData", "[", "\"\<GlobalEdges\>\"", "]"}], ",", " ", "2"}], 
  "]"}]], "Input",
 CellLabel->"In[31]:= ",
 CellID->1897815756,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

Cell[BoxData[
