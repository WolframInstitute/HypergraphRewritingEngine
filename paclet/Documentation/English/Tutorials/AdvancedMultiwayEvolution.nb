Cell[TextData[{
 "Edge ids start at 0 and the store is in id order, so a state's edges are \
the store entries at its ids plus 1. They are the ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " of the state's record, for every state:"
}], "Text",
 CellID->14312863,ExpressionUUID->"72ff7667-e560-b2c0-2285-68408c1a002a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AllTrue", "[", 
  RowBox[{
   RowBox[{"Keys", "[", 
    RowBox[{"edgeData", "[", "\"\<States\>\"", "]"}], "]"}], ",", " ", 
   RowBox[{"Function", "[", 
    RowBox[{"id", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"edgeData", "[", "\"\<GlobalEdges\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"edgeData", "[", "\"\<StateBitvectors\>\"", "]"}], "[", 
          "id", "]"}], " ", "+", " ", "1"}], "]"}], "]"}], " ", "===", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"edgeData", "[", "\"\<States\>\"", "]"}], "[", "id", "]"}], 
       "[", "\"\<Edges\>\"", "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[36]:= ",
 CellID->885490610,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[36]= ",
 CellID->749689765,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"]
}, Open  ]],

Cell["\<\
A state and its successor hold the same id for an edge the event did not \
touch. The seven states hold 24 edges between them, from 20 distinct edges:\
\>", "Text",
 CellID->1751204118,ExpressionUUID->"7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"edgeData", "[", "\"\<StateBitvectors\>\"", "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[37]:= ",
 CellID->1176841719,ExpressionUUID->"304452a4-201b-d64c-607c-4b0e51afbc96"],

Cell[BoxData["24"], "Output",
 CellLabel->"Out[37]= ",
 CellID->1950773862,ExpressionUUID->"6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"]
}, Open  ]],

Cell["\<\
Two edges are held by three states each, a state and its two successors:\
\>", "Text",
 CellID->530919167,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"Values", " ", "@", " ", 
    RowBox[{"Counts", " ", "@", " ", 
     RowBox[{"Catenate", " ", "@", " ", 
      RowBox[{"Values", " ", "@", " ", 
       RowBox[{"edgeData", "[", "\"\<StateBitvectors\>\"", "]"}]}]}]}]}], ",",
    " ", 
   RowBox[{"GreaterThan", "[", "1", "]"}]}], "]"}]], "Input",
 CellLabel->"In[38]:= ",
 CellID->1776146427,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "3"}], "}"}]], "Output",
 CellLabel->"Out[38]= ",
 CellID->1271561344,ExpressionUUID->"2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"]
}, Open  ]],

Cell["The causal relation", "Section",
 CellID->1600082692,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell[TextData[{
 "An event causally precedes another when the other consumes an edge it \
produced. ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20a7420b-376a-b23f-505d-6455421c0105"],
 " lists the pairs, with the producer as ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6af863a9-1098-c609-1a98-7af3a112ad53"],
 " and the consumer as ",
 Cell[BoxData["\"\<To\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "055bc2ad-6b92-a3be-3378-dbf70e24f184"],
 "; ",
 Cell[BoxData["\"\<RawFrom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " and ",
 Cell[BoxData["\"\<RawTo\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " are the ids of the individual applications, equal to ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " and ",
 Cell[BoxData["\"\<To\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " when events are not identified:"
}], "Text",
 CellID->1091979148,ExpressionUUID->"160f17c4-d31a-fe19-3e34-8ea1e6acc563"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{"HGEvolve", "[", 
