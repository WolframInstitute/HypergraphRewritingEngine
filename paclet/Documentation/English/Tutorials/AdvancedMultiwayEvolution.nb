Cell[TextData[{
 "Each ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " class lies inside one isomorphism class, so ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " never identifies two states that ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 " keeps apart:"
}], "Text",
 CellID->5047578,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

