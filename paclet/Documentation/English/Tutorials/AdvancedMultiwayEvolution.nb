   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[24]:= ",
 CellID->961694572,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

