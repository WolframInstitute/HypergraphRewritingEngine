     TraditionalForm], TraditionalForm]},
  "Legended",
  DisplayFunction->(GridBox[{{
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"], 
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, GridBoxItemSize -> Automatic, 
    BaselinePosition -> {1, 1}]& ),
  Editable->True,
  InterpretationFunction->(RowBox[{"Legended", "[", 
     RowBox[{#, ",", 
       RowBox[{"Placed", "[", 
         RowBox[{#2, ",", "After"}], "]"}]}], "]"}]& )]], "Output",
 CellLabel->"Out[65]= ",
 CellID->848867935,ExpressionUUID->"4b734859-75e7-efa6-7901-62030393b58c"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ae31c17-eefa-a706-7a90-96508a8c0a6c"],
 " thins the transitions of each rule separately; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sampling and Pruning the Multiway System"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
SamplingAndPruning"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "00844d77-2817-3ec6-30bc-653149a3842c"],
 "."
}], "Text",
 CellID->1113110913,ExpressionUUID->"20b97f64-b973-0c8a-5047-774e380656d0"],

Cell["Reproducibility", "Section",
 CellID->39476879,ExpressionUUID->"04469009-6b02-dcc3-2c7d-0a530eb4a629"],

Cell["\<\
The states, events and relations are determined by the rules, the initial \
states, the number of steps and the options, and do not depend on the number \
of threads or the order in which they run. The ids are assigned in the order \
states, events and edges are created, so two runs can give the same state \
different ids and list a relation in a different order. Compare runs by \
counts and canonical hashes.\
\>", "Text",
 CellID->1462859254,ExpressionUUID->"4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"],

Cell["Two runs give the same counts:", "Text",
 CellID->1067972408,ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<Debug\>\""}], 
   "]"}], " ", "===", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<Debug\>\""}], 
   "]"}]}]], "Input",
 CellLabel->"In[66]:= ",
 CellID->1702887294,ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[66]= ",
 CellID->1232690428,ExpressionUUID->"451364b5-819d-fb99-7321-7dff3029c9e3"]
}, Open  ]],

Cell["Another run reaches the same classes:", "Text",
 CellID->214787233,ExpressionUUID->"13b49e24-0fb7-4441-414b-178eaa422eab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<CanonicalHash\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{
      "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<States\>\"", ",",
        " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
       " ", 
       RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
      "]"}]}]}]}], " ", "===", " ", "classes"}]], "Input",
 CellLabel->"In[67]:= ",
 CellID->255743676,ExpressionUUID->"445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[67]= ",
 CellID->2135948075,ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"]
}, Open  ]],

Cell[TextData[{
 "The sampling options keep this property when a ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48fccab3-b886-a0f7-7883-e3fd3930f2dd"],
 " is set; the caps by arrival order do not. Both are described in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sampling and Pruning the Multiway System"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
SamplingAndPruning"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "0cdaad60-2181-5e26-34f9-454a5034250c"],
 "."
}], "Text",
 CellID->1022435225,ExpressionUUID->"542cff75-84e0-b601-7dd3-f73f2c9a1d6b"],

