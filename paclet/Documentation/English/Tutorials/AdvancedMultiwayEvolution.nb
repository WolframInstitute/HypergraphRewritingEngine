Cell[TextData[{
 "The initial edges are produced by a genesis event, which is left out by \
default. ",
 Cell[BoxData[
  RowBox[{"\"\<ShowGenesisEvents\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 " includes it, with rule index 65535, no consumed edges and the initial \
edges produced:"
}], "Text",
 CellID->1589358908,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

