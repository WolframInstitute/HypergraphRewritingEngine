Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{"S", 0}, {"S", 1}, {"S", 3}, {"S", 4}, {"E", 0}, {"E", 2}, {
       "E", 3}}, {{{5, 2}, {6, 3}, {7, 4}}, {{1, 5}, {2, 6}, {2, 
       7}}, {<|"EventId" -> 0|>, <|"EventId" -> 0|>, <|"EventId" -> 2|>, <|
        "EventId" -> 2|>, <|"EventId" -> 3|>, <|"EventId" -> 3|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {
        DirectedEdge[{"E", 3}, {"S", 4}, <|"EventId" -> 3|>] -> Placed[
           Row[{"Event ", 3}], Tooltip], 
         DirectedEdge[{"E", 2}, {"S", 3}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         UndirectedEdge[{"S", 1}, {"E", 2}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         UndirectedEdge[{"S", 1}, {"E", 3}, <|"EventId" -> 3|>] -> Placed[
           Row[{"Event ", 3}], Tooltip], 
         UndirectedEdge[{"S", 0}, {"E", 0}, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip]}, 
       EdgeStyle -> {
        DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], 
         DirectedEdge[{"E", 3}, {"S", 4}, <|"EventId" -> 3|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], 
         UndirectedEdge[{"S", 1}, {"E", 3}, <|"EventId" -> 3|>] -> Directive[
           GrayLevel[0.5]], 
