Cell[TextData[{
 "The chain rule creates a new vertex at every event, so no two of its states \
have the same edge list. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " identifies none of its states, and ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 " reduces 154 states to 6:"
}], "Text",
 CellID->1892712309,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

