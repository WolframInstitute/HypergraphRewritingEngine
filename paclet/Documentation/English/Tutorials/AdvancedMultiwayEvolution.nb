Cell["\<\
The classes of two runs combined are the union of their hash sets.\
\>", "Text",
 CellID->1570109414,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell["The edge store", "Section",
 CellID->746824257,ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"],

Cell["\<\
Every state is a set of edges from one store of all edges the evolution \
created. Asking for the properties together gives ids from one run:\
\>", "Text",
 CellID->966663717,ExpressionUUID->"7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"edgeData", " ", "=", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"rule", ",", " ", "init", ",", " ", "2", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<States\>\"", ",", " ", "\"\<GlobalEdges\>\"", ",", 
       " ", "\"\<StateBitvectors\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->1320129761,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"States\"\>", ",", "\<\"GlobalEdges\"\>", 
   ",", "\<\"StateBitvectors\"\>"}], "}"}]], "Output",
 CellLabel->"Out[30]= ",
 CellID->1479724538,ExpressionUUID->"362a4e41-4988-041f-5e2a-602b683d6f65"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<GlobalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " lists every edge once as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"id", ",", " ", "v1", ",", " ", "v2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 ", in id order, starting with the two initial edges:"
}], "Text",
 CellID->1607396713,ExpressionUUID->"6798df62-4cc7-e4e1-0da7-d74c6573cecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Take", "[", 
