Cell["The canonical hash across runs", "Section",
 CellID->1358080856,ExpressionUUID->"657c1c65-980e-511d-1303-964f19bb2067"],

Cell[TextData[{
 "State ids are assigned in the order states are found, so another run, or a \
run from a relabeled initial state, numbers its states differently. The ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " depends only on the isomorphism class, so it is the same in every run."
}], "Text",
 CellID->320615307,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[TextData[{
 "The hashes of the seven classes at three steps, kept as ",
 Cell[BoxData["classes"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 ":"
}], "Text",
 CellID->1594238871,ExpressionUUID->"1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"classes", " ", "=", " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"Values", "[", 
      RowBox[{"HGEvolve", "[", 
       RowBox[{
       "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<States\>\"", ",",
         " ", 
        RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
        " ", 
        RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
       "]"}], "]"}], ",", " ", "\"\<CanonicalHash\>\""}], "]"}]}]}]], "Input",\

 CellLabel->"In[26]:= ",
 CellID->961869727,ExpressionUUID->"370294fd-9e49-2d35-5d31-0da71bfc741f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "3456209204954656657"}], ",", 
   RowBox[{"-", "2510968229161682807"}], ",", 
   RowBox[{"-", "2510405279208606450"}], ",", 
   RowBox[{"-", "2052257726680550281"}], ",", 
   RowBox[{"-", "1880196251657875627"}], ",", 
   RowBox[{"-", "864756329166671601"}], ",", "5070671360234372917"}], 
  "}"}]], "Output",
 CellLabel->"Out[26]= ",
 CellID->263842116,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"]
}, Open  ]],

Cell["\<\
The same evolution from the initial state with other vertex names reaches the \
same classes:\
\>", "Text",
 CellID->2121396920,ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<CanonicalHash\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{"rule", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "8"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"7", ",", " ", "9"}], "}"}]}], "}"}], ",", " ", "3", ",", 
       " ", "\"\<States\>\"", ",", " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
       " ", 
       RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
      "]"}]}]}]}], " ", "===", " ", "classes"}]], "Input",
 CellLabel->"In[27]:= ",
 CellID->655171200,ExpressionUUID->"594776df-9e75-d16a-0f7d-6f991b01a3b0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[27]= ",
 CellID->1043022705,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"]
}, Open  ]],

Cell["\<\
A run of two steps from the triangle, the state after the first step:\
\>", "Text",
 CellID->50259360,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fromTriangle", " ", "=", " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{
    RowBox[{"Lookup", "[", "\"\<CanonicalHash\>\"", "]"}], " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{"rule", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "2", ",", 
       " ", "\"\<States\>\"", ",", " ", 
       RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
       " ", 
       RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
      "]"}]}]}]}]}]], "Input",
 CellLabel->"In[28]:= ",
 CellID->1719857260,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"],

