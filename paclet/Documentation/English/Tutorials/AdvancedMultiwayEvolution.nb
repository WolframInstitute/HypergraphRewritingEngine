Cell[TextData[{
 "Under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " there are 7 states, and parallel edges are separate applications between \
the same two classes:"
}], "Text",
