Notebook[{

Cell[CellGroupData[{
Cell["Advanced Multiway Evolution", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "The states, events and relations ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " reports depend on two settings: ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 ", which selects when two states are one state, and ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 ", which selects when two applications of a rule are one event. This \
tutorial shows how each output follows from these settings, and covers the \
canonical hash, the edge store, the causal and branchial relations, quotient \
exploration and several rules. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Getting Started with Hypergraph Rewriting"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/GettingStarted"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " introduces the properties used here."
}], "Text",
 CellID->329621944,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["The example", "Section",
 CellID->515379898,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell["\<\
The rule matches two edges from a common vertex and adds the edge that closes \
the triangle:\
\>", "Text",
 CellID->604760901,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rule", " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->214672358,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->985978867,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"]
}, Open  ]],

Cell["The initial state is the rule's left side:", "Text",
 CellID->448336599,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"init", " ", "=", " ", 
