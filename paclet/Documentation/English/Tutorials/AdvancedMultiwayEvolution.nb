Cell["\<\
The ids after the initial edges are assigned in the order edges are created, \
so another run can give the same ids to other vertex pairs.\
\>", "Text",
 CellID->2143439988,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell[TextData[{
 Cell[BoxData["\"\<StateBitvectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],
 " gives the ids each state holds. The initial state holds the first two:"
}], "Text",
 CellID->1933756212,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell[CellGroupData[{

Cell[BoxData[
