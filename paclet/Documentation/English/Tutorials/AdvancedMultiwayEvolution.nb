Cell["\<\
An event's identity is built from components that do not change when vertices \
are renamed: the canonical input state, the canonical output state, the step, \
the rule, and the positions of the consumed and produced edges in the \
canonical labeling of their states.\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"07359582-e823-44a1-2eca-0cef89d62e8b"],

Cell[TextData[{
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 " uses no component, so every application is its own event."
}], "Item",
 CellID->670734585,ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"],

Cell[TextData[{
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6184d2f2-049e-728e-17bb-cbbcad2b40d4"],
 " uses the input and output states."
}], "Item",
 CellID->58232708,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19bb1c5e-57ab-6e36-4f58-9618625e351c"],
 " uses the states, the step and both edge position lists."
}], "Item",
 CellID->393464600,ExpressionUUID->"5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],

Cell[TextData[{
 Cell[BoxData["\"\<Positional\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " uses the same components as ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52535901-cb26-8b9c-0261-516aeed0d9e6"],
 ", with edge positions read from each state's own labeling, as the ",
 Cell[BoxData["MultiwaySystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "323a4b1c-b138-a791-63da-6359c0b20dfb"],
 " function of the Wolfram Multicomputation paclet does."
}], "Item",
 CellID->1484396876,ExpressionUUID->"7421cf44-a1ac-4319-1dde-e721d0592e63"],

Cell["The number of events at three steps under each setting:", "Text",
 CellID->1149283354,ExpressionUUID->"511b3347-8d7d-ab60-0738-ab212409f64a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<NumEvents\>\"", ",",
      " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
     RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "mode"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"mode", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "None", ",", " ", "Full", ",", " ", "Automatic", ",", 
       " ", "\"\<Positional\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->232671466,ExpressionUUID->"36c19c85-764d-0b01-5efe-15ef03f8566b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"18", ",", "7", ",", "10", ",", "11"}], "}"}]], "Output",
 CellLabel->"Out[21]= ",
 CellID->636028256,ExpressionUUID->"6815cd54-0cd7-196f-182a-e51ea5626bb5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " needs ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 ", which computes the canonical labelings. The ",
 Cell[BoxData["\"\<Positional\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 " identity depends on the labeling the canonicalizer picks for each state, \
so it is reproducible for fixed inputs but changes when the initial state is \
relabeled."
}], "Text",
 CellID->559599970,ExpressionUUID->"12d95fcb-3316-2212-42e7-569546a37178"],

Cell["\<\
A list of components selects another identity. With the rule only, every \
application is one event, since there is one rule:\
\>", "Text",
 CellID->1710123944,ExpressionUUID->"733995c2-f5bf-78ee-22c6-0caffc4a4a34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<NumEvents\>\"", ",",
    " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", 
    RowBox[{"{", "\"\<Rule\>\"", "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[22]:= ",
 CellID->1156395434,ExpressionUUID->"4f8ab258-7e7f-0723-7589-34027b0a6a09"],

Cell[BoxData["1"], "Output",
 CellLabel->"Out[22]= ",
 CellID->317740183,ExpressionUUID->"6b12ee74-9953-131d-1921-003e18e67e67"]
}, Open  ]],

Cell["\<\
With the input state and the rule, there is one event for each class the rule \
is applied to:\
\>", "Text",
 CellID->284780108,ExpressionUUID->"65262d3c-fccc-1dc6-0cdd-c579f579672c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "rule", ",", " ", "init", ",", " ", "3", ",", " ", "\"\<NumEvents\>\"", ",",
    " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<InputState\>\"", ",", " ", "\"\<Rule\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[23]:= ",
 CellID->278671595,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell[BoxData["4"], "Output",
