Cell["Choosing what comes back", "Section",
 CellID->2098230307,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "The fourth argument selects the result. The graph properties are ",
 Cell[BoxData["\"\<StatesGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ", ",
 Cell[BoxData["\"\<CausalGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 ", ",
 Cell[BoxData["\"\<BranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 ", ",
 Cell[BoxData["\"\<EvolutionGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 ", ",
 Cell[BoxData["\"\<EvolutionCausalGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 ", ",
 Cell[BoxData["\"\<EvolutionBranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 " and the default ",
 Cell[BoxData["\"\<EvolutionCausalBranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 "."
}], "Text",
 CellID->1930159659,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "Each takes the suffix ",
 Cell[BoxData["Structure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " for the same graph with plain vertices, which draws faster:"
}], "Text",
