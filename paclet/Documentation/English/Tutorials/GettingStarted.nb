      AspectRatio -> 1, 
       EdgeLabels -> {
        DirectedEdge[{"E", 1}, {"S", 2}, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip], 
         DirectedEdge[{"E", 2}, {"S", 3}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         UndirectedEdge[{"S", 1}, {"E", 2}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
