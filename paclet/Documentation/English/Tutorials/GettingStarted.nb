Cell[TextData[{
 "Two events are branchially related when they were applied to the same state \
and consumed a common edge, so no single history contains both. ",
 Cell[BoxData["\"\<BranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " joins the two states such a pair of events produced. By default it shows \
the pairs of the final step:"
}], "Text",
 CellID->993357154,ExpressionUUID->"4b5b9263-9199-4e16-7978-144d202c157c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "triangle", ",", " ", "twoEdges", ",", " ", "3", ",", 
   " ", "\"\<BranchialGraph\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "540"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "4"}]}]}], "]"}]], "Input",
 CellLabel->"In[25]:= ",
 CellID->1256055991,ExpressionUUID->"475d7054-346c-a3cc-6d63-6a1ebd1ef116"],

