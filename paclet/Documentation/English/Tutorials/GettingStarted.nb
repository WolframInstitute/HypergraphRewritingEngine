Cell["Generated initial conditions and the GPU", "Section",
 CellID->865519937,ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"],

Cell[TextData[{
 "A string names a generated initial condition, shaped by options of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 ". The triangle rule on a 4 by 4 grid:"
}], "Text",
 CellID->845186625,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "triangle", ",", " ", "\"\<Grid\>\"", ",", " ", "1", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<GridWidth\>\"", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"\"\<GridHeight\>\"", " ", "->", " ", "4"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[34]:= ",
 CellID->711076509,ExpressionUUID->"1170384d-2f38-2c50-470f-b2174acd76ba"],

Cell[BoxData["33"], "Output",
 CellLabel->"Out[34]= ",
 CellID->1381970688,ExpressionUUID->"6ce33075-6d34-44a7-1490-aa3f04c12e8d"]
}, Open  ]],

Cell[TextData[{
 "The families are ",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 ", ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ", ",
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 ", ",
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 ", ",
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 ", ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 " (also ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 "), ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e490f1-5bc8-e939-619b-09bb5e62b803"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 " and ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Generated Initial Conditions"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
InitialConditions"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "15eb24b6-b946-3a65-43e8-bdf038f0894f"],
 " describes them."
}], "Text",
 CellID->315698450,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " runs the evolution on the GPU engine, which gives the same result as the \
CPU; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Evolving on the GPU"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/GPUEvolution"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 ":"
}], "Text",
 CellID->1751204118,ExpressionUUID->"0c5e608e-35dc-f74f-3466-79e8bc6edd95"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "triangle", ",", " ", "twoEdges", ",", " ", "5", ",", 
    " ", "\"\<NumStates\>\"", ",", " ", 
    RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], "]"}], 
  " ", "===", " ", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{
   "triangle", ",", " ", "twoEdges", ",", " ", "5", ",", 
    " ", "\"\<NumStates\>\""}], "]"}]}]], "Input",
