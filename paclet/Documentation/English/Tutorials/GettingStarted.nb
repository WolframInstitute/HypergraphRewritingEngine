Cell[TextData[{
 "The engine numbers vertices from 0 in order of first appearance and edges \
from 0 in order of creation, so the initial edge ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 " is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],
 ", edge 0 from vertex 0 to vertex 1:"
}], "Text",
 CellID->1593449978,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

