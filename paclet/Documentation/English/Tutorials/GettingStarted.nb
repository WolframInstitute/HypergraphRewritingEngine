Cell["A rule from the Wolfram Physics Project", "Section",
 CellID->1607396713,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
This rule replaces two edges from a common vertex by the first of them and \
three edges that meet at a new vertex:\
\>", "Text",
 CellID->171231949,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"physicsRule", " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[30]:= ",
 CellID->710532704,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

