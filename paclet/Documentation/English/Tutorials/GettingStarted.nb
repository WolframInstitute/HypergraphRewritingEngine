Cell["\<\
The vertices of a rule may be symbols. The chain rule written with symbols \
reaches the same ten states:\
\>", "Text",
 CellID->941376513,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "y"}], "}"}]}], "}"}]}], ",", " ", "oneEdge", ",",
    " ", "3", ",", " ", "\"\<NumStates\>\""}], "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->218200256,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell[BoxData["10"], "Output",
 CellLabel->"Out[15]= ",
 CellID->1147471427,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"]
}, Open  ]],

Cell["Identifying states", "Section",
 CellID->1047559317,ExpressionUUID->"7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],

Cell["\<\
The number of states grows with the number of histories. For the chain rule, \
the number of states at steps 0 to 5:\
\>", "Text",
 CellID->1820947576,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"HGEvolve", "[", 
    RowBox[{
    "chain", ",", " ", "oneEdge", ",", " ", "k", ",", 
     " ", "\"\<NumStates\>\""}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->1782161217,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "4", ",", "10", ",", "34", ",", "154"}], 
  "}"}]], "Output",
 CellLabel->"Out[16]= ",
 CellID->1762861669,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"]
}, Open  ]],

Cell[TextData[{
 "Step ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " adds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " states, one for each order in which the edges were split, and each is a \
path of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " edges."
}], "Text",
 CellID->58232708,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[TextData[{
 "Under the default ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "None"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 ", two histories that produce the same hypergraph give two states. A rule \
that duplicates an edge, applied to two equal edges, matches twice and \
produces the same three edges twice. The two states have the same ",
 Cell[BoxData["\"\<ContentStateId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " and different ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ":"
}], "Text",
 CellID->393464600,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[CellGroupData[{

Cell[BoxData[
