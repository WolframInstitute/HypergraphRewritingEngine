Notebook[{

Cell[CellGroupData[{
Cell["Getting Started with Hypergraph Rewriting", "Title",
 CellID->509267359,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 "A hypergraph is a list of hyperedges. A rewrite rule replaces the \
hyperedges that match its left side by those of its right side. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 " applies a rule to a hypergraph in every possible way for a number of \
steps, and gives the states reached, the events between them, and the causal \
and branchial relations between the events."
}], "Text",
 CellID->329621944,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Hypergraphs and rules", "Section",
 CellID->515379898,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\<\
A hyperedge is an ordered list of vertices. A hyperedge may have any number \
of vertices, and the same hyperedge may occur more than once.\
\>", "Text",
 CellID->604760901,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["A hypergraph with one binary edge from vertex 1 to vertex 2:", "Text",
 CellID->1476799103,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"oneEdge", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->871438681,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1135287974,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"]
}, Open  ]],

Cell[TextData[{
 "A rewrite rule is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 " whose two sides are hypergraphs. The vertices of a rule are pattern \
variables. A vertex on both sides is kept by every application, and a vertex \
only on the right is created by every application."
}], "Text",
 CellID->970785311,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["\<\
The chain rule replaces one edge by a path of two edges through a new vertex:\
\
\>", "Text",
 CellID->1377816002,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chain", " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->293863717,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}]], "Output",
 CellLabel->"Out[2]= ",
 CellID->1063680002,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"]
}, Open  ]],

Cell[TextData[{
 "A binary hyperedge is a directed edge, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " can draw each side of the rule:"
}], "Text",
 CellID->1641200340,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"DirectedEdge", " ", "@@@", " ", "#"}], ",", " ", 
      RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}], ",", " ", 
      RowBox[{"ImageSize", " ", "->", " ", "Small"}]}], "]"}], " ", "&"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"First", "[", "chain", "]"}], ",", " ", 
     RowBox[{"Last", "[", "chain", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->1873367150,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

