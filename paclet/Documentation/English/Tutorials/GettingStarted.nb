     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "y"}], "}"}]}], "}"}]}], ",", " ", "oneEdge", ",",
    " ", "3", ",", " ", "\"\<NumStates\>\""}], "]"}]], "Input",
