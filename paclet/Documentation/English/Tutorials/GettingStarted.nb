    "chain", ",", " ", "oneEdge", ",", " ", "k", ",", " ", "\"\<NumStates\>\"",
      ",", " ", 
     RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[18]:= ",
