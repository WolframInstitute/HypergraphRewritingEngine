Cell[TextData[{
 "With no ",
 StyleBox["prop", "TI"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " gives the evolution graph with the causal and branchial edges, ",
 Cell[BoxData["\"\<EvolutionCausalBranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 ". An orange causal edge runs from an event to a later event that consumed \
an edge it produced. A pink branchial edge joins two events applied to the \
same state that consumed a common edge. The chain rule has no branchial \
edges, since each of its events consumes one edge and no two matches share \
one:"
}], "Text",
 CellID->1689610856,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

