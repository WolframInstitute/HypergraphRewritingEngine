Cell[TextData[{
 "Step ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " adds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " states, one for each order in which the edges were split, and each is a \
path of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " edges."
}], "Text",
 CellID->58232708,ExpressionUUID->"7e9b7e66-629a-1114-26b9-7040172f607e"],

Cell[TextData[{
 "Under the default ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "None"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 ", two histories that produce the same hypergraph give two states. A rule \
that duplicates an edge, applied to two equal edges, matches twice and \
produces the same three edges twice. The two states have the same ",
 Cell[BoxData["\"\<ContentStateId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " and different ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ":"
}], "Text",
 CellID->393464600,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

