Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " uses a faster content hash (which may merge some non-isomorphic states); \
",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 " is exact."
}], "Text",
 CellID->299517738,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["The canonical Wolfram Physics rule", "Section",
 CellID->2142391071,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["\<\
This is the rule from the Wolfram Physics Project. Its uncanonicalized \
multiway blows up quickly, so show the isomorphism-merged states graph:\
\>", "Text",
 CellID->1002769646,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

