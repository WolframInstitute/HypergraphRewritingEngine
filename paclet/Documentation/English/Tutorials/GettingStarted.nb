Cell["One step, then three", "Section",
 CellID->535457321,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " evolves the hypergraph ",
 StyleBox["init", "TI"],
 " under ",
 StyleBox["rules", "TI"],
 " for ",
 StyleBox["n", "TI"],
 " steps and gives the property ",
 StyleBox["prop", "TI"],
 ". ",
 Cell[BoxData["\"\<StatesGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " is the graph whose vertices are the states reached and whose edges are the \
events between them; each state is drawn as its hypergraph."
}], "Text",
 CellID->141959522,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell["\<\
One step of the chain rule from one edge has one match, so the states graph \
has the initial state and one successor:\
\>", "Text",
 CellID->299517738,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
  "chain", ",", " ", "oneEdge", ",", " ", "1", ",", " ", "\"\<StatesGraph\>\"",
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "200"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1064655499,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

