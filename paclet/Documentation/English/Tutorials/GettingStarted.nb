Cell[TextData[{
 "Every event is still an edge of the states graph, so under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 " several edges can join the same two states. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Advanced Multiway Evolution"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
AdvancedMultiwayEvolution"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 " compares the settings of ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
 " and ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12f3dbee-abc4-6375-4280-d2cbce714e5f"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Sampling and Pruning the Multiway System"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
SamplingAndPruning"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
 " describes the options that evolve part of a large system."
}], "Text",
 CellID->559599970,ExpressionUUID->"2cfa2c34-ef50-7d46-5499-c6718ae547ac"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 " identifies states with the same edge list, without renaming vertices; \
these are the classes ",
 Cell[BoxData["\"\<ContentStateId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " numbers. It never identifies two states that ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " keeps apart. The two states of the duplicating rule are one state under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 ":"
}], "Text",
 CellID->1710123944,ExpressionUUID->"49f5450b-e8d1-97dd-7f8b-5d548965fd27"],

