Cell[TextData[{
 "The second argument is the initial state (a list of hyperedges); the third \
is the number of steps. By default ",
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " returns the combined evolution/causal/branchial graph."
}], "Text",
 CellID->448336599,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell["Choosing what to return", "Section",
 CellID->970785311,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["\<\
Pass a property string as the fourth argument to select the output:\
\>", "Text",
 CellID->1377816002,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

