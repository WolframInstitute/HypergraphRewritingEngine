           Row[{"Event ", 1}], Tooltip]}, 
       EdgeStyle -> {
        DirectedEdge[{"E", 1}, {"S", 2}, <|"EventId" -> 1|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[0.02]], 
         DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[0.02]], 
         UndirectedEdge[{"S", 0}, {"E", 0}, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5]], 
