Cell[TextData[{
 Cell[BoxData["\"\<CausalGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " has the events as vertices, and a directed edge from an event to each \
later event that consumed an edge it produced. An edge implied by a longer \
causal path is dropped, since ",
 Cell[BoxData["\"\<CausalTransitiveReduction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 " is on by default."
}], "Text",
 CellID->1594238871,ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"],

Cell["\<\
The two events of step 1 both consume both initial edges, so neither follows \
the other, and each starts its own causal tree:\
\>", "Text",
 CellID->2002505366,ExpressionUUID->"106b7ad8-6378-599b-4069-7382160d2be1"],

