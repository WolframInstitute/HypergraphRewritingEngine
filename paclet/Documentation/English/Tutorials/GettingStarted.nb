   RowBox[{"AspectRatio", " ", "->", " ", "1"}]}], "]"}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1772006941,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

