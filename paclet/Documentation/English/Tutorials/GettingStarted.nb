Cell["Continuing an evolution", "Section",
 CellID->530919167,ExpressionUUID->"457602f1-d86e-ac86-730d-9bbad918f6ec"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 " runs the evolution from the initial state on every call. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 " opens an evolution that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " continues from where it stopped; see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Continuing an Evolution with Sessions"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/Sessions"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 "."
}], "Text",
 CellID->1242319925,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"],

