Notebook[{

Cell[CellGroupData[{
Cell["Hypergraph Rewriting", "GuideTitle",
 CellID->942062912,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["\<\
Multiway hypergraph rewriting applies a set of rules to a hypergraph in every \
possible way. The result is the set of states reached, the events between \
them, and the causal and branchial relations between the events. The paclet \
computes these in a separate engine process, on the CPU or the GPU, and gives \
them as graphs, records or counts.\
\>", "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"]
}, Open  ]],

