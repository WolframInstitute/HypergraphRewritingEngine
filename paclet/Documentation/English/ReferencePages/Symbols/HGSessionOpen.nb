Notebook[{

Cell[CellGroupData[{
Cell["HGSessionOpen", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionOpen"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "opens a multiway evolution of ",
 StyleBox["init", "TI"],
 " under ",
 StyleBox["rules", "TI"],
 " that can be continued, and gives an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 " whose steps report the property ",
 StyleBox["prop", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionOpen"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 "\[LineSeparator]",
 "opens a session whose steps report ",
 Cell[BoxData["\"\<EvolutionCausalBranchialGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 "."
}], "Usage",
 CellID->329621944,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell[TextData[{
 "A session is an evolution that is continued rather than run again. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 " evolves it further from where the last step stopped, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " reads it, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionFrontier"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionFrontier", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " lists the states the next step expands, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionClose"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionClose", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 " releases it."
}], "Notes",
 CellID->515379898,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 StyleBox["rules", "TI"],
 " and ",
 StyleBox["init", "TI"],
 " take the forms ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " takes: a rule or a list of rules; a hypergraph, a list of hypergraphs (one \
initial state each), a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 ", or a named initial condition such as ",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 "."
}], "Notes",
 CellID->604760901,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 StyleBox["prop", "TI"],
 " is a property ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 " accepts, or a list of properties. It sets what a step reports by default; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " can ask for any other property of the same evolution."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[TextData[{
 "The session starts at step 0: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " applies no rule. After steps totalling ",
 StyleBox["k", "TI"],
 ", the session reports what ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 " gives."
}], "Notes",
 CellID->448336599,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " takes the options of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 ", with the same defaults, and every option of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 ". They hold for the whole session: a step or a query cannot change the \
rules, how states and events are identified, the device, or the options of \
the graphs it gives."
}], "Notes",
 CellID->970785311,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 Cell[BoxData["\"\<BranchialStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " set to ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " is resolved for each step's or query's own properties, so a graph asked \
for later has the branchial edges ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " gives it."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbde497-e826-5557-4442-fdd089d33fbd"],
 " opens the session on the GPU engine. Where no GPU engine is available, it \
issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "gpudev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " and opens on the CPU engine."
}], "Notes",
 CellID->1439899046,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

Cell[TextData[{
 "One session is open at a time for each device. While one is open, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "refused"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 "; the open session is unaffected."
}], "Notes",
 CellID->1641200340,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[TextData[{
 "The session is held by a persistent engine worker process. Where none can \
be started, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "noworker"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35077f55-9291-6519-633d-771f27244c63"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 "; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " still works."
}], "Notes",
 CellID->1424533854,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[TextData[{
 "A property ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],
 " does not accept issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "unknownprop"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02f88238-86c8-66df-3287-2462337d4c25"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 "."
}], "Notes",
 CellID->535457321,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"]
}, Open  ]],

