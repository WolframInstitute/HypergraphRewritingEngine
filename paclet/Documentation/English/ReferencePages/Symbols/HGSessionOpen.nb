Cell["\<\
Open a session on a rule that splits an edge into two, and evolve it:\
\>", "ExampleText",
 CellID->542889645,ExpressionUUID->"1d359769-845f-cd94-44ca-0f332deb97fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
