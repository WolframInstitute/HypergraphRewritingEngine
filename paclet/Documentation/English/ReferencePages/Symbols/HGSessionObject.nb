Notebook[{

Cell[CellGroupData[{
Cell["HGSessionObject", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionObject"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "represents a multiway evolution held by an engine worker, as given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 "."
}], "Usage",
 CellID->329621944,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " gives an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 " evolves it further, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 " reads it, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionFrontier"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionFrontier", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " lists the states the next step expands, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionClose"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionClose", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " releases it."
}], "Notes",
 CellID->515379898,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[TextData[{
 "The evolution (its states, events and frontier) is held by the engine \
worker process. The object holds what addresses it: a handle, the device, the \
properties named at ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " and the options that decide how replies are read."
}], "Notes",
 CellID->604760901,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["\<\
It is displayed as a summary box showing the device and the properties the \
session reports, with the state canonicalization under the expander.\
\>", "Notes",
 CellID->1476799103,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[TextData[{
 "The device is the one serving the session. A session opened with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 " where no GPU engine is available issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "gpudev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " and is served, and shown, as ",
 Cell[BoxData["CPU"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 "."
}], "Notes",
 CellID->448336599,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[TextData[{
 "An ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " is made only by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 "."
}], "Notes",
 CellID->970785311,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["\<\
No verb changes the expression: it addresses the same session before and \
after a step, and a copy addresses the same session.\
\>", "Notes",
 CellID->1377816002,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[TextData[{
 "After ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionClose"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionClose", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],
 ", every verb on the object issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "refused"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 ". A handle is not reused."
}], "Notes",
 CellID->1439899046,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["One session is open at a time for each device.", "Notes",
 CellID->1641200340,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "A verb given an expression that is not an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "::", "badsession"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbaaaf7-1388-e538-4b59-43b1a622cc02"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 "."
}], "Notes",
 CellID->1424533854,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"]
}, Open  ]],

