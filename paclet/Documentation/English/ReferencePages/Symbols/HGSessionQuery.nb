  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " stands for the property the session was opened for."
}], "Notes",
 CellID->448336599,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

