Cell["\<\
A new session holds the initial state; after three steps a query reads the \
evolution without extending it:\
\>", "ExampleText",
 CellID->542889645,ExpressionUUID->"55f417ec-7166-d78d-038b-8eb60010bdd7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionQuery", "[", "s", "]"}]}], "Input",
