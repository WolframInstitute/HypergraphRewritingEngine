Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ced6dc5-63f6-114b-8ab6-86b97c271050"],
 " asks whether their CONTENTS are equal \[LongDash] the same hyperedges over \
the same vertex names. That is cheap, and it is FINER than isomorphism, not \
an approximation of it: two isomorphic states whose vertices are labelled \
differently are different states under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90432d0e-7da2-ed48-afb4-8ac3c2912f02"],
 ", and stay separate. On a chain rule at 5 steps it merges nothing where ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581dfe39-1c65-9c45-be37-bef98dde3455"],
 " collapses 154 states to 6. Choose it when vertex names are meaningful and \
you want them respected; choose ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44734c78-43a8-1c48-998e-aa23731de8f1"],
 " when they are arbitrary and only the shape matters."
}], "ExampleText",ExpressionUUID->"aed3d468-2a6a-4e4e-8092-ccbc5aec8ffc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"CanonicalizeEvents\"", "ExampleSubsection",ExpressionUUID->"04e833bf-fa49-7b42-9f7d-62fac366df57"],

Cell[TextData[{
 "Event canonicalization merges equivalent update events. ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8219c143-dc3b-ee45-a5af-a314527243a1"],
 " (the default) keeps every application as its own event. ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "150303b7-5ab9-5c49-8908-f81fa9e5f0ee"],
 " identifies two applications when their canonical input and output states \
agree. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "844be552-304d-7544-94b1-493ad4f292d5"],
 " also distinguishes which edges were consumed and produced and at which \
step, resolving edges by their canonical positions \[LongDash] the identity \
is a property of the event, not of the schedule that produced it. ",
 Cell[BoxData["Positional"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "500595a2-98bc-904e-92b1-f0c7316f2517"],
 " uses the same components but resolves edge positions in each raw state's \
own labeling, reproducing the upstream ",
 Cell[BoxData["MultiwaySystem"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b609298-7c23-504a-b785-e61b85558312"],
 " convention (reproducible for a fixed input order, not \
isomorphism-invariant); it is incompatible with ",
 Cell[BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbf59979-7254-564a-9ccf-1d0250f7c02a"],
 ", which it disables with a warning. A list such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<InputState\>\"", ",", " ", "\"\<OutputState\>\"", ",", 
    " ", "\"\<Rule\>\""}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9a4f8300-26b8-5c43-8e18-6f753412ae69"],
 " selects a custom identity from the components ",
 Cell[BoxData["\"\<InputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c8996ee-259c-b84d-8cba-56766433d5ac"],
 ", ",
 Cell[BoxData["\"\<OutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cad4907d-33d8-4341-a9e0-38c2abec0a3e"],
 ", ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a2188c1-96b5-cc4a-9ae9-9f2f528ac8d6"],
 ", ",
 Cell[BoxData["\"\<Rule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00e43b83-3985-244d-a38d-c0b85e7f2aa2"],
 ", ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bce8641-2183-8841-885f-d6e86559731d"],
 ", ",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d07c099-0c1a-7e49-84e4-b48063d56d40"],
 ". Compare the event structure with it off and on:"
}], "ExampleText",ExpressionUUID->"c2c1c99b-2513-254a-9746-a55fb85c1b63"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", 
   " ", "\"\<EvolutionGraphStructure\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "None"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"df3f7b36-0abb-cf4c-91b7-92e8b6c0cb0d"],

