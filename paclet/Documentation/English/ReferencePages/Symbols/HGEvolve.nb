      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "2"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
