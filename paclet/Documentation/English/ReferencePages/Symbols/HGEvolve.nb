Cell[TextData[{
 "The setting selects when two states are one state. Under ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4104c6da-03d7-a765-773b-df84b6630a4f"],
 ", the default, a hypergraph reached by two histories is two states. Five \
steps of the chain rule from one edge reach 154 states:"
}], "ExampleText",
 CellID->1184240770,ExpressionUUID->"731f4b84-5335-8b87-2125-62ee66c1d9ed"],

