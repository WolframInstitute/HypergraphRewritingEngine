      FontSize->0.9 Inherited,ExpressionUUID->
      "13e711b4-4d78-4d68-419c-88fe640d17b2"],
     " (key ",
     Cell[BoxData["\"\<Width\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3fd09d86-aea1-a602-65ef-14e3cb550d68"],
     ") and the resolution of a curved surface (key ",
     Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
     ")"
    }], "TableText",ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7f56169e-4783-4dbb-256d-8fd872361781"], Cell[TextData[Cell[
    BoxData["\"\<GridHeight\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5b84d4d6-858d-5842-09bb-cd902c382aa8"]], "TableText",ExpressionUUID->
     "67558936-e5eb-8680-0d6a-2173939fecea"], Cell[TextData[Cell[BoxData[
    "10"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1072dc7c-f7d5-c74e-4001-d6398261ad94"]], "TableText",ExpressionUUID->
     "3462f0a3-098c-f6b3-5c11-e90da83edc99"], Cell[TextData[{
     "the height of a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "04cac1af-436c-9192-2cc9-d809761ee3f8"],
     ", ",
     Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "63be94f2-239e-9b81-1145-0dbc5628e9eb"],
     " or ",
     Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
     " (key ",
     Cell[BoxData["\"\<Height\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
     ")"
    }], "TableText",ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "178a6a52-23e4-1142-3d89-8c1c559163a8"], Cell[TextData[Cell[
    BoxData["\"\<GridHoles\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "52ddf811-e480-8137-02e2-f25a8d3ad01d"]], "TableText",ExpressionUUID->
     "719ae17a-c654-ed44-27b9-f927f3e6b7ae"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "62c8f42b-c628-388a-12f7-ee74f3c28ad0"]], "TableText",ExpressionUUID->
     "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"], Cell[TextData[{
     "holes cut from a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"],
     ", each as ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "radius"}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
     " (key ",
     Cell[BoxData["\"\<Holes\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7aafc905-908a-67da-2a54-e16f213f4d20"],
     ")"
    }], "TableText",ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0e7c794a-82c2-56e7-3604-711437773ccd"], Cell[TextData[Cell[
    BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "30f601cf-5001-fb68-608d-98a961b5c9b2"]], "TableText",ExpressionUUID->
     "04bc0f0b-f02f-243d-2c43-a75481db8f07"], Cell[TextData[Cell[BoxData[
    "500"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"]], "TableText",ExpressionUUID->
     "705e212e-f5a4-7717-2065-b88bfc515a7d"], Cell[TextData[{
     "the number of points of ",
     Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
     ", ",
     Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
     ", ",
     Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
     " and ",
     Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
     " (key ",
     Cell[BoxData["\"\<Density\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
     ")"
    }], "TableText",ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "138e1639-4d05-8b97-41b5-886364b1d9fd"], Cell[TextData[Cell[
    BoxData["\"\<SprinklingTimeExtent\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "156728ce-0023-e03b-431c-c1a8b1d7b301"]], "TableText",ExpressionUUID->
     "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"], Cell[TextData[Cell[BoxData[
    "10."], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26ff5c08-e081-ff27-4e85-56559135c20d"]], "TableText",ExpressionUUID->
