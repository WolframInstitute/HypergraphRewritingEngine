       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1947439f-a48e-a645-8ef7-eaa00af539c7"],

Cell[BoxData["10"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4b076a26-3f96-c447-a2f6-fbddd5fbff08"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell[
  "Applications", "ExampleSection",ExpressionUUID->
   "d5715ee2-1cae-4f33-89b2-0e99ea9caa6e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[CellGroupData[{

Cell["Cross-run isomorphism hashes", "ExampleSubsection",ExpressionUUID->"c11b470b-a6ac-2247-892b-a3c00c7cb314"],

Cell[TextData[{
 "Run-local state ids differ between runs, but ",
 Cell[BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85542668-e3f1-9e4e-b1a2-525c367f106e"],
 " attaches an isomorphism-stable hash usable to fuse pruned runs by \
isomorphism class:"
}], "ExampleText",ExpressionUUID->"6b57a271-3361-a544-9d06-a8a0b8aded19"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "2", ",", 
    " ", "\"\<States\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
   "]"}], " ", "//", " ", "Length"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ee9f8f4-5334-e24e-ae74-7ba67106003d"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c6f7bb47-ca9e-9840-be10-0af80565641c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continuing an evolution instead of re-running it", "ExampleSubsection",ExpressionUUID->"c7938621-9cb8-cf48-b684-f6bb8a7d449d"],

Cell[TextData[{
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6671a63d-04d9-1f4e-9901-fd43e67cd4bf"],
 " answers one question and discards the exploration that answered it, so \
asking for three steps and then five re-runs the first three. A ",
 StyleBox["session",
  FontWeight->"Bold"],
 " keeps the engine, its graph and the frontier the budget stopped at, so \
each step carries the ",
 StyleBox["same", "TI"],
 " exploration further and every state, event and relation already built \
keeps its identity:"
}], "ExampleText",ExpressionUUID->"679aec50-26ca-6f40-bae4-4ecc4d48f6cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionQuery", "[", "s", "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}]}], "}"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0ecbd05f-a97c-3b48-8567-f8bb485ac9f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "1"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "4"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "3"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "10"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "9"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"2e5c4148-3662-df4a-9e9d-eac02afd3776"]
}, Open  ]],

Cell[TextData[{
 "which gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"NumStates", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"NumEvents", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"2", ",", " ", "1"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"4", ",", " ", "3"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"10", ",", " ", "9"}], "|>"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "969e3857-b52c-8649-b290-cff1748552ec"],
 " \[LongDash] the same numbers as ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "k", ",", " ", 
    "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c409c7c6-136f-ea41-b268-c39df94a11dd"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k", " ", "=", " ", "0"}], ",", " ", "1", ",", " ", "2", ",", " ", 
   "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e61226b-749a-3b41-b941-8a5a447ab9ad"],
 ", reached by continuing rather than restarting. ",
 Cell[BoxData[
  RowBox[{"HGSessionQuery", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1c910e-7434-7d4b-a4e5-b94db88f8257"],
 " re-reads the accumulated graph without exploring further. ",
 Cell[BoxData[
  RowBox[{"HGSessionClose", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aba6378e-32e0-5e42-b670-778c8da85c28"],
 " releases the engine."
}], "ExampleText",ExpressionUUID->"b98356f1-b2b6-464b-be6b-4d23ac93231e"],

Cell["\<\
Three things are fixed when the session opens, and the later verbs refuse to \
change them:\
\>", "ExampleText",ExpressionUUID->"a7093366-d82d-6647-a90b-47941bccee37"],

Cell[TextData[{
 StyleBox["The rules.",
  FontWeight->"Bold"],
 " A session's rule set was fixed at ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e5006eb6-f4ef-7b4b-b2c3-eb7caaf0a862"],
 "; applying different ones would answer about a system the session is not \
exploring."
}], "Item",ExpressionUUID->"579bcd4f-ee71-9046-8f3d-70fa503a9b34"],

Cell[TextData[{
 StyleBox["The identity convention",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "292635f0-40e1-3547-b8e8-5d38364ecb5e"],
 ", ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06dad03-d35f-6f49-bcbf-99d5a24173bb"],
 ", ",
 Cell[BoxData["\"\<ShowGenesisEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57bd4e7d-2e7c-ec4e-9e2c-00d19ee4f1b4"],
 "). These decide what a state and an event ",
 StyleBox["are", "TI"],
 ". The engine reads them back from its own graph rather than from a step's \
request, so a query cannot report exact canonical forms as tree-mode ones."
}], "Item",ExpressionUUID->"eba31ea1-001a-fc4e-9474-78a14ba77aa1"],

Cell[TextData[{
 StyleBox["What the run records.",
  FontWeight->"Bold"],
 " An artifact the session was not opened for cannot be produced afterwards \
\[LongDash] the evolution that would have built it has already run. Open with \
the property you intend to ask for; asking for another returns an empty \
relation and the engine says so rather than serving the emptiness silently."
}], "Item",ExpressionUUID->"5425ec69-d7c8-9541-85a2-80d7e7b2cc37"],

Cell[TextData[{
 "A session's handle names a live engine process, so one session at a time is \
served per worker: a second ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73581601-a7f7-9743-b48b-242f4ad23a2c"],
 " while one is live is an error rather than an eviction, because evicting \
would discard an exploration without being asked."
}], "ExampleText",ExpressionUUID->"a42bb663-270b-1845-97b0-ab78ce778fb6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Steering: continuing from part of the frontier", "ExampleSubsection",ExpressionUUID->"a15fdd50-389b-314a-959c-9ae7ae38c339"],

Cell[TextData[{
 "An exploration that branches faster than it is worth exploring can be \
carried forward along a chosen branch. ",
 Cell[BoxData["HGSessionFrontier"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02fecb4a-bbbb-7346-8a55-17c9ef2dae8a"],
 " reports the states a continuation would resume from, and ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", 
     RowBox[{"{", "...", "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a631a38c-44c4-3449-af59-dd901f286edb"],
 " expands only those:"
}], "ExampleText",ExpressionUUID->"cf159775-16f6-6946-abed-76422f3b067c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"s", ",", " ", "2"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"HGSessionFrontier", "[", "s", "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"First", "[", "f", "]"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4c5ad0d9-955b-0048-9e21-5ebbd2b85dc1"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0ffd0b91-635c-b646-b1e1-edb27deb895a"]
}, Open  ]],

Cell["\<\
which reaches 7 states where an unsteered step of the same depth reaches 10.\
\>", "ExampleText",ExpressionUUID->"16dab0dd-f459-ac45-b7c0-042aff69f00d"],

Cell[TextData[{
 StyleBox["The unselected branches are retained, not discarded.",
  FontWeight->"Bold"],
 " They stay on the frontier and a later step resumes them, so a steered \
detour costs nothing in what remains reachable: continuing the session above \
without a selection lands on 34 states, exactly what ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<NumStates\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8070481-9ea3-4140-8193-480d929c0a0b"],
 " gives. Steering narrows what runs ",
 StyleBox["next", "TI"],
 ", never what is ",
 StyleBox["reachable", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"1e76b07f-b8f9-f64b-b290-2fd188cbbdaf"],

Cell[TextData[{
 "Naming a state that is not on the frontier is an error rather than a step \
that quietly does nothing, since a caller steering toward a state the \
exploration has already passed would otherwise get an unexplained empty \
result. Steered continuation is CPU-only: a device session carries its \
frontier as device state ids with no host-visible identity, so the selection \
cannot be resolved there, and ",
 Cell[BoxData[
  RowBox[{"TargetDevice", " ", "->", " ", "\"\<GPU\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d86fb4d2-bfe9-424c-ae6f-4207d69f8a62"],
 " reports that rather than running unsteered."
}], "ExampleText",ExpressionUUID->"47f1f4a2-6e57-2a44-9654-ef19e241ee30"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sending only what a step added", "ExampleSubsection",ExpressionUUID->"9b22924b-7498-2f46-943f-0f98dc9f2a74"],

Cell[TextData[{
 "A step re-serialises the whole accumulated graph. ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22172127-251c-b64f-afe2-686fc1f1c303"],
 " sends only what the session has not already been sent, and the Wolfram \
side merges it back into the graph the session holds \[LongDash] so the wire \
is incremental and the ",
 StyleBox["answer", "TI"],
 " is not: ",
 Cell[BoxData["HGSessionStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35086074-d0ca-3544-9ae2-5010683e5e02"],
 " returns the whole accumulated graph either way."
}], "ExampleText",ExpressionUUID->"eaea2239-7a5e-5841-a7ad-a45a07442af0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<StatesGraphStructure\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGSessionStep", "[", 
     RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
      RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]}], "]"}], 
    ",", " ", 
    RowBox[{"{", "6", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b071f43d-fcc1-1249-83c0-8694465aa4ed"],

Cell[TextData[{
 "Measured on this evolution at depth 7 (5,914 states), ",
 Cell["tools/dev/session_step_cost.wls", "InlineCode",ExpressionUUID->
  "6f8a0cbc-3623-a44d-b242-57045a6bc53d"],
 ": the engine leg falls from 381 ms to 269 ms and the reply from 516,535 to \
443,660 bytes. That is a 29% cut to the engine call and 8% to the step, \
because the rest of a step is the Wolfram Graph construction \[LongDash] \
1,640 ms of the 2,021 ms total \[LongDash] which a delta cannot reduce, since \
the graph being built is the whole accumulated one either way."
}], "ExampleText",ExpressionUUID->"c1e78773-b22c-4946-94c2-c2bc7d952092"],

Cell[TextData[{
 "Ask for a full delivery at any time to resynchronise; doing so resets what \
the session believes you hold, so the next delta is measured from it. Delta \
delivery is not served on the quotient reconstruction route (",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d425e44-6686-fe47-98f7-6a3a09d93a2b"],
 " with causal output), where the causal relation is reduced on read and an \
edge already sent can leave the reduction \[LongDash] a delta has no way to \
withdraw one, so those replies carry the whole graph and say so."
}], "ExampleText",ExpressionUUID->"57cb75a3-bbe6-4445-a6e4-050b5421ba76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keeping a bounded number of transitions per rule", "ExampleSubsection",ExpressionUUID->"ebd021fc-4586-094d-81a0-6535f56006a4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17a3698a-b592-7e4a-89dc-06acc6fcf580"],
 " keeps at most ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ae2c5f9-b1e6-d841-bf01-f9ef231058a9"],
 " of each state's own transitions ",
 StyleBox["per rule",
  FontWeight->"Bold"],
 ", and the choice is made when that state's matching is complete rather than \
as matches arrive:"
}], "ExampleText",ExpressionUUID->"0d6a156a-671b-6f44-98b5-1acc8f7ca824"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"18dec606-698e-4d40-8612-8546294fc948"],

Cell[BoxData["5"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"07e55519-a736-1e4c-ab01-8e03bbf3c84b"]
}, Open  ]],

Cell[TextData[{
 "The distinction from the other caps is what it is for. ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11a8afd2-10a4-a042-98db-71ce93298e7b"],
 " bounds children per parent regardless of which rule produced them. ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56fefb99-e050-ec41-9bba-396a1b24ba05"],
 " bounds by ",
 StyleBox["arrival order",
  FontWeight->"Bold"],
 ", which depends on the schedule, so two runs of the same evolution can keep \
different states. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6a29e00-4021-ae41-9cc0-eea0a61c9e58"],
 " ranks a state's transitions by their own isomorphism-invariant identity \
and the ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9334cc2-396a-bd42-b878-71ea8c2a6a5d"],
 ", so the kept set is the same at any thread count \[LongDash] choosing ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64ece24a-fdcb-c54f-82b9-d1135df7a93a"],
 " of ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647e257f-52a7-6848-9a5c-08dcf2344076"],
 " needs all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63ad5e4b-9133-bd49-beff-a173d6350aa4"],
 ", and all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6104680-ebed-0048-a227-e53a4a9fecfe"],
 " exist only once that state's matching has finished."
}], "ExampleText",ExpressionUUID->"1ae840ef-25db-f04e-a1d1-92b0273c7f49"],

Cell[TextData[{
 "Applies to a state's ",
 StyleBox["own",
  FontWeight->"Bold"],
 " matches. A match forwarded into a state from an ancestor arrives \
asynchronously and is not counted against the cap, for the same reason: its \
arrival races the point where the count would be taken. CPU only."
}], "ExampleText",ExpressionUUID->"74af38d2-38f0-5a42-87b2-15e185d4d3c4"]
}, Open  ]]
}, Open  ]],

