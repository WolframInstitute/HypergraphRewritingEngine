  }]], "3ColumnTableMod",ExpressionUUID->"26b811aa-3751-794e-8cd0-2f3109370517"],

Cell[TextData[{
 "Geometry and physics analyses \[LongDash] dimension, curvature, geodesics, \
entropy, topological charge, branchial sharpness \[LongDash] are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " part of this paclet. They live in the companion ",
 Cell[BoxData["hypergraph_viz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ff2ae1-4ce2-e942-86c9-956add0969cf"],
 " project, which consumes this engine as a dependency. ",
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "358a8dd9-1095-bd41-a21c-f0795ed0d3dc"],
 " accepts no options for them; use ",
 Cell[BoxData[
  RowBox[{"Options", "[", "HGEvolve", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a4104d45-8fee-ef4a-9ee2-5c1a701da90c"],
 " for the list it does accept."
}], "Notes",ExpressionUUID->"502f9f5a-3a96-854e-92b5-665eb6e051c4"],

Cell[TextData[{
 "Instead of an explicit ",
 StyleBox["initial", "TI"],
 ", an initial condition can be generated in place by naming it and shaping \
it with these options:"
}], "Notes",ExpressionUUID->"0945e94c-42d3-534c-b9a6-d43cf581828a"],

