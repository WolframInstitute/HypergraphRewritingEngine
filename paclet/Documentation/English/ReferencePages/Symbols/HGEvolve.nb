Cell[CellGroupData[{

Cell["Multiple rules and multiple initial states", "ExampleSubsection",ExpressionUUID->"d0c88c44-98de-c545-89f6-add0cb768ea8"],

Cell[TextData[{
 "Rules and initial states may both be lists; each initial state is a \
distinct entry point of the multiway system. Isomorphic states are merged \
with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ad040f0-00d5-2a4e-9011-983c7bf21a4a"],
 " to keep the graph compact:"
}], "ExampleText",ExpressionUUID->"685bc3ec-8a6d-3c41-b3cc-d98c90da52b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule2", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule3", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "}"}], " ", "->", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]}]}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9cd9f4fc-b509-1344-afa2-3de13d38fd80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rule1", ",", " ", "rule2", ",", " ", "rule3"}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "}"}]}], "}"}], ",",
    " ", "2", ",", " ", "\"\<StatesGraph\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"96b24909-15ed-1d43-9bbb-01142a900b84"],

