Cell["\<\
A rule that replaces one binary edge by a path of two edges through a new \
vertex:\
\>", "ExampleText",
 CellID->542889645,ExpressionUUID->"524d5b64-939d-9e2e-0273-534e2629e574"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chain", " ", "=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->2054848121,ExpressionUUID->"3bbb36c0-925a-ccd2-6958-afaa27ec9638"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], "}"}], "\[Rule]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->207869695,ExpressionUUID->"1a695b16-67b9-69b9-4a17-5350124c3b83"]
}, Open  ]],

Cell["\<\
Two steps of the rule from a single edge, as the evolution graph with its \
causal edges. The chain rule has no branchial pairs, since no two of its \
matches share an edge:\
\>", "ExampleText",
 CellID->2117652224,ExpressionUUID->"0deaf6de-bcac-37fa-3be9-ef98355e9dc0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "600"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->941593343,ExpressionUUID->"7a9276f6-63cd-444b-2aa2-6fb016782e91"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{"S", 0}, {"S", 1}, {"S", 2}, {"S", 3}, {"E", 0}, {"E", 1}, {
       "E", 2}}, {{{5, 2}, {6, 3}, {7, 4}, {5, 6}, {5, 7}}, {{1, 5}, {2, 6}, {
       2, 7}}, {<|"EventId" -> 0|>, <|"EventId" -> 0|>, <|"EventId" -> 1|>, <|
        "EventId" -> 1|>, <|"EventId" -> 2|>, <|"EventId" -> 2|>, <|
        "ProducerEvent" -> 0, "ConsumerEvent" -> 1|>, <|
        "ProducerEvent" -> 0, "ConsumerEvent" -> 2|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {
        DirectedEdge[{"E", 1}, {"S", 2}, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip], 
         DirectedEdge[{"E", 0}, {"E", 1}, <|
           "ProducerEvent" -> 0, "ConsumerEvent" -> 1|>] -> Placed[
           Column[{
             Row[{
               Style["Causal Edge", Bold]}], 
             
             Grid[{{"Producer Event:", 0}, {"Consumer Event:", 1}}, Alignment -> 
              Left, Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 
         DirectedEdge[{"E", 2}, {"S", 3}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         UndirectedEdge[{"S", 1}, {"E", 2}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         DirectedEdge[{"E", 0}, {"E", 2}, <|
           "ProducerEvent" -> 0, "ConsumerEvent" -> 2|>] -> Placed[
           Column[{
             Row[{
               Style["Causal Edge", Bold]}], 
             
             Grid[{{"Producer Event:", 0}, {"Consumer Event:", 2}}, Alignment -> 
              Left, Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 
         UndirectedEdge[{"S", 0}, {"E", 0}, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         UndirectedEdge[{"S", 1}, {"E", 1}, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip]}, 
       EdgeStyle -> {
        DirectedEdge[{"E", 1}, {"S", 2}, <|"EventId" -> 1|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], 
         DirectedEdge[{"E", 0}, {"S", 1}, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], 
         UndirectedEdge[{"S", 0}, {"E", 0}, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5]], 
         UndirectedEdge[{"S", 1}, {"E", 1}, <|"EventId" -> 1|>] -> Directive[
           GrayLevel[0.5]], 
         DirectedEdge[{"E", 0}, {"E", 1}, <|
           "ProducerEvent" -> 0, "ConsumerEvent" -> 1|>] -> Directive[
           RGBColor[1, 0.5, 0], 
           Arrowheads[Small]], 
         DirectedEdge[{"E", 0}, {"E", 2}, <|
           "ProducerEvent" -> 0, "ConsumerEvent" -> 2|>] -> Directive[
           RGBColor[1, 0.5, 0], 
           Arrowheads[Small]], 
         UndirectedEdge[{"S", 1}, {"E", 2}, <|"EventId" -> 2|>] -> Directive[
           GrayLevel[0.5]], 
         DirectedEdge[{"E", 2}, {"S", 3}, <|"EventId" -> 2|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]]}, GraphLayout -> "LayeredDigraphEmbedding", 
       ImageSize -> 600, VertexLabels -> {{"S", 1} -> Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 1}, {"CanonicalId:", 1}, {"Step:", 1}, {
