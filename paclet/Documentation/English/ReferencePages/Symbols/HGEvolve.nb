      RowBox[{"or", " ", "a", " ", "cap"}]}], ")"}], " ", "and", " ", "no", " ",
     "random", " ", "seed", " ", "was", " ", "set"}], ",", " ", 
   RowBox[{
   "so", " ", "the", " ", "rule", " ", "order", " ", "is", " ", "drawn", " ", 
    "afresh", " ", "each", " ", "run", " ", "and", " ", "the", " ", 
    "states"}], ",", " ", 
