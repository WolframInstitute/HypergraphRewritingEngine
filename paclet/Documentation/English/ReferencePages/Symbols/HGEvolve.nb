Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05590d03-2064-1772-3366-a56d51117a58"],
 " also uses the step and the canonical positions of the consumed and \
produced edges, so splitting an end edge of a path and splitting a middle \
edge are different events:"
}], "ExampleText",
 CellID->270596367,ExpressionUUID->"3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],

