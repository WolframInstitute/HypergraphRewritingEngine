   " ", "\"\<NumEvents\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "None"}]}], 
  "]"}]}], "Input",
