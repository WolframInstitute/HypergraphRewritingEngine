Cell[CellGroupData[{

Cell["\"RandomSeed\"", "ExampleSubsection",
 CellID->428094287,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],

Cell["\<\
The seed of every sampling draw, so a sampled evolution with a seed is \
reproducible:\
\>", "ExampleText",
 CellID->2104439730,ExpressionUUID->"250c2a2d-8da6-5f9d-5333-cc77245325e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
