Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "evolves the hypergraph ",
 StyleBox["init", "TI"],
 " under ",
 StyleBox["rules", "TI"],
 " for ",
 StyleBox["n", "TI"],
 " steps in every possible way and gives the graph of the states and events \
reached, with the causal and branchial edges between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 "\[LineSeparator]",
 "gives the property ",
 StyleBox["prop", "TI"],
 " of the evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["prop", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["prop", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 "\[LineSeparator]",
 "gives an association of the listed properties.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", 
    " ", "\"\<\!\(\*StyleBox[\"name\", \"TI\"]\)\>\"", ",", " ", 
    StyleBox["n", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 "\[LineSeparator]",
 "evolves a generated initial condition of the named family, shaped by the \
initial-condition options.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", 
       " ", "\"\<\!\(\*StyleBox[\"name\", \"TI\"]\)\>\""}], ",", " ", 
      "\[Ellipsis]"}], "|>"}], ",", " ", 
    StyleBox["n", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 "\[LineSeparator]",
 "evolves a generated initial condition shaped by the keys of the association."
}], "Usage",
 CellID->329621944,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell["\<\
A hypergraph is a list of hyperedges, and a hyperedge is an ordered list of \
vertices of any length. The same hyperedge may occur more than once.\
\>", "Notes",
 CellID->515379898,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "A rule is written ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " ",
 StyleBox["rhs", "TI"],
 ", with a hypergraph on each side; ",
 StyleBox["lhs", "TI"],
 " is not empty. ",
 StyleBox["rules", "TI"],
 " is a single rule or a list of rules; with a list, every rule is applied at \
every step."
}], "Notes",
 CellID->604760901,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["\<\
The vertices of a rule are pattern variables, written as integers or as \
symbols. A variable on both sides is kept by every application, a variable on \
the left only is consumed with its edges, and a variable on the right only is \
a vertex the application creates.\
\>", "Notes",
 CellID->1476799103,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "A match maps each hyperedge of ",
 StyleBox["lhs", "TI"],
 " to a distinct hyperedge of the state with the same number of vertices, and \
each variable to one vertex. Distinct variables may map to the same vertex."
}], "Notes",
 CellID->448336599,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 "An event removes the matched hyperedges and adds the hyperedges of ",
 StyleBox["rhs", "TI"],
 ". Every match is applied."
}], "Notes",
 CellID->970785311,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 StyleBox["init", "TI"],
 " is one of:"
}], "Notes",
 CellID->1377816002,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["a hypergraph, whose vertices may be integers or symbols", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1439899046,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["\<\
a list of hypergraphs, each of which becomes a distinct initial state\
\>", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1641200340,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[TextData[{
 "a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 ", whose edge list is taken as the hypergraph"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1424533854,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["a string naming a generated initial condition", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->535457321,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "an association with a ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " key naming a generated initial condition"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->141959522,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "an association with an ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " key and no ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " key, whose ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " is the hypergraph"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->299517738,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 StyleBox["n", "TI"],
 " is a non-negative integer. The initial states are at step 0; step ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " holds every state produced by an event applied to a state of step ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 "."
}], "Notes",
 CellID->2142391071,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[TextData[{
 "The evolution runs in a separate engine process, and the result reaches the \
kernel when it finishes. If that process ends during an evaluation, the \
message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "workerlost"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
 " is issued, the result is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
 ", and the next evaluation starts a new process. Text the engine process \
writes outside its result, such as a library's warning, is issued as ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "enginelog"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 "."
}], "Notes",
 CellID->1002769646,ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"],

Cell[TextData[{
 "When the engine process does not start, or does not answer its start-up \
check, the evaluation runs in a one-shot engine process, and the next \
evaluation tries to start the engine process again. After three such \
evaluations in a row, the evaluations on that device run in one-shot \
processes until ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "110914de-bbdd-83a1-4736-8d983e69d18b"],
 " is evaluated for the device. A one-shot process that exits without a \
result issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "enginefail"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76d004f9-29e5-6665-1eef-9da34f904d4f"],
 ", and the result is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 "."
}], "Notes",
 CellID->436346740,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "A job refused by the engine, such as an ",
 Cell[BoxData["\"\<EventOrderingFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 " list that leaves two matches tied, issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "enginemsg"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 " with the engine's reason, and the result is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 "."
}], "Notes",
 CellID->2122865143,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell["The possible properties are:", "Notes",
 CellID->1735808809,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "034d641c-5834-e412-3173-7e4659c6cf78"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "134534fb-1061-d656-417a-ada5a115bcbc"], Cell[TextData[Cell[
    BoxData["\"\<StatesGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"]], "TableText",ExpressionUUID->
     "6e1c99a5-dcef-9c28-1623-100ed49be772"], Cell[
    "graph whose vertices are states and whose edges are events", "TableText",
     ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2aa912c6-4938-1bb7-5a56-8ba068cd699d"], Cell[TextData[Cell[
    BoxData["\"\<CausalGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "66b4bee0-d247-b105-0e4b-37cde7f3006f"]], "TableText",ExpressionUUID->
     "337c2d89-644e-5b5e-6103-c4d30dfb29a4"], Cell["\<\
graph whose vertices are events, with a directed edge from an event to each \
event that consumed an edge it produced\
\>", "TableText",ExpressionUUID->"5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "644cc522-c7c4-9b18-0c73-dc8ff276e662"], Cell[TextData[Cell[
    BoxData["\"\<BranchialGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"]], "TableText",ExpressionUUID->
     "6801f052-da94-0b6f-183e-ea1fdf2159b5"], Cell["\<\
graph whose vertices are states, with an undirected edge between the output \
states of two branchially related events\
\>", "TableText",ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7b6211f5-475c-1194-2911-88bf72e963fe"], Cell[TextData[Cell[
    BoxData["\"\<EvolutionGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"]], "TableText",ExpressionUUID->
     "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"], Cell["\<\
graph with state and event vertices, each event joined to its input and \
output states\
\>", "TableText",ExpressionUUID->"5d5cbd3a-e88d-ee42-0b63-35678939b4a8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b7fe4cc-5889-7f4e-6904-fd96593c4594"], Cell[TextData[Cell[
    BoxData["\"\<EvolutionCausalGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6cb5c01f-62f5-68e0-144a-da5916803aca"]], "TableText",ExpressionUUID->
     "55f417ec-7166-d78d-038b-8eb60010bdd7"], Cell[
    "evolution graph with the causal edges", "TableText",ExpressionUUID->
     "4b6e5dad-9702-0c1f-7916-54f722b75765"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1d359769-845f-cd94-44ca-0f332deb97fe"], Cell[TextData[Cell[
    BoxData["\"\<EvolutionBranchialGraph\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2055bfee-d4b5-7aa2-506a-36cbdd404888"]], "TableText",ExpressionUUID->
     "64c30c0d-1857-1b13-0cf0-a65799e26679"], Cell[
    "evolution graph with the branchial edges", "TableText",ExpressionUUID->
     "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ea251ed-865f-e03c-1652-48b733ebb306"], Cell[TextData[Cell[
