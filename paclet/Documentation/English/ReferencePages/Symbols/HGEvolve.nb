Cell[CellGroupData[{

Cell["Multiple rules and multiple initial states", "ExampleSubsection",ExpressionUUID->"021d2681-d8be-904c-90ec-f11ac0e33246"],

Cell[TextData[{
 "Rules and initial states may both be lists; each initial state is a \
distinct entry point of the multiway system. Isomorphic states are merged \
with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b3002cf-51cf-8543-8703-ef5d09ee85f7"],
 " to keep the graph compact:"
}], "ExampleText",ExpressionUUID->"45b13330-ce5d-1a45-aaaf-91578641c4d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
