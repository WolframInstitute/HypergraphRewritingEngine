     "5f7f2999-1aee-25a5-0504-c0c39e988f8f"]], "TableText",ExpressionUUID->
     "128c7526-c883-085d-42b4-6c83e9365aa7"], Cell[
    "the step of the state", "TableText",ExpressionUUID->
     "3279c00f-c9e2-8758-6206-da68ef94eda2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "50b12ff8-e606-85f7-004e-c6a593b0efdd"], Cell[TextData[Cell[
    BoxData["\"\<Edges\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "640f47a5-4648-c62d-0c35-5e0f73e2ad77"]], "TableText",ExpressionUUID->
     "63a48922-0fac-666c-115b-208caa594cb6"], Cell[
    "the hyperedges, each as its edge id followed by its vertices", 
     "TableText",ExpressionUUID->"387a9e0d-0234-0e73-6819-1057b7c15559"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3f64ca0d-9927-5f44-651b-ec5718d225ae"], Cell[TextData[Cell[
    BoxData["\"\<IsInitial\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "399d1ff3-4632-be92-6fa2-96bd73c404f8"]], "TableText",ExpressionUUID->
     "1170384d-2f38-2c50-470f-b2174acd76ba"], Cell[
    "1 for an initial state, 0 otherwise", "TableText",ExpressionUUID->
     "6ce33075-6d34-44a7-1490-aa3f04c12e8d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6334ac9c-43f1-85c0-12cb-45c67585ef2a"]], "TableText",ExpressionUUID->
     "74397683-04f4-1d4d-1dc7-6fedac816797"], Cell[TextData[{
