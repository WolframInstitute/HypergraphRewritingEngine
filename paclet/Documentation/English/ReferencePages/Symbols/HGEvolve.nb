  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 " (the endpoints' canonical state ids), ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 "/",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " (edge ids), and ",
 Cell[BoxData["\"\<InputStateEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 "/",
 Cell[BoxData["\"\<OutputStateEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 " (the full edge lists). Under ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 ", ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e157ee2-48da-d240-062b-77cc696ca0aa"],
 " holds one record per isomorphism class, keyed by its canonical state id, \
and an event's ",
 Cell[BoxData["\"\<CanonicalInputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "78287f93-0f12-7c52-2828-76ddaaa746b8"],
 "/",
 Cell[BoxData["\"\<CanonicalOutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08285353-0e0e-39f8-3828-4b1dabb88bc2"],
 " are keys of ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1daed7d3-93e8-7698-4b55-ce9d259d5ce2"],
 "."
}], "Notes",
 CellID->1424533854,ExpressionUUID->"187adc3d-3961-76c2-4819-d667b8145c28"],

Cell["Edge identity", "NotesSubsection",
 CellID->535457321,ExpressionUUID->"641c78eb-7f03-7846-0c24-71b57ab64aac"],

Cell[TextData[{
 "Every state is a set of edges drawn from one global store, and the two \
properties below expose that store rather than the states built out of it. ",
 Cell[BoxData["\"\<GlobalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 " returns each edge once with its id, and ",
 Cell[BoxData["\"\<StateBitvectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 " says which of those ids each state holds \[LongDash] so a state's contents \
are the edges its id list names, and two states sharing an edge name the same \
id."
}], "Notes",
 CellID->141959522,ExpressionUUID->"6121b9de-dddd-aca8-10de-309bd469f6f2"],

Cell["Evolution and output options", "NotesSubsection",
 CellID->299517738,ExpressionUUID->"30209679-023a-ee91-61df-0823b7ccb4fb"],

Cell["\<\
State and event deduplication, exploration limits, and the output content are \
controlled by:\
\>", "Notes",
 CellID->2142391071,ExpressionUUID->"29bc1606-c22d-409d-5f43-8863f7d812e7"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"3119d855-3ffd-7401-6726-d21fb9885f6b"],
     Cell["Default", "TableText",
     FontWeight->Bold,ExpressionUUID->"62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7c41cdc9-5ab3-1ef5-247e-e4935f4664df"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "51fce014-dca1-0630-0783-fa51d5546d1a"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "657c1c65-980e-511d-1303-964f19bb2067"]], "TableText",ExpressionUUID->
     "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7e9b7e66-629a-1114-26b9-7040172f607e"]], "TableText",ExpressionUUID->
     "585a51e6-774f-2dd2-087a-48c002fa7738"], Cell[TextData[{
     "the identity states are merged by: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
     " (every provenance distinct), ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "370294fd-9e49-2d35-5d31-0da71bfc741f"],
     " (equal contents), or ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2845529c-454d-b13b-587b-4bc66cf90001"],
     " (equal up to isomorphism)"
    }], "TableText",ExpressionUUID->"7519012f-e657-215b-2326-988893e273a1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "594776df-9e75-d16a-0f7d-6f991b01a3b0"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6405505f-4b92-3bd6-0c3b-4a196e24893c"]], "TableText",ExpressionUUID->
     "6878c7f8-419e-9db5-1807-dea27028e79f"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "48a3d607-c312-9dd3-7850-c860f6a4e739"]], "TableText",ExpressionUUID->
     "539491e8-328f-8d7b-01ab-08b2473bd441"], Cell[TextData[{
     "merge equivalent events: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
     ", ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
     ", ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "21aa1c49-e16c-f406-57a9-9612901edf6c"],
     ", ",
     Cell[BoxData["Positional"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "289b85cd-827f-9a9c-58b8-1c97370be8e6"],
     ", or a list of keys"
    }], "TableText",ExpressionUUID->"12f3dbee-abc4-6375-4280-d2cbce714e5f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"], Cell[TextData[Cell[
    BoxData["\"\<CausalTransitiveReduction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2cfa2c34-ef50-7d46-5499-c6718ae547ac"]], "TableText",ExpressionUUID->
     "362a4e41-4988-041f-5e2a-602b683d6f65"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "01ed6b92-5a5f-fa78-3792-82dc5febc942"]], "TableText",ExpressionUUID->
     "107fa29c-d013-1000-4004-3bd9e1a6636a"], Cell[
    "remove redundant transitive causal edges", "TableText",ExpressionUUID->
     "6798df62-4cc7-e4e1-0da7-d74c6573cecb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49f5450b-e8d1-97dd-7f8b-5d548965fd27"], Cell[TextData[Cell[
    BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"]], "TableText",ExpressionUUID->
     "0b990c23-b656-01a6-39a6-a58cc3e3538c"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "52243646-2fbd-210e-03db-a8204a487054"]], "TableText",ExpressionUUID->
     "1acd7f4d-3da3-7753-4af3-7717b4565db9"], Cell["\<\
quotient exploration: expand each canonical state once, at its shortest depth \
(off by default, so every provenance is explored)\
\>", "TableText",ExpressionUUID->"062d91f0-6326-41c0-2fd2-08ba16d3132a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"], Cell[TextData[Cell[
    BoxData["\"\<QuotientInitialStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6f6ad260-8ee1-565a-1569-d44a2a943ca0"]], "TableText",ExpressionUUID->
     "612fd791-c81e-86f2-10d4-cedae9a8ecd8"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"]], "TableText",ExpressionUUID->
     "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"], Cell[TextData[{
     "collapse isomorphic initial states to a single canonical root (requires \
",
     Cell[BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6b853673-18d0-d9fa-19ba-a83d996aabc0"],
     "); off keeps each initial state a distinct entry point"
    }], "TableText",ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "574a2197-51ef-7938-7d49-b8d1679a4802"], Cell[TextData[Cell[
    BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6e85e9ed-427b-8528-16ba-00b7770fec72"]], "TableText",ExpressionUUID->
     "73b76025-96bb-3fff-214d-798f234f85c5"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "31f4c073-8ff6-126f-678b-da3d298360b5"]], "TableText",ExpressionUUID->
     "72ff7667-e560-b2c0-2285-68408c1a002a"], Cell["\<\
cap the successor states generated from each parent (0 = unlimited); the \
bound holds at any thread count, which successors meet it is not reproducible\
\
\>", "TableText",ExpressionUUID->"7c9be80e-0554-61c1-24b8-0268ace1332b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "106b7ad8-6378-599b-4069-7382160d2be1"], Cell[TextData[Cell[
