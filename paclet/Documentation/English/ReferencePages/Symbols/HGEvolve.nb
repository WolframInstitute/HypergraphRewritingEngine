    }], "TableText",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"]}
  }]], "2ColumnTableMod",
 CellID->1303163127,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[TextData[{
 "An event record has the keys ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27d2a24c-1e84-19ee-4de1-44169b316b34"],
 ", ",
 Cell[BoxData["\"\<CanonicalId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " (the event's identity under ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 "; its own id under ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 "), ",
 Cell[BoxData["\"\<RuleIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " (the position of the rule that fired, counted from 0), ",
 Cell[BoxData["\"\<InputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 ", ",
 Cell[BoxData["\"\<OutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 ", ",
 Cell[BoxData["\"\<CanonicalInputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 ", ",
 Cell[BoxData["\"\<CanonicalOutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f1e874b-6d22-b8ab-3525-1f1504d40af1"],
 ", ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c02104f-9807-e6c4-3431-8a2919b3cc2e"],
 " and ",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f909018-5ea1-6a32-15af-0a425b543918"],
 " (edge ids). Under ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f4595f3-090a-1216-557a-0cbda8bf617c"],
 " with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ", or with ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],
 ", the events are the rule applications the causal and branchial records \
name, and their edge lists are empty."
}], "Notes",
 CellID->2098230307,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[TextData[{
 "A causal record has the keys ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 " and ",
 Cell[BoxData["\"\<To\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7281c19b-2602-dcd4-22be-d8c553b4a63e"],
 " (the producer and consumer events under the event identity in use) and ",
 Cell[BoxData["\"\<RawFrom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " and ",
 Cell[BoxData["\"\<RawTo\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " (the same pair as the ids of the individual applications). A branchial \
record has the keys ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 " and ",
 Cell[BoxData["\"\<To\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 "."
}], "Notes",
 CellID->1930159659,ExpressionUUID->"1d7e6892-18cd-6f45-4b05-81dc997835af"],

Cell["\<\
The engine numbers the vertices of a state from 0 in order of first \
appearance, and hyperedges from 0 in order of creation. State and event ids \
are assigned in the order the engine creates them, which can differ between \
two evolutions of the same input, so ids are only meaningful within one \
result.\
\>", "Notes",
 CellID->1113655915,ExpressionUUID->"325c8f47-cd85-89da-6263-2720e431db20"],

Cell[TextData[{
 "Two events are causally related when one consumes a hyperedge the other \
produced. The causal relation is transitively reduced by default. ",
 Cell[BoxData["\"\<NumCausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43fcea2e-12ab-c026-7183-0388a75f930c"],
 ", ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b416c07-c3d3-bf4f-097e-8660f6670595"],
 " and the causal graphs give the same relation."
}], "Notes",
 CellID->1606118752,ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"],

Cell[TextData[{
 "Two events are branchially related when they are applied to the same state \
and consume a common hyperedge. ",
 Cell[BoxData["\"\<BranchialEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 " lists every such pair; the branchial graph joins the output states of the \
pairs at the step ",
 Cell[BoxData["\"\<BranchialStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 " selects."
}], "Notes",
 CellID->2141499446,ExpressionUUID->"7d3ffb2e-09a8-fc78-24c4-f288a842c742"],

Cell[TextData[{
 "A ",
 Cell[BoxData["\"\<StepStatistics\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 " entry has the keys ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 ", ",
 Cell[BoxData["\"\<RawStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b01e29-d171-5c92-6f4f-9072e00426f8"],
 ", ",
 Cell[BoxData["\"\<Classes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 " (isomorphism classes), ",
 Cell[BoxData["\"\<Redundancy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 " (states per class), ",
 Cell[BoxData["\"\<MaxMultiplicity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 ", ",
 Cell[BoxData["\"\<MultiplicityHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 ", ",
 Cell[BoxData["\"\<ClassEntropyBits\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 " and ",
 Cell[BoxData["\"\<ClassEntropyNormalized\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 " (the entropy of the states over the classes), ",
 Cell[BoxData["\"\<Events\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 " and ",
 Cell[BoxData["\"\<RuleCounts\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 " (the events whose output state is at the step), ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 " (for each of sixty-five per-state invariants, such as ",
 Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 ", ",
 Cell[BoxData["\"\<Components\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 ", ",
 Cell[BoxData["\"\<IncidenceDiameter\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 " and the geometry entries below, its ",
 Cell[BoxData["\"\<N\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 ", ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 ", ",
 Cell[BoxData["\"\<StandardDeviation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 ", ",
 Cell[BoxData["\"\<Min\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 ", ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 ", ",
 Cell[BoxData["\"\<Median\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 " and ",
 Cell[BoxData["\"\<Histogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
 "), ",
 Cell[BoxData["\"\<VertexInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10b62b5f-1d3f-f012-404d-c31994cbc378"],
 " and ",
 Cell[BoxData["\"\<EdgeInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " (distributions over the vertices and the edges of all the step's states, \
below), histograms of hyperedge arity and vertex degree, ",
 Cell[BoxData["\"\<BallGrowthDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 " (for each radius r, the summary of the states' ball-growth dimension at \
r), ",
 Cell[BoxData["\"\<LogGeodesicCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 " (for each distance d, the summary of the states' mean of the natural \
logarithm of the number of shortest paths between two vertices at distance d) \
and ",
 Cell[BoxData["\"\<RotationCurve\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 " (for each radius r, the summary of the states' orbital velocity at r, with \
",
 Cell[BoxData["\"\<StepStatisticsMeasures\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " ",
 Cell[BoxData["\"\<GeodesicAnalysis\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 ") and ",
 Cell[BoxData["\"\<WaveFront\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8469dd-bfc7-2a7a-04bb-80873a727940"],
 " (for each step i of the wave front below, the summary of the states' mean \
front size at i, with ",
 Cell[BoxData["\"\<StepStatisticsMeasures\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],
 " ",
 Cell[BoxData["\"\<WaveFront\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3921e4bb-f5e4-3596-68de-fde483969ffc"],
 "). Under ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13db9173-5387-1c16-41f8-093d6632677c"],
 " they are computed from one state per class and the number of states in the \
class. ",
 Cell[BoxData[
  RowBox[{"\"\<StepStatisticsWeighting\>\"", " ", "->", 
   " ", "\"\<Classes\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6804c0ab-fd16-b7db-183b-d9f4f4a01d21"],
 " counts each class once in ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77076ae4-09e5-8344-1d3c-83ceaf91d1ae"],
 ", ",
 Cell[BoxData["\"\<BallGrowthDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4289b0c6-8043-1b93-72b6-29a031f669f9"],
 ", ",
 Cell[BoxData["\"\<LogGeodesicCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070f3e08-556d-9d60-2d34-b0525c19e44a"],
 " and the histograms."
}], "Notes",
 CellID->339082558,ExpressionUUID->"6d593b15-c37a-9c59-1b66-b35ef60ce6a3"],

Cell[TextData[{
 "The structural entries of ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4140e475-1e41-1f16-777f-fe3f9bf4627c"],
 " are computed on the state's hypergraph and its incidence graph (a node for \
each vertex and each hyperedge, joined when the vertex is in the hyperedge):"
}], "Notes",
 CellID->432388834,ExpressionUUID->"67f13035-938c-831a-0d8e-aa7f263eee60"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "16b44e14-0404-e868-3e4c-605eadb6bab2"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"70bc3c38-1a7f-2cd8-2043-b6629f0a7622"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7e10bd94-ae42-3b4d-262f-34d1cbf48997"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5fdf5ac0-01aa-1326-05e5-53aab05f7e0c"], Cell[TextData[{
