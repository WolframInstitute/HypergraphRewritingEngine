Cell[CellGroupData[{

Cell["\"RuleWeights\"", "ExampleSubsection",
 CellID->1827701392,ExpressionUUID->"077289f0-6175-2cad-2d01-20ba100076f7"],

Cell[TextData[{
 "Per-rule multipliers on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133b68ba-8b92-4fbc-42d8-81e42e271586"],
 ", in rule order; a rule's transitions are kept with the product of the two. \
Weights ",
