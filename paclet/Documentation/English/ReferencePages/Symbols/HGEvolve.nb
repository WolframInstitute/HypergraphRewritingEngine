Cell[CellGroupData[{

Cell["\"TransitionRate\"", "ExampleSubsection",ExpressionUUID->"6a5f66ab-b33d-d943-b53f-de80b62da95f"],

Cell[TextData[{
 "Below 1, each transition is kept with the given probability. The draw is \
taken from the transition's own isomorphism-invariant identity together with ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef3a3c60-cc57-2f4c-b0e9-0ae4c88a55c8"],
 ", never from thread state, so the same seed selects the same subgraph at \
any thread count and on either device."
}], "ExampleText",ExpressionUUID->"7408077b-bf33-4147-a9b8-fedd0cb2a46b"],

Cell[TextData[{
 "It also carries a depth guarantee that ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b53f37-2e98-8e4a-9b53-3cb87ba6d87a"],
 " does not. A fixed rate is a knife edge: below one over the branching \
factor, a thinned evolution dies out before reaching the requested depth. A \
state whose every draw failed keeps its lowest-keyed transition, so the \
sample still reaches full depth."
}], "ExampleText",ExpressionUUID->"5a29b4df-de7f-0f47-b45b-ee63cd074fac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "6", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", "\n", "  ", 
   RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.125"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d4162fe0-e2e8-e149-9e0f-41278e8a64b7"],

