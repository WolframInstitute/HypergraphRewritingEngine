Cell[TextData[{
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae1b47f0-20a4-a74e-8110-fc2198b72fd3"],
 " asks whether two states are the same up to isomorphism, exactly. \
Relabelled copies of one hypergraph become one state:"
}], "ExampleText",ExpressionUUID->"60b8ad3d-f00b-dd41-8101-d73d011d8cda"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", 
   " ", "\"\<StatesGraph\>\"", ",", " ", 
