Cell[CellGroupData[{

Cell["\"Generational\"", "ExampleSubsection",
 CellID->728682164,ExpressionUUID->"21fc4796-9fa1-d99c-5784-5ed01a55abe6"],

Cell[TextData[{
 "With ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ea97580-6bed-1077-6657-6cea0d98635d"],
 ", the evolution follows one history, and each step is one generation of the \
Wolfram model's single-way update. The matches of the state are taken in the \
standard order, ",
 Cell[BoxData["\"\<LeastRecentEdge\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "345a0710-bfec-3876-5c79-9f5a399e8b5c"],
 ", then ",
 Cell[BoxData["\"\<RuleOrdering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56a4078a-bfa3-4726-7e5b-9ed43a562a0c"],
 ", then ",
 Cell[BoxData["\"\<RuleIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26fb0827-d9bf-287b-4e98-a180d84a7b41"],
 ", each unless it shares a hyperedge with a match taken before it, and the \
matches taken are applied together. Each is an event from the state to the \
next state. On a path of four edges the first and the third of the three \
matches are taken, and the next step contracts the two edges they make:"
}], "ExampleText",
 CellID->1702317733,ExpressionUUID->"5706a8dc-de84-4347-7d3d-4199db3111ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", " ", "/@", " ", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"Values", " ", "@", " ", 
     RowBox[{"HGEvolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
