Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{3, 4, 5, 6}, {
      Null, {{3, 4}, {1, 
       2}}, {<|"State1" -> 5, "State2" -> 6|>, <|
        "State1" -> 3, "State2" -> 4|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {
        UndirectedEdge[3, 4, <|"State1" -> 3, "State2" -> 4|>] -> Placed[
           Column[{
             Row[{
               Style["Branchial Edge", Bold]}], 
             
             Grid[{{"State 1:", 3}, {"State 2:", 4}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 
         UndirectedEdge[5, 6, <|"State1" -> 5, "State2" -> 6|>] -> Placed[
           Column[{
             Row[{
               Style["Branchial Edge", Bold]}], 
             
             Grid[{{"State 1:", 5}, {"State 2:", 6}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip]}, 
       EdgeStyle -> {
        UndirectedEdge[5, 6, <|"State1" -> 5, "State2" -> 6|>] -> Directive[
           Hue[0.89, 0.97, 0.71], 
           Arrowheads[0.02]], 
         UndirectedEdge[3, 4, <|"State1" -> 3, "State2" -> 4|>] -> Directive[
           Hue[0.89, 0.97, 0.71], 
           Arrowheads[0.02]]}, GraphLayout -> "LayeredDigraphEmbedding", 
       ImageSize -> 420, VertexLabels -> {4 -> Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 4}, {"CanonicalId:", 4}, {"Step:", 2}, {
               "IsInitial:", 0}, {
                Row[{"Edges (", 4, "):"}], {{
                  Style[4, Bold], 1, 2}, {
                  Style[11, Bold], 0, 2}, {
                  Style[12, Bold], 0, 1}, {
