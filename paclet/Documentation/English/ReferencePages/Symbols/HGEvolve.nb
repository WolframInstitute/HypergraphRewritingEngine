Cell[TextData[{
 "The setting selects when two applications are one event. Under ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "073f26db-34e5-c8c2-2ec4-bf85bc919a28"],
 ", the default, every application is its own event; three steps of the chain \
rule have nine:"
}], "ExampleText",
 CellID->484948520,ExpressionUUID->"27056d96-6b3e-545a-4d3a-84d00ecb3ea0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
