Cell[CellGroupData[{

Cell["\"EdgeDeduplication\"", "ExampleSubsection",
 CellID->29201913,ExpressionUUID->"2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],

Cell[TextData[{
 "By default a causal graph has one edge per pair of events. With ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1303f7c9-9cc9-b37e-4130-ee93157d1e44"],
 ", it has one edge for each hyperedge the consumer took from the producer, \
tagged with its ",
 Cell[BoxData["\"\<EdgeIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec53290-e027-d466-56fa-abdd91d3bf4c"],
 "; the counts and ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ec055d-da13-7d9a-4893-9d06dfa647e0"],
 " are unchanged. Three steps of the chain rule under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 " event identity have three causal pairs:"
}], "ExampleText",
 CellID->756445815,ExpressionUUID->"08a8ae1a-48d1-1e8c-3857-4044696464d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeCount", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
    " ", "\"\<CausalGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "Full"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1364299612,ExpressionUUID->"5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[1]= ",
 CellID->1998119732,ExpressionUUID->"151d482b-bd7d-21e9-4323-627534087333"]
}, Open  ]],

