Cell[CellGroupData[{

Cell["\"TransitionCost\"", "ExampleSubsection",
 CellID->1281844010,ExpressionUUID->"42383645-cae2-5342-73c7-a82eee9721a8"],

Cell["\<\
A rule that moves a loop along a hyperedge, from a 4-cycle with two loops at \
vertex 1. With the loop count as the field and a time step of 1/4, one step \
of the heat equation spreads the two loops to (1, 1/2, 0, 1/2) over the four \
vertices. Moving one loop to vertex 2 gives (1, 1, 0, 0), a residual of 1/2:\
\>", "ExampleText",
 CellID->206690953,ExpressionUUID->"0b11b9e5-bb8f-782a-392e-30cf3e3a4b70"],

Cell[CellGroupData[{

Cell[BoxData[
