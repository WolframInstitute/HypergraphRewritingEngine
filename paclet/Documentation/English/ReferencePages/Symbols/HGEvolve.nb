Cell[TextData[{
 Cell[BoxData["\"\<MemoryLimit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4172bb43-7495-39b2-7701-332d7d218b98"],
 " is the bytes of host memory an evolution may use. The default is half of \
the physical memory, and a larger value is lowered to the physical memory. An \
evolution that reaches the limit stops and gives the states and events it has \
built, with the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "overflow"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "230bdc3d-d065-76ac-5108-d666e1105cf6"],
 ". When the memory left cannot hold the whole result, the result has the \
four counts, and its states, events, relations and graphs are empty. The ",
 Cell[BoxData["\"\<Device\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7083369b-c5f9-1da2-20b0-afc4f38c6788"],
 " property gives the limit:"
}], "ExampleText",
 CellID->627846921,ExpressionUUID->"600ff364-211e-db59-1034-eb4e50a8a9a3"],

