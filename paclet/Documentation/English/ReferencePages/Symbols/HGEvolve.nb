  FontSize->0.9 Inherited,ExpressionUUID->
  "342ac02e-94b9-9375-5c29-d9881d4dfe5f"],
 ", many events join the same two states. Five steps of the chain rule have \
153 events between six states:"
}], "ExampleText",
 CellID->64218454,ExpressionUUID->"7e47f25d-3ed8-a4c4-267c-f407bb520e2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeCount", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "5", ",", 
    " ", "\"\<StatesGraph\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], "]"}], 
  "]"}]}], "Input",
