(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0606588-da16-174a-8969-35d4749dc9c2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d24cf94e-10f7-d44d-bcbc-007383217157"],
 "\[LineSeparator]",
 "performs multiway hypergraph rewriting of the hypergraph ",
 Cell[BoxData["initial"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79a1898c-7d06-2346-a946-0b73c3f3d878"],
 " under ",
 Cell[BoxData["rules"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4156342-4644-2e49-b2b9-035d8f2610a7"],
 " for ",
 Cell[BoxData["steps"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65cc3a60-8c50-4e48-8921-0e2dd4e41865"],
 " steps, returning the combined evolution/causal/branchial graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2cf18b88-8f72-0741-8f4a-449bf2498dd2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85c972a7-8888-ea4c-b474-871bff6f7f1b"],
 "\[LineSeparator]",
 "returns the specified ",
 Cell[BoxData["property"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0750b94-bc69-6441-b492-ad32b8b9bba8"],
 "."
}], "Usage",ExpressionUUID->"2fb63285-7314-bd45-ae84-8e2944b802f7"],

Cell[TextData[{
 "The ",
 StyleBox["rules", "TI"],
 " argument is a rule or list of rules of the form ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27712405-2e07-d94c-a9fc-a8cbf5d975ba"],
 " ",
 StyleBox["rhs", "TI"],
 ", e.g. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}]}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fb3ea7f6-ea3b-1f48-9130-200615d0480b"],
 ". Each side is a list of hyperedges and each hyperedge is a list of \
vertices. Vertices are variables that bind to (not necessarily distinct) \
vertices of the state hypergraph; a vertex appearing in ",
 StyleBox["rhs", "TI"],
 " but not ",
 StyleBox["lhs", "TI"],
 " is a freshly created vertex."
}], "Notes",ExpressionUUID->"2ae08547-5c01-2b41-b795-4302ead7d828"],

Cell[TextData[{
 "The ",
 StyleBox["initial", "TI"],
 " argument is a single hypergraph state or a list of states given as numeric \
vertex labels, e.g. ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57761fa7-477a-3a4e-8d13-90ecb17c0670"],
 ". It may also be a ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8c70e28-e7cb-5b4b-85fb-076e103bfa13"],
 " or a named initial condition (",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d3513ec-1f68-c347-a0e3-cd997d00ee12"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "444a693c-105b-504e-ace0-5b03c977221e"],
 ", \[Ellipsis]), shaped by the initial-condition options below."
}], "Notes",ExpressionUUID->"35836084-4e37-7448-96e9-5419014999ec"],

Cell[TextData[{
 "The ",
 StyleBox["steps", "TI"],
 " argument is an integer number of evolution steps."
}], "Notes",ExpressionUUID->"2a3b17af-57f2-7c4a-b581-187ad7e0cb53"],

Cell["\<\
The engine applies the rules in all possible ways (multiway evolution), \
optionally deduplicating isomorphic states, and builds the causal and \
branchial graphs. It runs in a standalone process, so a crash or abort never \
affects the notebook.\
\>", "Notes",ExpressionUUID->"60c054c9-c5e5-514b-a7d8-6c8a76ba8dac"],

Cell[TextData[{
 "The accepted values for ",
 StyleBox["property", "TI"],
 " include:"
}], "Notes",ExpressionUUID->"4b29b338-d5f6-7f49-b587-335236b18e81"],

