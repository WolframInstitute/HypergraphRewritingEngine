Cell["The genesis event is the first vertex of the causal graph:", \
"ExampleText",
 CellID->733532089,ExpressionUUID->"0df78371-259d-4014-3b8c-1b3b4c28137e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", 
   " ", "\"\<CausalGraphStructure\>\"", ",", " ", 
   RowBox[{"\"\<ShowGenesisEvents\>\"", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->373157308,ExpressionUUID->"2757147d-ed01-5031-4d6c-8e2684b4231b"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{"E", 0}, {"E", 1}, {"E", 2}, {"E", 3}}, {{{1, 2}, {2, 3}, {2, 
       4}}, Null, {<|"ProducerEvent" -> 0, "ConsumerEvent" -> 1|>, <|
        "ProducerEvent" -> 1, "ConsumerEvent" -> 2|>, <|
        "ProducerEvent" -> 1, "ConsumerEvent" -> 3|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {
        DirectedEdge[{"E", 0}, {"E", 1}, <|
           "ProducerEvent" -> 0, "ConsumerEvent" -> 1|>] -> Placed[
           Column[{
             Row[{
               Style["Causal Edge", Bold]}], 
             
             Grid[{{"Producer Event:", 0}, {"Consumer Event:", 1}}, Alignment -> 
              Left, Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 
         DirectedEdge[{"E", 1}, {"E", 3}, <|
           "ProducerEvent" -> 1, "ConsumerEvent" -> 3|>] -> Placed[
           Column[{
             Row[{
               Style["Causal Edge", Bold]}], 
             
             Grid[{{"Producer Event:", 1}, {"Consumer Event:", 3}}, Alignment -> 
              Left, Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 
         DirectedEdge[{"E", 1}, {"E", 2}, <|
           "ProducerEvent" -> 1, "ConsumerEvent" -> 2|>] -> Placed[
