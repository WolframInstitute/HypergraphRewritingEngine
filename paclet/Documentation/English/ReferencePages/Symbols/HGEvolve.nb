      FontSize->0.9 Inherited,ExpressionUUID->
      "20defbd0-ed8b-0b4e-a1c4-036213d48ad4"],
     "); off keeps each initial state a distinct entry point"
    }], "TableText",ExpressionUUID->"6e3cd274-10c4-354f-a03f-1e5975203821"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f7f4033e-515b-0f4b-834c-e59fb2d43aea"], Cell[TextData[Cell[
    BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
