Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9b9f37-eb8f-88a6-69b8-17708e3bda8c"],
 " is applied while the evolution runs, so it also determines which states \
are expanded. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ef0eca9-2ea7-fc5e-268f-05f34b53c6a4"],
 " identifies states whose edge lists are identical. This is finer than \
isomorphism: two isomorphic states with different vertex names stay separate. \
Initial states keep their own vertex names, so two initial states that differ \
only in vertex names are two states under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53b0040e-15e9-970f-014f-9e68a39dfa55"],
 "."
}], "Notes",
 CellID->1802489801,ExpressionUUID->"49c5479d-c9fe-ab26-7ffb-5ec6ef88f60c"],

Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73b5640c-4acf-57ea-214b-7e566f7a3d30"],
 " builds an event's identity from isomorphism-invariant components. ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12e31b8a-6cd9-3185-4290-92d4056d83ef"],
 " uses the canonical input and output states. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8dfb5f-95aa-8549-44b2-f3191c5cef93"],
 " also uses the step and the canonical positions of the consumed and \
produced edges within the state's isomorphism class; it needs ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77ba1ed5-dc9c-5ed1-1d59-979ed529243b"],
 ". ",
 Cell[BoxData["\"\<Positional\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b6086-f39f-774a-4229-79e3862a5d90"],
 " uses the same components with positions read from each state's own vertex \
labels, as the Wolfram Multicomputation paclet does. A list of any of ",
 Cell[BoxData["\"\<InputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "562fd52b-4ccb-95a8-7fd4-cd75657ffff2"],
 ", ",
 Cell[BoxData["\"\<OutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a176158-c8f1-b5ca-1a2d-7905e8851f10"],
 ", ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59294b9d-2c6b-0af3-08d7-62c7451e58d9"],
 ", ",
 Cell[BoxData["\"\<Rule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c93342e-976f-2690-74a0-ad88221b8cfa"],
 ", ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],
 " and ",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "386c40c3-2c7c-2bd7-6814-59ad4509793d"],
 " selects the components; in a list, ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38a5d185-6c33-4099-685a-c8ef05c612e3"],
 " is the input state with the consumed edges marked and ",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705b2160-d6f6-9bc7-2078-b94de280e92d"],
 " the output state with the produced edges marked, each up to isomorphism. A \
list runs on the CPU engine under ",
 Cell[BoxData[
  RowBox[{"TargetDevice", " ", "->", " ", "\"\<GPU\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ad5a48d-d13d-ee7b-6aea-3dd6e0c9b541"],
 "."
}], "Notes",
 CellID->115301326,ExpressionUUID->"3e286ad4-f19d-13f8-67d7-8391802861c2"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ae3c14-0aab-252d-7055-b65eaf5f8c77"],
 ", every property is the same as under full exploration; only the cost of \
the evolution changes. It needs ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3710829e-7f3a-eae8-5d2f-1bd87accb832"],
 ", and it is not applied with ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514f46f4-7214-5441-0775-5fbe07a13eab"],
 " or with ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a8341fe-fd5d-b2cd-0ab1-58bbf4e90017"],
 " and ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cf942e0-12f7-a17b-7487-5bcaa683f041"],
 "."
}], "Notes",
 CellID->1651187567,ExpressionUUID->"4db09b50-0334-b760-7b4f-131ab6c61a4a"],

Cell[TextData[{
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cb56032-9c81-172f-244b-7a7c15347a75"],
 ", ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f15dca-bfed-9606-038f-54943999fd6c"],
 ", ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5589ad74-704a-26e9-03b6-453e01fc8c33"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37fda5d4-10fa-7e26-5d82-3c9ea08f450c"],
 ", ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc64ef1-7b65-373d-14fe-67bb7e119a07"],
 ", ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "542582fc-1c6f-cfd5-7dda-1ba6951b953f"],
 " and ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ad84463-32de-d6a2-2af8-5e4d4768bc88"],
 " choose from the identity of each transition or state together with ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261459d-f728-27c9-621f-5cc682c28d13"],
 ". Under ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "331c7f17-1677-2611-6124-7751a3038d7b"],
 ", under ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14cbe893-f079-1a7f-3cc8-01dc810c6945"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a1d5a8b-943b-deab-6a23-53d51dcfa4f1"],
 ", and under ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "355f53e5-dafb-cebc-6365-4acede8f9486"],
 " ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "492c649c-8337-646c-78d4-7dc636c24eb6"],
 " or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1678747f-7a6a-a1d6-3e18-6e397f1cf33c"],
 ", every rank and every draw also reads the step, so a history that returns \
to an isomorphic state draws its choice there again. Under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c54ceec-a669-4ede-046b-e7c9d31c1424"],
 " without a step cap the ranks and draws read no step, so ",
 Cell[BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "336f4c4f-cb14-5955-6115-6628eea12bbf"],
 " keeps the same transitions as full exploration. The same seed keeps the \
same states at any thread count and on either device. A transition a cap does \
not keep is not taken."
}], "Notes",
 CellID->941376513,ExpressionUUID->"192b8c2c-1b0f-3631-4f28-26769ebb9d1b"],

Cell[TextData[{
 "Under ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2580083d-358c-3435-53bf-a267bc3e9f1f"],
 ", a transition's identity uses the symmetry class of each matched \
hyperedge, so transitions related by a symmetry of the state are kept or \
dropped together."
}], "Notes",
 CellID->2120243592,ExpressionUUID->"477fde83-a5ae-c17e-6d04-d7eccc589044"],

Cell[TextData[{
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0782fdeb-454d-5eca-2db1-f4b56cf82410"],
 " and ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69a01936-08b2-60cf-1f5f-9170a9473215"],
 " count successor states as ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "553ebd3d-d82b-159a-7cc5-3566d9de7fe0"],
 " identifies them: under ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c0b44c7-b7b3-5c45-1409-5da0c24626af"],
 " every transition makes its own state, under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4dba914e-52ed-e087-7b59-09286699b2ed"],
 " transitions that make identical edge lists make one state, and under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "497e5609-e734-e246-7f06-485292c6b0ac"],
 " transitions that make isomorphic states make one state. A successor state \
ranks by the lowest rank of the transitions into it, and every transition \
into a kept successor state is kept. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08c79fc2-e932-c645-38fc-16af88c4acaf"],
 " and ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2184153d-b162-7859-57bb-8d66c0174aa3"],
 " count transitions."
}], "Notes",
 CellID->1047559317,ExpressionUUID->"2402dcb3-2cfa-7570-4c31-d5fd448f5c5a"],

Cell[TextData[{
 Cell[BoxData["\"\<StateCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "554ef748-00c8-cf17-0375-ef12b162927d"],
 " orders the successor states of ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40bb2fe5-4c06-79cb-7058-c6cf65b34b11"],
 ", or the transitions of ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ee2421b-c68a-4a96-2692-6444f33f18fc"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79971006-243c-6fe2-2fac-8a604dc935c8"],
 ", by the cost of the state each one makes, the rank ordering states of \
equal cost. The cost is a pure function of the ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61109047-93e0-1377-172f-0a2125957e5d"],
 " names (",
 Cell[BoxData["#VertexCount"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c784b-10c0-0bab-5c24-7215a17559f1"],
 ", ",
 Cell[BoxData["#BallDimension"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4125a490-d89a-105a-70da-3dddd92f62a0"],
 ", \[Ellipsis]) built from real numbers, ",
 Cell[BoxData["+"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b67f461-4283-7871-391c-ee4b77364b5b"],
 ", ",
 Cell[BoxData["-"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79999c45-ea42-0b46-2fa6-162e8ff759ac"],
 ", ",
 Cell[BoxData["*"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fae9c0a-8a55-fd6e-0555-16542fe1c7b4"],
 ", ",
 Cell["/", "InlineCode",ExpressionUUID->
  "1ae1fb24-4e58-6c4d-4a9e-f28e6bed3697"],
 ", ",
 Cell[BoxData["Abs"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a4afb14-05e6-4298-3a49-f35eb39310e2"],
 ", ",
 Cell[BoxData["Min"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a681de3-120d-8f0a-4a17-94cda7b9d250"],
 ", ",
 Cell[BoxData["Max"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe8910c-2477-6bad-2597-09564d0239f7"],
 ", ",
 Cell[BoxData["Sqrt"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4724aa69-80a2-605c-6edb-4c33315732a6"],
 ", ",
 Cell[BoxData["Log"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7db6e0a3-5ee4-0113-2b4d-f90d5a915079"],
 ", ",
 Cell[BoxData["Exp"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64959d98-6722-362c-0caa-14c212d49d76"],
 " and powers with a constant exponent; any other expression returns ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f8c04ec-8c47-4bdf-05b3-9db625f21925"],
 " with the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "statecost"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023e8ab0-46e5-584b-33c5-23fa72902a91"],
 ". A state with no value for a name the cost reads, or whose cost is not a \
real number, has cost ",
 Cell[BoxData["Infinity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a0eac86-50d0-15df-0a35-45e061657f25"],
 ". The cost of a state is the same on both devices, so a cost-guided \
evolution keeps the same states at any thread count and on either device. \
Without a step cap the cost has no effect and the reply carries a warning."
}], "Notes",
 CellID->1820947576,ExpressionUUID->"58394c25-48c8-3ecd-09c7-658f69628417"],

Cell[TextData[{
 Cell[BoxData["\"\<TransitionCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1424a2b0-695c-dfcb-3ddb-3bfa08eea511"],
 " scores a transition from its parent state and its child state. A rewrite \
keeps the ids of the vertices it does not delete, so a vertex of both states \
has one id in both. For a field f on the vertices and a time step dt, the \
residual at a vertex v of both states is f_child(v) - f_parent(v) - dt (A - \
D) f_parent(v), where A - D is the graph Laplacian of the parent under ",
 Cell[BoxData["\"\<StatisticsGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05101942-3b9c-ad10-332f-912cbe2ef47a"],
 ", and the cost is the sum of the squared residuals that are real numbers. \
The fields are ",
 Cell[BoxData["\"\<Degree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35394d45-77a0-03f4-5cc7-652f025551de"],
 " (the degree of v in that graph), ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f9454e1-244e-40e6-65ac-4dcb4dfb12cc"],
 " (the ",
 Cell[BoxData["\"\<VertexCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530b93a6-4244-79d7-0108-0a0077f14b3d"],
 " of v), ",
 Cell[BoxData["\"\<LoopCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c785ed8-c9e5-405c-7418-5785ef9012a6"],
 " (the hyperedges whose every vertex is v) and ",
 Cell[BoxData["\"\<EdgeMultiplicity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a66b72e-8103-1d0f-3a1d-2e8830b66455"],
 " (the hyperedges that contain v and are not loops, each copy counted). \
Under ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6206b938-b2f8-72db-123d-3165c68d4021"],
 " a successor state's cost is the lowest cost of a transition into it. \
Without a step cap or ",
 Cell[BoxData[
  RowBox[{"\"\<Search\>\"", " ", "->", " ", "\"\<BestFirst\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a01a055-721a-3362-2a3e-3a1f07ac9e48"],
 " the cost has no effect and the reply carries a warning."
}], "Notes",
 CellID->670734585,ExpressionUUID->"425e231b-d90e-d650-7265-bb44d8b8bcba"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<Search\>\"", " ", "->", " ", "\"\<BestFirst\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f4b19d7-d2e6-1d55-1548-9090e69367bf"],
 " starts from the initial states with path cost 0 and repeatedly takes the \
transition whose child has the lowest path cost, the parent's path cost plus \
the transition's cost, the transition's rank breaking ties. Under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "266a3a12-a29b-0b72-4e69-bc5fd72e5658"],
 " or ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b97aeb9-f3a3-063a-49ac-47e286566d00"],
 " states a transition into a state already created is dropped. The search \
stops after ",
 Cell[BoxData["\"\<SearchBudget\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "670ec096-5157-8cf5-0d35-d9d060e3d6df"],
 " states or when no transition is left, and a state at the last step is not \
expanded. One transition is taken at a time, so a search with a given ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a46f8a5-a076-b8c1-7a7d-f10ed1000a2b"],
 " creates the same states at any thread count. The step caps, ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b9d6462-a0fd-67c7-29a3-7e4fd0884d2d"],
 ", ",
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c567373-a618-e547-046e-6b3cd392cfad"],
 ", ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5028993e-6f44-360e-01d7-11780af69d54"],
 ", ",
 Cell[BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05297336-3344-a7f5-2cd7-6b7046f60ddf"],
 ", ",
 Cell[BoxData["\"\<Generational\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75fa11b5-921a-0030-2399-88ff27af531a"],
 " and ",
 Cell[BoxData["\"\<EventOrderingFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d27580a-3980-0923-54dd-5254b8355809"],
 " do not apply with it, and the reply carries a warning when one is given. \
",
 Cell[BoxData["\"\<TransitionCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "077289f0-6175-2cad-2d01-20ba100076f7"],
 " runs on both devices, which compute the same costs and keep the same \
states. ",
 Cell[BoxData[
  RowBox[{"\"\<BeamCost\>\"", " ", "->", " ", "\"\<Path\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "133b68ba-8b92-4fbc-42d8-81e42e271586"],
 " runs on both devices, with the same path costs. ",
 Cell[BoxData[
  RowBox[{"\"\<Search\>\"", " ", "->", " ", "\"\<BestFirst\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6db49e4d-4459-39d0-1b4b-10176ded8b3a"],
 " runs on the CPU engine, and with ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01e45bb6-31a6-d4bb-379c-52f04050be81"],
 " the reply carries a warning."
}], "Notes",
 CellID->58232708,ExpressionUUID->"638a875f-059e-01af-1189-1f19ac2b53f5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<BeamCost\>\"", " ", "->", " ", "\"\<Path\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b1c9c05-9360-5fc6-6923-166f2615252c"],
 " ranks the transitions of a ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8f8704-dbc1-ad9f-5bb4-1f61de75f7e5"],
 " step by the path cost of the state each one makes, the path cost of its \
parent plus the transition's cost, where ",
 Cell[BoxData[
  RowBox[{"\"\<BeamCost\>\"", " ", "->", " ", "\"\<Transition\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bacb1bf-0091-7884-2953-28f9b1244aee"],
 " ranks them by the transition's cost alone. A successor state's path cost \
is the lowest over the transitions into it, and of those transitions only the \
ones of lowest path cost and rank are taken, so a successor state is made \
once. With ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Automatic"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e949b39-c960-dcff-16ab-1362e81aa6c5"],
 ", states with the same edge list are one successor, and the beam drops \
duplicates without canonicalization. The step needs ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52d3365b-85bc-1911-02e0-a8052c49687b"],
 " and a ",
 Cell[BoxData["\"\<StateCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "058c1579-2127-d4ed-33b3-8d2350d3be37"],
 " or ",
 Cell[BoxData["\"\<TransitionCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f55ae27-0b76-e8ec-756a-4781ae00ba36"],
 "; otherwise the reply carries a warning and the step ranks by transition."
}], "Notes",
 CellID->393464600,ExpressionUUID->"62fbf51e-f93c-ccd0-1298-ed5bf8ce963a"],

Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "011d018b-0453-500f-3722-98d5ade62355"],
 " keeps a state's lowest-keyed transitions when every draw at that state \
failed, so a sparse sample reaches the requested depth. ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b868176-6936-78c0-49bd-193008c34a2a"],
 " does not."
}], "Notes",
 CellID->1484396876,ExpressionUUID->"317554d9-f61a-a01f-670b-4d8283acf365"],

Cell[TextData[{
 "Without a ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "581509a3-40d5-fdc4-082a-a00d7161c72e"],
 " each call draws a new seed, as other random functions do; give ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27a46d13-c303-51d0-4d5b-855cf6b6233a"],
 " or call ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17c64253-a2be-52b9-3dfe-641cd74b2083"],
 " first to repeat a sampled run."
}], "Notes",
 CellID->1149283354,ExpressionUUID->"5a34ce21-af18-53d3-0bcb-e78acaad2139"],

Cell[TextData[{
 Cell[BoxData["\"\<Threads\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1308debe-b866-1363-4137-d7f839137e49"],
 " and ",
 Cell[BoxData["\"\<Tuning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "339fc10a-19b9-5d82-61a4-d954984c27e8"],
 " change how fast an evolution runs and how much memory it takes; the \
states, events and relations are the same at every setting. ",
 Cell[BoxData["\"\<Tuning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "442b12f5-789a-53e1-6c28-8bbf792f21cb"],
 " takes an association of names and integers: ",
 Cell[BoxData["\"\<CausalSetCapacity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39387274-e40a-435c-68d8-74318dbf11a6"],
 " (the first table size, per shard, of the CPU engine's causal relation \
sets), ",
 Cell[BoxData["\"\<ExpandChunk\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70ecc98e-c53f-f68b-2093-e0ebeccbdcd1"],
 " (the matches of one state rewritten per task on the CPU), ",
 Cell[BoxData["\"\<GPUBlocks\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53e7ddcf-0b8d-05e4-019c-d4a9ae386fce"],
 " (the blocks of the GPU's persistent kernel), ",
 Cell[BoxData["\"\<GPUBacklog\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a830965-7851-22cf-4ab0-a14f79e47015"],
 " (the waiting matches below which a GPU block takes one at a time), ",
 Cell[BoxData["\"\<GPUMemoryLimit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],
 " (the bytes of device memory a GPU evolution may use), ",
 Cell[BoxData["\"\<GPUL2Persist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2411395d-4500-dc0b-4c2e-b1076cbaa751"],
 " (the bytes of L2 cache the GPU keeps for its state table; ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51798d79-74e7-e8a1-0706-25237c93ba8b"],
 " keeps none) and ",
 Cell[BoxData["\"\<MemoryLimit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],
 " (the bytes of host memory an evolution may use). A name it does not list \
is skipped with the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "warn"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa139-5ae3-ed74-4004-39635e97b45e"],
 ". The environment variables ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_THREADS"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0084d900-0120-94d6-30bb-d16ab0dafe3c"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_CAUSAL", "_SET", "_CAPACITY"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45e3bdb3-b7b8-8152-7390-34fcc232d3b8"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_EXPAND", "_CHUNK"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e5e1e6c-8075-0eb3-0665-903631005499"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_GPU", "_BLOCKS"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b122816-0897-a47c-6921-c250a9230f46"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_GPU", "_BACKLOG"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12228eb7-81d1-9f6b-43d1-27f13065e5b1"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_GPU", "_MEMORY", "_LIMIT"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c4e3d89-d3d8-0dbe-3475-b4d2e66d5784"],
 ", ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_GPU", "_L2", "_PERSIST"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44dcab5a-698d-607d-6ce3-430408383347"],
 " and ",
 Cell[BoxData[
  RowBox[{"HG_TUNE", "_MEMORY", "_LIMIT"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "268a9802-0d7f-2bfd-4e89-126ca40a79c7"],
 " set the same values for every evolution of the engine process; an option \
given to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79bc5755-bb31-5780-2f44-4f1f3ec43dea"],
 " takes precedence."
}], "Notes",
 CellID->1092188694,ExpressionUUID->"0ff00406-ec89-251c-358f-9e63853d8c66"],

Cell[TextData[{
 "On the CPU, an evolution under ",
 Cell[BoxData["\"\<EventOrderingFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6791a5-5599-4f2a-2b1c-080f5c2c1270"],
 " runs on one worker thread at every value of ",
 Cell[BoxData["\"\<Threads\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7441be-5925-9c2b-240c-58f858d1e771"],
 ". Its events are applied one at a time, each after the one before."
}], "Notes",
 CellID->559599970,ExpressionUUID->"5ff4eb8a-8686-c1c6-058b-02d43330932c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "049abcb6-c083-4b47-2cb9-35f3f13619ad"],
 " runs the evolution on the GPU engine bundled for the platform, which gives \
the same states, events and relations as the CPU. The GPU engine needs an \
NVIDIA GPU of compute capability 7.5, 8.0, 8.6, 8.9 or 9.0 and NVIDIA driver \
580 or newer. Where no GPU engine is bundled, or the machine has no usable \
NVIDIA GPU, the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "gpudev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00908b6d-9173-71f0-30af-2337200643da"],
 " names the reason and the evolution runs on the CPU. The result is kept for \
the Wolfram Language session, so later GPU evaluations go to the CPU with the \
same message. ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<GPU\>\"", ",", " ", 
     RowBox[{"\"\<Strict\>\"", " ", "->", " ", "True"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c438d61-2567-fb5f-3470-254b4c13c9a5"],
 " gives ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3129044e-2557-7c3e-60d6-9e284ce24704"],
 " with the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "nogpu"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "185e1b20-c9fe-9997-4865-928def88ebfd"],
 " instead. An evolution whose result is partial, such as a GPU evolution \
that reaches a capacity limit or an evolution on either device that reaches \
the ",
 Cell[BoxData["\"\<MemoryLimit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],
 " of ",
 Cell[BoxData["\"\<Tuning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66994d41-411f-db5d-0ea7-652b70aba9a7"],
 ", issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "overflow"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba5d17e-cdbf-5380-095a-c93be44a21ea"],
 " with the reason and gives the partial result."
}], "Notes",
 CellID->1710123944,ExpressionUUID->"4459b86e-fafc-12f5-6c66-324bfe8960df"],

Cell[TextData[{
 "A generated initial condition is named by ",
 StyleBox["init", "TI"],
 ": ",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bcb2561-df35-3b41-39c8-bd4adac189ab"],
 " (also ",
 Cell[BoxData["\"\<GridWithHoles\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cdc7c52-f996-171f-54e4-761ff8237a65"],
 "), ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a04a347-6624-93dc-1a3b-3b2113d6e126"],
 ", ",
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fa3b0bf-db30-02a1-4550-29f8dec5508b"],
 ", ",
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11dd9886-a103-697c-47e2-11e3d0b63846"],
 ", ",
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d16072b-4094-e7d7-0b2d-9f757126cd3d"],
 ", ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e71c00a-9fc6-07cd-160e-da541a736d17"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59da3beb-dbdf-0123-0ff9-b2b4de6a5009"],
 " (also ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "28f3c6b4-96e3-425b-5880-dffe229610a1"],
 "), ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50dcf632-b06e-d3ec-00e3-e87fc118a136"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0192d3b7-44a5-149f-37a1-caf16d507ee5"],
 " or ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0300f609-8c78-c232-313f-e85325f29118"],
 ". The same names go in the ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "366efd8d-b3b0-5f87-5e15-f4d6c64525ed"],
 " key of an association, where the other keys shape the instance and take \
precedence over the options below. The association also takes keys with no \
option: ",
 Cell[BoxData["\"\<RandomizeDirections\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3db21443-28a2-09d2-6b41-8e2d49575b38"],
 " (",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bbb6266-506e-8b43-5958-84406118d9a9"],
 " by default, which reverses each edge of a grid, a surface or a ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e86e78b-e825-43de-16bd-fed489d01124"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00acb0de-f92e-37b6-3053-299bf8d89d9c"],
 " or ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "688c2685-a509-dc5c-18b3-bfeeccbda6a6"],
 " cloud with probability 1/2, and ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ceaa2e1-4528-9e89-54e9-3bcb6cc2e4d3"],
 ", which gives the same edge directions for every seed), ",
 Cell[BoxData["\"\<Diagonals\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1303f7c9-9cc9-b37e-4130-ee93157d1e44"],
 " (",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ec53290-e027-d466-56fa-abdd91d3bf4c"],
 " by default, and ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18ec055d-da13-7d9a-4893-9d06dfa647e0"],
 ", which adds both diagonals of each cell of a ",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "210c0b92-bdf5-0dca-5733-a2dc3b805710"],
 "), ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08a8ae1a-48d1-1e8c-3857-4044696464d6"],
 " (the radius of a ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a42a6f1-18c8-51d7-0a71-3fbb997d233d"],
 ", ",
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "151d482b-bd7d-21e9-4323-627534087333"],
 ", ",
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5613a8b7-1620-2919-7e20-41f1a3d57863"],
 " or ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae8fe52-8d2a-0d13-0a97-f01c24df5479"],
 ", 1 by default and 2 for ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9a61ac-db6f-0823-69ba-7809de1a5b09"],
 "), ",
 Cell[BoxData["\"\<MajorRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ebbb135-9363-cdcb-4658-297f26179711"],
 " and ",
 Cell[BoxData["\"\<MinorRadius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fac2774-ed95-ff32-6553-bf318421c218"],
 " (the radii of a ",
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e0bfcd9-47ee-c5d1-2608-f5837198af3b"],
 ", 3 and 1 by default). The radii change the coordinates of ",
 Cell[BoxData["\"\<InitialCondition\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bce04d4-edb5-1ec8-29f5-9d9184406412"],
 " and not the edges."
}], "Notes",
 CellID->934597701,ExpressionUUID->"04eac529-5321-5efa-2ce9-dd7366d424c0"],

Cell["The initial-condition options are:", "Notes",
 CellID->284780108,ExpressionUUID->"121d8e7a-a943-ef24-4222-2027c8f7b20e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3f53e49d-d2a9-b4ee-6560-fdc6e75d1e34"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"672c7908-ff3c-85a7-0ed4-7155faceef8d"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"4f36945c-6fe2-68e0-76cd-0e0609973aca"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"250c2a2d-8da6-5f9d-5333-cc77245325e7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "67928f76-a8f6-4c39-0da1-2733c8831703"], Cell[TextData[Cell[
    BoxData["\"\<GridWidth\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6f8d9e4d-778e-395a-15b2-101702388ba0"]], "TableText",ExpressionUUID->
     "4897ab63-07fe-7036-78ac-434db18b431c"], Cell[TextData[Cell[BoxData[
    "10"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3afe1774-f6b9-1a20-6a85-8f31834c690a"]], "TableText",ExpressionUUID->
     "0cb96547-3d6c-b437-3447-7d21b41e1f1d"], Cell[TextData[{
     "the width of a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2231aed9-983c-87b7-53ce-478319ceed9d"],
     " (key ",
     Cell[BoxData["\"\<Width\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4d324fdb-2677-e56b-74c2-66855303cfb1"],
     ") and the resolution of a curved surface (key ",
     Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5da8286f-a7a3-9cec-0b57-c248d257e636"],
     ")"
    }], "TableText",ExpressionUUID->"7d602230-5f26-2f06-2b1f-c47a5ad3726c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "77db54cc-ee9f-ec5f-1df9-4da98b2bb6a5"], Cell[TextData[Cell[
    BoxData["\"\<GridHeight\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6a072e47-9a01-f132-1a3c-c0211fb5c018"]], "TableText",ExpressionUUID->
     "03b41a97-fa59-5a01-314b-93d0ffec296b"], Cell[TextData[Cell[BoxData[
    "10"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "425dab48-397f-3702-7262-4312b80b9a68"]], "TableText",ExpressionUUID->
     "0b03a0e0-ac2b-54e8-3930-39cdc5de3e32"], Cell[TextData[{
     "the height of a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "23998a05-7963-184f-51a6-2c6f78166a95"],
     ", ",
     Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "422628af-426c-374e-73dd-c109771e9d94"],
     " or ",
     Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "26e7e4d8-634d-0d10-4e9c-fd8216f8547a"],
     " (key ",
     Cell[BoxData["\"\<Height\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "027e254c-1480-02c1-3205-bd169d35502b"],
     ")"
    }], "TableText",ExpressionUUID->"6456a901-44b8-c553-0c6d-416b6d32afb9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5de3bc1f-ff0d-b0a4-0b90-3658fab9028e"], Cell[TextData[Cell[
