    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Lookup", "[", "\"\<CanonicalHash\>\"", "]"}], " ", "@", " ", 
  RowBox[{"Values", " ", "@", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"chain", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", 
     " ", "\"\<States\>\"", ",", " ", 
     RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
    "]"}]}]}]}], "Input",
