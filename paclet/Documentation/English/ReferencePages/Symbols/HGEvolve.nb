Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "performs multiway hypergraph rewriting of the hypergraph ",
 Cell[BoxData["initial"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75d93363-5da6-51a4-23e6-ab4d5453238e"],
 " under ",
 Cell[BoxData["rules"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 " for ",
 Cell[BoxData["steps"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 " steps, returning the combined evolution/causal/branchial graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 "\[LineSeparator]",
 "returns the specified ",
 Cell[BoxData["property"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 "."
}], "Usage",
 CellID->329621944,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell[TextData[{
 "The ",
 StyleBox["rules", "TI"],
 " argument is a rule or list of rules of the form ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 " ",
 StyleBox["rhs", "TI"],
 ", e.g. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}]}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 ". Each side is a list of hyperedges and each hyperedge is a list of \
vertices. Vertices are variables that bind to (not necessarily distinct) \
vertices of the state hypergraph; a vertex appearing in ",
 StyleBox["rhs", "TI"],
 " but not ",
 StyleBox["lhs", "TI"],
 " is a freshly created vertex."
}], "Notes",
 CellID->515379898,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "The ",
 StyleBox["initial", "TI"],
 " argument is a single hypergraph state or a list of states given as numeric \
vertex labels, e.g. ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 ". It may also be a ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 " or a named initial condition (",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 ", \[Ellipsis]), shaped by the initial-condition options below."
}], "Notes",
 CellID->604760901,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 "The ",
 StyleBox["steps", "TI"],
 " argument is an integer number of evolution steps."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["\<\
The engine applies the rules in all possible ways (multiway evolution), \
optionally deduplicating isomorphic states, and builds the causal and \
branchial graphs. It runs in a standalone process, so a crash or abort never \
affects the notebook.\
\>", "Notes",
 CellID->448336599,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[TextData[{
 "The accepted values for ",
 StyleBox["property", "TI"],
 " include:"
}], "Notes",
 CellID->970785311,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

