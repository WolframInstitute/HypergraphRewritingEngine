Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ec506ef-e5f2-084e-bab9-662288255bbe"],
 " applies on the CPU. Under ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb30f6bf-0b99-c048-b409-c37fa6e1b7a7"],
 " it is reported in ",
 Cell[BoxData["\"\<Warnings\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fd757c9-1844-9842-910d-43e8ae1a7d19"],
 " and the evolution runs unsampled, rather than silently returning a \
different answer per device."
}], "ExampleText",ExpressionUUID->"0ee3dc04-6311-bc49-87bc-a1449882d7be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"RuleWeights\"", "ExampleSubsection",ExpressionUUID->"bb29b37e-e1be-364b-8473-9d8719a3366e"],

Cell[TextData[{
 "Per-rule multipliers on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a251a31-5b63-fd42-a301-6d966370a7bd"],
 ", given in rule order. The rate a rule's transitions are drawn at is the \
product of the two, so the knobs compose rather than one replacing the other: \
a rate of 1 with weights ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed6a4c86-1c41-a449-aa4b-d15e1ac5de97"],
 " still samples, dropping the second rule entirely and leaving the first \
untouched."
}], "ExampleText",ExpressionUUID->"f0f8cdc2-e1a2-bc48-a549-b94bd65330c4"],

Cell[TextData[{
 "A short list is a partial override. Rules past its end take weight 1, so \
weighting the first of five rules does not require spelling out four ones. ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebba03ea-9596-7a4d-a7d7-81f94996e179"],
 " weights every rule equally, which is what a run that sets nothing gets."
}], "ExampleText",ExpressionUUID->"c8cb3dea-58c0-4242-b528-c2837c3546a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", "\n", "  ", 
   RowBox[{"\"\<RuleWeights\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1.", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73d38676-933a-9f40-bd3c-5f196fd8523b"],

