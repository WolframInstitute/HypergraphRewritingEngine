Cell[CellGroupData[{

Cell["\"ExploreFromCanonicalStatesOnly\"", "ExampleSubsection",ExpressionUUID->"0227c37b-087b-b24d-8ab6-271cc95a80dc"],

Cell[TextData[{
 "Quotient exploration expands each canonical state once, at its shortest \
depth, rather than expanding every isomorphic copy \[LongDash] the compact \
way to explore a symmetric system. It is off by default and pairs with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d1305d9f-ed4a-7341-a38f-d6af1caeded4"],
 ":"
}], "ExampleText",ExpressionUUID->"414bfe2c-9ee8-a741-bc2e-b57656081a3b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<StatesGraph\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
    "True"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"593790c9-7642-c643-a5ab-0b7a67ad41ff"],

