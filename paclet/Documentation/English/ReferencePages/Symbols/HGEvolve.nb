Cell["Cross-run isomorphism hashes", "ExampleSubsection",ExpressionUUID->"1c0c2d13-1234-aa4b-9467-934f854a443f"],

Cell[TextData[{
 "Run-local state ids differ between runs, but ",
 Cell[BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b50b3054-93c7-ab4d-b6cc-95c4bbe477b4"],
 " attaches an isomorphism-stable hash usable to fuse pruned runs by \
isomorphism class:"
}], "ExampleText",ExpressionUUID->"81d24995-78a8-7447-bad3-10b4ec619a55"],

