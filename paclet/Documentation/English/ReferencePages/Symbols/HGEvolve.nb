Cell[CellGroupData[{

Cell["\"TargetDevice\"", "ExampleSubsection",ExpressionUUID->"63f10286-17d4-2145-83e5-466bad4c3c0e"],

Cell[TextData[{
 "Evolution runs on the CPU by default. Where a GPU build is bundled, ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49619137-01d7-884c-a636-69b3baad37cf"],
 " runs on the device; otherwise it falls back to the CPU with a message. The \
GPU engine honors the same ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fa97633-b3bb-d747-a062-e236da218380"],
 " modes (",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46cb7e4f-c2ba-0f44-8e30-15d1a77aaa2a"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b07a54a4-e9fd-e543-b2b4-e9f43be7cf8c"],
 ", ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b42d3de-d8d7-cc43-8ebc-7428325b7a18"],
 ") as the CPU, and its state counts match the CPU's in every mode:"
}], "ExampleText",ExpressionUUID->"8700d214-c80b-f146-bcf8-e0a524fd0ede"],

