Cell[TextData[{
 "A styled graph draws every state, so a styled picture of a large evolution \
is slow to render and hard to read. The ",
 Cell[BoxData["Structure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3eb66b53-0a81-4482-664d-831daf342ee8"],
 " graphs and ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4513a2b6-5679-71cc-7320-3bf0630c4316"],
 " keep a picture small. The Wolfram Physics Project rule reaches 45 states \
up to isomorphism in four steps:"
}], "ExampleText",
 CellID->1418099714,ExpressionUUID->"0a5000e8-62c3-6dca-3a6f-99b217763710"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
