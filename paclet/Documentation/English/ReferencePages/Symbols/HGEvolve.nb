(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"375ffa9c-2d94-0645-b1dd-1e7a50f92491"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c27556b7-b746-f04d-a06a-734e90667482"],
 "\[LineSeparator]",
 "performs multiway hypergraph rewriting of the hypergraph ",
 Cell[BoxData["initial"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef93f556-1e28-2e46-96af-935f5e096061"],
 " under ",
 Cell[BoxData["rules"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c3e5498-d783-0945-9a00-bfe8e91752bc"],
 " for ",
 Cell[BoxData["steps"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b3b9152-0c36-574b-8bdf-132ceb317f0e"],
 " steps, returning the combined evolution/causal/branchial graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5ae43b1f-48f3-4746-89f5-5ce9cf24e08c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74e7fe37-7f39-b14f-9b9e-a9c033459b9f"],
 "\[LineSeparator]",
 "returns the specified ",
 Cell[BoxData["property"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a20b75a0-b207-1c47-afc8-bd74be4f90ec"],
 "."
}], "Usage",ExpressionUUID->"3db1cfc6-e46a-ea4c-83df-d424db578fc1"],

Cell[TextData[{
 "The ",
 StyleBox["rules", "TI"],
 " argument is a rule or list of rules of the form ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e2406e5-cfe3-ca44-8f17-1164cf7ca010"],
 " ",
 StyleBox["rhs", "TI"],
 ", e.g. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}]}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "001f2651-0e95-7741-96f2-884186681eaf"],
 ". Each side is a list of hyperedges and each hyperedge is a list of \
vertices. Vertices are variables that bind to (not necessarily distinct) \
vertices of the state hypergraph; a vertex appearing in ",
 StyleBox["rhs", "TI"],
 " but not ",
 StyleBox["lhs", "TI"],
 " is a freshly created vertex."
}], "Notes",ExpressionUUID->"7bccbaa3-045e-b344-a147-c7d3a1bbf226"],

Cell[TextData[{
 "The ",
 StyleBox["initial", "TI"],
 " argument is a single hypergraph state or a list of states given as numeric \
vertex labels, e.g. ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f6b57-7fad-ce41-9459-536b3f55d7e1"],
 ". It may also be a ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aaa9ad74-1049-bd47-9677-156cde3cf0ba"],
 " or a named initial condition (",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20ed36dc-e284-fb47-a102-0d8867fec79c"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4203e9b0-373b-3d43-9f5e-cb513a982df6"],
 ", \[Ellipsis]), shaped by the initial-condition options below."
}], "Notes",ExpressionUUID->"193b8e10-b8f8-c142-be12-fc8f93197772"],

Cell[TextData[{
 "The ",
 StyleBox["steps", "TI"],
 " argument is an integer number of evolution steps."
}], "Notes",ExpressionUUID->"8678df40-68b3-fe4c-9137-949a80872419"],

Cell["\<\
The engine applies the rules in all possible ways (multiway evolution), \
optionally deduplicating isomorphic states, and builds the causal and \
branchial graphs. It runs in a standalone process, so a crash or abort never \
affects the notebook.\
\>", "Notes",ExpressionUUID->"a48a756f-8c10-f94d-ad3d-7636ffb46bda"],

Cell[TextData[{
 "The accepted values for ",
 StyleBox["property", "TI"],
 " include:"
}], "Notes",ExpressionUUID->"350efac1-4e07-e046-a181-4cacc56bec07"],

