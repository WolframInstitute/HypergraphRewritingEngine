Cell[CellGroupData[{

Cell["\"MatchesPerStateRule\"", "ExampleSubsection",
 CellID->1016696988,ExpressionUUID->"3129044e-2557-7c3e-60d6-9e284ce24704"],

Cell["\<\
A positive value keeps at most that many of a state's transitions for each \
rule. They are chosen after the state's matching is complete, by the \
transitions' identities and the seed, so the same transitions are kept at any \
thread count. Keeping one transition per state makes four steps of the chain \
rule a single path:\
\>", "ExampleText",
 CellID->1351390621,ExpressionUUID->"185e1b20-c9fe-9997-4865-928def88ebfd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeList", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1059777221,ExpressionUUID->"79986dc0-6b5a-b4b1-2fa7-84aa0eec1e9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"0", "1", 
     RowBox[{"\[LeftAssociation]", 
       RowBox[{"\"EventId\"", "\[Rule]", "0"}], "\[RightAssociation]"}]},
    "DirectedEdge"], ",", 
   TemplateBox[{"1", "2", 
     RowBox[{"\[LeftAssociation]", 
       RowBox[{"\"EventId\"", "\[Rule]", "1"}], "\[RightAssociation]"}]},
    "DirectedEdge"], ",", 
   TemplateBox[{"2", "3", 
     RowBox[{"\[LeftAssociation]", 
       RowBox[{"\"EventId\"", "\[Rule]", "2"}], "\[RightAssociation]"}]},
    "DirectedEdge"], ",", 
   TemplateBox[{"3", "4", 
     RowBox[{"\[LeftAssociation]", 
       RowBox[{"\"EventId\"", "\[Rule]", "3"}], "\[RightAssociation]"}]},
    "DirectedEdge"]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1328048569,ExpressionUUID->"66994d41-411f-db5d-0ea7-652b70aba9a7"]
}, Open  ]],

