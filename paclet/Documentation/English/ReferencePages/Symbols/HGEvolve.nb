Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01d0bcaf-07fb-bb4f-8ef3-f31e9a8926a4"],
 " applies on BOTH devices, and the same seed selects the same subgraph on \
either: the keep-or-drop decision is one shared body reached from the host \
engine and from the device rewrite kernel alike, keyed on the transition's \
own isomorphism-invariant identity rather than on any scheduling order."
}], "ExampleText",ExpressionUUID->"f18fa5bb-47d4-c544-8c30-eeb07458acac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"RuleWeights\"", "ExampleSubsection",ExpressionUUID->"1f4f9d7f-39a7-a84f-9f77-925303a0d989"],

Cell[TextData[{
 "Per-rule multipliers on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84743117-6b30-6044-82d7-c13e6976eb1b"],
 ", given in rule order. The rate a rule's transitions are drawn at is the \
product of the two, so the knobs compose rather than one replacing the other: \
a rate of 1 with weights ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bebbeff1-aa39-3741-b854-c3b5307c6192"],
 " still samples, dropping the second rule entirely and leaving the first \
untouched."
}], "ExampleText",ExpressionUUID->"9f9afab1-e65e-3e46-9f0a-d3aab5bd6968"],

Cell[TextData[{
 "A short list is a partial override. Rules past its end take weight 1, so \
weighting the first of five rules does not require spelling out four ones. ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f62e467-d95a-0e4a-9712-e7fec9135942"],
 " weights every rule equally, which is what a run that sets nothing gets."
}], "ExampleText",ExpressionUUID->"26d2aa84-dfd4-5b4a-be5d-886cdc3a4896"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", "\n", "  ", 
   RowBox[{"\"\<RuleWeights\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1.", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"188d7769-486c-7d48-bb85-811a83d58e22"],

