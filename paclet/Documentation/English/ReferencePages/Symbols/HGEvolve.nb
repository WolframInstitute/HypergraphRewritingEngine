               GridBox[{{"\"Id:\"", "11"}, {"\"Step:\"", "6"}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> 
                False, GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
                GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.5}}}], 
               "Grid"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
            DefaultBaseStyle -> "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
            GridBoxSpacings -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{0.5}}}], "Column"]],
         Annotation[#, 
          Column[{
            Row[{
              Style["State", Bold]}], 
            
            Grid[{{"Id:", 11}, {"Step:", 6}}, Alignment -> Left, 
             Spacings -> {1, 0.5}]}, Spacings -> 0.5], "Tooltip"]& ]}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[1]= ",
 CellID->514156622,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 " applies on BOTH devices, and the same seed selects the same subgraph on \
either: the keep-or-drop decision is one shared body reached from the host \
engine and from the device rewrite kernel alike, keyed on the transition's \
own isomorphism-invariant identity rather than on any scheduling order."
}], "ExampleText",
 CellID->1700796256,ExpressionUUID->"11cf5d11-52cc-ddbb-47f5-555b677ea781"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"RuleWeights\"", "ExampleSubsection",
 CellID->532325348,ExpressionUUID->"7ba8138a-66ce-478c-2957-8ad4137b2dd6"],

Cell[TextData[{
 "Per-rule multipliers on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],
 ", given in rule order. The rate a rule's transitions are drawn at is the \
product of the two, so the knobs compose rather than one replacing the other: \
a rate of 1 with weights ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fd66644-13e4-6fa7-15ee-782ea591358d"],
 " still samples, dropping the second rule entirely and leaving the first \
untouched."
}], "ExampleText",
 CellID->793533782,ExpressionUUID->"00abf1cf-696b-3507-30a8-e8a9081f9c6d"],

Cell[TextData[{
 "A short list is a partial override. Rules past its end take weight 1, so \
weighting the first of five rules does not require spelling out four ones. ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 " weights every rule equally, which is what a run that sets nothing gets."
}], "ExampleText",
 CellID->868578254,ExpressionUUID->"03dda600-4b0b-c3af-31e2-386a6ebf91f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
