    }], "TableText",ExpressionUUID->"06385f5e-e9d4-4e6c-2fd8-571b886114b6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "25d2fb85-296f-82e5-53e1-f2ef481bd0cf"], Cell[TextData[Cell[
    BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
