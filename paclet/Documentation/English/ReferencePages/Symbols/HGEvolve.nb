Cell[CellGroupData[{

Cell["\"ExploreFromCanonicalStatesOnly\"", "ExampleSubsection",
 CellID->1583522728,ExpressionUUID->"07179650-9fbb-2bc1-2d2c-081a1a4e792b"],

Cell[TextData[{
 "Quotient exploration expands each canonical state once, at its shortest \
depth, rather than expanding every isomorphic copy \[LongDash] the compact \
way to explore a symmetric system. It is off by default and pairs with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 ":"
}], "ExampleText",
 CellID->1739924885,ExpressionUUID->"326b0854-5043-0b63-6268-a21e61f65649"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<StatesGraph\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
    "True"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1140317291,ExpressionUUID->"1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],

