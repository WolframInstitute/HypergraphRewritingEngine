Cell[CellGroupData[{

Cell["\"TargetDevice\"", "ExampleSubsection",ExpressionUUID->"2c786728-62a9-c04f-b801-2b20ff3c5055"],

Cell[TextData[{
 "Evolution runs on the CPU by default. Where a GPU build is bundled, ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ecce9231-6942-fe41-8263-6ed411498131"],
 " runs on the device; otherwise it falls back to the CPU with a message. The \
GPU engine honors the same ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c15cdfab-4dc5-d34d-a1b9-4a8eab04a3cb"],
 " modes (",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ece8bee7-bfab-5347-ab43-eb726f52b22f"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee834759-f5b2-a342-bf15-cbd9bcd9ffb7"],
 ", ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a2f6dee-3562-2c4f-8321-1dcb3819dff6"],
 ") as the CPU, and its state counts match the CPU's in every mode:"
}], "ExampleText",ExpressionUUID->"12cf56ec-f64e-6942-9d57-85076f6475f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"588fcb00-be6d-5e4e-abb2-39ab08feb87a"],

