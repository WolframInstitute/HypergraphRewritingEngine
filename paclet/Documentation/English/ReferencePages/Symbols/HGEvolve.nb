      FontSize->0.9 Inherited,ExpressionUUID->
      "66c9a615-af45-c085-0ef6-385ecaf192ef"],
     ", in rule order"
    }], "TableText",ExpressionUUID->"0513e607-0f4c-1e20-3320-f861aaf9650a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0371ff35-cd30-cda2-310e-f77ee4ca9788"], Cell[TextData[Cell[
