Cell["\"MaxStatesPerStep\"", "ExampleSubsection",
 CellID->147747426,ExpressionUUID->"046e4336-067c-8bff-2c16-5b70b30ed9c5"],

Cell["\<\
A positive value keeps that many successor states in each step: the \
lowest-ranked of the states the step's transitions make, chosen once the \
step's matching is complete, with every transition into them and the \
successor states that tie with the last one kept:\
\>", "ExampleText",
 CellID->2026698593,ExpressionUUID->"07815119-4e7f-a41e-2dbf-49436b0b0f64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
