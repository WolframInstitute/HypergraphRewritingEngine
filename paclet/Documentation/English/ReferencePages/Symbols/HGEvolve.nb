Cell[CellGroupData[{

Cell["\"MaxSuccessorStatesPerParent\"", "ExampleSubsection",
 CellID->1260539265,ExpressionUUID->"319d38eb-f6c5-3702-67a2-b1b483719a68"],

Cell[TextData[{
 "A positive value keeps that many successor states of each state: the \
lowest-ranked, by a rank drawn from each transition's identity and ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2144f6-69f3-9218-2adf-5db00f87e162"],
 ", a successor state taking the lowest rank of the transitions into it. \
Every transition into a kept successor state is kept, and successor states \
that tie with the last one kept are kept as well. Under the default ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "None"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10a6d73c-c2c2-eea0-405d-cf79f774b48a"],
 " every transition makes its own state. Three steps of the loops rule \
without a cap:"
}], "ExampleText",
 CellID->892852605,ExpressionUUID->"3710847d-4883-61f0-5d2f-1e27693633da"],

