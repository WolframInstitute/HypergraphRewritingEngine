Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{"S", 0}, {"S", 1}, {"S", 2}, {"S", 3}, {"S", 4}, {"S", 5}, {
       "S", 6}, {"E", 0}, {"E", 1}, {"E", 2}, {"E", 3}, {"E", 4}, {
       "E", 5}}, {{{8, 2}, {9, 3}, {10, 4}, {11, 5}, {12, 6}, {13, 7}}, {{1, 
       8}, {1, 9}, {2, 10}, {2, 11}, {3, 12}, {3, 
       13}}, {<|"EventId" -> 0|>, <|"EventId" -> 0|>, <|"EventId" -> 1|>, <|
        "EventId" -> 1|>, <|"EventId" -> 2|>, <|"EventId" -> 2|>, <|
        "EventId" -> 3|>, <|"EventId" -> 3|>, <|"EventId" -> 4|>, <|
        "EventId" -> 4|>, <|"EventId" -> 5|>, <|"EventId" -> 5|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {
        DirectedEdge[{"E", 2}, {"S", 3}, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip], 
         DirectedEdge[{"E", 3}, {"S", 4}, <|"EventId" -> 3|>] -> Placed[
           Row[{"Event ", 3}], Tooltip], 
