Cell[CellGroupData[{

Cell["\"EdgeDeduplication\"", "ExampleSubsection",
 CellID->183375052,ExpressionUUID->"67928f76-a8f6-4c39-0da1-2733c8831703"],

Cell[TextData[{
 "By default a causal graph has one edge per pair of events. With ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6f8d9e4d-778e-395a-15b2-101702388ba0"],
 ", it has one edge for each hyperedge the consumer took from the producer, \
tagged with its ",
 Cell[BoxData["\"\<EdgeIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4897ab63-07fe-7036-78ac-434db18b431c"],
 "; the counts and ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3afe1774-f6b9-1a20-6a85-8f31834c690a"],
 " are unchanged. Three steps of the chain rule under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cb96547-3d6c-b437-3447-7d21b41e1f1d"],
 " event identity have three causal pairs:"
}], "ExampleText",
 CellID->919956290,ExpressionUUID->"2231aed9-983c-87b7-53ce-478319ceed9d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeCount", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
    " ", "\"\<CausalGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "Full"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->395709560,ExpressionUUID->"4d324fdb-2677-e56b-74c2-66855303cfb1"],

