      FontSize->0.9 Inherited,ExpressionUUID->
      "710db4a8-d877-0db2-2732-2df5d9025798"]
    }], "TableText",ExpressionUUID->"71e12f72-3ad4-a92f-279e-c73cbf66f875"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "06ea8612-dd18-b4f0-2ee9-185fd4921eda"], Cell[TextData[Cell[
    BoxData["\"\<IncidenceCycleRank\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0b02f270-2101-5c3d-3931-f43a50b42707"]], "TableText",ExpressionUUID->
     "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"], Cell[TextData[{
     "the number of incidences - (",
     Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
     " + ",
     Cell[BoxData["\"\<EdgeCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
     ") + ",
     Cell[BoxData["\"\<Components\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"]
    }], "TableText",ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"], Cell[TextData[{
     Cell[BoxData["\"\<IncidenceDiameter\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "12c044c4-b778-74e1-42f0-5da1c20d5ecb"],
     ", ",
     Cell[BoxData["\"\<IncidenceMeanDistance\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3d9aa029-60a8-273a-6bb9-3a7311428a00"]
    }], "TableText",ExpressionUUID->"64adc082-4122-deff-0c52-d9ec70d4a4c5"], 
    Cell["\<\
the longest and the mean distance between nodes of the largest incidence \
component\
\>", "TableText",ExpressionUUID->"7e451771-8a55-ceec-267a-8f3b2fe19436"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4670f053-f537-0b3f-6e0f-ea1cfcc25605"], Cell[TextData[Cell[
    BoxData["\"\<LargestComponentFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "330aabc0-bdd5-22a3-6109-42aa34607089"]], "TableText",ExpressionUUID->
     "38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"], Cell[TextData[{
     "the vertices of the largest incidence component over ",
     Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "70d705b8-410a-1477-20ec-9ce270bf7f5d"]
    }], "TableText",ExpressionUUID->"737c509e-bc52-eefb-2104-49d835e4b4c1"]}
  }]], "2ColumnTableMod",
 CellID->443736588,ExpressionUUID->"01a44b6b-c85f-9e0e-375c-6334e9ebe554"],

Cell[TextData[{
 Cell[BoxData["\"\<ArityHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 " and ",
 Cell[BoxData["\"\<DegreeHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25120901-cfbc-a8e6-5321-a16aea4efacc"],
 " count the hyperedges by arity and the vertices by degree over the step's \
states. ",
 Cell[BoxData["\"\<AritySignatureHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ee7491f-72c3-8814-669d-61590777db7e"],
 " and ",
 Cell[BoxData["\"\<DegreeSequenceHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67860241-8011-89c8-0dbd-a42b31a5db12"],
 " count the states by their list of hyperedge arities and by their degree \
sequence. All four are weighted as ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " is."
}], "Notes",
 CellID->1593449978,ExpressionUUID->"221ecbfd-1ed7-d323-5225-e2a79b63be09"],

Cell[TextData[{
 "The geometry entries of ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 " are computed on a state's graph: its vertices, with an edge between \
consecutive vertices of each hyperedge, or between every two vertices of a \
hyperedge under ",
 Cell[BoxData[
  RowBox[{"\"\<StatisticsGraph\>\"", " ", "->", " ", "\"\<AllPairs\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 ". A state where an entry is undefined is left out of that entry, so ",
 Cell[BoxData["\"\<N\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " counts the states where it is defined."
}], "Notes",
 CellID->1742646261,ExpressionUUID->"440467ae-8db5-79b4-6c3c-7e0824404b9e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3d27d006-86b8-9131-64dc-ca603332e01b"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3e44340b-ef5c-51d5-667b-ae548ae9233f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "321034f4-436e-dcec-622f-adbe7618a636"], Cell[TextData[{
     Cell[BoxData["\"\<GraphRadius\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
     ", ",
     Cell[BoxData["\"\<MeanEccentricity\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"]
    }], "TableText",ExpressionUUID->"087f5f2f-6486-1b59-3805-56890d3369a3"], 
    Cell["\<\
the least and the mean eccentricity of a vertex; undefined for a disconnected \
state\
\>", "TableText",ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"], Cell[TextData[Cell[
    BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13ecd9ee-6506-67bb-4193-d0c80cb34d81"]], "TableText",ExpressionUUID->
     "6724c974-bdf1-27a5-0edb-e13e3b858d8f"], Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ResourceFunction"]], "paclet:ref/ResourceFunction"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "2b52875c-0948-9ae8-5961-1f06a8e2e832"],
     "[\"WolframHausdorffDimension\"] of the graph, averaged over vertices, \
with the graph radius as the largest ball; undefined for a disconnected state \
or one vertex"
    }], "TableText",ExpressionUUID->"53412643-5a68-df00-017e-b82d5f02a26a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "696f5b1d-d56b-3a26-1f15-5346dc1f890c"], Cell[TextData[Cell[
    BoxData["\"\<WolframRicciCurvatureScalar\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0eb02373-2484-618c-364f-bb3d4d3133d6"]], "TableText",ExpressionUUID->
     "640353f1-ff8e-e9b3-0c31-4abafa38bb99"], Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["ResourceFunction"]], "paclet:ref/ResourceFunction"},
       "RefLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "37161f66-4600-a3a8-5d2d-974073baf1f2"],
     "[\"WolframRicciCurvatureScalar\"] of the graph at the state's own ",
     Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2e44757e-c407-f813-567c-6d3bedb3cb79"],
     ", averaged over vertices; undefined as that is"
    }], "TableText",ExpressionUUID->"07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"], Cell[TextData[Cell[
    BoxData["\"\<OllivierRicciCurvature\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1cd82739-42e3-b7ed-44e7-bf6376971d37"]], "TableText",ExpressionUUID->
     "0971a20b-7913-467e-3f0e-445578a62d44"], Cell["\<\
the mean over edges x-y of 1 - W1(m_x, m_y), with m_x half on x and half \
spread over its neighbours, and W1 the exact transport cost; undefined for a \
state with no edge\
\>", "TableText",ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"], Cell[TextData[{
     Cell[BoxData["\"\<DegreeEntropy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "21fdaace-430e-f3f9-5782-43a876b8c1c3"],
     ", ",
     Cell[BoxData["\"\<LocalEntropy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"]
    }], "TableText",ExpressionUUID->"10b057f0-cb39-4e6e-4040-4ebdeecc14b4"], 
    Cell["\<\
the entropy in bits of the vertex degrees, over the whole graph and averaged \
over the balls of radius 2\
\>", "TableText",ExpressionUUID->"41c6bfc6-0792-5005-77fd-36a0b227236f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "62752e4e-571f-d961-120a-c02862aba84b"], Cell[TextData[{
     Cell[BoxData["\"\<MutualInformation\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"],
     ", ",
     Cell[BoxData["\"\<FisherInformation\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "166277e1-e8de-815f-3e12-6eca8968d3a5"]
    }], "TableText",ExpressionUUID->"0ae7a534-7379-468c-3a9c-3d7e060c2cd6"], 
    Cell["\<\
neighbourhood overlap and dimension sharpness measures from radius-2 balls, \
defined in docs/SPEC.md\
\>", "TableText",ExpressionUUID->"34baef30-7963-b757-5c59-077a78171dbd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "15ce0314-20ee-2b64-43f5-9b5e509b764e"], Cell[TextData[Cell[
    BoxData["\"\<LargestComponentDimension\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "38a9ac88-4644-6c0e-6856-45d273f13754"]], "TableText",ExpressionUUID->
     "64802aa2-b136-451c-0cbf-c30fc0c32c66"], Cell[TextData[{
     "the mean over the vertices v of the largest component of d_v, v's own \
ball-growth dimension averaged over r = 1 to that component's radius; defined \
for a disconnected state, and equal to ",
     Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"],
     " for a connected one"
    }], "TableText",ExpressionUUID->"233ecb8e-17f3-8d32-52c5-e2e8a187d418"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"], Cell[TextData[{
     Cell[BoxData["\"\<LocalDimensionMax\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"],
     ", ",
     Cell[
     BoxData["\"\<LocalDimensionStandardDeviation\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "598f41e5-f1df-a461-0fb5-58ce806b0f4b"]
    }], "TableText",ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"], 
    Cell["\<\
the maximum and the population standard deviation of d_v over the largest \
component\
\>", "TableText",ExpressionUUID->"7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "41ecc127-3c02-05fa-7793-d881b5b76fc0"], Cell[TextData[Cell[
    BoxData["\"\<OllivierMoranI\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"]], "TableText",ExpressionUUID->
     "19c80315-d7de-7125-4ff7-9b5ee26b400f"], Cell["\<\
Moran's I of the vertex curvature k_v (the mean Ollivier curvature of v's \
edges) over the graph's edges; undefined when k_v is the same at every vertex\
\
\>", "TableText",ExpressionUUID->"6fdf78a7-59a9-97d9-15e5-7101585dfd23"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7a87483f-bfa4-2eb6-2abd-62793a51749c"], Cell[TextData[Cell[
    BoxData["\"\<OllivierDegreeCorrelation\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "09b26917-59e6-8729-3f41-81515f90ea73"]], "TableText",ExpressionUUID->
     "521ad179-838d-ce9b-0239-c923363994e1"], Cell["\<\
the correlation of k_v with the vertex degree; undefined when either is the \
same at every vertex\
\>", "TableText",ExpressionUUID->"136d7364-bcfb-8461-4113-6b4e348fef4b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2b78534b-7a52-d624-5918-4b157fe4bd0e"], Cell[TextData[{
     Cell[BoxData["\"\<BallDimension\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
     ", ",
     Cell[BoxData["\"\<BallScalarCurvature\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
     " (with ",
     Cell[BoxData["\"\<StepStatisticsMeasures\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
     ", as the entries below)"
    }], "TableText",ExpressionUUID->"5b82e386-6ff5-c0ee-09b1-fae009819234"], 
    Cell["\<\
the dimension and scalar curvature fitted to the growth of the ball sizes \
about each vertex of the largest component, averaged over the vertices with a \
fit\
\>", "TableText",ExpressionUUID->"34a39a2f-b372-ffce-5c50-1388c604c514"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66ca9132-7812-8248-0ec9-097c79a4d092"], Cell[TextData[{
     Cell[BoxData["\"\<RiemannianBallDimension\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
     ", ",
     Cell[BoxData["\"\<RiemannianBallScalarCurvature\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "29a4f364-fd74-7ca4-5f5b-eb41f401468e"]
    }], "TableText",ExpressionUUID->"47740231-7fc8-4299-6d0b-a47b7a7d10e3"], 
    Cell["\<\
the same fit to the growth of the Riemannian measure of the balls: the \
vertices of a ball whose neighbours all lie in the ball\
\>", "TableText",ExpressionUUID->"1af52337-5e42-c8c3-4a8a-bb715bf49a29"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"], Cell[TextData[{
     Cell[BoxData["\"\<SphereDimension\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5782d92f-a790-094a-7db1-d088d2255b90"],
     ", ",
     Cell[BoxData["\"\<SphereScalarCurvature\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "05d48452-325d-a277-33eb-1e1c47e9f15d"]
    }], "TableText",ExpressionUUID->"087ffcf6-194e-431e-3804-f5b098fb2e64"], 
    Cell["\<\
the same fit to the growth of the spheres, the vertices at each distance\
\>", "TableText",ExpressionUUID->"615fadf7-df9a-5675-1764-44b0da2f3d5f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"], Cell[TextData[Cell[
    BoxData["\"\<GeodeticFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2d0df906-1ebb-1081-5b32-f1609b4e62eb"]], "TableText",ExpressionUUID->
     "519a4e0d-3467-bfb9-07ba-6057bd130583"], Cell["\<\
the fraction of the ordered pairs of vertices joined by a path that are \
joined by exactly one shortest path. Undefined for a state with no edge\
\>", "TableText",ExpressionUUID->"3a891815-8c00-cf41-6ab6-925f25ba95ab"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0dbacffa-31b0-43f6-3b59-e6a4404511dc"], Cell[TextData[Cell[
    BoxData["\"\<SegmentEntropy\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "196a859c-b643-c1b3-4f69-1cd9c3f79399"]], "TableText",ExpressionUUID->
     "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"], Cell["\<\
the mean over the same pairs of the entropy in bits of the number of shortest \
paths through each vertex, normalised to sum 1. Undefined for a state with no \
edge\
\>", "TableText",ExpressionUUID->"50735439-04fd-dee7-0001-4e63ac89a4cd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3597ba8d-914b-928f-63ac-33d720ffe0d5"], Cell[TextData[Cell[
    BoxData["\"\<EulerCharacteristic\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "056fda38-a5bc-2884-3314-dc65cc497aee"]], "TableText",ExpressionUUID->
     "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"], Cell["\<\
V - E + T, the vertices less the edges plus the triangles of the graph\
\>", "TableText",ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "09cb884c-5fc8-b209-3fc8-22165a620153"], Cell[TextData[Cell[
    BoxData["\"\<RimFraction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "376c6589-bcca-29e8-5d14-7cd3357f7b32"]], "TableText",ExpressionUUID->
     "667bb688-7420-22c7-0e18-2fd27dd5702d"], Cell["\<\
the fraction of the vertices whose link, the subgraph on their neighbours, is \
not a cycle. Undefined when a vertex lies on no triangle\
\>", "TableText",ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "084561a7-5440-aaee-387b-78015dfaf834"], Cell[TextData[Cell[
    BoxData["\"\<CombinatorialCurvatureTotal\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "721e71e5-9ca7-ded5-2226-68cf1553a43f"]], "TableText",ExpressionUUID->
     "0a84e7eb-55e0-1894-3abb-feb563956afe"], Cell[TextData[{
     "the sum of 1 - k/6 over the vertices whose link is a k-cycle, which \
equals ",
     Cell[BoxData["\"\<EulerCharacteristic\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3261920b-7b77-02d6-621e-14557e02503c"],
     " for a closed triangulated surface. Undefined when no link is a cycle"
    }], "TableText",ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"], Cell[TextData[Cell[
    BoxData["\"\<ClusteringCoefficient\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "41d92934-9aba-8299-77e6-c17e1f4cd0e3"]], "TableText",ExpressionUUID->
     "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"], Cell["\<\
the mean over vertices of the number of triangles at the vertex over the \
number of pairs of its neighbours\
\>", "TableText",ExpressionUUID->"29880975-91f0-008f-5fb7-a13f278552d5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"], Cell[TextData[Cell[
    BoxData["\"\<LocalEulerExcess\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "22235db8-54be-42b7-53d1-54e25d4b109d"]], "TableText",ExpressionUUID->
     "0976d5ae-737d-f257-3f0d-cc080609c0bd"], Cell["\<\
the mean over vertices v of the excess of the edges among the vertices within \
distance 3 of v over the planar bound 3V - 6, relative to that bound\
\>", "TableText",ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3fd09d86-aea1-a602-65ef-14e3cb550d68"], Cell[TextData[{
     Cell[BoxData["\"\<TopologicalCharge\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2f6c0922-6605-ed68-5513-a08c13b1b7b2"],
     ", ",
     Cell[BoxData["\"\<TopologicalChargeMax\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2caab86a-2af9-b1b1-54a9-32344e8d039b"]
    }], "TableText",ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"], 
    Cell["\<\
the mean and the largest over vertices of log2 of the degree times one less \
the clustering coefficient, plus 10 times the Euler excess\
\>", "TableText",ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "67558936-e5eb-8680-0d6a-2173939fecea"], Cell[TextData[Cell[
    BoxData["\"\<DimensionGradientCurvature\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1072dc7c-f7d5-c74e-4001-d6398261ad94"]], "TableText",ExpressionUUID->
     "3462f0a3-098c-f6b3-5c11-e90da83edc99"], Cell["\<\
the mean over the vertices v of the largest component of the mean over the \
neighbours u of v of d_u - d_v\
\>", "TableText",ExpressionUUID->"04cac1af-436c-9192-2cc9-d809761ee3f8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "63be94f2-239e-9b81-1145-0dbc5628e9eb"], Cell[TextData[Cell[
    BoxData["\"\<NonLazyOllivierRicciCurvature\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"]], "TableText",ExpressionUUID->
     "3a0f2024-2f71-09ca-6a34-b98e4a045b10"], Cell["\<\
the mean over edges x-y of 1 - W1(m_x, m_y), with m_x spread evenly over the \
neighbours of x and none on x. Undefined for a state with no edge\
\>", "TableText",ExpressionUUID->"277956ac-4c9d-d338-4d07-4ff66529be02"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "178a6a52-23e4-1142-3d89-8c1c559163a8"], Cell[TextData[{
     Cell[BoxData["\"\<GeodesicProperTime\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
     ", ",
     Cell[BoxData["\"\<GeodesicProperTimeVariance\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "719ae17a-c654-ed44-27b9-f927f3e6b7ae"]
    }], "TableText",ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"], 
    Cell["\<\
the mean and the population variance of the distance d(v, t) over the ordered \
pairs of distinct vertices joined by a path. Undefined for a state with no \
edge\
\>", "TableText",ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"], Cell[TextData[Cell[
    BoxData["\"\<GeodesicBundleSpread\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0d437dad-8290-de9a-3b71-74f7372aa4e0"]], "TableText",ExpressionUUID->
     "7aafc905-908a-67da-2a54-e16f213f4d20"], Cell["\<\
the mean over the same pairs of the standard deviation of d(x, t) over the \
neighbours x of v\
\>", "TableText",ExpressionUUID->"62016b94-8ad8-fb56-123e-82de2f52c9bc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0e7c794a-82c2-56e7-3604-711437773ccd"], Cell[TextData[Cell[
    BoxData["\"\<GeodesicCurvature\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "30f601cf-5001-fb68-608d-98a961b5c9b2"]], "TableText",ExpressionUUID->
     "04bc0f0b-f02f-243d-2c43-a75481db8f07"], Cell["\<\
the mean over the same pairs of the mean of d(x, t) - d(v, t) over the \
neighbours x of v\
\>", "TableText",ExpressionUUID->"1a24bdc2-598a-1b95-4bdb-34ac583f69ff"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "705e212e-f5a4-7717-2065-b88bfc515a7d"], Cell[TextData[{
     Cell[BoxData["\"\<LensingDeflection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
     ", ",
     Cell[BoxData["\"\<LensingImpactParameter\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "211ecaf2-61ee-418f-5725-e3bc179b13d5"]
    }], "TableText",ExpressionUUID->"51e4dffc-d38f-5703-079b-d6b9e63a3a69"], 
    Cell["\<\
for the pairs of vertices s, t of the largest component at distance 2 or more \
whose shortest paths come within max(2, D'/5) of the centre C (the vertices \
of greatest local dimension, D' the component's diameter): the mean of the \
excess of the shortest walk through C over d(s, t), relative to d(s, t), and \
the mean of the least distance from a shortest path to C\
\>", "TableText",ExpressionUUID->"30e43b5d-74af-d0fb-609b-b3077d5ba2c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"], Cell[TextData[Cell[
    BoxData["\"\<LensingDeflectionRatio\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"]], "TableText",ExpressionUUID->
     "138e1639-4d05-8b97-41b5-886364b1d9fd"], Cell["\<\
the mean over the same pairs of the deflection times (b + 1) / M, with b the \
impact parameter and M the greatest local dimension\
\>", "TableText",ExpressionUUID->"156728ce-0023-e03b-431c-c1a8b1d7b301"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"], Cell[TextData[Cell[
    BoxData["\"\<OrbitalVelocity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "26ff5c08-e081-ff27-4e85-56559135c20d"]], "TableText",ExpressionUUID->
     "07c988c4-3ef2-8066-2df6-21aeba84d34c"], Cell["\<\
the mean over r = 1..R_C of v(r) = L(r) / (2\[Pi] r), with L(r) the size of \
the largest connected part of the vertices at distance r from C and R_C the \
greatest such distance. Undefined when R_C < 2\
\>", "TableText",ExpressionUUID->"4bc0a2f3-6150-447f-79ff-3bbd10e52f45"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"], Cell[TextData[{
     Cell[BoxData["\"\<RotationCurveExponent\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
     ", ",
     Cell[BoxData["\"\<RotationCurveResidual\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ab8b877-e011-189c-2a47-323091a46ae6"]
    }], "TableText",ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"], 
    Cell["\<\
the slope and the root mean square residual of the least squares fit of ln \
v(r) on ln r\
\>", "TableText",ExpressionUUID->"0da6433d-a7a4-ba24-3b5e-5b66d256090e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "462f64f6-435d-c7dd-6fd5-7db076e9ad27"], Cell[TextData[Cell[
    BoxData["\"\<WaveFrontSize\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4b06bf63-5f43-ed7c-793d-374d5af7b446"]], "TableText",ExpressionUUID->
     "0fd1c247-21a4-d962-35ee-e4215056a848"], Cell[TextData[{
     "the mean size of the fronts of InfraGeometry's ",
     Cell[BoxData["FindAdvancingInfraFront"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "09347675-9fce-c17b-38cc-683f1a789041"],
     " from each vertex of the largest component for twice its diameter in \
steps: each front moves to the neighbours one step farther from the front \
before it, and where a vertex has none, back to the neighbours one step \
nearer. Undefined for a component of fewer than 2 vertices"
    }], "TableText",ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66c4d8d6-27c8-a0db-0efb-d1905262f221"], Cell[TextData[Cell[
    BoxData["\"\<WaveFrontCoverage\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "4d3801b6-8b23-0df3-74c7-98f02ed657d9"]], "TableText",ExpressionUUID->
     "09816d05-11e9-fb6e-3fbe-856fa79dc9b4"], Cell["\<\
the mean over the origins of the fraction of the component's vertices the \
fronts visit\
\>", "TableText",ExpressionUUID->"35ec423d-cde2-7917-6394-6466eb97487d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "05e0e9bc-56b1-1bf2-339f-00e6634469d8"], Cell[TextData[Cell[
    BoxData["\"\<WaveReflectionStep\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "46408f14-a324-388b-6e7f-2751d6d68ad1"]], "TableText",ExpressionUUID->
     "40213c85-9219-7c2b-71de-b5ef27ac4771"], Cell["\<\
the mean over the origins of the first step whose front holds a vertex nearer \
the origin than the step\
\>", "TableText",ExpressionUUID->"678faed4-2cca-f411-0db4-479e457cdf7b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b3cac94-919f-f08d-6ac3-45de202bc2d7"], Cell[TextData[{
     Cell[BoxData["\"\<CliqueBetti0\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "634a1270-2707-566e-1149-943a52b23cb4"],
     ", ",
     Cell[BoxData["\"\<CliqueBetti1\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "571f0194-b08e-3ab4-7d24-98d1c138889e"],
     ", ",
     Cell[BoxData["\"\<CliqueBetti2\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "79764466-e076-5945-2f0e-5e4391032baf"]
    }], "TableText",ExpressionUUID->"54e8dec7-14b1-519a-7c97-d7a19d4423e0"], 
    Cell["\<\
the Betti numbers over the field of two elements of the clique complex of the \
graph, which has a simplex for each set of vertices joined in pairs\
\>", "TableText",ExpressionUUID->"25f5c72f-3423-741a-538a-de89bdd65f60"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6dbbd446-5835-e39a-1b58-ce2059c1b1e0"], Cell[TextData[Cell[
    BoxData["\"\<RipsBetti1\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6d34e655-b983-17e8-14cb-f81f38367d32"]], "TableText",ExpressionUUID->
     "5c435daa-0d1c-c5df-0471-54f4a4aeaf25"], Cell["\<\
the first Betti number of the Vietoris-Rips complex at radius 1, the clique \
complex of the graph that joins two vertices at distance 1 or 2\
\>", "TableText",ExpressionUUID->"21714cd0-c04e-e57a-570f-659df1f8cc40"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "74ff421b-073b-c6d4-1c85-6445b2cfac3e"], Cell[TextData[Cell[
    BoxData["\"\<MetricTensorGap\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3ebc3a74-dd7c-3fa6-6643-bc31d40e858c"]], "TableText",ExpressionUUID->
     "7d5c93fe-a057-3a16-2b63-0abbd1e3897c"], Cell["\<\
the distance of the values of Infrageometry's metric tensor on the sphere of \
radius \[LeftFloor]R/2\[RightFloor] about a centre vertex from those of \
max(cos \[CapitalTheta], 0), \[CapitalTheta] uniform on [0, \[Pi]], averaged \
over the centre vertices of the largest component of radius R. Undefined when \
R < 2\
\>", "TableText",ExpressionUUID->"487dadd0-5ed6-7873-7802-449a5b634b59"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5219761b-8a64-c9ff-0227-68452f169bc5"], Cell[TextData[{
     Cell[BoxData["\"\<AlignmentMoment1\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "69346765-6d1c-e9c9-18cc-7f4f04aebb13"],
     ", ",
     Cell[BoxData["\"\<AlignmentMoment2\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c22b8c2-70f4-0562-25d1-31ac00816c48"],
     ", ",
     Cell[BoxData["\"\<AlignmentMoment3\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "04fec585-b88c-469b-2c85-dcef39392ce1"]
    }], "TableText",ExpressionUUID->"7aa617d4-4041-969d-2a5d-8e9e71f5fce7"], 
    Cell["\<\
the principal moments, over the total mass, of the inertia of the largest \
component placed by the Laplacian eigenvectors 2 to 4, each vertex weighted \
by the absolute value of its Ricci scalar plus 1/100. Undefined for a \
component of fewer than 4 or more than 256 vertices, or when the fourth and \
fifth Laplacian eigenvalues coincide\
\>", "TableText",ExpressionUUID->"5e86e5c8-d785-1389-06bd-fc95e23061d3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3582ea65-851b-2569-63b1-0c4f2caf8fb3"], Cell[TextData[{
     Cell[BoxData["\"\<HolonomyTriangle\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5e81d752-d9a7-cf7a-06be-cf1fd8539240"],
     ", ",
     Cell[BoxData["\"\<HolonomySquare\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6dc17641-57cc-3497-1bff-682b627e9efd"]
    }], "TableText",ExpressionUUID->"647a9320-5a37-336f-0c19-0a8a5fc381b5"], 
    Cell["\<\
the mean holonomy angle at radius 1 of the triangles and of the 4-cycles \
without a chord, averaged over each face's base vertices and orientations. \
Undefined when there is no such face or a vertex has more than 6 neighbours\
\>", "TableText",ExpressionUUID->"57b40e76-1aa6-da65-7d4b-a0309f50a94f"]}
  }]], "2ColumnTableMod",
 CellID->29467524,ExpressionUUID->"575b10e3-003a-b957-7d78-89cdb1cc0bbd"],

Cell[TextData[{
 Cell[BoxData["\"\<VertexInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c7345dd-208f-a284-2401-5c87513bf0ee"],
 " pools the vertices of every state at the step, weighted as ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0121a537-2575-8479-30de-3d714c01ef43"],
 " is, into ",
 Cell[BoxData["\"\<LocalDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f325126-465a-e19d-26c2-488073ecb3e7"],
 " (d_v over the largest component), ",
 Cell[BoxData["\"\<OllivierRicciCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "739af998-c5c1-31b3-21b9-f0c5ec758399"],
 " (k_v over every vertex with a neighbour), ",
 Cell[BoxData["\"\<WolframRicciCurvatureScalar\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "003becda-d908-4451-31d8-0587d8bd2ebb"],
 " (the Ricci scalar of each vertex of the largest component, at the state's ",
 Cell[BoxData["\"\<LargestComponentDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aeb468a-2cc6-59e2-2ae9-5fd445732bc8"],
 "), the six volume-growth fits (",
 Cell[BoxData["\"\<BallDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3873a668-04d7-31ac-6800-3832ad6383f6"],
 " to ",
 Cell[BoxData["\"\<SphereScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4156c81a-8a68-59d7-776d-e2442f1d2b3d"],
 ") of each vertex with a fit, ",
 Cell[BoxData["\"\<CombinatorialCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "569e7ab4-00f8-e339-7ea6-73feb172ce03"],
 " (1 - k/6 for each vertex whose link is a k-cycle), ",
 Cell[BoxData["\"\<ClusteringCoefficient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b3ec616-de69-0141-3ac5-d853db1c53ab"],
 " and ",
 Cell[BoxData["\"\<TopologicalCharge\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c0d57bf-7ae8-3253-2433-4ef97e8280b9"],
 " of each vertex, and ",
 Cell[BoxData["\"\<DimensionGradientCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0aaecb0d-dff0-cd78-3a55-e356d98a9442"],
 " (the mean over the neighbours u of v of d_u - d_v, over the largest \
component). Each has the summary keys of ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fe4a286-576e-fd11-759b-3be06218c47b"],
 " with ",
 Cell[BoxData["\"\<Q1\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07179650-9fbb-2bc1-2d2c-081a1a4e792b"],
 ", ",
 Cell[BoxData["\"\<Q3\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aecd320-e31f-2936-2a93-ca8d96aa781c"],
 ", ",
 Cell[BoxData["\"\<P10\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "326b0854-5043-0b63-6268-a21e61f65649"],
 ", ",
 Cell[BoxData["\"\<P90\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d6edc53-4ce5-e0f2-4b15-d61d6491b2d8"],
 ", ",
 Cell[BoxData["\"\<Skewness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45f7e4e6-4e1c-a184-738c-fdc06baef3ee"],
 " and ",
 Cell[BoxData["\"\<Kurtosis\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70e98525-204e-6ba4-2096-1c8f51fb398e"],
 ". The moments are exact; the quantiles and ",
 Cell[BoxData["\"\<Histogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "704169dd-a4db-5005-207e-8086cd6e236f"],
 " come from 32 equal bins per state over a fixed range ([0, 8) for the \
dimensions, [-2, 1) for ",
 Cell[BoxData["\"\<OllivierRicciCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b2d1c14-5aff-cd5f-2ad2-965e5e8b97a5"],
 ", [-24, 8) for the scalar curvatures, [-7, 1) for ",
 Cell[BoxData["\"\<CombinatorialCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ac11c1-6d0b-a8c0-1253-88ab04bffa2a"],
 ", [0, 1) for ",
 Cell[BoxData["\"\<ClusteringCoefficient\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e7621e1-2fba-a33a-560d-b8cb4a4c0e00"],
 ", [0, 16) for ",
 Cell[BoxData["\"\<TopologicalCharge\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15938457-0322-a4d9-43a0-1e11b6d40e23"],
 " and [-8, 8) for ",
 Cell[BoxData["\"\<DimensionGradientCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f1ed2e3-b722-4b37-2525-cbccc2d7161d"],
 "), as defined in docs/SPEC.md."
}], "Notes",
 CellID->1939141443,ExpressionUUID->"52e63e44-9d5c-26a1-029d-b02e14ee8c8b"],

Cell[TextData[{
 Cell[BoxData["\"\<StepStatisticsMeasures\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e766a94-5ec6-6187-160d-83de5b7333ed"],
 " ",
 Cell[BoxData["\"\<Equilibrium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eead67c-41e5-1519-56e9-c82677907c63"],
 " adds the per-step key ",
 Cell[BoxData["\"\<Equilibrium\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23a655ec-dad2-e192-515e-4cc9df64b3f8"],
 ": the stabilities 1 / (1 + \[Sigma] / ",
 "|",
 "\[Mu]",
 "|",
 ") of the step means of ",
 Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62ef85cc-c62f-39ac-1294-1ca9f3db8bf6"],
 ", ",
 Cell[BoxData["\"\<DegreeEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6c313b-6800-4a9b-2b13-a96509b518e1"],
 " and ",
 Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75dfb56b-bb47-a02b-23e4-2d353ef3f371"],
 " over the last 20 steps up to the step (",
 Cell[BoxData["\"\<DimensionStability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57533ce7-69d6-be0e-7d60-b5c108600554"],
 ", ",
 Cell[BoxData["\"\<DegreeEntropyStability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27c3fefb-2ee6-8038-4df0-f7a54a90d302"],
 ", ",
 Cell[BoxData["\"\<SizeStability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d4995f-bb7f-b80c-10eb-11193e0b0b56"],
 "), their mean ",
 Cell[BoxData["\"\<OverallStability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64608bbe-760c-8af3-0c1f-22f803bed8d9"],
 ", the slopes ",
 Cell[BoxData["\"\<DimensionTrend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09661063-a2cf-675e-3f1d-8a4cd77a4da4"],
 " and ",
 Cell[BoxData["\"\<SizeTrend\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5561d787-26b0-8d0a-031e-cee1534ad450"],
 ", the number of steps ",
 Cell[BoxData["\"\<Window\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fea91e8-e80e-a1ed-35e9-08b589b8f337"],
 ", and ",
 Cell[BoxData["\"\<Equilibrated\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37725419-c8bf-c4cd-5d02-4e42e94bae17"],
 ", ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6eee5857-8f9d-bf63-1696-52112a290249"],
 " from step 50 on when ",
 Cell[BoxData["\"\<OverallStability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2635f536-2fc9-ab3c-4fca-ed704a7df606"],
 " is at least 0.95."
}], "Notes",
 CellID->5047578,ExpressionUUID->"1b3760e9-4a32-92b2-4acd-79b36fc4e098"],

Cell[TextData[{
 Cell[BoxData["\"\<EdgeInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14fe93a8-4ee9-5b9e-3c85-0af26a9c29e4"],
 " pools the edges of every state at the step, weighted as ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11cf5d11-52cc-ddbb-47f5-555b677ea781"],
 " is, into ",
 Cell[BoxData["\"\<NonLazyOllivierRicciCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ba8138a-66ce-478c-2957-8ad4137b2dd6"],
 " (the curvature of each edge with the walk spread evenly over the \
neighbours), with the keys and the 32 bins over [-2, 1) of the ",
 Cell[BoxData["\"\<VertexInvariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35c9e6d4-f3c4-84c1-63f6-ff918676ee2b"],
 " distributions."
}], "Notes",
 CellID->15008895,ExpressionUUID->"6fd66644-13e4-6fa7-15ee-782ea591358d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<StepStatisticsBranchial\>\"", " ", "->", 
   " ", "\"\<Graph\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00abf1cf-696b-3507-30a8-e8a9081f9c6d"],
 " adds per-step keys about the branchial graph of the step, whose vertices \
are the step's states: ",
 Cell[BoxData["\"\<BranchialDegree\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03d898fe-d35a-9eef-31e7-11bbe6ece435"],
 " and ",
 Cell[BoxData["\"\<BranchialDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03dda600-4b0b-c3af-31e2-386a6ebf91f5"],
 " (summaries), ",
 Cell[BoxData["\"\<BranchialComponents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4de38b79-ee67-8bee-7b90-23228b13d934"],
 " and ",
 Cell[BoxData["\"\<BranchialDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "347cf1ed-0cc4-b4dc-5c03-e8b7a5761e26"],
 " (the ",
 Cell[BoxData["\"\<WolframHausdorffDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],
 " of its largest component, absent when that has one state). The same \
component gives the six volume-growth keys with the prefix ",
 Cell[BoxData["\"\<Branchial\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " (",
 Cell[BoxData["\"\<BranchialBallDimension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c340229-13f4-0181-15cb-a473a58153eb"],
 " to ",
 Cell[BoxData["\"\<BranchialSphereScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dfa134-0866-9bb5-53e4-397ea910e99f"],
 ", absent when no state has a fit), ",
 Cell[BoxData["\"\<BranchialOllivierRicciCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425139cc-45a5-cefb-726e-b0966c5194c1"],
 " and ",
 Cell[BoxData["\"\<BranchialNonLazyOllivierRicciCurvature\>\""], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d922994-f334-45bb-7ba1-c0d186c12f81"],
 ". ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06c25578-1780-b25e-2ef2-4d22a23a00a4"],
 " adds, over every two states A, B as vertex sets: ",
 Cell[BoxData["\"\<StateOverlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f70617e-b140-9f95-0500-793bc0fae5ff"],
 " (the summary of ",
 "|",
 "A \:2229 B",
 "|",
 " / ",
 "|",
 "A \:222a B",
 "|",
 "), ",
 Cell[BoxData["\"\<StateCosineSimilarity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d0371a-30a6-04e5-2fef-af4441536ecf"],
 " (",
 "|",
 "A \:2229 B",
 "|",
 " / Sqrt[",
 "|",
 "A",
 "|",
 " ",
 "|",
 "B",
 "|",
 "]) and ",
 Cell[BoxData["\"\<StateMutualInformation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d950d76-dd18-2b24-2baa-a533d4ad760e"],
 " (the mutual information in bits of membership in A and in B over U, the \
union of the step's vertex sets). ",
 Cell[BoxData["\"\<InitialStateMutualInformation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7234a9f4-3232-6781-23cb-40be47c74deb"],
 " summarises, over the step's states, the mutual information of each state \
with S0, the union of the vertex sets of the initial states, over U \:222a \
S0. ",
 Cell[BoxData["\"\<VertexSharpness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42668d78-f434-72a4-721d-2525fdc1408e"],
 " and ",
 Cell[BoxData["\"\<BranchEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7cc198-0ad8-2426-3403-d8c2af528f0c"],
 " give 1/k and log2 k for each vertex held by k states; ",
 Cell[BoxData["\"\<EdgeSharpness\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69698b1d-3dc2-3628-1f16-2347b4749d72"],
 " and ",
 Cell[BoxData["\"\<EdgeBranchEntropy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "701e1eb7-eeba-61c8-2025-97f08b4f3312"],
 " give the same for each edge, an edge being its list of vertices. With both \
",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e322415-281a-3695-37c1-be5f49ac9cff"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "61beb272-ef15-9663-1745-343f8aa1fd49"],
 ", ",
 Cell[BoxData["\"\<OverlapByBranchialDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e8a6a96-06b4-6465-0689-83d0b3414f4f"],
 " gives, for each branchial distance d, the summary of ",
 "|",
 "A \:2229 B",
 "|",
 " / ",
 "|",
 "A \:222a B",
 "|",
 " over the pairs at distance d; it is absent when either is not computed. \
These keys count each state once under either ",
 Cell[BoxData["\"\<StepStatisticsWeighting\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55951090-ef25-ccfd-03aa-89dd8ad196c7"],
 ". ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53a2ca13-da2c-324e-0151-ec5cdfde8094"],
 " needs ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 " ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319e51f9-a9ce-1d21-67a6-48a2c87b640b"],
 ". Under ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 ", ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 " gives the values of the run that expands every state. Both devices compute \
them."
}], "Notes",
 CellID->1892712309,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell[TextData[{
 Cell[BoxData["\"\<StepStatisticsMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],
 " adds the per-step key ",
 Cell[BoxData["\"\<StateMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f7d0c35-7157-44bf-6502-a67f00e22e85"],
 ", an association. Its ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
 " lists the step's state ids in ascending order, the ids of ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "064e3005-d89e-7c03-2e75-aa6ed92b4769"],
 ". Each matrix asked for is a k x k array of reals whose row and column i \
belong to the i-th of those states. The overlap and cosine matrices are a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SparseArray"]], "paclet:ref/SparseArray"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "76c2caed-aea0-13a2-1ef1-e3b6cb556188"],
 " when fewer than half of the pairs of states share an element, and a packed \
array otherwise; the mutual information matrices are always packed arrays. ",
 Cell[BoxData["\"\<StateOverlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "260c3025-1fa9-9acd-4e33-a98f9a5de817"],
 ", ",
 Cell[BoxData["\"\<StateCosineSimilarity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b1e6c2c-0452-4134-7925-8676ade7101e"],
 " and ",
 Cell[BoxData["\"\<StateMutualInformation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 " hold, for every two states, the values the summaries of the same names \
summarise. ",
 Cell[BoxData["\"\<StateEdgeOverlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],
 ", ",
 Cell[BoxData["\"\<StateEdgeCosineSimilarity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8690e9-968f-68b3-16bd-09b3233a3a99"],
 " and ",
 Cell[BoxData["\"\<StateEdgeMutualInformation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"],
 " hold the same three with each state as its set of edges, an edge being its \
list of vertices, and U the union of the step's edge sets. The diagonal \
compares each state with itself: 1 for the overlap and the cosine, and the \
entropy in bits of membership in the state for the mutual information. A step \
whose matrices need more bytes than ",
 Cell[BoxData["\"\<StepStatisticsMatrixLimit\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25f1a39a-81e0-db80-538e-3ac4379aa9ea"],
 " has no ",
 Cell[BoxData["\"\<StateMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35466be2-b7a8-26dc-637d-82cfc2428c26"],
 ", and the run gives an ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "warn"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bdea72-0ba3-5f4c-0842-0c3cae562596"],
 " message naming the step. A matrix of a step of k states takes 16 k\.b2 \
bytes while it is built. State ids are numbered by the run, so two runs give \
the same matrices up to a renumbering of the states. ",
 Cell[BoxData["\"\<StepStatisticsMatrices\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e8cef58-e908-949c-16b3-070588a2fee6"],
 " needs ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abc4047-6c7b-4886-3a44-5a21050e1aec"],
 " ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],
 " or ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 ". Both devices compute it."
}], "Notes",
 CellID->787969749,ExpressionUUID->"2161c865-0900-0907-571e-e24fa8b5586d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " takes every option of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 " and passes it to the graph a graph property returns, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ImageSize"]], "paclet:ref/ImageSize"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40aa99e8-53bd-499c-70a9-10b266481be6"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["AspectRatio"]], "paclet:ref/AspectRatio"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d165407-aaf3-867b-0b2e-4e60ce87ed41"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VertexLabels"]], "paclet:ref/VertexLabels"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "75cb8946-a0dc-0da7-23c8-2123d169578d"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GraphLayout"]], "paclet:ref/GraphLayout"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63688a50-35e7-99e6-1117-2c1a4393ebcc"],
 " change the picture. A styled graph needs about 55 points of width for each \
state in its widest layer. The following options can also be given:"
}], "Notes",
 CellID->525088789,ExpressionUUID->"12187c95-2034-8b29-4238-75df51c6d673"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "29829495-262a-abaa-5fb1-0ddf53dcf9f0"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "136212ad-a4c2-b9f3-4111-8bf6cd740bd9"]], "TableText",ExpressionUUID->
     "67f6b273-a0bf-ee61-0d8d-343cd14bb54b"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07a2a6c0-d7ac-3784-2d51-3fade25e9dee"]], "TableText",ExpressionUUID->
     "7d29df82-54ab-6c21-24d6-d6ec5d5e370b"], Cell[TextData[{
     "when two states are one state: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2673b224-f5d9-a24c-4e00-2b81fc6df096"],
     " (never), ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27388ee6-22a7-f122-4ec7-27c05753c008"],
     " (identical edge lists) or ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"],
     " (isomorphic)"
    }], "TableText",ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7641b941-63e8-8619-1e7e-312b1582ed63"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "42b8cf72-fa81-ffe6-7247-e73fff35c5cc"]], "TableText",ExpressionUUID->
     "1c8db7a0-3aa3-299f-44b2-2e0abf567be5"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "473593be-64fb-e664-6eca-0af80c8fcd4e"]], "TableText",ExpressionUUID->
     "79a8e286-b760-8808-2f57-fbe3c21adb52"], Cell[TextData[{
     "when two applications are one event: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
     ", ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],
     ", ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "36bb0aa4-099e-3511-5e58-a30ea8289c7b"],
     ", ",
     Cell[BoxData["\"\<Positional\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6fab4322-7f5b-c123-15a9-5a8c7aef9009"],
     " or a list of identity components"
    }], "TableText",ExpressionUUID->"559c0528-76f1-864e-03a3-9d720285ec94"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c3b3e9a-7f95-6e09-75d8-b7c47a203553"], Cell[TextData[Cell[
    BoxData["\"\<CausalTransitiveReduction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7b834648-1855-f17e-29b1-581299e1c044"]], "TableText",ExpressionUUID->
     "6aa15cf4-f328-f435-1a5f-55b186c2df1f"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1fa3178e-7287-38be-4550-8ee807338a84"]], "TableText",ExpressionUUID->
     "33c53063-afff-c489-61fa-aa4cc98baed3"], Cell["\<\
whether to drop a causal pair implied by a longer causal path\
\>", "TableText",ExpressionUUID->"08d8bcb3-70a4-55b3-38e7-35fd01513f99"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "20e38226-5aed-155d-5090-1b805e987fa7"], Cell[TextData[Cell[
    BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "160727ef-d1b8-0069-3e3c-bec8e04d52b3"]], "TableText",ExpressionUUID->
     "261df1b1-b81e-57af-4e22-e8fb39ab3df5"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "00ba9d2f-c328-50fc-3059-1488f6dd22c6"]], "TableText",ExpressionUUID->
     "02964792-f196-8b6e-32ae-5edf8020d9b4"], Cell[TextData[{
     "the number of successor states kept per state, the lowest-ranked, with \
every transition into them and ties at the cut kept (",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "166d4e5f-4333-9385-3e13-601976c7e1ef"],
     " for no cap)"
    }], "TableText",ExpressionUUID->"1c99ee20-d785-d362-44a6-078de231be48"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "60858f89-56d8-6615-10ba-26d3636d4d7f"], Cell[TextData[Cell[
    BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "2e45545e-c429-efe4-567b-4e1bedddb5ce"]], "TableText",ExpressionUUID->
     "24564246-a2b2-7a9b-4c6e-6423d74748e1"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "273d1382-afb1-09c0-4ec2-8aefca445b2a"]], "TableText",ExpressionUUID->
     "39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"], Cell[TextData[{
     "the number of successor states kept per step, the lowest-ranked, with \
every transition into them and ties at the cut kept (",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "46be6341-4be3-06d9-6e46-7b2b6d966c23"],
     " for no cap)"
    }], "TableText",ExpressionUUID->"352b8971-1d3f-d4c9-6328-213b94cbbe13"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "227c7e4b-1c68-aac8-5204-70159502f812"], Cell[TextData[Cell[
    BoxData["\"\<StateCost\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "6cd9b5a9-dbed-51da-14e6-2cf2dd982320"]], "TableText",ExpressionUUID->
     "4becebe3-5bfe-fac0-7993-02cd5d88c82a"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "312d182f-c6c7-5e1e-60d2-9188f3722564"]], "TableText",ExpressionUUID->
     "1449d45f-8382-90b9-3c76-ce193634e283"], Cell[TextData[{
     "a pure function of ",
     Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "444f09dd-766a-dba7-6c74-a087031ca98d"],
     " names, such as ",
     Cell[BoxData[
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#BallDimension", " ", "-", " ", "3"}], "]"}], " ", "&"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "79e9b65a-67eb-1624-2f96-2804119e7d0e"],
     "; with ",
     Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "394df0e2-3b3f-7a44-6f72-e9ccbeca48ae"],
     ", or ",
     Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
