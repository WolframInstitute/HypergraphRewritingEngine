Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4c3bdf2-2a18-d546-8ad6-d2310d0d36b9"],
 " applies on the CPU. Under ",
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd5ae96d-d4a9-9749-ae45-f2ca8cfd11e6"],
 " it is reported in ",
 Cell[BoxData["\"\<Warnings\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cd48aca-3bca-6745-b76a-2497eadb3fb8"],
 " and the evolution runs unsampled, rather than silently returning a \
different answer per device."
}], "ExampleText",ExpressionUUID->"c9023fa3-13ee-2f41-9551-b2748d473288"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"RuleWeights\"", "ExampleSubsection",ExpressionUUID->"3a48de93-d064-a94c-a579-22d52ab22e8f"],

Cell[TextData[{
 "Per-rule multipliers on ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3905baa7-9971-0340-ab64-ac45a0f04e56"],
 ", given in rule order. The rate a rule's transitions are drawn at is the \
product of the two, so the knobs compose rather than one replacing the other: \
a rate of 1 with weights ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "0"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8a4030b-72cf-0440-bb9a-ed81bd27f60b"],
 " still samples, dropping the second rule entirely and leaving the first \
untouched."
}], "ExampleText",ExpressionUUID->"d766fe00-f84a-cb41-b7fc-1f65503e50c7"],

Cell[TextData[{
 "A short list is a partial override. Rules past its end take weight 1, so \
weighting the first of five rules does not require spelling out four ones. ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb4fe4a5-fbe3-284e-95f5-4621610a1efa"],
 " weights every rule equally, which is what a run that sets nothing gets."
}], "ExampleText",ExpressionUUID->"6a61b4cf-e30c-6045-aaa2-2e782351f43c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", "\n", "  ", 
   RowBox[{"\"\<RuleWeights\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1.", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"85de0d50-ced2-bf4c-a878-87c545445f99"],

