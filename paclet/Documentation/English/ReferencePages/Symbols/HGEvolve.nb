      FontSize->0.9 Inherited,ExpressionUUID->
      "013c2307-fb8b-27c7-30c3-bb60fe3f8d2d"],
     ", ",
     Cell[BoxData["\"\<EdgeCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4b734859-75e7-efa6-7901-62030393b58c"]
    }], "TableText",ExpressionUUID->"4ae31c17-eefa-a706-7a90-96508a8c0a6c"], 
    Cell["the number of vertices and of hyperedges", "TableText",
     ExpressionUUID->"00844d77-2817-3ec6-30bc-653149a3842c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "20b97f64-b973-0c8a-5047-774e380656d0"], Cell[TextData[{
     Cell[BoxData["\"\<MaxDegree\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "04469009-6b02-dcc3-2c7d-0a530eb4a629"],
     ", ",
     Cell[BoxData["\"\<MeanDegree\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4e35d333-5bd5-ef26-77ca-cb7d5e61b20c"]
    }], "TableText",ExpressionUUID->"5547dfb6-0e84-e145-037c-d6f0ab36b3af"], 
    Cell["\<\
the largest and the mean number of hyperedge slots a vertex fills\
\>", "TableText",ExpressionUUID->"12b61bfc-9cd7-eca9-424d-92a61563b6f3"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "451364b5-819d-fb99-7321-7dff3029c9e3"], Cell[TextData[Cell[
    BoxData["\"\<TwoSectionEdgeCount\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "13b49e24-0fb7-4441-414b-178eaa422eab"]], "TableText",ExpressionUUID->
     "445bf28f-7a5a-ecd1-6c78-ebe97fecb63b"], Cell[
    "the number of distinct vertex pairs that share a hyperedge", "TableText",
     ExpressionUUID->"089aa42d-ce49-3603-38b9-3e76ebfd9d69"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "48fccab3-b886-a0f7-7883-e3fd3930f2dd"], Cell[TextData[Cell[
    BoxData["\"\<Components\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0cdaad60-2181-5e26-34f9-454a5034250c"]], "TableText",ExpressionUUID->
     "542cff75-84e0-b601-7dd3-f73f2c9a1d6b"], Cell[
    "the number of components of the incidence graph", "TableText",
     ExpressionUUID->"00dd9d4d-f7ec-565f-30e2-151681993ca5"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0d66b502-775d-ec4c-3b1d-2d6c02e9b696"], Cell[TextData[Cell[
    BoxData["\"\<CycleRank\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3a3bfee8-9a0e-4a4b-6bd8-f7b21fbb1891"]], "TableText",ExpressionUUID->
     "333832e2-8bec-4128-62c7-abcc2d991072"], Cell[TextData[{
     Cell[BoxData["\"\<TwoSectionEdgeCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "78cf51d6-d7cd-4672-28f5-4893e2782d58"],
     " - ",
     Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1d9e3d6f-99f1-7c1e-4ba5-b5491f844764"],
