Cell[TextData[{
 Cell[BoxData["prop"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "96ba7a9d-48f6-e440-915f-a64df671b83f"],
 " may also be a list of property strings, in which case an association keyed \
by those strings is returned."
}], "Notes",ExpressionUUID->"74da1c98-f4dc-f243-aa51-5109d8ffd0c8"],

Cell[TextData[{
 "Any ",
 Cell[BoxData[
  RowBox[{"*", "Graph"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4aaec19b-b5b1-9741-878d-ac0cd5215707"],
 " property may take the suffix ",
 Cell[BoxData["Structure"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "765e6929-2203-df45-8ac8-b6819c45ad9b"],
 " to return the same graph without vertex styling (a lighter-weight \
rendering), e.g. ",
 Cell[BoxData["\"\<StatesGraphStructure\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98ef6678-9bc6-cc4b-9c38-d23b11f0292e"],
 "."
}], "Notes",ExpressionUUID->"c7060099-13d1-b443-a1c8-ee3fd0cd4fe0"],

Cell[TextData[{
 "A raw ",
 Cell[BoxData["\"\<States\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f2bb337-3708-d045-b71f-3a78698cdb47"],
 " result is a list of associations, one per state, with keys ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0786376-80ab-a349-813f-bf49317d5f8e"],
 ", ",
 Cell[BoxData["\"\<CanonicalId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e7f027b-d60f-bc4b-8a47-1087e4aa6ef8"],
 ", ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8e922a1-41c0-ec42-810b-651aeb247c1a"],
 ", ",
 Cell[BoxData["\"\<IsInitial\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fc9ad8b-46e0-5745-9bd7-e3536362e844"],
 ", ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dd3705e-8cd0-7f40-94fd-66a00799d313"],
 " (the state's hyperedges), and \[LongDash] when ",
 Cell[BoxData[
  RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3a60af3-3560-9643-9b1c-9c08e315ab1d"],
 " \[LongDash] ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0ed6a187-fcd7-c44a-ad63-fd01c05a236b"],
 ". A raw ",
 Cell[BoxData["\"\<Events\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9f8d98ed-7db3-4743-a16c-fd7fcbf10931"],
 " result is a list of associations with keys ",
 Cell[BoxData["\"\<Id\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "656c3da2-67c6-7d43-9ad9-c44a3bc12dc0"],
 ", ",
 Cell[BoxData["\"\<CanonicalId\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ae7f344-1bfe-2643-9eef-886cf4f780bb"],
 ", ",
 Cell[BoxData["\"\<RuleIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5923a16c-13ba-f04c-959f-8ca2b4d1352b"],
 ", ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2490a9e5-efcc-924b-bea8-1a81ca3a6659"],
 ", ",
 Cell[BoxData["\"\<InputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8e289db-eb92-f44c-9ef5-1e3c2d049783"],
 "/",
 Cell[BoxData["\"\<OutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e64eaac0-bc7e-b040-9006-5c794d7b1031"],
 " (state ids), ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8fff8c50-6304-9d4e-9567-ec756badc982"],
 "/",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce567d9b-724f-654a-bc92-7b2e470b0a5f"],
 " (edge ids), and ",
 Cell[BoxData["\"\<InputStateEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4330fa66-78a5-8844-84ab-b24df44fe9d2"],
 "/",
 Cell[BoxData["\"\<OutputStateEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35445bd2-57e5-fe4c-b4f7-e29ffbd62be7"],
 " (the full edge lists)."
}], "Notes",ExpressionUUID->"5f126070-d129-bc4a-89e0-39ff8894bc10"],

Cell["\<\
State and event deduplication, exploration limits, and the output content are \
controlled by:\
\>", "Notes",ExpressionUUID->"cc6e94eb-7fb8-ac4a-9f74-b596154dbb33"],

