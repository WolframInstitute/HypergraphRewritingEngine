   " ", "\"\<EvolutionGraph\>\"", ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "600"}], ",", " ", 
   RowBox[{"AspectRatio", " ", "->", " ", 
    RowBox[{"1", "/", "2"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
