Cell[CellGroupData[{

Cell["Identifying isomorphic states", "ExampleSubsection",
 CellID->326038929,ExpressionUUID->"4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],

Cell[TextData[{
 "By default every distinct provenance is a separate state. ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 " merges states that are equal up to isomorphism, collapsing the multiway \
graph. Compare the raw and canonical state counts:"
}], "ExampleText",
