Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "evolves the hypergraph ",
 StyleBox["init", "TI"],
 " under ",
 StyleBox["rules", "TI"],
 " for ",
 StyleBox["n", "TI"],
 " steps in every possible way and gives the graph of the states and events \
reached, with the causal and branchial edges between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 "\[LineSeparator]",
 "gives the property ",
 StyleBox["prop", "TI"],
 " of the evolution.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["prop", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["prop", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 "\[LineSeparator]",
 "gives an association of the listed properties.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", 
    " ", "\"\<\!\(\*StyleBox[\"name\", \"TI\"]\)\>\"", ",", " ", 
    StyleBox["n", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56e0e12c-de7d-6135-7e9f-f889db08301f"],
 "\[LineSeparator]",
 "evolves a generated initial condition of the named family, shaped by the \
initial-condition options.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", 
       " ", "\"\<\!\(\*StyleBox[\"name\", \"TI\"]\)\>\""}], ",", " ", 
      "\[Ellipsis]"}], "|>"}], ",", " ", 
    StyleBox["n", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 "\[LineSeparator]",
 "evolves a generated initial condition shaped by the keys of the association."
}], "Usage",
 CellID->329621944,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell["\<\
A hypergraph is a list of hyperedges, and a hyperedge is an ordered list of \
vertices of any length. The same hyperedge may occur more than once.\
\>", "Notes",
 CellID->515379898,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell[TextData[{
 "A rule is written ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " ",
 StyleBox["rhs", "TI"],
 ", with a hypergraph on each side; ",
 StyleBox["lhs", "TI"],
 " is not empty. ",
 StyleBox["rules", "TI"],
 " is a single rule or a list of rules; with a list, every rule is applied at \
every step."
}], "Notes",
 CellID->604760901,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["\<\
The vertices of a rule are pattern variables, written as integers or as \
symbols. A variable on both sides is kept by every application, a variable on \
the left only is consumed with its edges, and a variable on the right only is \
a vertex the application creates.\
\>", "Notes",
 CellID->1476799103,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 "A match maps each hyperedge of ",
 StyleBox["lhs", "TI"],
 " to a distinct hyperedge of the state with the same number of vertices, and \
each variable to one vertex. Distinct variables may map to the same vertex."
}], "Notes",
 CellID->448336599,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[TextData[{
 "An event removes the matched hyperedges and adds the hyperedges of ",
 StyleBox["rhs", "TI"],
 ". Every match is applied."
}], "Notes",
 CellID->970785311,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 StyleBox["init", "TI"],
 " is one of:"
}], "Notes",
 CellID->1377816002,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["a hypergraph, whose vertices may be integers or symbols", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1439899046,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["\<\
a list of hypergraphs, each of which becomes a distinct initial state\
\>", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1641200340,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[TextData[{
 "a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 ", whose edge list is taken as the hypergraph"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->1424533854,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["a string naming a generated initial condition", "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->535457321,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "an association with a ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " key naming a generated initial condition"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->141959522,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "an association with an ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bf5a20e-c541-e06e-698a-446becf5b2b4"],
 " key and no ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07964fa7-8d1e-ff14-2dae-660124a8c27e"],
 " key, whose ",
 Cell[BoxData["\"\<Edges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 " is the hypergraph"
}], "Notes",
 CellMargins->{{18 + Inherited, Inherited}, {2 + Inherited, Inherited}},
 CellID->299517738,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[TextData[{
 StyleBox["n", "TI"],
 " is a non-negative integer. The initial states are at step 0; step ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77d99fdb-a351-2d53-1de6-1684d6e477b9"],
 " holds every state produced by an event applied to a state of step ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04646437-faee-7dfc-2c1c-7e70fe9b47c6"],
 "."
}], "Notes",
 CellID->2142391071,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell["\<\
The evolution runs in a separate engine process, and the result reaches the \
kernel when it finishes.\
\>", "Notes",
 CellID->1002769646,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

Cell["The possible properties are:", "Notes",
 CellID->436346740,ExpressionUUID->"4c358d3e-86d3-ec5f-75ca-25783367b6a5"],

