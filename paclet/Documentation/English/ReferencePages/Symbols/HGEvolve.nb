      FontSize->0.9 Inherited,ExpressionUUID->
      "3181a460-bc62-f1ee-67be-3e4a3514c334"]
    }], "TableText",ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"], 
    Cell["the same seven graphs with plain vertices and no styling", 
     "TableText",ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e187950-8ca2-2ab2-0638-711a25577898"], Cell[TextData[Cell[
    BoxData["\"\<States\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "250a2d7c-9b81-05b0-5309-c5261e346f9a"]], "TableText",ExpressionUUID->
     "15a9104d-5625-6af3-4356-8a1763d038d9"], Cell[
    "the state records, an association keyed by state id", "TableText",
     ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "43821c38-6720-b4f9-71b1-966212da1ec3"], Cell[TextData[Cell[
    BoxData["\"\<Events\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "341c54d9-3079-6bba-5c24-4d83410c3980"]], "TableText",ExpressionUUID->
     "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"], Cell[
    "the event records, an association keyed by event id", "TableText",
     ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"], Cell[TextData[Cell[
    BoxData["\"\<EventClasses\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5077c06e-c394-b43c-000c-da4bf6261f06"]], "TableText",ExpressionUUID->
     "07359582-e823-44a1-2eca-0cef89d62e8b"], Cell[TextData[{
     "for each event under ",
     Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
     ", the ids of the rule applications it stands for"
    }], "TableText",ExpressionUUID->"68c76573-72ce-0c1a-18fd-7d3d077b5760"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6184d2f2-049e-728e-17bb-cbbcad2b40d4"], Cell[TextData[Cell[
