      FontSize->0.9 Inherited,ExpressionUUID->
      "107fa29c-d013-1000-4004-3bd9e1a6636a"],
     " and ",
     Cell[BoxData["\"\<OSMemoryLimit\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
     " (the operating-system limit the engine process runs under, ",
     Cell[BoxData["0"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
     " for none); on the CPU ",
