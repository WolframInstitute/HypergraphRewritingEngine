Cell[CellGroupData[{

Cell["\"EdgeDeduplication\"", "ExampleSubsection",
 CellID->870168325,ExpressionUUID->"6090c20f-1226-92f3-10af-e469a7d0e0d9"],

Cell[TextData[{
 "By default a causal graph has one edge per pair of events. With ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05991ec7-58a0-3f5d-33a6-97a1595a85a7"],
 ", it has one edge for each hyperedge the consumer took from the producer, \
tagged with its ",
 Cell[BoxData["\"\<EdgeIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d6d1e2a-2e52-ea78-3b12-90744be4b942"],
 "; the counts and ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "514c4c6c-8022-d8b7-0774-663631d4aa9d"],
 " are unchanged. Three steps of the chain rule under ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68df41a8-6354-4794-18e5-58f216e12dfe"],
 " event identity have three causal pairs:"
}], "ExampleText",
 CellID->327826064,ExpressionUUID->"6341ee00-46aa-0ad7-117e-006a735f583d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeCount", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
    " ", "\"\<CausalGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "Full"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1914710608,ExpressionUUID->"51765390-551f-8be6-070e-4ada5cabd9cc"],

Cell[BoxData["3"], "Output",
 CellLabel->"Out[1]= ",
 CellID->974758211,ExpressionUUID->"651ec994-b5cc-7852-1325-e0de3c794ab8"]
}, Open  ]],

Cell["With one edge per shared hyperedge:", "ExampleText",
 CellID->1550219352,ExpressionUUID->"04ab5aad-5ed8-49aa-2ca9-53f75b6d1bf0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EdgeCount", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
    " ", "\"\<CausalGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<EdgeDeduplication\>\"", " ", "->", " ", "False"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",
 CellID->1054643014,ExpressionUUID->"3f9eb20d-625d-c280-65a5-345717e990ea"],

Cell[BoxData["8"], "Output",
 CellLabel->"Out[2]= ",
