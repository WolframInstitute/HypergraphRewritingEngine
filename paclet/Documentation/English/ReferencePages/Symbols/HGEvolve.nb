Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "193fcd55-fc39-0e46-93a6-1a0ca743865b"],
 ", this stops keeping new states once that many exist for the step, tracing \
a narrow history rather than the full multiway system:"
}], "ExampleText",ExpressionUUID->"1de4ee8c-921f-9e4c-bada-8679f6922d69"],

