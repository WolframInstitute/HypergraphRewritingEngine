Cell[TextData[{
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21873d4b-abab-604f-af6b-55892e80aee6"],
 " asks whether their CONTENTS are equal \[LongDash] the same hyperedges over \
the same vertex names. That is cheap, and it is FINER than isomorphism, not \
an approximation of it: two isomorphic states whose vertices are labelled \
differently are different states under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3777082d-ef62-3248-a93b-fa88f29b5ac9"],
 ", and stay separate. On a chain rule at 5 steps it merges nothing where ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e828276a-ed8b-6c4b-9ca2-42022633cf17"],
 " collapses 154 states to 6. Choose it when vertex names are meaningful and \
you want them respected; choose ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "985d13c4-7c9a-ef4d-bd9c-7fc6a9d25b50"],
 " when they are arbitrary and only the shape matters."
}], "ExampleText",ExpressionUUID->"da39c685-3476-4743-a0ef-60d8bd450c05"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"CanonicalizeEvents\"", "ExampleSubsection",ExpressionUUID->"591f26a2-3c13-f14c-bf88-cbda113007e5"],

Cell["\<\
Event canonicalization merges equivalent update events. Compare the event \
structure with it off and on:\
\>", "ExampleText",ExpressionUUID->"8ccd3d2a-44e0-1b4b-b603-fb300b318fe4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "2", ",", 
   " ", "\"\<EvolutionGraphStructure\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "None"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6b9be1c6-1f09-da40-ad09-d512303a1b41"],

