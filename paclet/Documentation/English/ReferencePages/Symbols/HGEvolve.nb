Cell[CellGroupData[{

Cell["\"CanonicalizeStates\"", "ExampleSubsection",ExpressionUUID->"75b822a4-17b2-e140-ba9d-15cc8550343b"],

Cell["\<\
This chooses WHEN two states are the same state, and the three settings are \
three different questions, not three accuracies of one question. Each is \
applied as the run proceeds, so it decides what gets explored and not merely \
how results are grouped.\
\>", "ExampleText",ExpressionUUID->"9239bb21-d8ee-0e49-b611-6a7ca1506c63"],

Cell[TextData[{
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1237562d-9537-ab49-ab9a-61816159814b"],
 " asks nothing: every provenance is its own state, so a hypergraph reached \
by two different histories appears twice."
}], "ExampleText",ExpressionUUID->"afa2e54f-8987-ec44-b9eb-853da07769df"],

