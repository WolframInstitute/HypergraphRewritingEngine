Cell[CellGroupData[{

Cell["\"TargetDevice\"", "ExampleSubsection",ExpressionUUID->"616399ea-f604-c246-8531-92b24e4bea61"],

Cell[TextData[{
 "Evolution runs on the CPU by default. Where a GPU build is bundled, ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "007596ed-315a-9b4b-bb85-6e451bfff651"],
 " runs on the device; otherwise it falls back to the CPU with a message. The \
GPU engine honors the same ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "85a7cf53-3c68-0c45-a75b-f9823888c922"],
 " modes (",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7718a240-de01-7441-84d7-6f9c232e5d74"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a63322e-b049-124d-a65c-f9366c95c09b"],
 ", ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6099fbe-ddfe-6a4c-ab1d-0c9cbbfecbda"],
 ") as the CPU, and its state counts match the CPU's in every mode:"
}], "ExampleText",ExpressionUUID->"95e44952-c7c3-7e4c-8cf1-0f30fba5226f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c52a6eb8-055f-d845-8832-7fff61c9dc2f"],

Cell[BoxData["10"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4824fd04-419d-1148-a64d-dc450821c70b"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell[
  "Applications", "ExampleSection",ExpressionUUID->
   "d5715ee2-1cae-4f33-89b2-0e99ea9caa6e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[CellGroupData[{

Cell["Cross-run isomorphism hashes", "ExampleSubsection",ExpressionUUID->"9c9081eb-aad2-9c47-b26f-00491a3cfe13"],

Cell[TextData[{
 "Run-local state ids differ between runs, but ",
 Cell[BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8461813a-034a-b746-a091-eb6c8bc9fe51"],
 " attaches an isomorphism-stable hash usable to fuse pruned runs by \
isomorphism class:"
}], "ExampleText",ExpressionUUID->"4f5b301b-83c5-d84b-bbe4-a9f3c6170065"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "2", ",", 
    " ", "\"\<States\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
   "]"}], " ", "//", " ", "Length"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8596eb2a-48ab-5643-b0be-ae919fbf13a9"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"ee49a2d8-9f5a-244c-8c61-a69c268b3e3d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continuing an evolution instead of re-running it", "ExampleSubsection",ExpressionUUID->"5aad2852-23ce-694b-a3d8-f4aa895f85e6"],

Cell[TextData[{
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18116cbe-0d20-344a-a27b-b54b7c6f622f"],
 " answers one question and discards the exploration that answered it, so \
asking for three steps and then five re-runs the first three. A ",
 StyleBox["session",
  FontWeight->"Bold"],
 " keeps the engine, its graph and the frontier the budget stopped at, so \
each step carries the ",
 StyleBox["same", "TI"],
 " exploration further and every state, event and relation already built \
keeps its identity:"
}], "ExampleText",ExpressionUUID->"d9f8d2de-c496-f644-bd5e-a8cd2f98cce9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionQuery", "[", "s", "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}]}], "}"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0de85ff3-e767-f54b-8971-d923881f0348"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "1"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "4"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "3"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "10"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "9"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b1210b12-a8de-a945-b861-d419cfbff2a4"]
}, Open  ]],

Cell[TextData[{
 "which gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"NumStates", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"NumEvents", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"2", ",", " ", "1"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"4", ",", " ", "3"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"10", ",", " ", "9"}], "|>"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3aee5e29-c454-dd4f-9ff8-248e198fbb89"],
 " \[LongDash] the same numbers as ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "k", ",", " ", 
    "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6acf96d0-80a9-7b4f-97d5-a54d14d84c9d"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k", " ", "=", " ", "0"}], ",", " ", "1", ",", " ", "2", ",", " ", 
   "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95e59257-2ba5-0c41-9ea4-1f7a496249e8"],
 ", reached by continuing rather than restarting. ",
 Cell[BoxData[
  RowBox[{"HGSessionQuery", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0abf9a5e-7978-a344-ac7a-e478616fb9f7"],
 " re-reads the accumulated graph without exploring further. ",
 Cell[BoxData[
  RowBox[{"HGSessionClose", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe93130c-d445-6848-aa2a-130cb46e33a1"],
 " releases the engine."
}], "ExampleText",ExpressionUUID->"85ed8a73-cf61-a448-a2ac-9eb26e3fb258"],

Cell["\<\
Three things are fixed when the session opens, and the later verbs refuse to \
change them:\
\>", "ExampleText",ExpressionUUID->"87d25ca3-7b51-bf4a-974f-23600836520f"],

Cell[TextData[{
 StyleBox["The rules.",
  FontWeight->"Bold"],
 " A session's rule set was fixed at ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0d040a6-dc73-2a4e-b650-94111aada6ec"],
 "; applying different ones would answer about a system the session is not \
exploring."
}], "Item",ExpressionUUID->"5c235981-c297-064e-9e88-201df729634b"],

Cell[TextData[{
 StyleBox["The identity convention",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9609e89a-cee1-bd4d-80d7-3421512ff1c8"],
 ", ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "969551cf-90a8-ee43-843a-84b615b41a96"],
 ", ",
 Cell[BoxData["\"\<ShowGenesisEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6985444-e760-d042-a3a1-12a35cd5631f"],
 "). These decide what a state and an event ",
 StyleBox["are", "TI"],
 ". The engine reads them back from its own graph rather than from a step's \
request, so a query cannot report exact canonical forms as tree-mode ones."
}], "Item",ExpressionUUID->"dbb0ff35-6175-4345-8afa-c221646e4253"],

Cell[TextData[{
 StyleBox["What the run records.",
  FontWeight->"Bold"],
 " An artifact the session was not opened for cannot be produced afterwards \
\[LongDash] the evolution that would have built it has already run. Open with \
the property you intend to ask for; asking for another returns an empty \
relation and the engine says so rather than serving the emptiness silently."
}], "Item",ExpressionUUID->"68ad446f-3149-e943-8e1c-a43776d89da0"],

Cell[TextData[{
 "A session's handle names a live engine process, so one session at a time is \
served per worker: a second ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9301ed07-f310-d64a-8d66-79e11add3ccd"],
 " while one is live is an error rather than an eviction, because evicting \
would discard an exploration without being asked."
}], "ExampleText",ExpressionUUID->"dd9f04cf-535c-a945-a545-ef21cdc851d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Steering: continuing from part of the frontier", "ExampleSubsection",ExpressionUUID->"90124738-9743-7743-b12b-df59cb136dfc"],

Cell[TextData[{
 "An exploration that branches faster than it is worth exploring can be \
carried forward along a chosen branch. ",
 Cell[BoxData["HGSessionFrontier"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77669769-24a1-ef45-a173-7ec09ec0c1ee"],
 " reports the states a continuation would resume from, and ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", 
     RowBox[{"{", "...", "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9780393-5c53-8248-984c-cc5e256be4ca"],
 " expands only those:"
}], "ExampleText",ExpressionUUID->"fd1beeb8-fc05-c246-9af2-33d89a28c4c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"s", ",", " ", "2"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"HGSessionFrontier", "[", "s", "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"First", "[", "f", "]"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6312a718-1dec-a14d-ad13-5b5cec820aea"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cc2f9d08-1eb3-cc40-a49f-7450f8277c69"]
}, Open  ]],

Cell["\<\
which reaches 7 states where an unsteered step of the same depth reaches 10.\
\>", "ExampleText",ExpressionUUID->"0d1516c6-6ec0-aa4c-a38a-0793e5b766c8"],

Cell[TextData[{
 StyleBox["The unselected branches are retained, not discarded.",
  FontWeight->"Bold"],
 " They stay on the frontier and a later step resumes them, so a steered \
detour costs nothing in what remains reachable: continuing the session above \
without a selection lands on 34 states, exactly what ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<NumStates\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cade55a1-631c-2e4f-a610-2a7596184f8c"],
 " gives. Steering narrows what runs ",
 StyleBox["next", "TI"],
 ", never what is ",
 StyleBox["reachable", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"7dfef376-ec96-6348-80b1-ba853a88e653"],

Cell[TextData[{
 "Naming a state that is not on the frontier is an error rather than a step \
that quietly does nothing, since a caller steering toward a state the \
exploration has already passed would otherwise get an unexplained empty \
result. Both devices serve the same contract: under ",
 Cell[BoxData[
  RowBox[{"TargetDevice", " ", "->", " ", "\"\<GPU\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "986dec4f-9a19-8942-9ac7-2b184f388546"],
 " the worker resolves the selection against the frontier it last reported \
and puts the unselected entries back after the step, each at the depth it was \
stranded at."
}], "ExampleText",ExpressionUUID->"c1dca80c-2bed-0540-90d3-3ccdd14414b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sending only what a step added", "ExampleSubsection",ExpressionUUID->"8b382049-d2f9-3b4d-8ccf-d3545f44549c"],

Cell[TextData[{
 "A step re-serialises the whole accumulated graph. ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1663079f-25e7-3f42-8905-90b4eacfda2d"],
 " sends only what the session has not already been sent, and the Wolfram \
side merges it back into the graph the session holds \[LongDash] so the wire \
is incremental and the ",
 StyleBox["answer", "TI"],
 " is not: ",
 Cell[BoxData["HGSessionStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73af6b00-6598-1c44-8501-1287be061a34"],
 " returns the whole accumulated graph either way."
}], "ExampleText",ExpressionUUID->"e2b2c157-3fb3-f648-8f8e-16b01643fc6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<StatesGraphStructure\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGSessionStep", "[", 
     RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
      RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]}], "]"}], 
    ",", " ", 
    RowBox[{"{", "6", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cca46095-dfcf-dd40-a02c-780b0458811e"],

Cell[TextData[{
 "Measured on this evolution at depth 7 (5,914 states), ",
 Cell["tools/dev/session_step_cost.wls", "InlineCode",ExpressionUUID->
  "e40c35cb-e1d2-3947-afc4-3cc7c8697013"],
 ": the engine leg falls from 381 ms to 269 ms and the reply from 516,535 to \
443,660 bytes. That is a 29% cut to the engine call and 8% to the step, \
because the rest of a step is the Wolfram Graph construction \[LongDash] \
1,640 ms of the 2,021 ms total \[LongDash] which a delta cannot reduce, since \
the graph being built is the whole accumulated one either way."
}], "ExampleText",ExpressionUUID->"76702d09-56b1-7e4d-bcce-701cb3b5e31e"],

Cell[TextData[{
 "Ask for a full delivery at any time to resynchronise; doing so resets what \
the session believes you hold, so the next delta is measured from it. Delta \
delivery is not served on the quotient reconstruction route (",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b76900b7-4421-924d-b466-fc5cda6205dc"],
 " with causal output), where the causal relation is reduced on read and an \
edge already sent can leave the reduction \[LongDash] a delta has no way to \
withdraw one, so those replies carry the whole graph and say so."
}], "ExampleText",ExpressionUUID->"4b7e84f1-6ba2-754f-98ef-de517fb81dfc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keeping a bounded number of transitions per rule", "ExampleSubsection",ExpressionUUID->"1e1c734f-3745-9645-9940-43cbc9107a33"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1672c73-09fc-5640-8cfa-7e5c2bf68bde"],
 " keeps at most ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "13f908ff-8de9-7c4c-b033-eaa6bcb6ab4c"],
 " of each state's own transitions ",
 StyleBox["per rule",
  FontWeight->"Bold"],
 ", and the choice is made when that state's matching is complete rather than \
as matches arrive:"
}], "ExampleText",ExpressionUUID->"4f7770da-2ea2-2f49-8de8-c3d11da92c52"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cad77fd4-9a9d-724f-8b09-c252c957fad7"],

Cell[BoxData["5"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c5c1c5d8-2869-8641-8772-e433357bfafa"]
}, Open  ]],

Cell[TextData[{
 "The distinction from the other caps is what it is for. ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39dd59e4-93c3-f347-920b-a921b50d5acd"],
 " bounds children per parent regardless of which rule produced them. ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a43c0b3c-9a4b-ec40-805e-221dc8c31fe0"],
 " bounds by ",
 StyleBox["arrival order",
  FontWeight->"Bold"],
 ", which depends on the schedule, so two runs of the same evolution can keep \
different states. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8a1bd1a-5ecc-284f-b419-5a616b727c0b"],
 " ranks a state's transitions by their own isomorphism-invariant identity \
and the ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c0bca90-7e91-fe4e-ae09-a1cf2cd7709e"],
 ", so the kept set is the same at any thread count \[LongDash] choosing ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9fd24921-f59b-fb48-ae6d-eeacf5e695e8"],
 " of ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "675146a5-4fe9-6443-b68c-c895cedc0afa"],
 " needs all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e039de2-6573-e142-a6e9-cc50a12c90f1"],
 ", and all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37aefeda-34b2-bf46-9bf7-39604c4ab692"],
 " exist only once that state's matching has finished."
}], "ExampleText",ExpressionUUID->"cd6a7da1-3a5d-e844-bbd4-344d542891af"],

Cell[TextData[{
 "Applies to a state's ",
 StyleBox["own",
  FontWeight->"Bold"],
 " matches. A match forwarded into a state from an ancestor arrives \
asynchronously and is not counted against the cap, for the same reason: its \
arrival races the point where the count would be taken. CPU only."
}], "ExampleText",ExpressionUUID->"535347bf-3cf0-7644-9987-2f659509767b"]
}, Open  ]]
}, Open  ]],

