      "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
     " for sampling that is actually uniform"
    }], "TableText",ExpressionUUID->"63a48922-0fac-666c-115b-208caa594cb6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "387a9e0d-0234-0e73-6819-1057b7c15559"], Cell[TextData[Cell[
    BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3f64ca0d-9927-5f44-651b-ec5718d225ae"]], "TableText",ExpressionUUID->
     "399d1ff3-4632-be92-6fa2-96bd73c404f8"], Cell[TextData[Cell[BoxData[
    "0"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1170384d-2f38-2c50-470f-b2174acd76ba"]], "TableText",ExpressionUUID->
     "6ce33075-6d34-44a7-1490-aa3f04c12e8d"], Cell[TextData[{
     "with ",
     Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
     ", the per-step cap described above (0 = all)"
    }], "TableText",ExpressionUUID->"6334ac9c-43f1-85c0-12cb-45c67585ef2a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "74397683-04f4-1d4d-1dc7-6fedac816797"], Cell[TextData[Cell[
    BoxData["\"\<BranchialStep\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "735e49d5-32a1-4a48-2166-609f47541892"]], "TableText",ExpressionUUID->
     "335d55a2-cf9b-493d-6163-4c0fea2e1807"], Cell[TextData[Cell[BoxData[
