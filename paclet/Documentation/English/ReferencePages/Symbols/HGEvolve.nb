(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["HGEvolve", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bda62185-6d00-0e49-a273-0b53cd75c541"],
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10596588-68a6-624b-bd01-7c6937db1666"],
 "\[LineSeparator]",
 "performs multiway hypergraph rewriting of the hypergraph ",
 Cell[BoxData["initial"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04015659-fedd-3b43-a9ca-7bafdf2fb6db"],
 " under ",
 Cell[BoxData["rules"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "feb2894e-9673-d34a-b75c-c3a57c578d7b"],
 " for ",
 Cell[BoxData["steps"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2531f616-7d7c-2044-b1a7-76fbd5426a4a"],
 " steps, returning the combined evolution/causal/branchial graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b534ea9f-d25b-a74b-a9b8-b7ece7ec1022"],
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["initial", "TI"], ",", " ", 
    StyleBox["steps", "TI"], ",", " ", 
    StyleBox["property", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97bc85cf-e7bc-bd4b-8056-3a828a440d18"],
 "\[LineSeparator]",
 "returns the specified ",
 Cell[BoxData["property"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff0af9f7-42ed-4942-84f4-553d4eeb9a84"],
 "."
}], "Usage",ExpressionUUID->"4e8a17e5-af48-3241-98ae-7e1f9355cb5c"],

Cell[TextData[{
 "The ",
 StyleBox["rules", "TI"],
 " argument is a rule or list of rules of the form ",
 StyleBox["lhs", "TI"],
 " ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66d3d7a8-7800-cf45-a2df-6dea47ac4ef1"],
 " ",
 StyleBox["rhs", "TI"],
 ", e.g. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4"}], "}"}]}], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c494b3f4-da56-6047-9d02-af69495142ab"],
 ". Each side is a list of hyperedges and each hyperedge is a list of \
vertices. Vertices are variables that bind to (not necessarily distinct) \
vertices of the state hypergraph; a vertex appearing in ",
 StyleBox["rhs", "TI"],
 " but not ",
 StyleBox["lhs", "TI"],
 " is a freshly created vertex."
}], "Notes",ExpressionUUID->"a70cb1c5-7d5a-6342-a0cb-547fcbabd6e4"],

Cell[TextData[{
 "The ",
 StyleBox["initial", "TI"],
 " argument is a single hypergraph state or a list of states given as numeric \
vertex labels, e.g. ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dee2a922-97fc-fd44-b890-c72dd21e2abe"],
 ". It may also be a ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178de8ae-62e7-b44a-8b03-e8428b9b8d2a"],
 " or a named initial condition (",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cadf0f9-2c0d-8a43-825a-b5a53d5f19b3"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b1f0edc-c124-124f-bd88-8759226934a7"],
 ", \[Ellipsis]), shaped by the initial-condition options below."
}], "Notes",ExpressionUUID->"13d4ecca-fc29-d245-8758-8324ccb73d8f"],

Cell[TextData[{
 "The ",
 StyleBox["steps", "TI"],
 " argument is an integer number of evolution steps."
}], "Notes",ExpressionUUID->"8caca623-c8aa-b04b-b452-e288cad93de7"],

Cell["\<\
The engine applies the rules in all possible ways (multiway evolution), \
optionally deduplicating isomorphic states, and builds the causal and \
branchial graphs. It runs in a standalone process, so a crash or abort never \
affects the notebook.\
\>", "Notes",ExpressionUUID->"4e5854e5-56db-4249-a175-c4efdbd22e87"],

Cell[TextData[{
 "The accepted values for ",
 StyleBox["property", "TI"],
 " include:"
}], "Notes",ExpressionUUID->"3b1c3952-fa7f-f24f-9991-aafe0efed100"],

