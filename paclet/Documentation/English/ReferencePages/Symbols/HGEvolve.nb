     "d844092f-0e1f-f042-9f48-2e2553cc4bbb"]], "TableText",ExpressionUUID->
     "92bf95e8-c43e-5949-9d2a-65d250cbf756"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b411c9d8-d8f4-bc48-9585-db3ca1e19cc9"]], "TableText",ExpressionUUID->
     "6f7e82d2-81ca-cd44-8de5-2b66c31a9979"], Cell[TextData[{
     "the identity states are merged by: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2c1dd8dc-572f-0547-80e8-813f044bf847"],
     " (every provenance distinct), ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2d4100c3-9347-ab45-990d-8b2224f90f19"],
     " (equal contents), or ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "56f4b065-de7d-1d4b-bd5d-114a6dc640a7"],
     " (equal up to isomorphism)"
    }], "TableText",ExpressionUUID->"caf3b282-eb60-7f48-8082-375cbdc4a078"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0ffd94cb-7bea-be4c-9c7f-c313163a6623"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "af10084d-fcdf-9b4d-9159-91bb5650fbd5"]], "TableText",ExpressionUUID->
     "d9163f67-fba6-4445-b34f-0110da4c4c23"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fddc8a08-d6df-844b-95e4-fed1a5f9b215"]], "TableText",ExpressionUUID->
     "7c93bb5a-a332-1e4b-977d-682bb56e8c71"], Cell[TextData[{
     "merge equivalent events: ",
