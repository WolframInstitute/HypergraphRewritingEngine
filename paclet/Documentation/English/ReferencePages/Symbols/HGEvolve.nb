     "53412643-5a68-df00-017e-b82d5f02a26a"]], "TableText",ExpressionUUID->
     "696f5b1d-d56b-3a26-1f15-5346dc1f890c"], Cell["\<\
whether the events that create the initial states are part of the result\
\>", "TableText",ExpressionUUID->"0eb02373-2484-618c-364f-bb3d4d3133d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "640353f1-ff8e-e9b3-0c31-4abafa38bb99"], Cell[TextData[Cell[
    BoxData["\"\<ColorByRule\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "37161f66-4600-a3a8-5d2d-974073baf1f2"]], "TableText",ExpressionUUID->
     "2e44757e-c407-f813-567c-6d3bedb3cb79"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"]], "TableText",ExpressionUUID->
     "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"], Cell["\<\
whether a styled graph colors each transition by the rule that fired it, with \
a legend\
\>", "TableText",ExpressionUUID->"1cd82739-42e3-b7ed-44e7-bf6376971d37"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0971a20b-7913-467e-3f0e-445578a62d44"], Cell[TextData[Cell[
    BoxData["\"\<MultiedgeStyle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "09df342d-d743-5809-3fe4-ae76e2f62b53"]], "TableText",ExpressionUUID->
     "0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "21fdaace-430e-f3f9-5782-43a876b8c1c3"]], "TableText",ExpressionUUID->
     "1b4e2dea-4a49-bf2e-4975-c4b46ffd0274"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "10b057f0-cb39-4e6e-4040-4ebdeecc14b4"],
     " draws one edge per event or pair; ",
     Cell[BoxData["\"\<Merged\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "41c6bfc6-0792-5005-77fd-36a0b227236f"],
     " draws edges with the same endpoints as one edge"
    }], "TableText",ExpressionUUID->"62752e4e-571f-d961-120a-c02862aba84b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "34ee5221-bb14-cc46-5c96-4b8b3ea696ac"], Cell[TextData[Cell[
    BoxData["\"\<ShowProgress\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "166277e1-e8de-815f-3e12-6eca8968d3a5"]], "TableText",ExpressionUUID->
     "0ae7a534-7379-468c-3a9c-3d7e060c2cd6"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "34baef30-7963-b757-5c59-077a78171dbd"]], "TableText",ExpressionUUID->
     "15ce0314-20ee-2b64-43f5-9b5e509b764e"], Cell[
    "whether to print the engine's progress", "TableText",ExpressionUUID->
     "38a9ac88-4644-6c0e-6856-45d273f13754"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "64802aa2-b136-451c-0cbf-c30fc0c32c66"], Cell[TextData[Cell[
    BoxData["\"\<DebugFFI\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "67771ff6-ea2e-a98b-0d0c-96b38fd8fbd1"]], "TableText",ExpressionUUID->
     "233ecb8e-17f3-8d32-52c5-e2e8a187d418"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7dd949a9-d8cf-50b3-2be7-60f2d97a2299"]], "TableText",ExpressionUUID->
     "4a74bc9f-39f4-5114-7a0b-35d9bf81207e"], Cell["\<\
whether to print what is requested from the engine and what it returns\
\>", "TableText",ExpressionUUID->"598f41e5-f1df-a461-0fb5-58ce806b0f4b"]}
  }]], "3ColumnTableMod",
 CellID->339082558,ExpressionUUID->"1e0f0df5-2071-c96f-4634-a4bf51059bb5"],

Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f6e12d5-e3b9-0bb9-2515-8b9e964c5983"],
 " is applied while the evolution runs, so it also determines which states \
are expanded. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41ecc127-3c02-05fa-7793-d881b5b76fc0"],
 " identifies states whose edge lists are identical. This is finer than \
isomorphism: two isomorphic states with different vertex names stay separate. \
The vertices of each initial state are numbered from 0 separately, so two \
initial states that differ only in vertex names are one state under ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1190ff72-a9fe-60f8-47af-f73fcf8b32c2"],
 "."
}], "Notes",
 CellID->432388834,ExpressionUUID->"19c80315-d7de-7125-4ff7-9b5ee26b400f"],

Cell[TextData[{
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fdf78a7-59a9-97d9-15e5-7101585dfd23"],
 " builds an event's identity from isomorphism-invariant components. ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a87483f-bfa4-2eb6-2abd-62793a51749c"],
 " uses the canonical input and output states. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09b26917-59e6-8729-3f41-81515f90ea73"],
 " also uses the step and the canonical positions of the consumed and \
produced edges within the state's isomorphism class; it needs ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "521ad179-838d-ce9b-0239-c923363994e1"],
 ". ",
 Cell[BoxData["\"\<Positional\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "136d7364-bcfb-8461-4113-6b4e348fef4b"],
 " uses the same components with positions read from each state's own vertex \
labels, as the Wolfram Multicomputation paclet does. A list of any of ",
 Cell[BoxData["\"\<InputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b78534b-7a52-d624-5918-4b157fe4bd0e"],
 ", ",
 Cell[BoxData["\"\<OutputState\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30c454b2-bdb8-e427-60fc-4dfc3432cf0d"],
 ", ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6879dfe8-0276-0c7b-1806-d6b2b7035741"],
 ", ",
 Cell[BoxData["\"\<Rule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7cc522fa-6a93-e579-24fa-bba40f27cc43"],
 ", ",
 Cell[BoxData["\"\<ConsumedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b82e386-6ff5-c0ee-09b1-fae009819234"],
 " and ",
 Cell[BoxData["\"\<ProducedEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34a39a2f-b372-ffce-5c50-1388c604c514"],
 " selects the components."
}], "Notes",
 CellID->443736588,ExpressionUUID->"66ca9132-7812-8248-0ec9-097c79a4d092"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023b1c4a-5b09-a8c9-33d8-96145ebdfa13"],
 ", every property is the same as under full exploration; only the cost of \
the evolution changes. It needs ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29a4f364-fd74-7ca4-5f5b-eb41f401468e"],
 "."
}], "Notes",
 CellID->1593449978,ExpressionUUID->"47740231-7fc8-4299-6d0b-a47b7a7d10e3"],

Cell[TextData[{
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1af52337-5e42-c8c3-4a8a-bb715bf49a29"],
 ", ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2fdb82dc-2353-e9b3-55f8-1b8656e7bb99"],
 " and ",
 Cell[BoxData["\"\<UniformRandom\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5782d92f-a790-094a-7db1-d088d2255b90"],
 " with ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05d48452-325d-a277-33eb-1e1c47e9f15d"],
 " cap by arrival order. The bound holds at any thread count, and which \
states are kept depends on the thread schedule. ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087ffcf6-194e-431e-3804-f5b098fb2e64"],
 ", ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "615fadf7-df9a-5675-1764-44b0da2f3d5f"],
 " and ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5de452e3-5fd7-a751-0b9c-4bcd5a630dbb"],
 " draw from the identity of each transition or state together with ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d0df906-1ebb-1081-5b32-f1609b4e62eb"],
 ", so the same seed keeps the same states at any thread count and on either \
device."
}], "Notes",
 CellID->1742646261,ExpressionUUID->"519a4e0d-3467-bfb9-07ba-6057bd130583"],

Cell[TextData[{
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a891815-8c00-cf41-6ab6-925f25ba95ab"],
 " keeps a state's lowest-keyed transition when every draw at that state \
failed, so a sparse sample reaches the requested depth. ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dbacffa-31b0-43f6-3b59-e6a4404511dc"],
 " does not."
}], "Notes",
 CellID->29467524,ExpressionUUID->"196a859c-b643-c1b3-4f69-1cd9c3f79399"],

Cell[TextData[{
 "A run that sets no ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c8a383-1e42-ef31-78f7-3aed9bf4b21b"],
 " and discards states through an arrival-order cap, ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50735439-04fd-dee7-0001-4e63ac89a4cd"],
 " or ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3597ba8d-914b-928f-63ac-33d720ffe0d5"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "warn"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "056fda38-a5bc-2884-3314-dc65cc497aee"],
 ", and its result can differ from run to run. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "383c4a9f-130c-f8c1-69c4-63d9a6beca2b"],
 " keeps the same transitions with or without a seed and issues no warning."
}], "Notes",
 CellID->1939141443,ExpressionUUID->"7b649e79-a2e1-7610-291b-1022d6945d7a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09cb884c-5fc8-b209-3fc8-22165a620153"],
 " runs the evolution on the GPU engine bundled for the platform, which gives \
the same states, events and relations as the CPU. Where no GPU engine is \
bundled, the message ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "gpudev"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376c6589-bcca-29e8-5d14-7cd3357f7b32"],
 " is issued and the evolution runs on the CPU. A GPU evolution that reaches \
a capacity limit issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "overflow"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667bb688-7420-22c7-0e18-2fd27dd5702d"],
 " and gives a partial result."
}], "Notes",
 CellID->5047578,ExpressionUUID->"72002252-da4c-5210-223f-c41fdff9217a"],

Cell[TextData[{
 "A generated initial condition is named by ",
 StyleBox["init", "TI"],
 ": ",
 Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "084561a7-5440-aaee-387b-78015dfaf834"],
 ", ",
 Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "721e71e5-9ca7-ded5-2226-68cf1553a43f"],
 ", ",
 Cell[BoxData["\"\<Torus\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a84e7eb-55e0-1894-3abb-feb563956afe"],
 ", ",
 Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3261920b-7b77-02d6-621e-14557e02503c"],
 ", ",
 Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebe3b2c-9c8f-bd2d-7645-b376153b0477"],
 ", ",
 Cell[BoxData["\"\<Mobius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d6a0058-fb4a-caff-2b69-9a05fefc98c5"],
 ", ",
 Cell[BoxData["\"\<Sprinkling\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41d92934-9aba-8299-77e6-c17e1f4cd0e3"],
 " (also ",
 Cell[BoxData["\"\<Minkowski\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cc23ff5-bf0f-f019-04f1-b6bf3abbc363"],
 "), ",
 Cell[BoxData["\"\<BrillLindquist\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29880975-91f0-008f-5fb7-a13f278552d5"],
 ", ",
 Cell[BoxData["\"\<Poisson\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "551c00cf-fc58-99c4-0323-99a8f5d2eb2e"],
 " or ",
 Cell[BoxData["\"\<Uniform\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22235db8-54be-42b7-53d1-54e25d4b109d"],
 ". The same names go in the ",
 Cell[BoxData["\"\<Type\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0976d5ae-737d-f257-3f0d-cc080609c0bd"],
 " key of an association, where the other keys shape the instance and take \
precedence over the options below."
}], "Notes",
 CellID->15008895,ExpressionUUID->"13e711b4-4d78-4d68-419c-88fe640d17b2"],

Cell["The initial-condition options are:", "Notes",
 CellID->1892712309,ExpressionUUID->"3fd09d86-aea1-a602-65ef-14e3cb550d68"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f6c0922-6605-ed68-5513-a08c13b1b7b2"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"2caab86a-2af9-b1b1-54a9-32344e8d039b"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"7f56169e-4783-4dbb-256d-8fd872361781"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"5b84d4d6-858d-5842-09bb-cd902c382aa8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "67558936-e5eb-8680-0d6a-2173939fecea"], Cell[TextData[Cell[
    BoxData["\"\<GridWidth\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1072dc7c-f7d5-c74e-4001-d6398261ad94"]], "TableText",ExpressionUUID->
     "3462f0a3-098c-f6b3-5c11-e90da83edc99"], Cell[TextData[Cell[BoxData[
    "10"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04cac1af-436c-9192-2cc9-d809761ee3f8"]], "TableText",ExpressionUUID->
     "63be94f2-239e-9b81-1145-0dbc5628e9eb"], Cell[TextData[{
     "the width of a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5a3d7a71-218e-1995-0bc3-7c3b503b6bff"],
     " (key ",
     Cell[BoxData["\"\<Width\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3a0f2024-2f71-09ca-6a34-b98e4a045b10"],
     ") and the resolution of a curved surface (key ",
     Cell[BoxData["\"\<Resolution\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "277956ac-4c9d-d338-4d07-4ff66529be02"],
     ")"
    }], "TableText",ExpressionUUID->"178a6a52-23e4-1142-3d89-8c1c559163a8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "52ddf811-e480-8137-02e2-f25a8d3ad01d"], Cell[TextData[Cell[
    BoxData["\"\<GridHeight\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "719ae17a-c654-ed44-27b9-f927f3e6b7ae"]], "TableText",ExpressionUUID->
     "62c8f42b-c628-388a-12f7-ee74f3c28ad0"], Cell[TextData[Cell[BoxData[
    "10"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "36e5ffeb-8179-694d-5e9a-f6b5300c3b97"]], "TableText",ExpressionUUID->
     "7af061c8-c44a-ae8e-2a80-7895edfcf4d4"], Cell[TextData[{
     "the height of a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0d437dad-8290-de9a-3b71-74f7372aa4e0"],
     ", ",
     Cell[BoxData["\"\<Cylinder\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7aafc905-908a-67da-2a54-e16f213f4d20"],
     " or ",
     Cell[BoxData["\"\<Klein\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
     " (key ",
     Cell[BoxData["\"\<Height\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "0e7c794a-82c2-56e7-3604-711437773ccd"],
     ")"
    }], "TableText",ExpressionUUID->"30f601cf-5001-fb68-608d-98a961b5c9b2"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "04bc0f0b-f02f-243d-2c43-a75481db8f07"], Cell[TextData[Cell[
    BoxData["\"\<GridHoles\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"]], "TableText",ExpressionUUID->
     "705e212e-f5a4-7717-2065-b88bfc515a7d"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5c2f5325-a3f6-c048-05d5-4a8ed5809292"]], "TableText",ExpressionUUID->
     "211ecaf2-61ee-418f-5725-e3bc179b13d5"], Cell[TextData[{
     "holes cut from a ",
     Cell[BoxData["\"\<Grid\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
     ", each as ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y", ",", " ", "radius"}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
     " (key ",
     Cell[BoxData["\"\<Holes\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
     ")"
    }], "TableText",ExpressionUUID->"36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "138e1639-4d05-8b97-41b5-886364b1d9fd"], Cell[TextData[Cell[
    BoxData["\"\<SprinklingDensity\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "156728ce-0023-e03b-431c-c1a8b1d7b301"]], "TableText",ExpressionUUID->
     "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"], Cell[TextData[Cell[BoxData[
