Cell[CellGroupData[{

Cell["\"IncludeCanonicalHashes\"", "ExampleSubsection",
 CellID->728682164,ExpressionUUID->"6b9216eb-8f9f-eb69-19a1-8fb52a2bb9b3"],

Cell[TextData[{
 "With ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59f120da-5631-2eb2-0f8e-b98463c47498"],
 ", each state record has a ",
 Cell[BoxData["\"\<CanonicalHash\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5fa7ad17-3a9c-8e6e-055c-4551bf2ed4b4"],
 ", equal for isomorphic states and the same on every run, so states from \
separate evolutions can be matched by isomorphism class. The two states of \
step 2 are both paths of three edges:"
}], "ExampleText",
 CellID->1702317733,ExpressionUUID->"2c844eb4-1a55-00c1-54bc-67fe9fe0522b"],

Cell[CellGroupData[{

