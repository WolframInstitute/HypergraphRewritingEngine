Cell[TextData[{
 "When the events and branchial pairs are asked for only as ",
 Cell[BoxData["\"\<NumEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7757f304-1d73-ea00-1d6c-eb6e9407b96a"],
 " and ",
 Cell[BoxData["\"\<NumBranchialEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fa4a1ef-0881-bd46-655b-38c9a93507ac"],
 ", they are computed from the number of states in each class, without \
building the individual events. Twenty steps of the chain rule:"
}], "ExampleText",
 CellID->1632029257,ExpressionUUID->"6f9797aa-fa32-a424-15ac-0ef7ffc40f0e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "20", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}], ",", 
   " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
    "True"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1490148079,ExpressionUUID->"73356d58-d9e6-c51e-22ca-8505df90ac64"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"NumStates\"\>", "\[Rule]", "21"}], ",", 
   RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "2561327494111820313"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->485355249,ExpressionUUID->"7ecebc9e-fbf5-4932-26f5-35dbfd801818"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"MatchesPerStateRule\"", "ExampleSubsection",
 CellID->29201913,ExpressionUUID->"5942b0b3-6f6e-6b43-0f71-29fd0a1b39a9"],

Cell["\<\
A positive value keeps that many of a state's transitions for each rule, \
together with any that tie with the last one kept. They are chosen after the \
state's matching is complete, by the transitions' identities and the seed, so \
the same transitions are kept at any thread count. Keeping one transition per \
state makes four steps of the chain rule a single path:\
\>", "ExampleText",
 CellID->756445815,ExpressionUUID->"68dbfb54-9cec-44d9-18f8-f31e14992e23"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeList", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1364299612,ExpressionUUID->"490cd331-563c-164f-7f33-cb7b63c97c95"],

