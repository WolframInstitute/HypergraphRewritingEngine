Cell[CellGroupData[{

Cell["Events, edge lists, and counts", "ExampleSubsection",
 CellID->433391590,ExpressionUUID->"3a0f2024-2f71-09ca-6a34-b98e4a045b10"],

Cell[TextData[{
 Cell[BoxData["\"\<Events\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "277956ac-4c9d-d338-4d07-4ff66529be02"],
 " returns the update events, ",
 Cell[BoxData["\"\<CausalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "178a6a52-23e4-1142-3d89-8c1c559163a8"],
 " / ",
 Cell[BoxData["\"\<BranchialEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ddf811-e480-8137-02e2-f25a8d3ad01d"],
 " the raw causal / branchial edge lists, and ",
 Cell[BoxData["\"\<Debug\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "719ae17a-c654-ed44-27b9-f927f3e6b7ae"],
 " an association of the four counts:"
}], "ExampleText",
 CellID->300556661,ExpressionUUID->"62c8f42b-c628-388a-12f7-ee74f3c28ad0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{"rules", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "3", ",", 
      " ", "\"\<Events\>\""}], "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{"rules", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "3", ",", 
      " ", "\"\<CausalEdges\>\""}], "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"HGEvolve", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "3", ",", 
     " ", "\"\<Debug\>\""}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->286073324,ExpressionUUID->"36e5ffeb-8179-694d-5e9a-f6b5300c3b97"],

