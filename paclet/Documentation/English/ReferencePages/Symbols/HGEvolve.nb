Cell[TextData[{
 "With the default order the events are those of ",
 Cell[BoxData["\"\<Generational\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65e95d55-a99f-bfd5-1397-551ec82b053f"],
 ", one per step. The caps, ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e95e83b-0d9e-83fb-06aa-0265a428d1c1"],
 ", ",
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f578f4c-339a-d4b8-056c-2716462cbe82"],
 ", ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7a39f5-2f84-924e-4b19-b0bf4a36e094"],
 " and ",
 Cell[BoxData["\"\<StateCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59677bcb-6d95-6f1d-0f1d-729504203267"],
 " do not apply with it, and it cannot be combined with ",
 Cell[BoxData["\"\<Generational\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56ec6282-f98a-b15f-7e94-7beff83c03a5"],
 "."
}], "ExampleText",
 CellID->1922458087,ExpressionUUID->"40fbad85-d3f9-d70d-7098-44eee58dba57"],

Cell[TextData[{
 "On the CPU each event is applied after the one before, so the evolution \
runs on one worker thread at every value of ",
 Cell[BoxData["\"\<Threads\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47eae38a-28ac-69e2-6de9-fad449593bc8"],
 ". The ",
 Cell[BoxData["\"\<Device\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d21e4c2-12f3-8786-64de-fdaca687edec"],
 " property gives the number of worker threads of the evolution:"
}], "ExampleText",
 CellID->282779835,ExpressionUUID->"72da8a28-c018-2074-22f9-2c75f1ad735e"],

