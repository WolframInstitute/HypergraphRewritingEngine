     "60049622-f570-0e0e-103b-0f8ffc055554"], Cell[TextData[{
     "colour each transition edge by the rule that produced it; applies to \
the styled graph properties, whose edge payloads carry the rule index (the ",
     Cell[BoxData["Structure"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "40ea559d-da93-7842-70ea-4cc6df264aa8"],
     " variants carry topology only and are unaffected)"
    }], "TableText",ExpressionUUID->"23ccc6ee-92c0-e596-51f3-dfc8277acffc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "114d8d02-b276-9c05-4772-256fc700e76f"], Cell[TextData[Cell[
