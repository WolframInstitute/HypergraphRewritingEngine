     FontSize->0.9 Inherited,ExpressionUUID->
     "289b85cd-827f-9a9c-58b8-1c97370be8e6"]], "TableText",ExpressionUUID->
     "12f3dbee-abc4-6375-4280-d2cbce714e5f"], Cell[TextData[{
     "the device that ran the evolution and the tuning values it used, an \
association with the keys ",
     Cell[BoxData["\"\<Type\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ed5da6f-a344-b859-26ea-dc48d6f60aa3"],
     " (",
     Cell[BoxData["\"\<CPU\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
     " or ",
     Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "362a4e41-4988-041f-5e2a-602b683d6f65"],
     "), ",
     Cell[BoxData["\"\<Threads\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
     ", ",
