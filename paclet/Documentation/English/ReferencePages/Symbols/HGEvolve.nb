     "63b9e3d6-2298-231e-1146-fa9057128e64"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "67c13665-f813-2f11-0dfe-a84ef9a6727b"]], "TableText",ExpressionUUID->
     "4c440104-ea8a-4285-747b-99618f3f10ef"], Cell[TextData[{
     "per-rule multipliers on ",
