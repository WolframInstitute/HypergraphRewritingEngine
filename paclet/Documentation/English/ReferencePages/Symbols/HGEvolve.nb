Cell[CellGroupData[{

Cell["\"BeamCost\"", "ExampleSubsection",
 CellID->1827701392,ExpressionUUID->"76f331b0-e4d2-d206-1e80-a8fd8d64a16c"],

Cell["\<\
The loop move on a 6-cycle with four loops at vertex 1, with two states per \
step under the loop count's heat residual. Ranked by the transition's cost, \
the ties at each step's cut keep many transitions into equal edge lists; \
ranked by the path cost, each step makes its two successor states once:\
\>", "ExampleText",
 CellID->49958151,ExpressionUUID->"5aa658dd-12e3-7f58-0a5e-5187a69645a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"beam", "[", "cost_", "]"}], " ", ":=", " ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "x"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}]}], "}"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", "y"}], "}"}]}], "}"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
      " ", "\"\<States\>\"", ",", " ", 
      RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Automatic"}], ",",
       " ", 
      RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<TransitionCost\>\"", " ", "->", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Field\>\"", " ", "->", " ", "\"\<LoopCount\>\""}], ",", 
         " ", 
         RowBox[{"\"\<TimeStep\>\"", " ", "->", " ", "0.25"}]}], "|>"}]}], ",",
       " ", 
      RowBox[{"\"\<BeamCost\>\"", " ", "->", " ", "cost"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"beam", "[", "\"\<Transition\>\"", "]"}], ",", " ", 
   RowBox[{"beam", "[", "\"\<Path\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->107042570,ExpressionUUID->"25a3641b-c972-205a-5351-7e44e80772a0"],

