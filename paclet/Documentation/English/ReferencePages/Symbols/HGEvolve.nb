   "d5715ee2-1cae-4f33-89b2-0e99ea9caa6e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"1cd6234d-1e3c-431d-9989-71f3025eee95"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell[CellGroupData[{

Cell["Cross-run isomorphism hashes", "ExampleSubsection",ExpressionUUID->"a4129a54-4275-ce4e-b414-6ca07535e2ee"],

Cell[TextData[{
 "Run-local state ids differ between runs, but ",
 Cell[BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33a5312c-9eb5-6f4e-930f-2cdc74466433"],
 " attaches an isomorphism-stable hash usable to fuse pruned runs by \
isomorphism class:"
}], "ExampleText",ExpressionUUID->"700bb000-01ce-c14b-a9d5-c25c61b571d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "2", ",", 
    " ", "\"\<States\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
   "]"}], " ", "//", " ", "Length"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"80d825b9-f498-8140-9845-079d0cee6fc8"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4c0f6e87-1c08-e542-873c-7eca55894aa3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continuing an evolution instead of re-running it", "ExampleSubsection",ExpressionUUID->"415f7dce-f09e-c146-9519-34bcf0440a84"],

Cell[TextData[{
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67270a1c-9f6c-ce4b-8161-3af093e738e5"],
 " answers one question and discards the exploration that answered it, so \
asking for three steps and then five re-runs the first three. A ",
 StyleBox["session",
  FontWeight->"Bold"],
 " keeps the engine, its graph and the frontier the budget stopped at, so \
each step carries the ",
 StyleBox["same", "TI"],
 " exploration further and every state, event and relation already built \
keeps its identity:"
}], "ExampleText",ExpressionUUID->"e29bbc8e-cfaa-a348-9dd4-05f7a2496456"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionQuery", "[", "s", "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}]}], "}"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c1cdd24f-1457-db48-9645-354316dbf417"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "1"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "4"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "3"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "10"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "9"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a8d334d-0ef3-9444-bf8e-7e7365e9374f"]
}, Open  ]],

Cell[TextData[{
 "which gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"NumStates", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"NumEvents", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"2", ",", " ", "1"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"4", ",", " ", "3"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"10", ",", " ", "9"}], "|>"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a05be4b-6b95-1c47-83ea-4b5932eec20d"],
 " \[LongDash] the same numbers as ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "k", ",", " ", 
    "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d634d39-0d8a-3a44-ace3-3cba3eea007a"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k", " ", "=", " ", "0"}], ",", " ", "1", ",", " ", "2", ",", " ", 
   "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9590f7a2-fb0f-3a42-8644-b2743ab4af24"],
 ", reached by continuing rather than restarting. ",
 Cell[BoxData[
  RowBox[{"HGSessionQuery", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "488de345-f008-b741-8680-300e30426f86"],
 " re-reads the accumulated graph without exploring further. ",
 Cell[BoxData[
  RowBox[{"HGSessionClose", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e5011df-7cb6-e747-8d9e-4fb69e2b1126"],
 " releases the engine."
}], "ExampleText",ExpressionUUID->"66ab6dee-8ee2-154f-9e02-d65ff9c54bff"],

Cell["\<\
Three things are fixed when the session opens, and the later verbs refuse to \
change them:\
\>", "ExampleText",ExpressionUUID->"316981f1-00d0-154a-9450-f60dddd2c6a0"],

Cell[TextData[{
 StyleBox["The rules.",
  FontWeight->"Bold"],
 " A session's rule set was fixed at ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21056d7d-63bd-de47-b26c-5010dfc74a1d"],
 "; applying different ones would answer about a system the session is not \
exploring."
}], "Item",ExpressionUUID->"af1fdb31-abfe-2947-88be-05c3c9ebcfcf"],

Cell[TextData[{
 StyleBox["The identity convention",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc0f0fad-df2c-e743-a4de-14b396ed82e2"],
 ", ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "535711d7-71c2-2e4f-945d-8ae2b6d18713"],
 ", ",
 Cell[BoxData["\"\<ShowGenesisEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d36de6b-737e-1944-8d05-c03d022e399c"],
 "). These decide what a state and an event ",
 StyleBox["are", "TI"],
 ". The engine reads them back from its own graph rather than from a step's \
request, so a query cannot report exact canonical forms as tree-mode ones."
}], "Item",ExpressionUUID->"19036042-6acd-1942-bda2-aa9346cc3c33"],

Cell[TextData[{
 StyleBox["What the run records.",
  FontWeight->"Bold"],
 " An artifact the session was not opened for cannot be produced afterwards \
\[LongDash] the evolution that would have built it has already run. Open with \
the property you intend to ask for; asking for another returns an empty \
relation and the engine says so rather than serving the emptiness silently."
}], "Item",ExpressionUUID->"26c6c2b7-1500-8c47-958e-8781a574d0e6"],

Cell[TextData[{
 "A session's handle names a live engine process, so one session at a time is \
served per worker: a second ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cddf1835-f8eb-0848-8f22-065213d62c4c"],
 " while one is live is an error rather than an eviction, because evicting \
would discard an exploration without being asked."
}], "ExampleText",ExpressionUUID->"cb84fa03-e360-5e42-8283-872e0ac9e2dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Steering: continuing from part of the frontier", "ExampleSubsection",ExpressionUUID->"9049aa9a-5da9-0e43-92c2-98a572a8a38c"],

Cell[TextData[{
 "An exploration that branches faster than it is worth exploring can be \
carried forward along a chosen branch. ",
 Cell[BoxData["HGSessionFrontier"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40c380e6-8151-094b-9203-62e7941c608e"],
 " reports the states a continuation would resume from, and ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", 
     RowBox[{"{", "...", "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f4cfb864-04ac-3445-b9b9-6ea61a68a46e"],
 " expands only those:"
}], "ExampleText",ExpressionUUID->"25310365-076e-7d43-bfa6-34a49ab700f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"s", ",", " ", "2"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"HGSessionFrontier", "[", "s", "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"First", "[", "f", "]"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5526b077-93fe-f241-9b4a-237bfd01b465"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"8e6f8bc5-33ac-c04d-99eb-354856156d1e"]
}, Open  ]],

Cell["\<\
which reaches 7 states where an unsteered step of the same depth reaches 10.\
\>", "ExampleText",ExpressionUUID->"de8e7306-753d-254d-b5c3-1d73ab0dd406"],

Cell[TextData[{
 StyleBox["The unselected branches are retained, not discarded.",
  FontWeight->"Bold"],
 " They stay on the frontier and a later step resumes them, so a steered \
detour costs nothing in what remains reachable: continuing the session above \
without a selection lands on 34 states, exactly what ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<NumStates\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5e269ae-5428-a543-9992-5b9923c563ce"],
 " gives. Steering narrows what runs ",
 StyleBox["next", "TI"],
 ", never what is ",
 StyleBox["reachable", "TI"],
 "."
}], "ExampleText",ExpressionUUID->"5ee0a4f0-698a-174d-ae17-697f99d7acf8"],

Cell[TextData[{
 "Naming a state that is not on the frontier is an error rather than a step \
that quietly does nothing, since a caller steering toward a state the \
exploration has already passed would otherwise get an unexplained empty \
result. Both devices serve the same contract: under ",
 Cell[BoxData[
  RowBox[{"TargetDevice", " ", "->", " ", "\"\<GPU\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "add22cd3-180a-9149-979a-9f1e8c2db6a2"],
 " the worker resolves the selection against the frontier it last reported \
and puts the unselected entries back after the step, each at the depth it was \
stranded at."
}], "ExampleText",ExpressionUUID->"afbe9a5f-524a-0441-851a-21f9fce3fc6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sending only what a step added", "ExampleSubsection",ExpressionUUID->"50d191b1-6923-ea47-8746-a97831d7a50d"],

Cell[TextData[{
 "A step re-serialises the whole accumulated graph. ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "281daf42-dee8-c842-8faa-12fae4aea843"],
 " sends only what the session has not already been sent, and the Wolfram \
side merges it back into the graph the session holds \[LongDash] so the wire \
is incremental and the ",
 StyleBox["answer", "TI"],
 " is not: ",
 Cell[BoxData["HGSessionStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10efb171-e9fd-8a4e-809a-e10b3419e18a"],
 " returns the whole accumulated graph either way."
}], "ExampleText",ExpressionUUID->"be73dc4d-9b23-ac41-8c48-9461ac5d1028"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<StatesGraphStructure\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGSessionStep", "[", 
     RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
      RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]}], "]"}], 
    ",", " ", 
    RowBox[{"{", "6", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"483c25c9-e6bd-894d-99ff-d4aed469356c"],

Cell[TextData[{
 "Measured on this evolution at depth 7 (5,914 states), ",
 Cell["tools/dev/session_step_cost.wls", "InlineCode",ExpressionUUID->
  "5bb9659c-aefd-0642-aea6-c42948419c57"],
 ": the engine leg falls from 381 ms to 269 ms and the reply from 516,535 to \
443,660 bytes. That is a 29% cut to the engine call and 8% to the step, \
because the rest of a step is the Wolfram Graph construction \[LongDash] \
1,640 ms of the 2,021 ms total \[LongDash] which a delta cannot reduce, since \
the graph being built is the whole accumulated one either way."
}], "ExampleText",ExpressionUUID->"5a38ec8a-9d0d-fb4d-bea1-3229cdb5eb32"],

Cell[TextData[{
 "Ask for a full delivery at any time to resynchronise; doing so resets what \
the session believes you hold, so the next delta is measured from it. Delta \
delivery is not served on the quotient reconstruction route (",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46c38ccf-a172-2c40-9d31-2bbfc97896ff"],
 " with causal output), where the causal relation is reduced on read and an \
edge already sent can leave the reduction \[LongDash] a delta has no way to \
withdraw one, so those replies carry the whole graph and say so."
}], "ExampleText",ExpressionUUID->"5fe213a7-c1a7-2847-a1c4-1953c84b096e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keeping a bounded number of transitions per rule", "ExampleSubsection",ExpressionUUID->"71ae4f7e-04f5-5247-b904-46324d9dc10f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b25e37c-e0fb-ba4d-abf9-5242ff2f9b3f"],
 " keeps at most ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5119f814-a845-e940-83de-dbc125265c62"],
 " of each state's own transitions ",
 StyleBox["per rule",
  FontWeight->"Bold"],
 ", and the choice is made when that state's matching is complete rather than \
as matches arrive:"
}], "ExampleText",ExpressionUUID->"69465331-f0f2-5f4d-854e-612066f90602"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d1b88a85-1bf3-3342-b25c-ab019d292953"],

Cell[BoxData["5"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7bb1a67b-1d0c-c147-9539-4a762b35b40f"]
}, Open  ]],

Cell[TextData[{
 "The distinction from the other caps is what it is for. ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20b4c995-a55a-7f43-9f8c-05b7a7a3649d"],
 " bounds children per parent regardless of which rule produced them. ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b92315b4-2358-eb45-983e-163341d0609d"],
 " bounds by ",
 StyleBox["arrival order",
  FontWeight->"Bold"],
 ", which depends on the schedule, so two runs of the same evolution can keep \
different states. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ab508c5-a491-0647-9c6d-6ca308554396"],
 " ranks a state's transitions by their own isomorphism-invariant identity \
and the ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b99d3d00-7097-b24a-be6d-273d84865816"],
 ", so the kept set is the same at any thread count \[LongDash] choosing ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d1127d7-aa59-224f-9c7b-eb5905675743"],
 " of ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4cd75380-b883-e549-971f-7be27a76e1d3"],
 " needs all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f07b05a3-c7a7-9245-8208-5e7089832b84"],
 ", and all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5cef309f-6f80-6348-880c-adfab7804d24"],
 " exist only once that state's matching has finished."
}], "ExampleText",ExpressionUUID->"6db10632-dd3d-ad4d-9935-26403dca5485"],

Cell[TextData[{
 "Applies to a state's ",
 StyleBox["own",
  FontWeight->"Bold"],
 " matches. A match forwarded into a state from an ancestor arrives \
asynchronously and is not counted against the cap, for the same reason: its \
arrival races the point where the count would be taken. Applies on both \
devices."
}], "ExampleText",ExpressionUUID->"b9390728-882f-ad45-8629-59eba9f49efb"]
}, Open  ]]
}, Open  ]],

