Cell[CellGroupData[{

Cell["\"CanonicalizeEvents\"", "ExampleSubsection",
 CellID->1124258132,ExpressionUUID->"7b9c4f1f-9707-8ca1-29a4-675922b3d68b"],

Cell[TextData[{
 "The setting selects when two applications are one event. Under ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0839f778-d15e-09ff-39c6-ef25e0eb5bc5"],
 ", the default, every application is its own event; three steps of the chain \
rule have nine:"
}], "ExampleText",
 CellID->484948520,ExpressionUUID->"7962e333-0c57-77b8-2f11-fb7da5e25d82"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumEvents\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<CanonicalizeEvents\>\"", " ", "->", " ", "None"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1553512796,ExpressionUUID->"0e58b71a-bb3b-e382-3667-2f443ecfb1e8"],

