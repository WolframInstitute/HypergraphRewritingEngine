     "36ea7e2c-072a-2221-5eea-7076b2df710b"], Cell[TextData[Cell[BoxData[
    "Automatic"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5b23761c-2477-64e8-0ad1-68464d024e32"]], "TableText",ExpressionUUID->
     "73216bcf-7cf1-61ac-22de-82a9748433f6"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
     " draws one edge per event (or per causal or branchial pair); ",
     Cell[BoxData["\"\<Merged\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "409bca18-cbd6-e54d-70b8-ec45ee60cf97"],
     " draws edges with the same endpoints and type as one edge, whose \
tooltip lists the events it stands for. With ",
     Cell[BoxData[
      RowBox[{"\"\<ColorByRule\>\"", " ", "->", " ", "True"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "10b62b5f-1d3f-f012-404d-c31994cbc378"],
     ", edges of different rules stay separate"
    }], "TableText",ExpressionUUID->"79984792-c453-565a-2fb8-5edfede63ca0"]}
  }]], "3ColumnTableMod",
 CellID->1002769646,ExpressionUUID->"1d45428e-8fa1-6801-4b7b-5be82a543b6b"],

Cell["Analysis options", "NotesSubsection",
 CellID->436346740,ExpressionUUID->"604bb87d-3174-a116-1048-32274006f07c"],

Cell[TextData[{
 "Geometry and physics analyses \[LongDash] dimension, curvature, geodesics, \
entropy, topological charge, branchial sharpness \[LongDash] are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " part of this paclet. They live in the companion ",
 Cell[BoxData["hypergraph_viz"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "763191a2-6f8b-197a-1fce-080c0a3e6840"],
 " project, which consumes this engine as a dependency. ",
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635fdfdb-2856-deda-1164-d68549e0a420"],
 " accepts no options for them; use ",
 Cell[BoxData[
  RowBox[{"Options", "[", "HGEvolve", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f6eb37a-d9e9-6713-3515-2b27df9c4a79"],
 " for the list it does accept."
}], "Notes",
 CellID->2122865143,ExpressionUUID->"5c8469dd-bfc7-2a7a-04bb-80873a727940"],

Cell["Initial-condition options", "NotesSubsection",
 CellID->1735808809,ExpressionUUID->"182ee0c1-720e-fc83-49d5-f9ab07b8c6e9"],

Cell[TextData[{
 "Instead of an explicit ",
 StyleBox["initial", "TI"],
 ", an initial condition can be generated in place by naming it and shaping \
it with these options:"
}], "Notes",
 CellID->753514147,ExpressionUUID->"3921e4bb-f5e4-3596-68de-fde483969ffc"],

