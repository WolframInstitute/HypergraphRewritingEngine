     FontSize->0.9 Inherited,ExpressionUUID->
     "7281c19b-2602-dcd4-22be-d8c553b4a63e"]], "TableText",ExpressionUUID->
     "3c8746fc-db76-c487-64bd-5fb9de00aeed"], Cell["\<\
attach a run-stable isomorphism hash to each state, for fusing results across \
runs\
\>", "TableText",ExpressionUUID->"11f0f87a-e6f0-91cd-478f-f227928ae317"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "473164ce-b547-c1f4-6ecf-7da83cf393de"], Cell[TextData[Cell[
    BoxData["\"\<ShowProgress\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "12c4fc3b-e00c-2bba-42fb-f66491b97980"]], "TableText",ExpressionUUID->
