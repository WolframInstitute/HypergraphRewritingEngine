Cell[CellGroupData[{

Cell["\"UniformRandom\"", "ExampleSubsection",
 CellID->428094287,ExpressionUUID->"6e91b615-0ed0-3b31-16ae-285fab6a861b"],

Cell[TextData[{
 "With ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070d5859-2054-d468-2d33-520351e6beb2"],
 ", ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2322320f-c27e-967c-52d1-b468f708fd46"],
 " caps the transitions kept per step. The transitions are drawn uniformly \
without replacement from ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "043be316-2158-5fff-2dd8-fb5050ed25c5"],
 " and the step, so a history that returns to an isomorphic state can take a \
different transition there. With a cap of 1 the evolution follows one history:"
}], "ExampleText",
 CellID->2104439730,ExpressionUUID->"6802a81d-2cf4-f5d5-1831-42474486df3f"],

