Cell[TextData[{
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02dc9a40-ff1a-b94a-ac0c-fc019026b6cd"],
 " applies on both devices; the weights are uploaded with the run and \
multiply ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fea06143-e2a4-c848-b5a6-d94834374889"],
 " in the same shared decision."
}], "ExampleText",ExpressionUUID->"6108d07e-0760-8d49-8983-4c357bbbfccb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"UniformRandom\"", "ExampleSubsection",ExpressionUUID->"49b53c77-a162-8844-b37e-205f5eeca52b"],

Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a5322531-1efc-6f46-a7c4-342482631f58"],
 ", this stops keeping new states once that many exist for the step, tracing \
a narrow history rather than the full multiway system:"
}], "ExampleText",ExpressionUUID->"35ea845f-716d-4c41-b2f1-e4732dbdba99"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
   RowBox[{"\"\<UniformRandom\>\"", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"\"\<MatchesPerStep\>\"", " ", "->", " ", "1"}], ",", " ", 
   RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"32eaf194-89cf-8144-bf91-daa3d4bb4376"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{0, 1, 2, 
      3}, {{{1, 2}, {2, 3}, {3, 4}}, 
       Null, {<|"EventId" -> 0|>, <|"EventId" -> 1|>, <|"EventId" -> 2|>}}, {
      AspectRatio -> None, 
       EdgeLabels -> {DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         DirectedEdge[1, 2, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip], 
         DirectedEdge[2, 3, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip]}, 
       EdgeStyle -> {DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[0.02]], DirectedEdge[1, 2, <|"EventId" -> 1|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[0.02]], DirectedEdge[2, 3, <|"EventId" -> 2|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[0.02]]}, Epilog -> {}, GraphLayout -> 
       "LayeredDigraphEmbedding", VertexLabels -> {2 -> Placed[
           Column[{
