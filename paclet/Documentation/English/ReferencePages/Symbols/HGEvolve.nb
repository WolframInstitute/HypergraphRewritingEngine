         RowBox[{"{", 
          RowBox[{"x", ",", " ", "z"}], "}"}], "}"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", "5", ",", 
       " ", "\"\<States\>\"", ",", " ", 
       RowBox[{"\"\<Generational\>\"", " ", "->", " ", "True"}]}], "]"}]}], ",",
     " ", "\"\<Edges\>\""}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->1728960765,ExpressionUUID->"2d69e98f-64de-6fdb-5b16-00e90d6b3521"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "2", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1393868943,ExpressionUUID->"168d2c40-6f69-6af1-3eb2-c62a0a1c38db"]
}, Open  ]],

Cell["\<\
Every hyperedge of a state is rewritten at each step of this growth rule, so \
six steps make 1 + 2 + \[Ellipsis] + 32 events:\
\>", "ExampleText",
 CellID->1929315209,ExpressionUUID->"5ba2698e-fe1d-1d69-0951-80ebfba867b3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "6", ",", 
   " ", "\"\<NumEvents\>\"", ",", " ", 
   RowBox[{"\"\<Generational\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",
 CellID->428735727,ExpressionUUID->"0ea67a49-9063-84e3-365e-7c132117eec9"],

