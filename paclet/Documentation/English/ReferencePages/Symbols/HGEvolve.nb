 CellLabel->"Out[2]= ",
 CellID->1066255337,ExpressionUUID->"58f54a37-a74b-68c6-088b-6c70d2fe3a2c"]
}, Open  ]],

Cell[TextData[{
 "The caps, ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75e1b769-bd43-d492-239e-2f3334f7bef8"],
 ", ",
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ca9690d-8fe0-3108-1456-8157299a8052"],
 ", ",
 Cell[BoxData["\"\<ExplorationProbability\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "647c50fc-34e3-bac8-0c04-49a6bc970812"],
 " and ",
 Cell[BoxData["\"\<StateCost\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f185d1-6f58-e3b1-4e8e-1c9b0ad2b19b"],
 " do not apply with it."
}], "ExampleText",
 CellID->1339500288,ExpressionUUID->"2068c8a6-f8a3-ae64-5017-e103f957f54e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"EventOrderingFunction\"", "ExampleSubsection",
 CellID->1095368139,ExpressionUUID->"71e08206-fd12-5e06-279f-2463f4a7256c"],

Cell[TextData[{
 "With a list of SetReplace's event ordering names, the evolution follows one \
history from each initial state, and each step applies one event: the match \
of the state that comes first in the order. This is the update of \
SetReplace's ",
 Cell[BoxData["WolframModel"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0d887537-d4d2-c16f-3b88-6d70dd6493b5"],
 ". The order compares two matches by the first name in the list that tells \
them apart:"
}], "ExampleText",
 CellID->2136925236,ExpressionUUID->"4f5790be-8388-a9de-756c-09f83622fb24"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3df4e37b-637b-fece-6b8b-fb25160fc414"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"4a3f75be-20c7-75c2-7bc5-6cf851725f28"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3be838d6-abbf-bcfe-6997-b193ce4b06c4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4edd261b-067a-5094-76e2-b845b30f22fe"], Cell[TextData[{
     Cell[BoxData["\"\<OldestEdge\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "037c0c65-d4c7-b425-3103-a64edd731f0f"],
     ", ",
     Cell[BoxData["\"\<LeastOldEdge\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "574a8c08-e927-fc17-7d49-265588d3c77d"]
    }], "TableText",ExpressionUUID->"661d9b09-967b-e29f-0e22-1353230fb0e5"], 
    Cell["\<\
the hyperedge ids of the match sorted from oldest to newest, the smaller list \
first or last\
\>", "TableText",ExpressionUUID->"50592a6e-077b-04ad-0066-cc48b20e6ef7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4ae9de12-c3c6-bf78-7a96-d05ff6700242"], Cell[TextData[{
     Cell[BoxData["\"\<LeastRecentEdge\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1c131b6b-6556-d251-4420-93350ce0a0bb"],
     ", ",
     Cell[BoxData["\"\<NewestEdge\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "663ec209-2bde-9ee1-0fc5-e4534e68e4cb"]
    }], "TableText",ExpressionUUID->"4646ec1c-7bb4-e85c-6e7d-06467e46baa6"], 
    Cell["\<\
the hyperedge ids sorted from newest to oldest, the smaller list first or last\
\>", "TableText",ExpressionUUID->"009fa45f-c653-9503-30a4-3e18f3e7fc69"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0df8e50a-e098-808a-3b87-fd579112d2d0"], Cell[TextData[{
     Cell[BoxData["\"\<RuleOrdering\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5e2e8d5f-1666-371d-07d5-2519a3109a67"],
     ", ",
     Cell[BoxData["\"\<ReverseRuleOrdering\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "156af067-c7e0-b0e6-4369-ea40f19a02cc"]
    }], "TableText",ExpressionUUID->"4bf44795-0096-4fae-798c-5edfb12315f4"], 
    Cell["\<\
the hyperedge ids in the order of the rule's left-hand side, the smaller list \
first or last\
\>", "TableText",ExpressionUUID->"6df0ebcc-3ebb-64ea-1b8f-0296bb4e4e30"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b24542a-2937-2c7d-6adc-4e7448c27747"], Cell[TextData[{
     Cell[BoxData["\"\<RuleIndex\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2b2c6ce5-e2d3-dbc3-5ad3-85ce9767a929"],
     ", ",
     Cell[BoxData["\"\<ReverseRuleIndex\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "47b8b786-9b5d-56d3-6d47-2ee01ee83c39"]
    }], "TableText",ExpressionUUID->"39ca63f1-5b29-ac93-6fca-7abb5eddf6f9"], 
    Cell["the position of the rule, the smaller first or last", "TableText",
     ExpressionUUID->"4ddb3fe8-f924-fde1-7bf8-b6b5f8d6c7cb"]}
  }]], "2ColumnTableMod",
 CellID->1619328474,ExpressionUUID->"1a3c3edd-6533-5c23-4bc3-b7870cc62709"],

Cell[TextData[{
 "A hyperedge id is its creation order: the initial hyperedges in input \
order, then the hyperedges each event makes in right-hand-side order. Two \
lists compare by their first differing id, and a list comes before a longer \
list that starts with it. ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e06e0ed-b7e1-fe10-163d-f9b6c195c57a"],
 " is SetReplace's default, ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<LeastRecentEdge\>\"", ",", " ", "\"\<RuleOrdering\>\"", ",", 
    " ", "\"\<RuleIndex\>\""}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "092132f0-8112-8068-38de-abba30a4d2b2"],
 ". The list must order every two matches: it contains ",
 Cell[BoxData["\"\<RuleOrdering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "47a7abaa-7c0e-d713-6d5c-42f475b8ba79"],
 " or ",
 Cell[BoxData["\"\<ReverseRuleOrdering\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6059b901-cdf2-bf42-1066-316aeb8405a8"],
 ", and with more than one rule ",
 Cell[BoxData["\"\<RuleIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64b436e8-4ec1-9688-0c4b-afb26b75fcd2"],
 " or ",
 Cell[BoxData["\"\<ReverseRuleIndex\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e284bac-efa5-b7a3-6628-62098a511d89"],
 ". ",
 Cell[BoxData["\"\<Random\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "223ac921-909b-296a-53d9-e08b212e7bb0"],
 " and ",
 Cell[BoxData["\"\<Any\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64f5a232-c990-b984-0c8a-447fe82a0bee"],
 " are not supported."
}], "ExampleText",
 CellID->1505812281,ExpressionUUID->"4b797f7f-c7ba-1604-7907-7738f24f7d6e"],

Cell[TextData[{
 "On a path of four hyperedges, the default order contracts the oldest pair \
first, and ",
 Cell[BoxData["\"\<NewestEdge\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45ea52ef-3554-0907-73ea-4bc9bce1586d"],
 " the newest:"
}], "ExampleText",
 CellID->963623293,ExpressionUUID->"5aa94cfa-2f23-80a7-0a57-65a44ad7d28d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"Values", " ", "@", " ", 
      RowBox[{"HGEvolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"y", ",", " ", "z"}], "}"}]}], "}"}], " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "z"}], "}"}], "}"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", "3", ",", 
        " ", "\"\<Events\>\"", ",", " ", 
        RowBox[{"\"\<EventOrderingFunction\>\"", " ", "->", " ", "#"}]}], 
       "]"}]}], ",", " ", "\"\<ConsumedEdges\>\""}], "]"}], " ", "&"}], " ", "/@",
   " ", 
  RowBox[{"{", 
   RowBox[{"Automatic", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<NewestEdge\>\"", ",", " ", "\"\<RuleOrdering\>\""}], 
     "}"}]}], "}"}]}]], "Input",
