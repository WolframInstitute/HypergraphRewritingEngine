 CellID->85546653,ExpressionUUID->"4c93342e-976f-2690-74a0-ad88221b8cfa"],

Cell["\<\
By default a causal pair implied by a longer causal path is dropped. The \
reduced causal relation of the loops rule after three steps:\
\>", "ExampleText",
 CellID->1023050894,ExpressionUUID->"0c05a0c6-8ada-cee6-343a-39a02f6c94cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumCausalEdges\>\""}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
