   {Cell["      ", "ModInfo",ExpressionUUID->
     "171b8815-f34a-444f-93d7-30b2371b811f"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "18ecff31-b026-5642-a348-9aa2de7ff018"]], "TableText",ExpressionUUID->
     "65ce7eeb-75aa-434b-bd57-bb6d152debc7"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bdce605a-9ca4-8c40-b1da-c266e61983cb"]], "TableText",ExpressionUUID->
     "69b2894f-fd42-5f42-933a-29cc0748cca4"], Cell[TextData[{
     "the identity states are merged by: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ef5e297e-ff13-9c4f-8056-9426eca2b36f"],
     " (every provenance distinct), ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b92e0dc9-37db-a645-9585-766a0a098b88"],
     " (equal contents), or ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9b90709d-c57b-0d45-99b6-71903af45138"],
     " (equal up to isomorphism)"
    }], "TableText",ExpressionUUID->"5e8e0f7b-421f-a745-b41a-4bd7b924cc5c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e91c8390-2d72-fe4f-96ec-7c6b13ff7a62"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9c974607-de64-ac4c-86fe-f2b5743bf3fe"]], "TableText",ExpressionUUID->
     "171a0533-a75d-5344-9eb5-dfe37631891e"], Cell[TextData[Cell[BoxData[
