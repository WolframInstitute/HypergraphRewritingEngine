 CellID->1658674693,ExpressionUUID->"530b93a6-4244-79d7-0108-0a0077f14b3d"],

Cell["\<\
Below 1, each transition is kept with the given probability. The draw depends \
on the transition's isomorphism-invariant identity and the seed, so the same \
seed keeps the same transitions at any thread count and on either device:\
\>", "ExampleText",
 CellID->48446724,ExpressionUUID->"4c785ed8-c9e5-405c-7418-5785ef9012a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TransitionRate\>\"", " ", "->", " ", "0.25"}], ",", " ", 
