Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{0, 1, 2, 
      3}, {{{1, 2}, {2, 3}, {2, 4}}, 
       Null, {<|"EventId" -> 0|>, <|"EventId" -> 1|>, <|"EventId" -> 2|>}}, {
      AspectRatio -> Rational[1, 2], 
       EdgeLabels -> {DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Placed[
           Row[{"Event ", 0}], Tooltip], 
         DirectedEdge[1, 2, <|"EventId" -> 1|>] -> Placed[
           Row[{"Event ", 1}], Tooltip], 
         DirectedEdge[1, 3, <|"EventId" -> 2|>] -> Placed[
           Row[{"Event ", 2}], Tooltip]}, 
       EdgeStyle -> {DirectedEdge[0, 1, <|"EventId" -> 0|>] -> Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], DirectedEdge[1, 2, <|"EventId" -> 1|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]], DirectedEdge[1, 3, <|"EventId" -> 2|>] -> 
         Directive[
           GrayLevel[0.5], 
           Arrowheads[Small]]}, GraphLayout -> "LayeredDigraphEmbedding", 
       VertexLabels -> {2 -> Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 2}, {"Step:", 2}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 1 -> 
         Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 1}, {"Step:", 1}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 3 -> 
         Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 3}, {"Step:", 2}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip], 0 -> 
         Placed[
           Column[{
             Row[{
               Style["State", Bold]}], 
             
             Grid[{{"Id:", 0}, {"Step:", 0}}, Alignment -> Left, 
              Spacings -> {1, 0.5}]}, Spacings -> 0.5], Tooltip]}, 
       VertexStyle -> {3 -> Directive[
           RGBColor[0.368417, 0.506779, 0.709798], 
           EdgeForm[
            RGBColor[0.2, 0.3, 0.5]]], 1 -> Directive[
           RGBColor[0.368417, 0.506779, 0.709798], 
           EdgeForm[
            RGBColor[0.2, 0.3, 0.5]]], 0 -> Directive[
           RGBColor[0.368417, 0.506779, 0.709798], 
           EdgeForm[
            RGBColor[0.2, 0.3, 0.5]]], 2 -> Directive[
           RGBColor[0.368417, 0.506779, 0.709798], 
           EdgeForm[
            RGBColor[0.2, 0.3, 0.5]]]}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
        Medium], 
        TagBox[
         TooltipBox[
          {GrayLevel[0.5], Arrowheads[Small], 
           ArrowBox[{{0., 0.5}, {0., 0.25}}, 0.01273]},
          TemplateBox[{"\"Event \"", "0"}, "RowDefault"]],
         Annotation[#, 
          Row[{"Event ", 0}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[
          {GrayLevel[0.5], Arrowheads[Small], 
           ArrowBox[{{0., 0.25}, {-1., 0.}}, 0.01273]},
          TemplateBox[{"\"Event \"", "1"}, "RowDefault"]],
         Annotation[#, 
          Row[{"Event ", 1}], "Tooltip"]& ], 
        TagBox[
         TooltipBox[
          {GrayLevel[0.5], Arrowheads[Small], 
           ArrowBox[{{0., 0.25}, {0., 0.}}, 0.01273]},
          TemplateBox[{"\"Event \"", "2"}, "RowDefault"]],
         Annotation[#, 
          Row[{"Event ", 2}], "Tooltip"]& ]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
        TagBox[
         TooltipBox[
          {RGBColor[0.368417, 0.506779, 0.709798], EdgeForm[RGBColor[
           0.2, 0.3, 0.5]], DiskBox[{0., 0.5}, 0.01273]},
          TagBox[
           GridBox[{{
              TemplateBox[{
                StyleBox["\"State\"", Bold, StripOnInput -> False]}, 
               "RowDefault"]}, {
              TagBox[
               
               GridBox[{{"\"Id:\"", "0"}, {"\"Step:\"", "0"}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> 
                False, GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
                GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.5}}}], 
               "Grid"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
            DefaultBaseStyle -> "Column", 
            GridBoxItemSize -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
            GridBoxSpacings -> {
             "Columns" -> {{Automatic}}, "Rows" -> {{0.5}}}], "Column"]],
         Annotation[#, 
          Column[{
            Row[{
              Style["State", Bold]}], 
            
            Grid[{{"Id:", 0}, {"Step:", 0}}, Alignment -> Left, 
             Spacings -> {1, 0.5}]}, Spacings -> 0.5], "Tooltip"]& ], 
        TagBox[
         TooltipBox[
          {RGBColor[0.368417, 0.506779, 0.709798], EdgeForm[RGBColor[
           0.2, 0.3, 0.5]], DiskBox[{0., 0.25}, 0.01273]},
          TagBox[
           GridBox[{{
              TemplateBox[{
                StyleBox["\"State\"", Bold, StripOnInput -> False]}, 
               "RowDefault"]}, {
              TagBox[
               
