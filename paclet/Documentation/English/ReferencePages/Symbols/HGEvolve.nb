 CellID->1511654706,ExpressionUUID->"2fdf34a4-4672-e0d0-55e4-ad0e7304b23a"],

Cell["\<\
The number of edges of a sprinkling of twenty points under each option:\
\>", "ExampleText",
 CellID->1510167059,ExpressionUUID->"4de787d6-2024-7dd3-7b9c-1e9051d14739"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"triangle", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sprinkle", "[", "opts___", "]"}], " ", ":=", " ", 
   RowBox[{"Length", "[", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{
     "triangle", ",", " ", "\"\<Sprinkling\>\"", ",", " ", "0", ",", 
      " ", "\"\<GlobalEdges\>\"", ",", " ", 
      RowBox[{"\"\<SprinklingDensity\>\"", " ", "->", " ", "20"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "1"}], ",", " ", "opts"}],
      "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<TimeExtent\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingTimeExtent\>\"", " ", "->", " ", "2."}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"\"\<SpatialExtent\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingSpatialExtent\>\"", " ", "->", " ", "2."}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<SpatialDim 1\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingSpatialDim\>\"", " ", "->", " ", "1"}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<SpatialDim 3\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingSpatialDim\>\"", " ", "->", " ", "3"}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<LightconeAngle\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingLightconeAngle\>\"", " ", "->", " ", "0.5"}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<AlexandrovCutoff\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingAlexandrovCutoff\>\"", " ", "->", " ", "2."}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<TransitivityReduction\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingTransitivityReduction\>\"", " ", "->", " ", 
      "False"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<MaxEdgesPerVertex\>\"", " ", "->", " ", 
    RowBox[{"sprinkle", "[", 
     RowBox[{"\"\<SprinklingMaxEdgesPerVertex\>\"", " ", "->", " ", "2"}], 
     "]"}]}]}], "|>"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->610101805,ExpressionUUID->"55fa1cea-4458-dcd2-0399-95b46dd2a638"],

