 CellLabel->"Out[1]= ",
 CellID->1383363790,ExpressionUUID->"7517e465-645e-477c-232c-fe4f0deb2a46"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "560e68d9-da1a-2272-7e35-8182dfaf7158"],
 " identifies applications with the same canonical input state and the same \
canonical output state, one event per step here:"
}], "ExampleText",
 CellID->1785990179,ExpressionUUID->"46aa8ea3-37c3-4040-6ea9-270d427612aa"],

