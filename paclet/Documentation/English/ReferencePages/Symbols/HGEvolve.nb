     FontSize->0.9 Inherited,ExpressionUUID->
     "181c845d-0625-2e4d-8535-a75e56b4c20e"]], "TableText",ExpressionUUID->
     "22c2f493-b156-1240-a9cc-88c19e8a7e2a"], Cell[TextData[{
     "merge equivalent events: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c240066f-5d2e-8a44-9551-f798a79df48d"],
     ", ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "07aece0d-0057-1a4a-9e82-cb3c20d71c9e"],
     ", ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4880e107-8fbd-8249-ba40-904e3f583edb"],
     ", ",
