Cell[TextData[{
 "The bound holds at any thread count. ",
 StyleBox["Which", "TI"],
 " successors meet it does not: a parent's successors are counted as they are \
produced, and matches forwarded into a state from an ancestor arrive \
asynchronously, so a capped run may keep a different subset on a different \
thread count. Use ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60d7278b-f9f1-2740-ad79-e3aeaf4496d9"],
 " where the kept set has to be reproducible."
}], "ExampleText",ExpressionUUID->"d894fc1a-ec69-294e-9369-65872e3fab37"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\"MaxStatesPerStep\"", "ExampleSubsection",ExpressionUUID->"baf9466a-e026-6641-bec1-7a034c1ed28c"],

Cell["\<\
Limits the states retained per evolution step (0 = unlimited).\
\>", "ExampleText",ExpressionUUID->"b11b9c46-753a-e64b-98a5-f6def5db7d4b"],

Cell[TextData[{
 "The bound holds at any thread count. ",
 StyleBox["Which", "TI"],
 " states meet it does not: the cap is applied as states arrive, so a capped \
run may return a different subset on different runs or thread counts. \
Uncapped runs are unaffected -- their state, event, causal and branchial sets \
do not depend on the thread count or the scheduling order. Use ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc34b7c7-ec84-2741-844b-45639ecb08ce"],
 " for a reproducible cap, or ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d43853e-b175-cc4d-ba61-0b0bffe90554"],
 " with a ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8246219-45e5-ea42-aa84-bd09b854272e"],
 " for a reproducible thinning."
}], "ExampleText",ExpressionUUID->"5762330c-bd9d-f34c-acf6-aea519d094c0"],

