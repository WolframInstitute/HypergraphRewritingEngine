Cell[CellGroupData[{

Cell["\"CausalTransitiveReduction\"", "ExampleSubsection",
 CellID->532325348,ExpressionUUID->"50d2e924-c37a-d2d3-00e1-0081f60ca039"],

Cell["\<\
By default a causal pair implied by a longer causal path is dropped. The \
reduced causal relation of the loops rule after three steps:\
\>", "ExampleText",
 CellID->793533782,ExpressionUUID->"790318be-6549-22ff-2f30-91f80cfc70c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumCausalEdges\>\""}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1242545104,ExpressionUUID->"3e35e667-42ed-6e5d-67ca-f841769834a7"],

Cell[BoxData["24"], "Output",
 CellLabel->"Out[1]= ",
 CellID->777700477,ExpressionUUID->"3d92e0fe-61dd-aa06-6ba1-f9b81069f96c"]
}, Open  ]],

Cell[TextData[{
 "With ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f422cf-5719-5b56-038b-bba962ac29bc"],
 ", every pair is kept:"
}], "ExampleText",
 CellID->693690130,ExpressionUUID->"185882f2-3bbf-8530-4867-1bbcbe4bec1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"loops", ",", " ", 
