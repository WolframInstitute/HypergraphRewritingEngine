Cell[CellGroupData[{

Cell["Statistics of each step", "ExampleSubsection",
 CellID->1819502047,ExpressionUUID->"0d437dad-8290-de9a-3b71-74f7372aa4e0"],

Cell[TextData[{
 Cell[BoxData["\"\<StepStatistics\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7aafc905-908a-67da-2a54-e16f213f4d20"],
 " returns one association per step describing the raw states at that step: \
",
 Cell[BoxData["\"\<RawStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62016b94-8ad8-fb56-123e-82de2f52c9bc"],
 ", ",
 Cell[BoxData["\"\<Classes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7c794a-82c2-56e7-3604-711437773ccd"],
 " (isomorphism classes), ",
 Cell[BoxData["\"\<Redundancy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f601cf-5001-fb68-608d-98a961b5c9b2"],
 " (raw states per class), ",
 Cell[BoxData["\"\<MaxMultiplicity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04bc0f0b-f02f-243d-2c43-a75481db8f07"],
 ", ",
 Cell[BoxData["\"\<MultiplicityHistogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a24bdc2-598a-1b95-4bdb-34ac583f69ff"],
 ", ",
 Cell[BoxData["\"\<ClassEntropyBits\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "705e212e-f5a4-7717-2065-b88bfc515a7d"],
 " and ",
 Cell[BoxData["\"\<ClassEntropyNormalized\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c2f5325-a3f6-c048-05d5-4a8ed5809292"],
 " (the entropy of the raw states over the classes), ",
 Cell[BoxData["\"\<Events\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "211ecaf2-61ee-418f-5725-e3bc179b13d5"],
 " and ",
 Cell[BoxData["\"\<RuleCounts\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51e4dffc-d38f-5703-079b-d6b9e63a3a69"],
 " (the raw events whose output state is at the step), ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30e43b5d-74af-d0fb-609b-b3077d5ba2c1"],
 " (for each of eleven per-state invariants, such as ",
 Cell[BoxData["\"\<VertexCount\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44d9380c-2e05-8f35-6ce6-b2564bb1d21f"],
 ", ",
 Cell[BoxData["\"\<Components\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36758762-649a-f7b1-5e0a-1f4c0d2cdd9b"],
 " and ",
 Cell[BoxData["\"\<IncidenceDiameter\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "138e1639-4d05-8b97-41b5-886364b1d9fd"],
 ", its ",
 Cell[BoxData["\"\<N\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "156728ce-0023-e03b-431c-c1a8b1d7b301"],
 ", ",
 Cell[BoxData["\"\<Mean\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fc37353-2ed8-42c8-25f1-6b1d4b6d1012"],
 ", ",
 Cell[BoxData["\"\<StandardDeviation\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26ff5c08-e081-ff27-4e85-56559135c20d"],
 ", ",
 Cell[BoxData["\"\<Min\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07c988c4-3ef2-8066-2df6-21aeba84d34c"],
 ", ",
 Cell[BoxData["\"\<Max\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4bc0a2f3-6150-447f-79ff-3bbd10e52f45"],
 ", ",
 Cell[BoxData["\"\<Median\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ac66077-3bfa-1f18-2afe-7a31bd8f6262"],
 " and ",
 Cell[BoxData["\"\<Histogram\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d863d84-94ab-5643-6bbd-b4ee1d5e3ca9"],
 "), and the arity and degree histograms. With ",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ab8b877-e011-189c-2a47-323091a46ae6"],
 " they are computed from one state per class and the number of raw states in \
the class, so no raw state is built:"
}], "ExampleText",
 CellID->1147788002,ExpressionUUID->"35eb0178-2238-e094-63e8-992257b2b2fe"],

