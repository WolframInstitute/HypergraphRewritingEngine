Cell[TextData[{
 "The same seed keeps the same transitions at any thread count and on either \
device. ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2eb3f556-206c-8695-5640-ed10511eecff"],
 " keeps each transition with a probability instead."
}], "ExampleText",
 CellID->290695803,ExpressionUUID->"48778410-45aa-a58c-780c-1e5a6c5c0fd6"]
}, Open  ]],

