Cell[TextData[{
 "A cost may read any statistic of ",
 Cell[BoxData["\"\<Invariants\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d937789-2253-fc97-1ba1-6ed357e7c6fd"],
 ". This beam of one state per step follows rule A of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Science with Step Statistics"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/tutorial/\
ScienceWithStepStatistics"},
   "RefLinkPlain",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",ExpressionUUID->
  "579a3a64-9432-ab70-7db9-bc4e1dc4f65a"],
 " from a torus and keeps the state whose ball dimension is closest to 1.5:"
}], "ExampleText",
 CellID->99231901,ExpressionUUID->"194a91b0-0c16-7c4e-4f49-08faa5a34694"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ruleA", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "w"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "v"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "u"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", " ", "x"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "u"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"\"\<Invariants\>\"", ",", " ", "\"\<BallDimension\>\""}], 
         "]"}], ",", " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
      RowBox[{"1", "/", "1000"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
  
  RowBox[{"HGEvolve", "[", 
   RowBox[{"ruleA", ",", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", " ", "->", " ", "\"\<Torus\>\""}], ",", " ", 
      RowBox[{"\"\<Resolution\>\"", " ", "->", " ", "6"}], ",", " ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", " ", "6", 
    ",", " ", "\"\<StepStatistics\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"\"\<StateCost\>\"", " ", "->", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#BallDimension", " ", "-", " ", "1.5"}], "]"}], " ", "&"}], 
      ")"}]}], ",", " ", 
    RowBox[{"\"\<StepStatisticsMeasures\>\"", " ", "->", " ", 
     RowBox[{"{", "\"\<VolumeGrowth\>\"", "}"}]}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}]}]}], "Input",\

 CellLabel->"In[3]:= ",
 CellID->833579686,ExpressionUUID->"1e65ff1b-2e7b-83a1-461a-f7454b0fd18b"],

Cell[BoxData[
 RowBox[{"{", 
