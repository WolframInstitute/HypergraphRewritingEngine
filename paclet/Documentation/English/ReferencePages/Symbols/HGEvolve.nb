     Cell[BoxData[
      RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "735e49d5-32a1-4a48-2166-609f47541892"],
     ", a hash equal for isomorphic states"
    }], "TableText",ExpressionUUID->"335d55a2-cf9b-493d-6163-4c0fea2e1807"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3bfbbd45-edb8-1b0b-6998-352e844d6651"], Cell[TextData[Cell[
    BoxData["\"\<VertexCurvature\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "045023ab-c37d-b770-2c6f-baf4f6091a5a"]], "TableText",ExpressionUUID->
     "73e8aeff-5b91-f8f4-2197-47b95e25cade"], Cell[TextData[{
