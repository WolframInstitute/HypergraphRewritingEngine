      FontSize->0.9 Inherited,ExpressionUUID->
      "b5c42bb6-49be-3343-8e94-24980fadbb40"],
     "); off keeps each initial state a distinct entry point"
    }], "TableText",ExpressionUUID->"a13d4486-cc1d-1f46-a4ae-f925b7449769"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0433ac7a-9b1c-d047-80fb-3a8630774dfc"], Cell[TextData[Cell[
