     "d1b55160-f426-314f-bcb0-850d8eef914f"], Cell["\<\
quotient exploration: expand each canonical state once, at its shortest depth \
(off by default, so every provenance is explored)\
\>", "TableText",ExpressionUUID->"6267bba4-ec88-a346-9443-94c4a7af9fd1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c56021cb-c20d-0c48-af48-30a51c279eb9"], Cell[TextData[Cell[
    BoxData["\"\<QuotientInitialStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "121942e7-13f3-534e-abe4-fd60c626f007"]], "TableText",ExpressionUUID->
     "f0c4a5f7-8cc6-ef45-9298-bc8b3e95fb7a"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
