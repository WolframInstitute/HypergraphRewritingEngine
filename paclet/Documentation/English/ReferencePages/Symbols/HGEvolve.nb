Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGEvolve", "::", "statecost"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"\<\"StateCost\"\>", " ", "->", " "}], 
  RowBox[{
   RowBox[{"Sin", "[", "#VertexCount", "]"}], "&"}], 
  RowBox[{" ", 
   RowBox[{"is", " ", "not", " ", 
    RowBox[{"supported", ":", " "}]}]}], 
  RowBox[{
   RowBox[{"Sin", "[", "#VertexCount", "]"}], " ", "is", " ", "not", " ", "a",
    " ", "supported", " ", "term"}], 
  RowBox[{
   RowBox[{
    RowBox[{".", " ", "A"}], " ", "cost", " ", "is", " ", "a", " ", "pure", " ",
     "function", " ", "of", " ", "\<\"Invariants\"\>", " ", "statistic", " ", 
    "names", " ", 
    RowBox[{"(", 
     RowBox[{"such", " ", "as", " ", "#BallDimension"}], ")"}], " ", "built", 
    " ", "from", " ", "real", " ", "numbers"}], ",", " ", 
   RowBox[{"+", 
    RowBox[{",", " ", 
     RowBox[{"-", 
      RowBox[{",", " ", 
       RowBox[{"*", 
        RowBox[{",", " ", 
         RowBox[{"/", 
          RowBox[{
          ",", " ", "Abs", ",", " ", "Min", ",", " ", "Max", ",", " ", "Sqrt",
            ",", " ", "Log", ",", " ", 
           RowBox[{
           "Exp", " ", "and", " ", "powers", " ", "with", " ", "a", " ", 
            "constant", " ", 
            RowBox[{"exponent", "."}]}]}]}]}]}]}]}]}]}]}]}]], "Message", "MSG",
 CellID->1596838818,ExpressionUUID->"287634d7-a493-5377-580d-ad90cd263e5d"],

