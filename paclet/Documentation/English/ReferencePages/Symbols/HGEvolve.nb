Cell[CellGroupData[{

Cell["\"CausalTransitiveReduction\"", "ExampleSubsection",
 CellID->532325348,ExpressionUUID->"331c7f17-1677-2611-6124-7751a3038d7b"],

Cell["\<\
By default a causal pair implied by a longer causal path is dropped. The \
reduced causal relation of the loops rule after three steps:\
\>", "ExampleText",
 CellID->793533782,ExpressionUUID->"14cbe893-f079-1a7f-3cc8-01dc810c6945"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
