     "7085d256-6adc-aa08-20ba-d4100f6ef952"]], "TableText",ExpressionUUID->
     "5f932952-49a5-d34f-05a0-c11c6851a195"], Cell[TextData[Cell[BoxData[
    "1."], "InlineFormula",
