Cell[CellGroupData[{

Cell["\"StateCost\"", "ExampleSubsection",
 CellID->955758104,ExpressionUUID->"1c27efc5-dd5c-0ea0-45dc-06aed4e9548a"],

Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<MaxStatesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f9ca573-a525-e7a3-25a3-3d3cccd1cd89"],
 ", a cost function keeps each step's successor states of lowest cost. The \
cost here is the negated incidence mean distance, so each step keeps the two \
states whose vertices and hyperedges are farthest apart. The mean of ",
 Cell[BoxData["\"\<IncidenceMeanDistance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1eda8955-2ca4-ffeb-46f9-211f4556c531"],
 " over the kept states at each step:"
}], "ExampleText",
 CellID->1896713164,ExpressionUUID->"04eee7d5-a4c3-ea8f-2c95-fe9ecd77b8d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loops", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"meanDistance", "[", "opts___", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           
           RowBox[{"\"\<Invariants\>\"", ",", 
            " ", "\"\<IncidenceMeanDistance\>\""}], "]"}], ",", 
          " ", "\"\<Mean\>\""}], "]"}], ",", " ", 
        RowBox[{"1", "/", "100"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"HGEvolve", "[", 
     RowBox[{"loops", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", "6", ",", 
      " ", "\"\<StepStatistics\>\"", ",", " ", 
      RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", 
      " ", 
      RowBox[{"\"\<MaxStatesPerStep\>\"", " ", "->", " ", "2"}], ",", " ", 
      RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}], ",", " ", "opts"}],
      "]"}]}]}], ";"}], "\n", 
 RowBox[{"meanDistance", "[", 
  RowBox[{"\"\<StateCost\>\"", " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "#IncidenceMeanDistance"}], " ", "&"}], ")"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->467895564,ExpressionUUID->"2fb07358-8f92-ce5d-5540-6b022a2494a7"],

