Cell[CellGroupData[{

Cell["Multiple rules and multiple initial states", "ExampleSubsection",ExpressionUUID->"b21ff2fb-5df1-ff4d-9fb6-eb90b7aede8e"],

Cell[TextData[{
 "Rules and initial states may both be lists; each initial state is a \
distinct entry point of the multiway system. Isomorphic states are merged \
with ",
 Cell[BoxData[
  RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "968884f7-9666-9441-9c19-9fe1ad7a77f6"],
 " to keep the graph compact:"
}], "ExampleText",ExpressionUUID->"61f10b30-ef57-f749-815b-653eb7f0271e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule2", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rule3", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "}"}], " ", "->", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]}]}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"52d436f9-19b5-2145-a4ff-961620afd12c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rule1", ",", " ", "rule2", ",", " ", "rule3"}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], "}"}]}], "}"}], ",",
    " ", "2", ",", " ", "\"\<StatesGraph\>\"", ",", " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"22b97b85-312a-384e-b275-fc5db315c22c"],

