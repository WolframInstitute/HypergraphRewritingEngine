      FontSize->0.9 Inherited,ExpressionUUID->
      "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
     ", ",
     Cell[BoxData["\"\<ComputeCapability\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "52243646-2fbd-210e-03db-a8204a487054"],
     ", ",
     Cell[BoxData["\"\<MemoryCap\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
     ", ",
     Cell[BoxData["\"\<Blocks\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
     ", ",
     Cell[BoxData["\"\<Backlog\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
     " and ",
     Cell[BoxData["\"\<L2Persist\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6f6ad260-8ee1-565a-1569-d44a2a943ca0"]
    }], "TableText",ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "26dca2d1-2715-746d-4ee3-3b9b52a05eb7"], Cell[TextData[Cell[
    BoxData["\"\<PathCosts\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"]], "TableText",ExpressionUUID->
     "6b853673-18d0-d9fa-19ba-a83d996aabc0"], Cell[TextData[{
     "with ",
     Cell[BoxData[
      RowBox[{"\"\<Search\>\"", " ", "->", " ", "\"\<BestFirst\>\""}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "25b5b884-ef74-61b3-534a-31e18a013399"],
     " or ",
     Cell[BoxData[
      RowBox[{"\"\<BeamCost\>\"", " ", "->", " ", "\"\<Path\>\""}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "574a2197-51ef-7938-7d49-b8d1679a4802"],
     ", an association from each state id to its path cost"
    }], "TableText",ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73b76025-96bb-3fff-214d-798f234f85c5"], Cell[TextData[Cell[
