Cell[TextData[{
 Cell[BoxData["\"\<RuleWeights\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d81b9ce-3a4c-aa2a-2bbe-30a8bffef970"],
 " applies on both devices; the weights are uploaded with the run and \
multiply ",
 Cell[BoxData["\"\<TransitionRate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6bb9b374-9caf-337d-1946-2b3e155b9e47"],
 " in the same shared decision."
}], "ExampleText",
