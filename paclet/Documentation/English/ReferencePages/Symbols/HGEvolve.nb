     Cell[BoxData["\"\<ExploreFromCanonicalStatesOnly\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7ba86ff4-a2fe-744e-9c22-a5fe6a1874bc"],
     "); off keeps each initial state a distinct entry point"
    }], "TableText",ExpressionUUID->"419deaf7-fa27-0c4e-9f97-ee39daa1d00e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81abf7c8-8ed5-4340-8a81-ada5735d58b7"], Cell[TextData[Cell[
    BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
