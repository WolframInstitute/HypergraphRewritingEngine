      FontSize->0.9 Inherited,ExpressionUUID->
      "63b9e3d6-2298-231e-1146-fa9057128e64"]
    }], "TableText",ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4c440104-ea8a-4285-747b-99618f3f10ef"], Cell[TextData[Cell[
    BoxData["\"\<ContentStateId\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "66c9a615-af45-c085-0ef6-385ecaf192ef"]], "TableText",ExpressionUUID->
     "0513e607-0f4c-1e20-3320-f861aaf9650a"], Cell[
    "the lowest id of the states with the same edge list", "TableText",
     ExpressionUUID->"0371ff35-cd30-cda2-310e-f77ee4ca9788"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6833ae6a-6ac5-a2c8-19c0-40340f71f012"], Cell[TextData[Cell[
