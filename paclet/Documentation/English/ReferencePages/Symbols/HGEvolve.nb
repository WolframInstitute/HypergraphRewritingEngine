     Cell[BoxData["\"\<CausalGraphStructure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "66c67103-72a1-9427-0efe-696d0755ff0d"],
     ", ",
     Cell[BoxData["\"\<BranchialGraphStructure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
     ", ",
     Cell[BoxData["\"\<EvolutionGraphStructure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "58ee7ecb-1370-1005-0896-7795a605636f"],
