  StyleBox[
   RowBox[{"HGEvolve", "::", "warn"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"The", " ", "engine", " ", "returned", " ", "warnings", " ", "("}], 
  
  RowBox[{"{", "\<\"Engine\"\>", "}"}], 
  RowBox[{")", ":", " "}], 
  RowBox[{
   RowBox[{"this", " ", "run", " ", "discards", " ", "work", " ", 
    RowBox[{"(", 
