     "04786d0e-016a-d127-2c07-8568b01ca00d"], Cell["\<\
evolution graph with the causal and the branchial edges (the default)\
\>", "TableText",ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2d1ff276-b82a-c3ca-5b24-f43039dc9110"], Cell[TextData[{
     Cell[BoxData["\"\<StatesGraphStructure\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
