   {Cell["      ", "ModInfo",ExpressionUUID->
     "4322f94b-5e55-c141-ae10-0975f279693c"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "55982597-29f7-454c-a8a4-efe608f05aa4"]], "TableText",ExpressionUUID->
     "be725f49-9f15-dd4e-a279-9d6431e27146"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fbb3efed-5184-d044-82d4-fc1df1ea4c61"]], "TableText",ExpressionUUID->
     "97c3590c-3987-1346-9a9a-30b913b83154"], Cell[TextData[{
     "the identity states are merged by: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "72dc4232-59fd-274c-bb17-ab17de8eee7f"],
     " (every provenance distinct), ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "83cbcb47-413a-1641-9451-33f309bd2c15"],
     " (equal contents), or ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9718fae0-3bc2-e043-81be-fea3da8e203e"],
     " (equal up to isomorphism)"
    }], "TableText",ExpressionUUID->"7b8f5a3c-a1b1-134a-ac97-76346a3e3b18"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a70dc30b-2e2e-1c4f-b92c-758e67a509d7"], Cell[TextData[Cell[
    BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "856d9b11-73f3-a84d-9ee9-3e53b01e5cb8"]], "TableText",ExpressionUUID->
     "42e0d241-7297-a34f-ad4e-18e05b09dda7"], Cell[TextData[Cell[BoxData[
    "None"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "de0a7503-a38a-2a46-b625-97a30f765749"]], "TableText",ExpressionUUID->
     "cb20ad62-5703-3644-84c8-31d846d616a0"], Cell[TextData[{
     "merge equivalent events: ",
     Cell[BoxData["None"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3394625a-a7fe-4245-a507-23f0c79a9399"],
     ", ",
     Cell[BoxData["Full"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a92cea68-9522-0c40-9edd-e31a1c717ed1"],
     ", ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "96d38576-2a82-b742-9b8e-ea704f077bf5"],
     ", ",
     Cell[BoxData["Positional"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9d0f0e9f-8501-d744-98de-30a42f7d761a"],
     ", or a list of keys"
    }], "TableText",ExpressionUUID->"f900e570-b3a1-aa4f-a647-d1f921594405"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c4df82c-0eeb-7041-a190-cce68d1d2bab"], Cell[TextData[Cell[
