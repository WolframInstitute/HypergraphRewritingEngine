Cell[TextData[{
 Cell[BoxData["\"\<EvolutionGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07ff9e3d-196e-b566-2d84-106798181c4c"],
 " gives the graph of states and events, each event joined to its input and \
output states:"
}], "ExampleText",
 CellID->90506499,ExpressionUUID->"7611561e-6aa4-cbf1-1e2f-48580f5699db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HGEvolve", "[", 
  RowBox[{"triangle", ",", " ", 
   RowBox[{"{", 
