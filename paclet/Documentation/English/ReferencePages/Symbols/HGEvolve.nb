     "3bfbbd45-edb8-1b0b-6998-352e844d6651"]], "TableText",ExpressionUUID->
     "045023ab-c37d-b770-2c6f-baf4f6091a5a"], Cell[TextData[{
     "step at which branchial edges are computed: ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
     ", ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "33e490f1-5bc8-e939-619b-09bb5e62b803"],
     ", ",
     Cell[BoxData[
      RowBox[{"-", "1"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "794a4309-908b-2549-2f4a-5b53213f8f93"],
     " (final), or a 1-based step"
    }], "TableText",ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "15eb24b6-b946-3a65-43e8-bdf038f0894f"], Cell[TextData[Cell[
    BoxData["\"\<EdgeDeduplication\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "27d2a24c-1e84-19ee-4de1-44169b316b34"]], "TableText",ExpressionUUID->
     "285985c7-a1c8-13eb-5866-1ca0d07d6131"], Cell[TextData[Cell[BoxData[
    "True"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "57868ed1-450c-c474-7dbd-279b6cbeaf5e"]], "TableText",ExpressionUUID->
     "0c5e608e-35dc-f74f-3466-79e8bc6edd95"], Cell["\<\
one causal/branchial edge per event pair, rather than one per shared hyperedge\
\>", "TableText",ExpressionUUID->"1a1e4090-3303-05ed-4a26-59da46b66f37"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10256af3-3972-af7a-41da-83bdb804f240"], Cell[TextData[Cell[
    BoxData["\"\<TargetDevice\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "457602f1-d86e-ac86-730d-9bbad918f6ec"]], "TableText",ExpressionUUID->
     "499f95c1-a958-6c18-7fa4-0caac8ed3762"], Cell[TextData[Cell[
