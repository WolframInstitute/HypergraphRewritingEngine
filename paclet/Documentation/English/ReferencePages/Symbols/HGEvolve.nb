Cell[TextData[{
 Cell[BoxData["\"\<GlobalEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fd1c247-21a4-d962-35ee-e4215056a848"],
 " returns every edge the evolution created with its id, and ",
 Cell[BoxData["\"\<StateBitvectors\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09347675-9fce-c17b-38cc-683f1a789041"],
 " the ids each state holds. Asking for both is what makes either useful: the \
ids alone do not say what an edge is, and the edge list alone does not say \
which state holds it."
}], "ExampleText",
 CellID->1472343854,ExpressionUUID->"2c597ed5-00d9-d535-5467-779fb16dbc1f"],

