Cell[CellGroupData[{

Cell["\"TargetDevice\"", "ExampleSubsection",ExpressionUUID->"6ba8f048-6a99-5c41-99d0-51e9f8e58b2e"],

Cell[TextData[{
 "Evolution runs on the CPU by default. Where a GPU build is bundled, ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eab63a9c-20c6-f644-890b-329d77025097"],
 " runs on the device; otherwise it falls back to the CPU with a message. The \
GPU engine honors the same ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d604f02-dc6a-d446-a13a-644a9b56aed0"],
 " modes (",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bbd1261-e796-6a4b-b0d2-e6159c0b4d3d"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0a6dd44-8411-6945-89fa-abb5467d3bc4"],
 ", ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14bdfe81-e841-0f4b-91c1-afeba6f2e25e"],
 ") as the CPU, and its state counts match the CPU's in every mode:"
}], "ExampleText",ExpressionUUID->"f7b3b99e-32b5-1445-83cd-8738761484cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b6bba739-dbe9-5547-ae9b-0830107eb8bf"],

Cell[BoxData["10"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5c679a20-e7c1-5243-bf5a-ef2a13fb02c9"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

