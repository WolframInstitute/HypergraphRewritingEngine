Cell[TextData[{
 "When the events and branchial pairs are asked for only as ",
 Cell[BoxData["\"\<NumEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51798d79-74e7-e8a1-0706-25237c93ba8b"],
 " and ",
 Cell[BoxData["\"\<NumBranchialEdges\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e7478e0-34bc-b2ae-360c-71cabd4e00f4"],
 ", they are computed from the number of states in each class, without \
building the individual events. Twenty steps of the chain rule:"
}], "ExampleText",
 CellID->670671484,ExpressionUUID->"107fa139-5ae3-ed74-4004-39635e97b45e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"chain", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "20", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}], ",", 
   " ", 
   RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
   RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", 
    "True"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
