Cell[CellGroupData[{

Cell["\"MatchesPerStateRule\"", "ExampleSubsection",
 CellID->1364034540,ExpressionUUID->"47763c58-6b8c-f19b-6d0d-b6020e3ec3e1"],

Cell["\<\
A positive value keeps at most that many of a state's transitions for each \
rule. They are chosen after the state's matching is complete, by the \
transitions' identities and the seed, so the same transitions are kept at any \
thread count. Keeping one transition per state makes four steps of the chain \
rule a single path:\
\>", "ExampleText",
 CellID->438320377,ExpressionUUID->"2411395d-4500-dc0b-4c2e-b1076cbaa751"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chain", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"EdgeList", "[", 
  RowBox[{"HGEvolve", "[", 
   RowBox[{"chain", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<StatesGraphStructure\>\"", ",", " ", 
    RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}], ",", " ", 
    RowBox[{"\"\<RandomSeed\>\"", " ", "->", " ", "7"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->382340526,ExpressionUUID->"51798d79-74e7-e8a1-0706-25237c93ba8b"],

