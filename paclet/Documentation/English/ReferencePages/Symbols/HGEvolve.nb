  FontSize->0.9 Inherited,ExpressionUUID->
  "5f19c016-97c3-092d-0526-da5022765877"],
 " for ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "unknownprop"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c809b18-7d36-d224-44bf-134274c0a10e"],
 " for a property, ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "unknownic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7167cc0d-03c8-d238-271c-e657b662a102"],
 " for an initial-condition name and ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "evorder"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "324c55d1-ee3a-374b-6274-4c9a8bcc9d91"],
 " for an ",
 Cell[BoxData["\"\<EventOrderingFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4495e7b4-eb19-1195-6caa-fef18eac63ff"],
 " that is not ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "561855fc-8d4a-f767-7e38-4ca624fcda4d"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6cc16cd1-dd21-1c76-14fe-859ad4d4675c"],
 ", a string or a list of strings. A ",
 Cell[BoxData["\"\<MultiedgeStyle\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30881872-2ed2-344c-60b7-923c4b649e96"],
 " other than ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06a6bc82-b4ed-9511-2e5d-35ec3c99fc7b"],
 " or ",
 Cell[BoxData["\"\<Merged\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15240c0a-58c5-65f1-3cdb-a65459704fdb"],
 " issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "badmultiedge"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6874cd6b-f967-cd5b-180b-e534f81397a1"],
 ", and ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16aea7ca-f02c-8fa8-3e55-3e9781ded5f2"],
 " is used. A generated initial condition with no edges issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "emptyic"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68bcb404-3168-9397-1843-2e6e4002e1fd"],
 ". A platform whose paclet has no engine issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "noengine"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3074fef3-0190-9aee-600b-f7bdb02ae834"],
 "."
}], "Notes",
 CellID->931950651,ExpressionUUID->"5132409c-0c71-a3d8-00c2-59c6a505f122"],

