Cell["\"TargetDevice\"", "ExampleSubsection",
 CellID->955758104,ExpressionUUID->"53a2ca13-da2c-324e-0151-ec5cdfde8094"],

Cell[TextData[{
 "Evolution runs on the CPU by default. Where a GPU build is bundled, ",
 Cell[BoxData["\"\<GPU\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5930221d-821b-4026-08cf-c44737ae130c"],
 " runs on the device; otherwise it falls back to the CPU with a message. The \
GPU engine honors the same ",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76ba63e9-5df8-c241-1e5a-7ab3547290ab"],
 " modes (",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "319e51f9-a9ce-1d21-67a6-48a2c87b640b"],
 ", ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26f4962c-805e-a216-4e8b-087631e8f17c"],
 ", ",
 Cell[BoxData["Full"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "313d5a7b-7caf-7acc-60c3-5c25755a4816"],
 ") as the CPU, and its state counts match the CPU's in every mode:"
}], "ExampleText",
 CellID->1896713164,ExpressionUUID->"2da78195-91be-94f0-5b5c-18df2048feda"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "3", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<TargetDevice\>\"", " ", "->", " ", "\"\<GPU\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->467895564,ExpressionUUID->"39c6b7ab-78e0-e73c-6ffd-2ef5789aca06"],

Cell[BoxData["10"], "Output",
 CellLabel->"Out[1]= ",
 CellID->100518384,ExpressionUUID->"3f7d0c35-7157-44bf-6502-a67f00e22e85"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell[
  "Applications", "ExampleSection",ExpressionUUID->
   "47b49f91-c3c7-4deb-6d4b-16daf6721731"],
  $Line = 0; Null]], "ExampleSection",
 CellID->258228157,ExpressionUUID->"064e3005-d89e-7c03-2e75-aa6ed92b4769"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "76c2caed-aea0-13a2-1ef1-e3b6cb556188"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"260c3025-1fa9-9acd-4e33-a98f9a5de817"],

Cell[CellGroupData[{

Cell["Cross-run isomorphism hashes", "ExampleSubsection",
 CellID->893796687,ExpressionUUID->"4b1e6c2c-0452-4134-7925-8676ade7101e"],

Cell[TextData[{
 "Run-local state ids differ between runs, but ",
 Cell[BoxData["\"\<IncludeCanonicalHashes\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2982aea8-af87-65d7-5fb1-47f5ca324f3d"],
 " attaches an isomorphism-stable hash usable to fuse pruned runs by \
isomorphism class:"
}], "ExampleText",
 CellID->827580376,ExpressionUUID->"19ac3a5e-0cd6-873c-4f53-bc18a560ea06"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}], ",", " ", "2", ",", 
    " ", "\"\<States\>\"", ",", " ", 
    RowBox[{"\"\<CanonicalizeStates\>\"", " ", "->", " ", "Full"}], ",", " ", 
    
    RowBox[{"\"\<IncludeCanonicalHashes\>\"", " ", "->", " ", "True"}]}], 
   "]"}], " ", "//", " ", "Length"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->425790019,ExpressionUUID->"6e8690e9-968f-68b3-16bd-09b3233a3a99"],

Cell[BoxData["4"], "Output",
 CellLabel->"Out[1]= ",
 CellID->1231021859,ExpressionUUID->"2b6bc1ec-c569-bd9f-5968-d8c9ec1d07e5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continuing an evolution instead of re-running it", "ExampleSubsection",
 CellID->1852680185,ExpressionUUID->"25f1a39a-81e0-db80-538e-3ac4379aa9ea"],

Cell[TextData[{
 Cell[BoxData["HGEvolve"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "35466be2-b7a8-26dc-637d-82cfc2428c26"],
 " answers one question and discards the exploration that answered it, so \
asking for three steps and then five re-runs the first three. A ",
 StyleBox["session",
  FontWeight->"Bold"],
 " keeps the engine, its graph and the frontier the budget stopped at, so \
each step carries the ",
 StyleBox["same", "TI"],
 " exploration further and every state, event and relation already built \
keeps its identity:"
}], "ExampleText",
 CellID->494381976,ExpressionUUID->"58bdea72-0ba3-5f4c-0842-0c3cae562596"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<NumStates\>\"", ",", " ", "\"\<NumEvents\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HGSessionQuery", "[", "s", "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", 
   RowBox[{"HGSessionStep", "[", 
    RowBox[{"s", ",", " ", "1"}], "]"}]}], "}"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1344806010,ExpressionUUID->"6e8cef58-e908-949c-16b3-070588a2fee6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "1"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "0"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "2"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "1"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "4"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "3"}]}], "\[RightAssociation]"}],
    ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"NumStates\"\>", "\[Rule]", "10"}], ",", 
     RowBox[{"\<\"NumEvents\"\>", "\[Rule]", "9"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->641397874,ExpressionUUID->"0abc4047-6c7b-4886-3a44-5a21050e1aec"]
}, Open  ]],

Cell[TextData[{
 "which gives ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"NumStates", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"NumEvents", " ", "->", " ", "0"}]}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"2", ",", " ", "1"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"4", ",", " ", "3"}], "|>"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"10", ",", " ", "9"}], "|>"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24e21d63-fe6b-5877-4c91-954cfb1e2b5d"],
 " \[LongDash] the same numbers as ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "k", ",", " ", 
    "..."}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "348d2737-4aeb-e3cb-5cb2-bf716e9fb111"],
 " for ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"k", " ", "=", " ", "0"}], ",", " ", "1", ",", " ", "2", ",", " ", 
   "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2161c865-0900-0907-571e-e24fa8b5586d"],
 ", reached by continuing rather than restarting. ",
 Cell[BoxData[
  RowBox[{"HGSessionQuery", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3cadbe4b-a339-c651-6452-3014d6cdacbb"],
 " re-reads the accumulated graph without exploring further. ",
 Cell[BoxData[
  RowBox[{"HGSessionClose", "[", "s", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31169419-f57b-983b-672d-0e42fc0feb01"],
 " releases the engine."
}], "ExampleText",
 CellID->1710536547,ExpressionUUID->"40aa99e8-53bd-499c-70a9-10b266481be6"],

Cell["\<\
Three things are fixed when the session opens, and the later verbs refuse to \
change them:\
\>", "ExampleText",
 CellID->2029136281,ExpressionUUID->"5d165407-aaf3-867b-0b2e-4e60ce87ed41"],

Cell[TextData[{
 StyleBox["The rules.",
  FontWeight->"Bold"],
 " A session's rule set was fixed at ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75cb8946-a0dc-0da7-23c8-2123d169578d"],
 "; applying different ones would answer about a system the session is not \
exploring."
}], "Item",
 CellID->715626236,ExpressionUUID->"63688a50-35e7-99e6-1117-2c1a4393ebcc"],

Cell[TextData[{
 StyleBox["The identity convention",
  FontWeight->"Bold"],
 " (",
 Cell[BoxData["\"\<CanonicalizeStates\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12187c95-2034-8b29-4238-75df51c6d673"],
 ", ",
 Cell[BoxData["\"\<CanonicalizeEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34b193bd-0a67-a7a6-5c4e-0ae7af130d8c"],
 ", ",
 Cell[BoxData["\"\<ShowGenesisEvents\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4fca8ec2-4b73-3b52-75c9-27ac6e0789b8"],
 "). These decide what a state and an event ",
 StyleBox["are", "TI"],
 ". The engine reads them back from its own graph rather than from a step's \
request, so a query cannot report exact canonical forms as tree-mode ones."
}], "Item",
 CellID->465173273,ExpressionUUID->"656925a1-dac3-d209-1316-bc0adf77a153"],

Cell[TextData[{
 StyleBox["What the run records.",
  FontWeight->"Bold"],
 " An artifact the session was not opened for cannot be produced afterwards \
\[LongDash] the evolution that would have built it has already run. Open with \
the property you intend to ask for; asking for another returns an empty \
relation and the engine says so rather than serving the emptiness silently."
}], "Item",
 CellID->1676957670,ExpressionUUID->"09e13884-5cc5-f650-3f9e-b1ee5571dcba"],

Cell[TextData[{
 "A session's handle names a live engine process, so one session at a time is \
served per worker: a second ",
 Cell[BoxData["HGSessionOpen"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29829495-262a-abaa-5fb1-0ddf53dcf9f0"],
 " while one is live is an error rather than an eviction, because evicting \
would discard an exploration without being asked."
}], "ExampleText",
 CellID->1755616428,ExpressionUUID->"136212ad-a4c2-b9f3-4111-8bf6cd740bd9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Steering: continuing from part of the frontier", "ExampleSubsection",
 CellID->411019540,ExpressionUUID->"67f6b273-a0bf-ee61-0d8d-343cd14bb54b"],

Cell[TextData[{
 "An exploration that branches faster than it is worth exploring can be \
carried forward along a chosen branch. ",
 Cell[BoxData["HGSessionFrontier"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a2a6c0-d7ac-3784-2d51-3fade25e9dee"],
 " reports the states a continuation would resume from, and ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", 
     RowBox[{"{", "...", "}"}]}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d29df82-54ab-6c21-24d6-d6ec5d5e370b"],
 " expands only those:"
}], "ExampleText",
 CellID->1791983110,ExpressionUUID->"2673b224-f5d9-a24c-4e00-2b81fc6df096"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<NumStates\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HGSessionStep", "[", 
   RowBox[{"s", ",", " ", "2"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"HGSessionFrontier", "[", "s", "]"}]}], ";"}], "\n", 
 RowBox[{"HGSessionStep", "[", 
  RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
   RowBox[{"\"\<From\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"First", "[", "f", "]"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1705657336,ExpressionUUID->"27388ee6-22a7-f122-4ec7-27c05753c008"],

Cell[BoxData["7"], "Output",
 CellLabel->"Out[1]= ",
 CellID->1068798779,ExpressionUUID->"51cd4bfd-d3fa-9dcf-07f3-62a6e58ce715"]
}, Open  ]],

Cell["\<\
which reaches 7 states where an unsteered step of the same depth reaches 10.\
\>", "ExampleText",
 CellID->1072761042,ExpressionUUID->"06a776cb-b9d0-3c58-2e5d-6f95386a86a2"],

Cell[TextData[{
 StyleBox["The unselected branches are retained, not discarded.",
  FontWeight->"Bold"],
 " They stay on the frontier and a later step resumes them, so a steered \
detour costs nothing in what remains reachable: continuing the session above \
without a selection lands on 34 states, exactly what ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "[", 
   RowBox[{"rules", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
    " ", "\"\<NumStates\>\""}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7641b941-63e8-8619-1e7e-312b1582ed63"],
 " gives. Steering narrows what runs ",
 StyleBox["next", "TI"],
 ", never what is ",
 StyleBox["reachable", "TI"],
 "."
}], "ExampleText",
 CellID->331475396,ExpressionUUID->"42b8cf72-fa81-ffe6-7247-e73fff35c5cc"],

Cell[TextData[{
 "Naming a state that is not on the frontier is an error rather than a step \
that quietly does nothing, since a caller steering toward a state the \
exploration has already passed would otherwise get an unexplained empty \
result. Both devices serve the same contract: under ",
 Cell[BoxData[
  RowBox[{"TargetDevice", " ", "->", " ", "\"\<GPU\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c8db7a0-3aa3-299f-44b2-2e0abf567be5"],
 " the worker resolves the selection against the frontier it last reported \
and puts the unselected entries back after the step, each at the depth it was \
stranded at."
}], "ExampleText",
 CellID->867029361,ExpressionUUID->"473593be-64fb-e664-6eca-0af80c8fcd4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sending only what a step added", "ExampleSubsection",
 CellID->1012894407,ExpressionUUID->"79a8e286-b760-8808-2f57-fbe3c21adb52"],

Cell[TextData[{
 "A step re-serialises the whole accumulated graph. ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "766f3dde-6e6e-8ae3-1e14-b4980b18d8c9"],
 " sends only what the session has not already been sent, and the Wolfram \
side merges it back into the graph the session holds \[LongDash] so the wire \
is incremental and the ",
 StyleBox["answer", "TI"],
 " is not: ",
 Cell[BoxData["HGSessionStep"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7acff19c-f8f8-c05b-2af4-e8d9f97292a1"],
 " returns the whole accumulated graph either way."
}], "ExampleText",
 CellID->40139268,ExpressionUUID->"36bb0aa4-099e-3511-5e58-a30ea8289c7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", " ", "=", " ", 
   RowBox[{"HGSessionOpen", "[", 
    RowBox[{"rules", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", 
     " ", "\"\<StatesGraphStructure\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"HGSessionStep", "[", 
     RowBox[{"s", ",", " ", "1", ",", " ", "Automatic", ",", " ", 
      RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]}], "]"}], 
    ",", " ", 
    RowBox[{"{", "6", "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"HGSessionClose", "[", "s", "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->302691079,ExpressionUUID->"6fab4322-7f5b-c123-15a9-5a8c7aef9009"],

Cell[TextData[{
 "Measured on this evolution at depth 7 (5,914 states), ",
 Cell["tools/dev/session_step_cost.wls", "InlineCode",ExpressionUUID->
  "559c0528-76f1-864e-03a3-9d720285ec94"],
 ": the engine leg falls from 381 ms to 269 ms and the reply from 516,535 to \
443,660 bytes. That is a 29% cut to the engine call and 8% to the step, \
because the rest of a step is the Wolfram Graph construction \[LongDash] \
1,640 ms of the 2,021 ms total \[LongDash] which a delta cannot reduce, since \
the graph being built is the whole accumulated one either way."
}], "ExampleText",
 CellID->331769880,ExpressionUUID->"4c3b3e9a-7f95-6e09-75d8-b7c47a203553"],

Cell[TextData[{
 "Ask for a full delivery at any time to resynchronise; doing so resets what \
the session believes you hold, so the next delta is measured from it. Delta \
delivery is not served on the quotient reconstruction route (",
 Cell[BoxData[
  RowBox[{"\"\<ExploreFromCanonicalStatesOnly\>\"", " ", "->", " ", "True"}]],
   "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b834648-1855-f17e-29b1-581299e1c044"],
 " with causal output), where the causal relation is reduced on read and an \
edge already sent can leave the reduction \[LongDash] a delta has no way to \
withdraw one, so those replies carry the whole graph and say so."
}], "ExampleText",
 CellID->922365201,ExpressionUUID->"6aa15cf4-f328-f435-1a5f-55b186c2df1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Keeping a bounded number of transitions per rule", "ExampleSubsection",
 CellID->103265333,ExpressionUUID->"1fa3178e-7287-38be-4550-8ee807338a84"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "k"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33c53063-afff-c489-61fa-aa4cc98baed3"],
 " keeps at most ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08d8bcb3-70a4-55b3-38e7-35fd01513f99"],
 " of each state's transitions ",
 StyleBox["per rule",
  FontWeight->"Bold"],
 ", and the choice is made when that state's matching is complete rather than \
as matches arrive:"
}], "ExampleText",
 CellID->1543690019,ExpressionUUID->"20e38226-5aed-155d-5090-1b805e987fa7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"HGEvolve", "[", 
  RowBox[{"rules", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], ",", " ", "4", ",", 
   " ", "\"\<NumStates\>\"", ",", " ", 
   RowBox[{"\"\<MatchesPerStateRule\>\"", " ", "->", " ", "1"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1878070349,ExpressionUUID->"160727ef-d1b8-0069-3e3c-bec8e04d52b3"],

Cell[BoxData["5"], "Output",
 CellLabel->"Out[1]= ",
 CellID->939900604,ExpressionUUID->"261df1b1-b81e-57af-4e22-e8fb39ab3df5"]
}, Open  ]],

Cell[TextData[{
 "The distinction from the other caps is what it is for. ",
 Cell[BoxData["\"\<MaxSuccessorStatesPerParent\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00ba9d2f-c328-50fc-3059-1488f6dd22c6"],
 " bounds children per parent regardless of which rule produced them. ",
 Cell[BoxData["\"\<MatchesPerStep\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02964792-f196-8b6e-32ae-5edf8020d9b4"],
 " bounds by ",
 StyleBox["arrival order",
  FontWeight->"Bold"],
 ", which depends on the schedule, so two runs of the same evolution can keep \
different states. ",
 Cell[BoxData["\"\<MatchesPerStateRule\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166d4e5f-4333-9385-3e13-601976c7e1ef"],
 " ranks a state's transitions by their own isomorphism-invariant identity \
and the ",
 Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c99ee20-d785-d362-44a6-078de231be48"],
 ", so the kept set is the same at any thread count \[LongDash] choosing ",
 Cell[BoxData["k"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60858f89-56d8-6615-10ba-26d3636d4d7f"],
 " of ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e45545e-c429-efe4-567b-4e1bedddb5ce"],
 " needs all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "24564246-a2b2-7a9b-4c6e-6423d74748e1"],
 ", and all ",
 Cell[BoxData["M"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "273d1382-afb1-09c0-4ec2-8aefca445b2a"],
 " exist only once that state's matching has finished."
}], "ExampleText",
 CellID->1318687329,ExpressionUUID->"39c9e52f-ed06-87fb-6ff6-fc8884b0edc1"],

Cell["\<\
It counts every match of the state. A match handed to a state from its parent \
would arrive after that state's matching completes, where it could not be \
counted, so under this option the engine matches each state in full instead. \
Applies on both devices.\
\>", "ExampleText",
 CellID->142962819,ExpressionUUID->"46be6341-4be3-06d9-6e46-7b2b6d966c23"]
}, Open  ]]
}, Open  ]],

