    "DIFFER", " ", "between", " ", "invocations", " ", "of", " ", "the", " ", 
    "same", " ", 
    RowBox[{"call", ".", " ", "Set"}], " ", "a", " ", "random", " ", "seed", " ",
     "to", " ", "make", " ", "the", " ", "sample", " ", 
    RowBox[{"reproducible", "."}]}]}]}]], "Message", "MSG",
 CellID->1516831433,ExpressionUUID->"34f1caf0-755d-71af-5c8e-e3ba7ce843f5"],

