     "160f17c4-d31a-fe19-3e34-8ea1e6acc563"]], "TableText",ExpressionUUID->
     "10beb8bd-bdb6-ee93-4045-31e73440b4f9"], Cell[TextData[{
     "probability of keeping each transition; reproducible from ",
     Cell[BoxData["\"\<RandomSeed\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
