     "8cf69cd2-ed00-1341-b436-ce0442e6c399"], Cell["\<\
quotient exploration: expand each canonical state once, at its shortest depth \
(off by default, so every provenance is explored)\
\>", "TableText",ExpressionUUID->"9eac7a41-2ef2-be4d-9268-87f3d953ef2e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2c858533-ae47-aa47-ae31-453d27806629"], Cell[TextData[Cell[
    BoxData["\"\<QuotientInitialStates\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "83b85e48-23a1-ad42-bd78-89865c3941c3"]], "TableText",ExpressionUUID->
     "7165a3ad-b3c7-da43-b702-e8f26d9f1d44"], Cell[TextData[Cell[BoxData[
    "False"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
