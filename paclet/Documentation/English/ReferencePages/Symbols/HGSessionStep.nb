Notebook[{

Cell[CellGroupData[{
Cell["HGSessionStep", "ObjectName",
 CellID->1224892054,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionStep"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["session", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 "\[LineSeparator]",
 "evolves ",
 StyleBox["session", "TI"],
 " ",
 StyleBox["n", "TI"],
 " steps further and gives the property the session was opened for, over the \
whole evolution so far.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionStep"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["session", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 "\[LineSeparator]",
 "gives the property ",
 StyleBox["prop", "TI"],
 " instead."
}], "Usage",
 CellID->329621944,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[TextData[{
 StyleBox["session", "TI"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2f3e8453-9762-68ea-56c5-1e1d22173a30"],
 " given by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5902d484-617f-9570-0f31-cdee100bfc5a"],
 "; ",
 StyleBox["n", "TI"],
 " is a non-negative integer."
}], "Notes",
 CellID->515379898,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[TextData[{
 "A step of ",
 StyleBox["n", "TI"],
 " expands the states on the session's frontier (the states ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionFrontier"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionFrontier", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5708d032-2150-04f2-7d37-ca7c50e56ed8"],
 " lists) through ",
 StyleBox["n", "TI"],
 " more levels. After a step without ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", the frontier is the set of states at the new depth."
}], "Notes",
 CellID->604760901,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[TextData[{
 "Steps add up: after steps totalling ",
 StyleBox["k", "TI"],
 ", counts and graph sizes are those of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGEvolve"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["rules", "TI"], ",", " ", 
    StyleBox["init", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["prop", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " with the session's rules, initial states and options, and graphs and \
states agree with it up to isomorphism."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[TextData[{
 "State, event and edge ids, and the names of vertices created by the rules, \
are assigned in the order the engine creates them, so a session's raw records \
can carry different ids from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 "'s."
}], "Notes",
 CellID->448336599,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["HGSessionStep"]], 
     "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
     "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["session", "TI"], ",", " ", "0"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23253b8d-1c99-a6bf-52da-b2d7952d0c85"],
 " does not evolve and gives the same result as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6e84829b-9667-6594-16bb-1bc523124ffe"],
 "."
}], "Notes",
 CellID->970785311,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[TextData[{
 StyleBox["prop", "TI"],
 " is any property ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],
 " accepts, or a list of them, whether or not it was named at ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 ". ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " stands for the property the session was opened for."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell["The following options can be given:", "Notes",
 CellID->1439899046,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"], Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],
     Cell["", "TableText",
     FontWeight->Bold,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"], Cell[TextData[Cell[
    BoxData["\"\<From\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "1dbaaaf7-1388-e538-4b59-43b1a622cc02"]], "TableText",ExpressionUUID->
     "77d99fdb-a351-2d53-1de6-1684d6e477b9"], Cell[TextData[Cell[BoxData[
    "All"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "04646437-faee-7dfc-2c1c-7e70fe9b47c6"]], "TableText",ExpressionUUID->
     "1cbde497-e826-5557-4442-fdd089d33fbd"], Cell[TextData[{
     "the frontier states to expand: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],
     ", or a list of ids from ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["HGSessionFrontier"]], 
        "paclet:WolframInstitute/HypergraphRewriteEngine/ref/\
HGSessionFrontier", "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "4c358d3e-86d3-ec5f-75ca-25783367b6a5"],
     " (an empty list means ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
     ")"
    }], "TableText",ExpressionUUID->"5dac66ba-272d-3627-0b54-7fe452d99d0d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "110914de-bbdd-83a1-4736-8d983e69d18b"], Cell[TextData[Cell[
    BoxData["\"\<Delivery\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "76d004f9-29e5-6665-1eef-9da34f904d4f"]], "TableText",ExpressionUUID->
     "2c76c797-c249-79ca-540d-ded0f7fc4b10"], Cell[TextData[Cell[
    BoxData["\"\<Full\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "35077f55-9291-6519-633d-771f27244c63"]], "TableText",ExpressionUUID->
     "4ebf3687-f906-130d-7644-afe0f8b37e57"], Cell[TextData[{
     Cell[BoxData["\"\<Full\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
     " sends the whole result from the engine; ",
     Cell[BoxData["\"\<Delta\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
     " sends only what this session has not sent before"
    }], "TableText",ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"]}
  }]], "3ColumnTableMod",
 CellID->1641200340,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[TextData[{
 "With ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "034d641c-5834-e412-3173-7e4659c6cf78"],
 ", only the named frontier states are expanded; the others stay on the \
frontier, and a later step without ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52ce4f6a-032d-a48b-02f6-6734b6d90ed1"],
 " expands them up to the depth that step reaches."
}], "Notes",
 CellID->1424533854,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "A ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 " naming a state that is not on the frontier issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "refused"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e1c99a5-dcef-9c28-1623-100ed49be772"],
 "; the session is unchanged."
}], "Notes",
 CellID->535457321,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Delivery\>\"", " ", "->", " ", "\"\<Delta\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa912c6-4938-1bb7-5a56-8ba068cd699d"],
 " the result is still the whole evolution; only the transfer from the engine \
is smaller."
}], "Notes",
 CellID->141959522,ExpressionUUID->"66b4bee0-d247-b105-0e4b-37cde7f3006f"],

Cell[TextData[{
 "A negative or non-integer ",
 StyleBox["n", "TI"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "::", "negsteps"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "337c2d89-644e-5b5e-6103-c4d30dfb29a4"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7c2741-1c81-ec9b-0503-bf2b9535b6e1"],
 ". A property ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGEvolve"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGEvolve", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "644cc522-c7c4-9b18-0c73-dc8ff276e662"],
 " does not accept issues ",
 Cell[BoxData[
  RowBox[{"HGEvolve", "::", "unknownprop"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2de8c8f9-eaf3-8e90-5b97-e1a28e87d4fa"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6801f052-da94-0b6f-183e-ea1fdf2159b5"],
 "."
}], "Notes",
 CellID->299517738,ExpressionUUID->"0daf8e98-7628-e40b-3b54-27c203c2cf51"],

Cell[TextData[{
 "On a closed session it issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "refused"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b6211f5-475c-1194-2911-88bf72e963fe"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c8f7bdf-2493-8d8a-24b5-72994d27d7d0"],
 "; for an expression that is not an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14e8dcaf-74c9-37ba-3c97-d5097d7d9d80"],
 " it issues ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "::", "badsession"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b7fe4cc-5889-7f4e-6904-fd96593c4594"],
 "."
}], "Notes",
 CellID->2142391071,ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"]
}, Open  ]],

