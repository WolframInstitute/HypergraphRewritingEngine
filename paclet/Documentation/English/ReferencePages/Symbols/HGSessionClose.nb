Cell[TextData[{
 "Closing discards the session's evolution. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionStep"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionStep", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3b7807e8-9504-b25a-6907-9eb21cb600a0"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionQuery"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionQuery", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "166f8969-5e31-e8e5-3e14-21335bc5bacf"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionFrontier"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionFrontier", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "234f1fb7-07c6-bba9-5174-96f1b27009f3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionClose"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionClose", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],
 " on a closed session issue the message ",
 Cell[BoxData[
  RowBox[{"HGSessionOpen", "::", "refused"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],
 " and give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ec9a758-58be-624c-16f6-3f02594b3096"],
 "."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell["\<\
A session's handle is not reused, so a verb on a closed session is refused \
rather than answered from a session opened later.\
\>", "Notes",
 CellID->448336599,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[TextData[{
 "One session is open at a time for each device. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionOpen"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionOpen", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "569e173f-6b36-b240-7ea5-8f790ec000aa"],
 " is refused while another session is open, so a session that is no longer \
needed should be closed."
}], "Notes",
 CellID->970785311,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell[TextData[{
 "An expression that is not an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HGSessionObject"]], 
    "paclet:WolframInstitute/HypergraphRewriteEngine/ref/HGSessionObject", 
    "WolframInstitute/HypergraphRewriteEngine Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "779c57de-bb93-d239-1da4-4e983e27a103"],
 " issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "::", "badsession"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2867ea9b-6e8d-517b-581c-03c50b382041"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "76dfbc62-92ac-7b6e-1ee4-364c275949b4"],
 "."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[TextData[{
 "If the engine process that holds the session has ended (an aborted call \
ends it), it issues the message ",
 Cell[BoxData[
  RowBox[{"HGSessionStep", "::", "expired"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"],
 " and gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$Failed"]], "paclet:ref/$Failed"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "741b091d-feb2-1a39-1c38-a146fb476903"],
 "; open a new session."
}], "Notes",
 CellID->1439899046,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"]
}, Open  ]],

