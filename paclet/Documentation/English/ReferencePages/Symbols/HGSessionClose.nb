Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"HGSessionOpen", "::", "refused"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{
   RowBox[{
   "The", " ", "engine", " ", "refused", " ", "this", " ", "session", " ", 
    RowBox[{"job", ".", " ", "The"}], " ", "usual", " ", 
    RowBox[{"causes", ":", " ", 
     RowBox[{
     "a", " ", "session", " ", "is", " ", "already", " ", "open", " ", "on", " ",
       "this", " ", "worker", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "one", " ", "is", " ", "served", " ", "at", " ", "a", " ", "time"}], ",",
         " ", 
        RowBox[{
        "so", " ", "close", " ", "it", " ", "before", " ", "opening", " ", 
         "another"}]}], ")"}]}]}]}], ",", " ", 
   RowBox[{
   "or", " ", "the", " ", "verb", " ", "named", " ", "a", " ", "session", " ",
