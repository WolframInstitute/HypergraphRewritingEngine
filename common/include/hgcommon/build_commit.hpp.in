#pragma once
// Generated by CMake at configure time into ${CMAKE_BINARY_DIR}/generated/hgcommon/. The three
// values the build stamp (hgcommon/build_stamp.hpp) takes from the build system rather than
// from the compiler: the commit, the build type and the configuration's C++ flags. A generated
// header rather than a compile definition, so a new commit recompiles only the translation
// units that define a stamp and not every object in the tree (a definition on every target
// made each commit a full device rebuild).
#define HG_BUILD_COMMIT "@HG_BUILD_COMMIT@"
#define HG_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define HG_BUILD_FLAGS "@HG_BUILD_FLAGS@"
