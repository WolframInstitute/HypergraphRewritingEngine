/build*/
/compile_commands.json

# Built paclet archives (regenerable via tools/build_paclet.wls / make create_paclet_archive)
*.paclet
/paclet_archive/

# Documentation notebooks (Documentation/English/**/*.nb) ARE tracked — rendered from the markdown
# (Documentation/Source) on a cloud-connected machine and committed. Ignored here are the doc
# build's own generated/transient outputs:
/paclet/Documentation/Source/generated/
/paclet/Documentation/.english_stage/
/paclet/Documentation/English/.build_ok
/paclet/Documentation/English/.doc_manifest.wl
__pycache__/
*.pyc

# Generated by tools/dev/evidence.sh: a regenerated report, not a source.
evidence/

# Generated benchmark output. The suite writes a directory per commit; nothing in the tree
# references a particular one, and a snapshot goes stale the moment the engine changes -- the
# tracked copy was 277 commits behind HEAD. The numbers that are part of the deliverable live in
# the paper, which states the commit they were taken at.
/benchmark_results/

# LaTeX build output. The paper source and the built main.pdf are tracked; the rest of
# what pdflatex writes is not.
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
# `make arxiv` builds and packs a submission tree; both are outputs of a target in this repo.
/paper/arxiv-submission.tar.gz
/paper/arxiv-submission/
/paper/*.toc

# Reports written by tools/dev/source_map.py and tools/dev/source_audit.py (libclang over the
# tree); regenerated on demand, never hand-edited.
/SOURCE_MAP.md
/SOURCE_AUDIT.md

# Local artifacts pulled off a rented measurement box (tools/dev/remote_drive.sh).
remote_runs/

# GenMC caches the engine IR here, keyed on the sources it was built from.
.genmc_ir_cache/
